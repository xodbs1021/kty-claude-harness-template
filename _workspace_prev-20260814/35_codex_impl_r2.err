   167	# 15. 게이트를 듀얼리뷰(3.5) 뒤로 옮기기 — 지우는 변이가 아니라 **옮기는 변이**다.
   168	#     (지우면 "게이트 없음"을 재는 것이지 "순서가 틀림"을 재는 것이 아니다 — ADR-0012 규약)
   169	total=$((total + 1))
   170	if python3 - "$VSTOP" <<'PY'
   171	import sys
   172	p = sys.argv[1]
   173	src = open(p, encoding='utf-8').read()
   174	# 앵커 정확히 1회 계약 — mutate() 와 동일. index() 는 첫 발생만 잡아 중복 앵커에서
   175	# 엉뚱한 블록을 옮기고도 "순서 방어 확인"으로 집계될 수 있다(구현 검수 [cx] 지적).
   176	for a in ('# (3.4) **머리 표명 게이트**', '# (3.5) 듀얼 리뷰(codex) 게이트',
   177	          '# (4) change-explainer 게이트'):
   178	    if src.count(a) != 1:
   179	        raise SystemExit(1)
   180	start = src.index('# (3.4) **머리 표명 게이트**')
   181	end = src.index('# (3.5) 듀얼 리뷰(codex) 게이트')
   182	block = src[start:end]
   183	rest = src[:start] + src[end:]
   184	anchor = "# (4) change-explainer 게이트"
   185	i = rest.index(anchor)
   186	open(p, 'w', encoding='utf-8').write(rest[:i] + block + rest[i:])
   187	PY
   188	then
   189	  if "$TEST" >/dev/null 2>&1; then
   190	    green=$((green + 1)); echo "  🟢 [m15 게이트를 3.5 뒤로 이동] 살아남음"
   191	  else
   192	    red=$((red + 1)); echo "  🔴 [m15 게이트를 3.5 뒤로 이동] 적색 (순서 계약 확인)"
   193	  fi
   194	  restore "$VSTOP"
   195	else
   196	  echo "  ✗ [m15] 블록 이동 실패 — 실패 처리" >&2
   197	fi
