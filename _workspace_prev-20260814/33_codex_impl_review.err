   620	# --- 케이스 (r28~ — 둘째 줄 레퍼런스 표명, ADR-0015) ----------------------
   621	
   622	# ref_pass <이름> <둘째줄|PRINTF_RAW> [원본파일내용] — 통과 기대 케이스 공통 골격.
   623	# 감사 게이트 도달 + 회수 게이트 침묵 + 플래그 자동 해제까지 요구한다(rc 단독 판정 금지).
   624	ref_pass() {
   625	  local name="$1" second="$2" raw="${3-}" why='' p
   626	  p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   627	  if [ "$second" = "PRINTF_RAW" ]; then
   628	    printf '%s' "$raw" > "$p/_workspace/00_design.md"
   629	  else
   630	    mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST" "$second"
   631	  fi
   632	  set_flag "$p" retrieval '_workspace/00_design.md'
   633	  set_flag "$p" audit 'src/x.ts'
   634	  mk_tx "$p/tx.jsonl" neutral
   635	  run_stop "$p" "$p/tx.jsonl"
   636	  if [ "$DID_RUN" -ne 1 ];             then why='훅 미실행'
   637	  elif contains "$ERR" "$TOK_RET";     then why="위양성 — 머리 표명 게이트가 막았다: $(printf '%s' "$ERR" | sed -n '3,5p' | head -c 120)"
   638	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   639	  elif ! flag_gone "$p";               then why='플래그 미해제'
   640	  fi
   641	  report "$name" "$why"
   642	}
   643	
   644	# ref_block <이름> <둘째줄> <사유조각> — 차단 기대 케이스 공통 골격.
   645	ref_block() {
   646	  local name="$1" second="$2" frag="$3" why='' p
   647	  p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   648	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST" "$second"
   649	  set_flag "$p" retrieval '_workspace/00_design.md'
   650	  set_flag "$p" audit 'src/x.ts'
   651	  mk_tx "$p/tx.jsonl" neutral
   652	  run_stop "$p" "$p/tx.jsonl"
   653	  if [ "$DID_RUN" -ne 1 ];              then why='훅 미실행'
   654	  elif [ "$RC" -ne 2 ];                 then why="rc=$RC (기대 2)"
   655	  elif ! contains "$ERR" "$TOK_RET";    then why="머리 표명 게이트가 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   656	  elif ! contains "$ERR" "$frag";       then why="사유($frag)가 메시지에 없다: $(printf '%s' "$ERR" | sed -n '3,5p' | head -c 120)"
   657	  elif flag_gone "$p";                  then why='불량인데 플래그가 해제됐다'
   658	  fi
   659	  report "$name" "$why"
   660	}
