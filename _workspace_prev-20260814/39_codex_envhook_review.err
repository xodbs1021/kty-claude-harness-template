     2	# mutate-env-check-hook.sh — harness.env 편집 검증 훅(post:edit:harness-env, ADR-0016)
     3	# 방어의 **변이 측정**. 형제 하네스(mutate-retrieval-gate 등)와 같은 계약:
     4	#   · 대상에 미커밋 변경이 있으면 거부 (복원이 작업물을 지운다)
     5	#   · 치환 앵커는 정확히 1회 매치해야 진행 (빈 변이 = 거짓 초록 방지)
     6	#   · 복원 직후 git hash-object ↔ rev-parse HEAD:<경로> 대조
     7	
     8	set -uo pipefail
     9	cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
    10	
    11	HOOK="template/.claude/hooks/check-harness-env.sh"
    12	COMMON="template/.claude/hooks/_common.sh"
    13	TEST="./tests/check-harness-env.test.sh"
    14	
    15	for f in "$HOOK" "$COMMON"; do
    16	  if ! git diff --quiet -- "$f" || ! git diff --cached --quiet -- "$f"; then
    17	    echo "✗ 대상에 미커밋 변경이 있습니다: $f — 먼저 커밋하고 재세요 (복원이 작업물을 지웁니다)" >&2
    18	    exit 1
    19	  fi
    20	done
    21	
    22	LOCK="$(git rev-parse --git-dir)/mutate-env-check-hook.lock"
    23	if ! mkdir "$LOCK" 2>/dev/null; then
    24	  echo "✗ 이미 다른 변이 측정이 돌고 있습니다: $LOCK" >&2
    25	  echo "  (그 프로세스가 죽었다면: rmdir '$LOCK')" >&2
    26	  exit 1
    27	fi
    28	trap 'rmdir "$LOCK" 2>/dev/null' EXIT
    29	
    30	if ! "$TEST" >/dev/null 2>&1; then
    31	  echo "✗ 기준선 실패 — 변이 없이도 테스트가 빨갛습니다. 먼저 초록으로 만들고 재세요" >&2
    32	  exit 1
    33	fi
    34	
    35	total=0; red=0; green=0
    36	
    37	restore() {
    38	  git restore --source=HEAD --worktree -- "$1" || { echo "✗ 복원 실패: $1" >&2; exit 1; }
    39	  local w h
    40	  w="$(git hash-object "$1")"; h="$(git rev-parse "HEAD:$1")"
    41	  [ "$w" = "$h" ] || { echo "✗ 복원 검증 실패: $1 ($w != $h)" >&2; exit 1; }
    42	}
    43	
    44	mutate() {
    45	  local name="$1" file="$2" anchor="$3" repl="$4" n
    46	  total=$((total + 1))
    47	  n="$(python3 - "$file" "$anchor" <<'PY'
    48	import sys
    49	src = open(sys.argv[1], encoding='utf-8').read()
    50	print(src.count(sys.argv[2]))
    51	PY
    52	)"
    53	  if [ "$n" != "1" ]; then
    54	    echo "  ✗ [$name] 앵커 매치 ${n}회 (기대 1) — 빈 변이 방지로 실패 처리" >&2
    55	    return 1
    56	  fi
    57	  python3 - "$file" "$anchor" "$repl" <<'PY'
    58	import sys
    59	p, a, r = sys.argv[1], sys.argv[2], sys.argv[3]
    60	src = open(p, encoding='utf-8').read()
    61	open(p, 'w', encoding='utf-8').write(src.replace(a, r, 1))
    62	PY
    63	  if "$TEST" >/dev/null 2>&1; then
    64	    green=$((green + 1))
    65	    echo "  🟢 [$name] 살아남음 — 이 방어를 지키는 케이스가 없다"
    66	  else
    67	    red=$((red + 1))
    68	    echo "  🔴 [$name] 적색 (방어 확인)"
    69	  fi
    70	  restore "$file"
    71	}
    72	
    73	echo "harness.env 편집 검증 훅 변이 측정"
    74	
    75	# 1. 판독기의 부재(rc=3) 구분 제거 — 부재가 "못 믿음"으로 접혀 안 쓰는 키에 경고(위양성)
    76	mutate 'e01 파서의 rc=3 부재 구분 제거' "$COMMON" \
    77	  '  if (N == 0) exit 3        # 부재 — 안 쓰는 키의 정상 상태 (반환 계약 rc=3)
    78	  if (N > 1) exit 1' \
    79	  '  if (N != 1) exit 1'
    80	
    81	# 2. 파일 없음의 rc=3 제거 (rc=1 로 회귀) — 부재 클래스의 다른 반쪽
    82	mutate 'e02 파일 없음 rc=3 제거' "$COMMON" \
    83	  "  [ -f \"\$file\" ] || { printf '%s' ''; return 3; }" \
    84	  "  [ -f \"\$file\" ] || { printf '%s' ''; return 1; }"
    85	
    86	# 3. 훅이 rc=3 을 경고 대상에 포함 — c04(키 없음 침묵)가 빨개진다
    87	mutate 'e03 훅의 부재 침묵 제거' "$HOOK" \
    88	  '    0|3) ;;                              # 판독됨 / 부재(안 쓰는 키) — 정상, 침묵' \
    89	  '    0) ;;'
    90	
    91	# 4. 경고 방출 제거 — 문법 실수가 침묵으로 넘어간다(이 훅의 존재 이유 소멸)
    92	mutate 'e04 systemMessage 방출 제거' "$HOOK" \
    93	  'printf '"'"'{"systemMessage":"harness.env 판독 경고: %s' \
    94	  ': # printf 제거됨 -- %s'
    95	
    96	# 5. 경로 앵커 느슨화 — 무관 동명 파일에도 발화(위양성)
    97	mutate 'e05 경로 앵커 느슨화' "$HOOK" \
    98	  '  */.claude/harness/harness.env|.claude/harness/harness.env) ;;' \
    99	  '  *harness.env) ;;'
   100	
   101	# 6. 상대경로를 cwd 기준으로 — 다른 cwd 에서 그 파일을 못 찾아 부재로 오인(침묵)
   102	mutate 'e06 상대경로를 cwd 기준으로' "$HOOK" \
   103	  '  *)  envfile="$PROJECT_DIR/$file_path" ;;' \
   104	  '  *)  envfile="$file_path" ;;'
   105	
   106	# 7. 훅 비활성 접기 제거 — 탈출구 소멸
   107	mutate 'e07 hook_disabled 접기 제거' "$HOOK" \
   108	  'hook_disabled "$HOOK_ID" && exit 0' \
   109	  ':'
   110	
   111	echo
   112	echo "총 $total 건 — 적색 $red · 초록 $green"
   113	[ "$green" -eq 0 ] && [ "$red" -eq "$total" ]

