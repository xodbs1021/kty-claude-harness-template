    65	#   ① 파일 첫머리 BOM 제거 → ② 각 줄 후행 CR 제거 → ③ **줄을 넘는 인용 상태** 추적 →
    66	#   ④ 히어독 본문 배제 → ⑤ 선언 판정 → ⑥ 따옴표 벗기기 → ⑦ 따옴표 **밖** 후행 주석
    67	#   → ⑧ 남은 후행 공백 절단
    68	#
    69	# ── 반환 계약 ──────────────────────────────────────────────────────────
    70	#   rc=0 : 최상위 선언이 **정확히 1개**이고 값을 지원 문법으로 판독했다.
    71	#          stdout = 판독된 값. **빈 문자열일 수 있다** — "리터럴로 비웠다"는 뜻이다.
    72	#   rc=1 : 값을 믿을 수 없다 — 파일 없음 · 읽기 실패 · 선언 0개 · 선언 2개 이상 ·
    73	#          지원 문법 밖. stdout = 빈 문자열.
    74	#
    75	# 왜 이 둘을 rc 로 가르나: 스위치형 슬롯은 "리터럴로 비웠다"(=끈다)와 "미설정"(=이전
    76	# 동작 보존)이 **반대 방향**이다. 빈 문자열 하나로 뭉뚱그리면 키가 없는 기존 설치본이
    77	# 업그레이드 순간 게이트가 꺼진 것과 구별되지 않는다.
    78	#
    79	# ── 지원 문법 (좁게 고정했다. 이 밖은 전부 rc=1) ───────────────────────
    80	#   KEY=값  ·  export KEY=값   (export 뒤는 공백 또는 탭)
    81	#   값: "겹따옴표"  ·  '홑따옴표'  ·  인용 없는 평문
    82	#   닫는 따옴표 뒤에는 **공백**과 `# 주석` 만 올 수 있다 (`""#on` 은 문법 밖 — 셸에서
    83	#     그 값은 `#on` 이라 비어 있지 않은데, 주석으로 읽으면 게이트가 꺼지는 방향이다)
    84	#   인용 없는 값은 **공백에 이어지는 `#`** 부터가 주석이다 (`a#b`·`#on` 은 값 그대로)
    85	# ── 지원하지 않는 것 (조용히 절반만 읽지 않고 rc=1 로 떨어진다) ────────
    86	#   등호 바로 뒤의 공백(`KEY= x`) · 백슬래시 이스케이프 · 한 줄에 인용 조각 여러 개 ·
    87	#   여러 줄 값 · 닫히지 않은 따옴표
    88	#
    89	# 판독 모델: **선행 공백이 없는 최상위 대입만** 선언으로 센다. 조건문·함수 본문 안의
    90	# 대입은 실행되지 않을 수도 있어 원문만으로는 발효 여부를 알 수 없다.
   220	raw="$(printf '%s' "$payload" | json_get tool_input.file_path; printf 'X')"
   221	raw="${raw%X}"
   222	file_path="${raw%$'\n'}"
   223	[ -z "$file_path" ] && exit 0
   224	
   225	# 개행 가드는 **정규화보다 먼저**여야 한다. 디렉토리 컴포넌트가 개행으로 끝나면
   226	# (…/sr<LF>/app.ts) physical_path 의 pwd -P 출력을 받는 명령 치환이 그 개행을 먹어
   227	# 경로가 …/sr/app.ts 로 조용히 바뀐다 — 없는 파일이 게이트에 박히고 정작 편집한
   228	# 파일은 무게이트가 된다. 플래그 파일은 줄 단위라 개행이 든 경로는 애초에 못 적는다.
   229	case "$file_path" in
   230	  *$'\n'*) emit_message "$MSG_NEWLINE"; exit 0 ;;
   231	esac
   232	
   233	# 양쪽을 물리 경로로 맞춘 뒤에 비교한다. git 은 실제 경로를 돌려주는데 편집 경로는
   234	# 심링크를 지나올 수 있고(macOS /var → /private/var), .. 로 되돌아올 수도 있다.
   235	# 정규화 없이 자르면 접두사가 안 맞아 프로젝트 안 편집이 통째로 "밖"으로 샌다.
   236	# PROJECT_DIR 은 디렉토리라 통째로 물리화한다(심링크 PROJECT_DIR — 케이스 11·12).
   237	# 편집 경로는 파일이라 마지막 성분 이름을 보존하는 physical_path 를 쓴다 — 두 계약이
   238	# 다르므로 함수도 둘이다.
   239	proj="$(physical_dir "$PROJECT_DIR")"
   240	case "$file_path" in
   241	  /*) ;;
   242	  *) file_path="$proj/$file_path" ;;
   243	esac
   244	abs="$(physical_path "$file_path")"
   245	
   246	# 설계·계획 산출물은 위치·git 여부와 무관하게 듀얼리뷰 게이트만 세운다.
   247	# **정규화 뒤**에 판정해야 한다: 상대경로 입력에는 선행 슬래시가 없어 아래 글롭에
   248	# 걸리지 않고, .. 가 섞인 경로는 기록값이 .claude/../_workspace/… 로 남는다.
   249	# 매칭만 소문자화하고 기록은 원본 대소문자로 한다.
   250	lower_abs="$(printf '%s' "$abs" | tr '[:upper:]' '[:lower:]')"
   251	# 설계·계획 산출물은 듀얼리뷰 **와 지식·회수 표명 게이트**를 세운다. 코드가 아니므로
   252	# 타입체크·변경설명·감사는 과하지만, 설계가 나온 턴을 지식 저장소 반영 없이 끝내면
   253	# "왜 그렇게 정했나"가 그 자리에서 사라진다 — 결정을 만든 근거가 정확히 이 파일들이다.
   254	# 회수 플래그(ADR-0013·0015)는 머리 두 줄(`사전 결정 회수:`·`레퍼런스 조사:`) 표명을
   255	# Stop 이 검사하고 지키면 스스로 지운다. 이름에 codex 가 든다고 빼는 식의 **이름 제외는 두지 않는다** —
   256	# 관측되지 않은 재귀를 막으려고 실재하는 위음성(codex 를 다루는 정상 설계서의 무게이트)을
   257	# 만들게 된다. 리뷰 산출물과의 재귀는 명명 계약(리뷰 산출물은 00_design·01_plan 접두어
   258	# 금지 — 오케스트레이터 스킬)이 막는다.
   259	case "$lower_abs" in
   260	  */_workspace/00_design*.md|*/_workspace/01_plan*.md)
   261	    dual_value="$(project_rel "$abs")" || dual_value="$abs"
   262	    dw=0
   263	    record_flag "$DUALREVIEW_FLAG" "$dual_value" || dw=1
   264	    record_flag "$KNOWLEDGE_FLAG"  "$dual_value" || dw=1
   265	    record_flag "$RETRIEVAL_FLAG"  "$dual_value" || dw=1
   266	    [ "$dw" -eq 1 ] && emit_message "$MSG_WRITE_FAIL"
   267	    exit 0 ;;
   268	esac
   269	
   270	if rel="$(project_rel "$abs")"; then
   271	  value="$rel"
   272	  verdict="$(classify "$rel" "$proj")"
   273	else
   274	  # 프로젝트 밖. 기록값은 절대경로다.
   275	  value="$abs"
   276	  root="$(git_toplevel "$abs")" || root=''
   277	  if [ -n "$root" ] && is_harness_canonical "$root"; then
   278	    case "$abs" in
   279	      "$root"/*) rel="${abs#"$root"/}" ;;
   280	      *) rel="$abs" ;;
