++# 타입체크는 항상 리터럴로 비운다 — 이 파일이 재는 것은 결정 게이트뿐이고, 타입체크가
++# 먼저 막으면 그 케이스는 결정 게이트에 **도달조차 못 한 채** 기대값이 우연히 맞는다.
++new_project() {
++  PROJ_N=$((PROJ_N + 1))
++  local p="$TMPROOT/proj$PROJ_N"
++  mkdir -p "$p/.claude/hooks" "$p/.claude/harness" || return 1
