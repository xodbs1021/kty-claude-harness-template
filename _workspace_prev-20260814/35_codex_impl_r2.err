   775	  local name='r46 실패 빈 괄호 → 차단 (변형 공통 내용 검사)' why='' p p2
   776	  p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   777	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST" '레퍼런스 조사: 실패()'
   778	  set_flag "$p" retrieval '_workspace/00_design.md'
   779	  set_flag "$p" audit 'src/x.ts'
