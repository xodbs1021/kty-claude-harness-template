     1	#!/usr/bin/env bash
     2	# PostToolUse(Edit|Write|MultiEdit): 편집된 파일이 완료 게이트 대상이면 플래그를 세운다.
     3	#
     4	# 이 플래그는 completion-auditor 가 검증을 통과시킨 뒤에만 지워진다.
     5	# Stop 훅이 플래그를 보고 턴 종료를 막는다 → 감사자 호출이 강제된다.
     6	# 커밋 여부와 무관하게 동작하므로 "커밋해서 트리가 clean 해졌으니 통과" 같은 구멍이 없다.
     7	#
     8	# 검사 범위:
     9	#   프로젝트 안       — _workspace/·.claude/·순수 *.md|*.markdown(대소문자 무관) 를 뺀 전부
    10	#   밖 + 하네스 정본  — 저장소(루트에 template/.claude/) **전체**를 프로젝트와 같은 규칙으로
    11	#   밖 + 그 외        — .claude/ 앵커에 걸린 하네스 파일만 (git 저장소일 필요 없음)
    12	#   설계·계획 산출물  — 위치·git 무관하게 _workspace/00_design*.md·01_plan*.md 는 듀얼리뷰+지식
    13	#   결정 문서        — docs/decisions/*.md 는 문서 제외의 예외로 지식만
    14	#
    15	# 왜 이렇게 넓나 (2026-08-04 실사고): 하네스 자신을 고치는 작업은 **늘** 별도 클론에서
    16	# 일어나는데 훅이 프로젝트 밖을 통째로 스킵해, 게이트가 프로젝트는 지키면서 정작 하네스
    17	# 자체 개발만 못 지켰다.
    18	# 왜 위치가 아니라 경로 모양인가: 예전엔 홈 디렉터리를 통째로 예외 처리했는데, 그 규칙이
    19	# 남의 닷파일 저장소를 오탐하면서(vimrc) 정작 홈에 설치된 하네스 파일은 놓쳤다. 위치는
    20	# 게이트 대상 여부와 상관이 없다 — 하네스 동작을 정의하는 파일인지가 상관있다.
    21	# 홈 디렉터리 예외는 삭제됐다. 되살리지 마라 (회귀 테스트가 정적으로 막는다).
    22	#
    23	# 기록값: 프로젝트 안은 상대경로, 밖은 **절대경로**. 밖 편집을 상대경로로 적으면
    24	#         프로젝트 쪽 동명 파일과 구분되지 않는다.
    25	#
    26	# PostToolUse 는 절대 차단하지 않는다(도구는 이미 실행됨). 항상 exit 0.
    27	# 차단할 수 없으므로, 기록에 **실패**했거나 경로 때문에 기록을 **포기**했을 때는
    28	# stdout 의 systemMessage 로 알린다 — 조용히 게이트가 사라지는 것보다 낫다.
    29	#
    30	# 이 판정 계약의 기계 정본은 tests/mark-needs-audit.cases.sh 이고
    31	# tests/mark-needs-audit.test.sh 가 그것을 돌린다.
    32	# 셸 이식성: macOS 기본 bash 는 3.2 다. ${var,,}·mapfile·연관배열 금지.
    33	
    34	set -uo pipefail
    35	# shellcheck source=_common.sh
    36	. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
    37	
    38	HOOK_ID="post:edit:needs-audit"
    39	hook_disabled "$HOOK_ID" && exit 0
    40	
    41	# 메시지 상수. " 와 \ 와 제어문자를 쓰지 않는다 — 그래서 이스케이프 로직이 필요 없다.
    42	# 경로를 넣지 않는 것도 같은 이유다: 기록 실패 상황에서 사용자에게 필요한 정보는
    43	# "게이트가 안 섰다"는 사실이고, 경로를 끼우는 순간 이스케이프 기계장치가 딸려온다.
    44	MSG_WRITE_FAIL="완료 게이트 플래그를 기록하지 못했다(.claude 쓰기 실패). 게이트가 서지 않았으니 완료 판정 전에 수동으로 확인하라."
    45	MSG_NEWLINE="편집 경로에 개행이 있어 게이트 플래그를 기록하지 않았다. 줄 단위 플래그 파일이 오염되기 때문이다. 수동으로 확인하라."
    46	MSG_GIT_UNAVAILABLE="git 이 저장소 정보를 돌려주지 못해(소유권 거부·권한·손상) 하네스 정본 여부를 판정하지 못했다. 앵커 밖 파일에는 게이트가 서지 않았으니 수동으로 확인하라."
    47	
    48	# --- 계약 함수 ------------------------------------------------------------
    49	
    50	# emit_message <메시지> — {"systemMessage":"..."} 를 stdout 에 한 줄로.
    51	# JSON 을 만드는 **유일 지점**이다. 여기 말고 다른 곳에서 stdout 에 쓰면 안 된다.
    52	emit_message() {
    53	  printf '{"systemMessage":"%s"}\n' "$1"
    54	}
    55	
    56	# physical_dir <디렉토리> — 심링크·`..`·`.` 를 푼 물리 절대경로를 stdout 에.
    57	# 실패하면 **원본을 그대로 내고** rc=1. 호출자는 스킵하지 않는다 — 정규화에 실패했다고
    58	# 게이트를 지우면 조용한 위음성이 되므로, 덜 정확한 경로로라도 판정을 잇는 쪽을 택한다.
    59	#
    60	# **cd 는 반드시 -P 여야 한다** — pwd -P 만으로는 부족하다. 논리 cd(기본값)는 `심링크/..` 를
    61	# 심링크를 따라가기 **전에** 문자로 상쇄하므로 커널이 실제로 여는 곳과 다른 답을 낸다
    62	# (실측: `cd -- /var/..` → `/`, `cd -P -- /var/..` → `/private`). 그 차이만큼 프로젝트
    63	# **밖** 파일이 프로젝트 **안** 상대경로로 기록돼, 게이트는 서는데 감사자가 엉뚱한 파일을
    64	# 본다(케이스 67). 반대 방향으로는 밖 하네스 파일의 게이트가 통째로 사라진다(케이스 68).
    65	# 형제 검사기 scripts/check-rule-copies.sh 의 physical_path 와 같은 방식이다(PR #13).
    66	physical_dir() {
    67	  local out
    68	  out="$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P)"
    69	  if [ -z "$out" ]; then
    70	    printf '%s\n' "$1"
    71	    return 1
    72	  fi
    73	  printf '%s\n' "$out"
    74	}
    75	
    76	# physical_path <파일경로> — 편집 경로를 물리화한다. 실패하면 **원본 경로를 그대로 내고** rc=1.
    77	#
    78	# 마지막 성분이 **이름이면 보존**한다 — 파일 자신이 심링크여도 편집 대상의 이름으로
    79	# 기록해야 하고, 애초에 파일에는 cd 할 수 없다. 파일이 아직 없을 수도 있다(케이스 51).
    80	#
    81	# **단 `.`·`..` 는 이름이 아니라 디렉토리 이동이라 반드시 푼다.** 보존할 이름이 없으므로
    82	# 위 예외의 근거가 성립하지 않는다. 안 풀면 dirname 만 물리화된 `…/src/..` 가 그대로 나와
    83	# 프로젝트 접두사에 문자열상 걸리고, 플래그에 디렉토리 표기가 박힌다(케이스 69·70).
    84	# 형제 검사기가 PR #13 에서 같은 이름의 같은 버그를 이 방식으로 고쳤다 — 접근을 맞춘다.
    85	physical_path() {
    86	  local dir base
    87	  base="$(basename -- "$1")"
    88	  # cd 는 반드시 명령 치환 안에서 — 함수 본문에서 그냥 cd 하면 호출부의 cwd 가 바뀐다.
    89	  case "$base" in
    90	    . | ..) physical_dir "$1"; return ;;
    91	  esac
    92	  dir="$(physical_dir "$(dirname -- "$1")")" || { printf '%s\n' "$1"; return 1; }
    93	  # pwd -P 가 "/" 를 낼 때만 "//base" 가 된다 (루트 바로 아래 경로).
    94	  if [ "$dir" = '/' ]; then dir=''; fi
    95	  printf '%s/%s\n' "$dir" "$base"
    96	}
    97	
    98	# project_rel <절대경로> — $proj 아래면 프로젝트 기준 상대경로를 stdout·rc=0, 아니면 rc=1.
    99	# 접두사에 **슬래시를 반드시 포함**한다. 빠뜨리면 형제 디렉토리(<proj>-backup/…)를
   100	# 프로젝트 안으로 오인한다. "$proj" 를 인용하는 것은 경로 안의 글롭 문자 때문이다.
   101	project_rel() {
   102	  case "$1" in
   103	    "$proj"/*) printf '%s\n' "${1#"$proj"/}" ;;
   104	    *) return 1 ;;
   105	  esac
   106	}
   107	
   108	# git_toplevel <절대경로> — 그 파일이 속한 git 저장소 루트를 물리 경로로. 없으면 rc=1.
   109	# GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE 을 소거한다: 훅이 git 훅 안에서 돌면 이 변수들이
   110	# 엉뚱한 저장소를 가리켜 귀속이 통째로 바뀐다.
   111	# 경로에 /.git/ 가 있으면 그 앞을 기준으로 삼는다: git 은 .git 안에서 --show-toplevel 에
   112	# 실패하므로(실측 rc=128), 그대로 물으면 .git/hooks/* 편집이 판정 불가로 새어나간다.
   113	git_toplevel() {
   114	  local dir top
   115	  case "$1" in
   116	    */.git/*) dir="${1%%/.git/*}" ;;
   117	    */.git)   dir="${1%/.git}" ;;
   118	    *)        dir="$(dirname -- "$1")" ;;
   119	  esac
   120	  top="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
   121	         git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"
   122	  [ -n "$top" ] || return 1
   123	  physical_dir "$top"
   124	}
   125	
   126	# has_git_ancestor <절대경로> — 조상 디렉토리에 .git 이 있는가. git 을 쓰지 않는다.
   127	# git_toplevel 이 빈 값을 돌려준 이유가 "저장소가 아님"인지 "git 이 거부함"인지를 가르는
   128	# 데 쓴다. rev-parse 는 둘 다 rc=128 로 돌려주므로 stderr 내용으로 가르는 것은 취약하다.
   129	has_git_ancestor() {
   130	  local d
   131	  d="$(dirname -- "$1")"
   132	  while [ "$d" != '/' ] && [ "$d" != '.' ]; do
   133	    [ -e "$d/.git" ] && return 0
   134	    d="$(dirname -- "$d")"
   135	  done
   136	  return 1
   137	}
   138	
   139	# is_harness_canonical <저장소루트> — 하네스 정본 저장소인가.
   140	# 마커는 이 한 조건뿐이다. 조건을 더 얹으면 재배치 포크에서 위음성이 넓어지는데,
   141	# 위음성은 조용하고 오탐은 탈출구(ECC_DISABLED_HOOKS)가 있다 — 그래서 단순한 쪽을 택했다.
   142	is_harness_canonical() {
   143	  [ -d "$1/template/.claude" ]
   144	}
   145	
   146	# harness_anchor <선행 슬래시가 있는 경로> — 하네스 동작을 정의하는 자리인가.
   147	# 앵커 목록을 정의하는 **유일 지점**이다.
   148	harness_anchor() {
   149	  case "$1" in
   150	    */.claude/agents/*|*/.claude/skills/*|*/.claude/hooks/*|*/.claude/harness/*|*/.claude/settings.json)
   151	      return 0 ;;
   152	  esac
   153	  return 1
   154	}
   155	
   156	# classify <기준 상대경로> <기준 디렉토리> — gate · knowledge · skip 을 stdout 에.
   157	# 프로젝트 안(4a)과 밖-하네스정본(4b)이 **같은 규칙**을 쓰도록 공유한다.
   158	#
   159	# 순서가 계약이다:
   160	#   1) .claude/*·_workspace/* 제외가 앵커보다 **먼저**. 그래야 하네스 정본 저장소가
   161	#      자기 자신에 설치해 둔 소비 사본(.claude/hooks/*)이 빠지고 정본(template/.claude/*)만
   162	#      발화한다. 설치본은 정본을 고쳐 sync 하는 게 규약이라 제자리 편집은 일시적이다.
   163	#   2) 앵커가 *.md 제외보다 먼저. 에이전트·스킬·원칙 정의는 전부 .md 인데 일괄 제외하면
   164	#      하네스 저장소에서 가장 흔한 변경에 플래그가 하나도 안 선다.
   165	#   3) global-agents/*.md 는 **정본 스코프에서만** 예외의 예외를 연다. install/sync 가
   166	#      배포하는 전역 에이전트 정본이기 때문이며, 남의 프로젝트로 새면 오탐이 된다.
   167	classify() {
   168	  local rel="$1" base="$2" lower
   169	  case "$rel" in
   170	    _workspace/*|.claude/*) printf 'skip\n'; return 0 ;;
   171	  esac
   172	  if harness_anchor "/$rel"; then
   173	    printf 'gate\n'; return 0
   174	  fi
   175	  case "$rel" in
   176	    global-agents/*.md)
   177	      if is_harness_canonical "$base"; then printf 'gate\n'; return 0; fi ;;
   178	  esac
   179	  # 확장자 판정은 소문자화해서 본다 — README.MD 가 코드로 취급되면 안 된다.
   180	  lower="$(printf '%s' "$rel" | tr '[:upper:]' '[:lower:]')"
   181	  # 결정 문서는 문서 제외의 **예외**다. 하네스가 스스로 "결정은 여기 이 이름으로 쓴다"고
   182	  # 규정한 경로(결정 기록 절)라 **하네스가 아는 산출물**이고, 그 자리가 편집됐다는 것은
   183	  # 곧 결정이 나왔다는 뜻이다. 코드가 아니므로 게이트 4종은 과하다 — 지식 게이트만 세운다.
   184	  #
   185	  # 공시된 한계: 결정 문서를 이 경로 **밖**에 두면 게이트가 서지 않는다. 하네스가 아는
   186	  # 경로만 알 수 있기 때문이고, 프로젝트마다 다른 위치를 알아내려면 다시 상위 층 구현을
   187	  # 알아야 한다. 이 공백은 회수 정책 ADR 로 넘긴다.
   188	  case "$lower" in
   189	    docs/decisions/*.md|docs/decisions/*.markdown) printf 'knowledge\n'; return 0 ;;
   190	  esac
   191	  case "$lower" in
   192	    *.md|*.markdown) printf 'skip\n'; return 0 ;;
   193	  esac
   194	  printf 'gate\n'
   195	}
   196	
   197	# record_flag <플래그파일> <값> — 이미 있으면 그냥 두고, 없으면 한 줄 덧붙인다. 실패하면 rc=1.
   198	# grep 의 -- 는 필수다: 값이 - 로 시작하면(예: 파일명 --version) grep 이 그것을 옵션으로
   199	# 해석해 rc=0(=이미 있음)을 돌려주고, BSD grep 은 -q 아래서도 버전 문자열을 stdout 에 뱉는다.
   200	# append 를 중괄호로 감싸는 것도 필수다: 리다이렉트 **열기** 실패는 셸이 보고하는데,
   201	# printf 뒤에 붙인 2>/dev/null 은 그 시점에 아직 적용되지 않아 stderr 가 샌다(실측).
   202	record_flag() {
   203	  mkdir -p "$STATE_DIR" 2>/dev/null
   204	  if grep -qxF -- "$2" "$1" 2>/dev/null; then
   205	    return 0
   206	  fi
   207	  { printf '%s\n' "$2" >> "$1"; } 2>/dev/null || return 1
   208	  return 0
   209	}
   210	
   211	# --- 판정 -----------------------------------------------------------------
   212	
   213	payload="$(cat)"
   214	# json_get 결과를 **센티널로** 받는다. 명령 치환은 후행 개행을 전부 지우므로 그냥 받으면
   215	# 경로 끝의 개행이 아래 가드에 닿기도 전에 사라지고, 경고 없이 **다른 파일** 경로가
   216	# 기록된다("src/app.ts" + LF → "src/app.ts"). X 를 붙여 받고 도로 뗀 뒤, json_get 자신이
   217	# print() 로 붙인 개행 **하나만** 지운다 — 그러면 원본의 후행 개행이 살아남는다.
   218	raw="$(printf '%s' "$payload" | json_get tool_input.file_path; printf 'X')"
   219	raw="${raw%X}"
   220	file_path="${raw%$'\n'}"
   221	[ -z "$file_path" ] && exit 0
   222	
   223	# 개행 가드는 **정규화보다 먼저**여야 한다. 디렉토리 컴포넌트가 개행으로 끝나면
   224	# (…/sr<LF>/app.ts) physical_path 의 pwd -P 출력을 받는 명령 치환이 그 개행을 먹어
   225	# 경로가 …/sr/app.ts 로 조용히 바뀐다 — 없는 파일이 게이트에 박히고 정작 편집한
   226	# 파일은 무게이트가 된다. 플래그 파일은 줄 단위라 개행이 든 경로는 애초에 못 적는다.
   227	case "$file_path" in
   228	  *$'\n'*) emit_message "$MSG_NEWLINE"; exit 0 ;;
   229	esac
   230	
   231	# 양쪽을 물리 경로로 맞춘 뒤에 비교한다. git 은 실제 경로를 돌려주는데 편집 경로는
   232	# 심링크를 지나올 수 있고(macOS /var → /private/var), .. 로 되돌아올 수도 있다.
   233	# 정규화 없이 자르면 접두사가 안 맞아 프로젝트 안 편집이 통째로 "밖"으로 샌다.
   234	# PROJECT_DIR 은 디렉토리라 통째로 물리화한다(심링크 PROJECT_DIR — 케이스 11·12).
   235	# 편집 경로는 파일이라 마지막 성분 이름을 보존하는 physical_path 를 쓴다 — 두 계약이
   236	# 다르므로 함수도 둘이다.
   237	proj="$(physical_dir "$PROJECT_DIR")"
   238	case "$file_path" in
   239	  /*) ;;
   240	  *) file_path="$proj/$file_path" ;;
   241	esac
   242	abs="$(physical_path "$file_path")"
   243	
   244	# 설계·계획 산출물은 위치·git 여부와 무관하게 듀얼리뷰 게이트만 세운다.
   245	# **정규화 뒤**에 판정해야 한다: 상대경로 입력에는 선행 슬래시가 없어 아래 글롭에
   246	# 걸리지 않고, .. 가 섞인 경로는 기록값이 .claude/../_workspace/… 로 남는다.
   247	# 매칭만 소문자화하고 기록은 원본 대소문자로 한다.
   248	lower_abs="$(printf '%s' "$abs" | tr '[:upper:]' '[:lower:]')"
   249	# 설계·계획 산출물은 듀얼리뷰 **와 지식 게이트**를 세운다. 코드가 아니므로 타입체크·
   250	# 변경설명·감사는 과하지만, 설계가 나온 턴을 지식 저장소 반영 없이 끝내면 "왜 그렇게
   251	# 정했나"가 그 자리에서 사라진다 — 결정을 만든 근거가 정확히 이 파일들이다.
   252	case "$lower_abs" in
   253	  */_workspace/00_design*.md|*/_workspace/01_plan*.md)
   254	    dual_value="$(project_rel "$abs")" || dual_value="$abs"
   255	    dw=0
   256	    record_flag "$DUALREVIEW_FLAG" "$dual_value" || dw=1
   257	    record_flag "$KNOWLEDGE_FLAG"  "$dual_value" || dw=1
   258	    [ "$dw" -eq 1 ] && emit_message "$MSG_WRITE_FAIL"
   259	    exit 0 ;;
   260	esac
   261	
   262	if rel="$(project_rel "$abs")"; then
   263	  value="$rel"
   264	  verdict="$(classify "$rel" "$proj")"
   265	else
   266	  # 프로젝트 밖. 기록값은 절대경로다.
   267	  value="$abs"
   268	  root="$(git_toplevel "$abs")" || root=''
   269	  if [ -n "$root" ] && is_harness_canonical "$root"; then
   270	    case "$abs" in
   271	      "$root"/*) rel="${abs#"$root"/}" ;;
   272	      *) rel="$abs" ;;
   273	    esac
   274	    verdict="$(classify "$rel" "$root")"
   275	  elif harness_anchor "$abs"; then
   276	    # 앵커 판정에 git 을 요구하지 않는다 — 홈에 설치된 .claude/agents/*.md 는
   277	    # 그 디렉토리가 git 저장소가 아니어도 하네스 동작을 정의한다.
   278	    verdict='gate'
   279	  else
   280	    verdict='skip'
   281	    # git 이 빈 값을 돌려줬는데 조상에 .git 이 있으면, 저장소가 아닌 게 아니라 git 이
   282	    # 거부한 것이다(safe.directory 소유권 거부·권한·손상). 그대로 두면 정본 저장소
   283	    # 전체가 앵커 밖 파일에 대해 무게이트 + 무신호로 조용히 감시 축소된다.
   284	    # 판정은 바꾸지 않는다(추측으로 게이트를 세우면 남의 저장소를 오탐한다) — 알리기만
   285	    # 한다. physical_path 가 fail-loud 인데 여기만 fail-silent 이던 비대칭을 없앤다.
   286	    [ -z "$root" ] && has_git_ancestor "$abs" && emit_message "$MSG_GIT_UNAVAILABLE"
   287	  fi
   288	fi
   289	
   290	# 결정 문서는 지식 게이트 하나만. 코드가 아니므로 타입체크·변경설명·감사는 과하다.
   291	if [ "$verdict" = 'knowledge' ]; then
   292	  record_flag "$KNOWLEDGE_FLAG" "$value" || emit_message "$MSG_WRITE_FAIL"
   293	  exit 0
   294	fi
   295	
   296	[ "$verdict" = 'gate' ] || exit 0
   297	
   298	# 완료 게이트 4종을 동시에 세운다:
   299	#   .needs-audit      → completion-auditor 강제 (Phase 6)
   300	#   .needs-explain    → change-explainer 강제 (Phase 5)
   301	#   .needs-knowledge  → 지식 저장소 반영 또는 불요 사유 기록 강제 (2026-08-02 kty —
   302	#                       산문 규칙이 기억에만 의존해 세션 내내 0회 이행된 실사고의 재발 방지)
   303	#   .needs-dualreview → codex 듀얼 리뷰 강제 (2026-08-03 kty)
   304	# 각 게이트는 해당 작업이 실제로 끝난 뒤에만 수동으로 지워진다. Stop 훅이 넷 다 본다.
   305	#
   306	# 지식 게이트가 꺼져 있어도 여기서는 **기록한다.** 켜짐/꺼짐 판정은 harness.env 를 한 번
   307	# 더 읽는 일인데 이 훅은 편집마다 돌고 Stop 훅은 턴에 한 번 돈다 — 판정은 Stop 쪽
   308	# 한 곳(knowledge_gate_active)으로 모았다. 꺼져 있으면 이 파일은 아무 효력이 없다.
   309	write_failed=0
   310	for flag in "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG"; do
   311	  record_flag "$flag" "$value" || write_failed=1
   312	done
   313	# 넷이 다 실패해도 메시지는 한 줄만 낸다.
   314	[ "$write_failed" -eq 1 ] && emit_message "$MSG_WRITE_FAIL"
   315	exit 0

