+    fail("대화 기록을 한 줄도 파싱하지 못했습니다 (형식이 바뀌었을 수 있습니다)")
+
+start = -1
+for i, e in enumerate(entries):
+    if isinstance(e, dict) and is_user_prompt(e):
+        start = i
