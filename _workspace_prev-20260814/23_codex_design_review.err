   200	BEGIN {
   201	  SQ = sprintf("%c", 39)
   202	  N = 0; FOUND = ""; INHD = 0; HTERM = ""; HDASH = 0; BAD = 0; OPENQ = ""
   203	  RX = "^(export[ \t]+)?" key "="
   204	}
   205	{
   206	  line = $0
   207	  sub(/\r$/, "", line)
   208	  if (NR == 1 && substr(line, 1, 3) == bom) line = substr(line, 4)
