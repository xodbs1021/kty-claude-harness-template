+        if [ -z "$(printf '%s' "${rline#사전 결정 회수:}" | LC_ALL=C tr -d '[:space:]')" ]; then
+          retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
 "
           retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 표명 접두어 뒤에 내용이 없음
 "
         fi
         ;;
       "")
-        retrieval_bad_paths="${retrieval_bad_paths}${entry}
+        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
 "
         retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일이 비었거나 첫 줄이 빈 줄
 "
         ;;
       *)
-        retrieval_bad_paths="${retrieval_bad_paths}${entry}
+        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
 "
         retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 첫 줄이 '사전 결정 회수:' 로 시작하지 않음
 "
         ;;
     esac
+    # ── 둘째 줄: 레퍼런스 표명 (ADR-0015) — 닫힌 문법 ──
+    #   레퍼런스 조사:<SP*><변형><SP*>(<내용>)<SP*>
+    #   <변형> = 조사함|불요|실패 (정확 일치 — 꼬리 문자가 붙으면 불량)
+    #   <SP>   = ASCII 스페이스·탭 뿐 (비ASCII 공백은 SP 가 아니다)
+    #   <내용> = LC_ALL=C tr -d '[:space:]' 후 비어있지 않음 (내부 괄호 허용 —
+    #            마지막 `)` 가 닫는 괄호. 첫 `)` 로 자르면 `조사함(a(b) c)` 가 잘린다)
+    if [ "$ref_missing" -eq 1 ]; then
+      retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 둘째 줄 없음(레퍼런스 표명 누락)
+"
+    else
+      rline2="${rline2%$'\r'}"
+      case "$rline2" in
+        "레퍼런스 조사:"*)
+          ref_body="${rline2#레퍼런스 조사:}"
+          # 앞뒤 SP(스페이스·탭)만 트림한다 — 트림 후 마지막 문자가 `)` 여야 하므로
+          # 닫는 괄호 뒤 잡음은 아래 case 에서 불량으로 떨어진다.
+          while :; do
+            case "$ref_body" in
+              ' '*)  ref_body="${ref_body# }" ;;
+              '	'*)  ref_body="${ref_body#	}" ;;
+              *' ')  ref_body="${ref_body% }" ;;
+              *'	')  ref_body="${ref_body%	}" ;;
+              *) break ;;
+            esac
+          done
+          ref_head="${ref_body%%\(*}"
+          while :; do
+            case "$ref_head" in
+              *' ')  ref_head="${ref_head% }" ;;
+              *'	')  ref_head="${ref_head%	}" ;;
+              *) break ;;
+            esac
+          done
+          if [ "$ref_head" = "$ref_body" ]; then
+            # 여는 괄호가 없다 — `불요` 단독(사유 없음)·접두어만 남은 줄이 여기 온다.
+            retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+            retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
+"
+          else
+            case "$ref_head" in
+              조사함|불요|실패)
+                case "$ref_body" in
+                  *\))
+                    ref_inner="${ref_body#*\(}"
+                    ref_inner="${ref_inner%\)}"
+                    # 내용 검사는 세 변형 **공통의 단일 경로**다 — 변형별로 복제하면
+                    # 한 변형만 검사가 빠지는 부류가 생긴다(`실패()` — 설계 검수 [cx] r2).
+                    if [ -z "$(printf '%s' "$ref_inner" | LC_ALL=C tr -d '[:space:]')" ]; then
+                      retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+                      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명의 괄호 안이 비었음(불요·실패에도 사유는 필수)
+"
+                    fi
+                    ;;
+                  *)
+                    # 트림 후에도 `)` 로 안 끝난다 — 닫는 괄호 뒤 잡음·미닫힘.
+                    retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+                    retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
+"
+                    ;;
+                esac
+                ;;
+              *)
+                # 변형 꼬리(`조사함부족`)·유의어(`불필요`)·비ASCII 공백이 낀 머리.
+                retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+                retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
+"
+                ;;
+            esac
+          fi
+          ;;
+        *)
+          # 빈 둘째 줄(개행만)도 여기로 온다 — 접두어 사유 하나로 접는다.
+          retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+          retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 둘째 줄이 '레퍼런스 조사:' 로 시작하지 않음
+"
+          ;;
+      esac
+    fi
   done < "$RETRIEVAL_FLAG"
 
   if [ -z "$retrieval_bad_paths" ]; then
     # 전부 형식 준수(또는 소실뿐) → 자동 해제. rm 이 실패하면 플래그가 남아 다음 턴에
     # 다시 검사된다 — 게이트가 죽는 방향이 아니라 남는 방향이므로 조용해도 안전하다.
     rm -f "$RETRIEVAL_FLAG" 2>/dev/null
     # 지문을 다시 계산한다 — 진입 시 스냅숏에는 방금 지운 "r" 비트가 남아 있어, 이 턴의
     # 하위 게이트가 stale 지문으로 예산을 매기고 다음 턴에 거짓 리셋이 난다([cc] HIGH).
     compute_flags_fp
     if ! work_pending; then
       # 이 턴의 할 일이 이것뿐이었다 — 여기서 끝내지 않으면 맨 아래 감사 게이트가
       # 빈 목록으로 허위 차단한다([cc·cx] 검수). 술어는 조기 종료와 같은 것을 쓴다 —
       # push 미완·다른 플래그가 남았으면 아래 게이트들로 계속 흘러간다.
       rm -f "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
       if [ -n "${decision_note:-}" ]; then
         # 경고를 삼키지 않는 것이 결정 게이트 fail-open 의 유일한 조건이다(ADR-0012 ②).
         # 성공 경로에도 적용된다 — 예산 소진 경로가 같은 방식으로 싣는다.
         printf '{"systemMessage":"참고: %s — 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."}\n' "$decision_note"
       fi
       exit 0
     fi
   else
     # 예산 키는 게이트 자신에게만 결합한다. 불량 목록을 공유 지문(flags_fp)에 넣으면
     # 다른 게이트의 예산까지 리셋된다. 목록이 줄면(파일을 고치면) 이 게이트의 카운터만
     # 리셋된다 — push 가 "몇 개 남았나"를 지문에 넣는 것과 같은 의도다.
     # 파이프가 실패하거나 빈 값을 내면(제한된 PATH·I/O 오류) 예산 키가 비어 "진전이
     # 리셋을 못 만드는" 상태가 된다([cx] 지적) — 외부 명령 없는 bash 치환으로 폴백한다.
     # 폴백은 정렬이 없어 키 안정성이 낮지만, 같은 플래그 파일은 순서가 유지되므로 실효는 같다.
     retrieval_bad_sorted="$(printf '%s' "$retrieval_bad_paths" | sort -u | tr '\n' ' ')" \
       || retrieval_bad_sorted=""
     [ -n "$retrieval_bad_sorted" ] || retrieval_bad_sorted="${retrieval_bad_paths//$'\n'/ }"
     gate_budget "retrieval:${retrieval_bad_sorted}"
     {
-      echo "[완료 차단] 설계·계획 산출물에 회수 표명이 없습니다 — 선행 결정을 회수하지 않고 만든 산출물로는 끝낼 수 없습니다."
+      echo "[완료 차단] 설계·계획 산출물의 머리 표명이 계약과 다릅니다 — 회수(1줄)·레퍼런스 조사(2줄) 표명 없이 만든 산출물로는 끝낼 수 없습니다."
       echo
       echo "형식이 어긋난 파일:"
       printf '%s' "$retrieval_bad_msgs" | sed 's/^/  - /'
       echo
       echo "해야 할 일:"
       echo "  1. 프로필 9절의 지식 진입점을 읽고, 이번 작업과 관련된 항목만 따라가 읽는다."
-      echo "  2. 산출물 **첫 줄**에 표명을 적는다:"
-      echo "     사전 결정 회수: <읽은 경로>     또는     사전 결정 회수: 없음(<사유>)"
-      echo "     이어서 회수 블록: - 걸리는 선행 결정: <제목 — 한 줄> (없으면 \"걸리는 선행 결정 없음\")"
-      echo "  3. 형식을 지키면 이 게이트는 스스로 풀립니다 — 지울 플래그가 없습니다."
+      echo "  2. 레퍼런스 조사가 필요한 작업이었는지 판단한다 — 필요했으면 조사하고(인접"
+      echo "     도메인 포함), 불요·실패라도 사유를 적는다. 조용한 스킵은 없다."
+      echo "  3. 산출물 **머리 3줄**을 이 형식으로 맞춘다:"
+      echo "     1줄: 사전 결정 회수: <읽은 경로>      또는  사전 결정 회수: 없음(<사유>)"
+      echo "     2줄: 레퍼런스 조사: 조사함(<대상·출처>) | 불요(<사유>) | 실패(<시도 — 사유>)"
+      echo "          — 이 세 단어와 반각 괄호만. 괄호 안이 비면 불량입니다."
+      echo "     3줄~: - 걸리는 선행 결정: <제목 — 한 줄> (없으면 \"걸리는 선행 결정 없음\")"
+      echo "  4. 형식을 지키면 이 게이트는 스스로 풀립니다 — 지울 플래그가 없습니다."
       echo
-      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지는 검수(plan-reviewer·codex)가 봅니다."
+      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지·조사했는지는 검수(plan-reviewer·codex)가 봅니다."
       emit_decision_note
       echo
       echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
     } >&2
     bump_and_block
   fi
 fi
 
 # (3.5) 듀얼 리뷰(codex) 게이트 (2026-08-03 kty — "리뷰가 필요한 모든 단계를 codex와 같이"의 기계화).
 #      설계·계획 산출물이 저장되거나 코드가 바뀐 턴은 codex 독립 리뷰 없이 끝낼 수 없다.
 #      Claude 단독 리뷰가 놓친 CRITICAL을 codex가 잡은 실사고(2026-08-03 POK-30)의 재발 방지.
 if [ -s "$DUALREVIEW_FLAG" ] && ! hook_disabled "stop:dualreview"; then
   gate_budget "dualreview"
   {
     echo "[완료 차단] codex 듀얼 리뷰 미수행 — Claude 단독 리뷰로는 끝낼 수 없습니다."
     echo
     echo "이 턴의 듀얼 리뷰 대상:"
     sed 's/^/  - /' "$DUALREVIEW_FLAG" 2>/dev/null
     echo
     echo "해야 할 일:"
     echo "  1. 대상 산출물/diff를 codex로 독립 리뷰시킨다 (모델·effort는 guard-codex-invocation 규정 — 임의 하향 금지)."
     echo "  2. 결과를 _workspace/ 에 *codex*.md 로 저장하고 지적을 [cc]/[cx] 태그로 통합한다."
     echo "  3. 그 뒤에만:  rm -f .claude/.needs-dualreview"
     echo "     codex 미설치·호출 실패면 사용자 보고에 '듀얼 리뷰 생략(codex 실패)'을 명시한 뒤에 지운다."
     echo "     리뷰 없이 플래그만 지우는 것은 이 게이트의 존재 이유를 없앤다."
     echo
     emit_decision_note
     echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:dualreview"
   } >&2
   bump_and_block
 fi
 
 # (4) change-explainer 게이트 (Phase 5) — 감사자보다 먼저 강제한다.
 #     코드가 바뀐 턴은 변경 설명 없이 끝낼 수 없다. change-explainer 가 실제로
 #     사용자용 설명을 낸 뒤에만 .needs-explain 을 지운다.
 #     (완료 감사와 별개로 이 게이트만 끄려면 ECC_DISABLED_HOOKS=stop:explain)
 if [ -s "$EXPLAIN_FLAG" ] && ! hook_disabled "stop:explain"; then
   gate_budget "explain"
   {
     echo "[완료 차단] change-explainer 미실행 — 변경 설명 없이 끝낼 수 없습니다."
     echo
     echo "이 턴에서 바뀐 코드/설정:"
     sed 's/^/  - /' "$EXPLAIN_FLAG" 2>/dev/null
     echo
     echo "해야 할 일:"
     echo "  1. change-explainer 에이전트로 실제 diff 기반 사용자용 변경 설명을 낸다."
     echo "  2. 설명을 낸 뒤에만:  rm -f .claude/.needs-explain"
     echo "     설명 없이 플래그만 지우는 것은 이 게이트의 존재 이유를 없앤다."
     echo
     emit_decision_note
     echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:explain"
   } >&2
   bump_and_block
 fi
 
 # (5) 지식 저장소 반영 게이트 — 감사보다 먼저 강제한다 (감사자가 반영 결과를 검증하도록).
 #     (2026-08-02 kty — 산문 규칙이 세션 내내 0회 이행된 실사고의 기계화)
 #
 #     **이 훅이 아는 것은 계약 하나뿐이다**: "지식 저장소가 설정돼 있으면, 결정·설계가
 #     나온 턴은 반영 없이 끝낼 수 없다." 저장소가 어디인지·어떤 구조인지·무엇을 어느
 #     파일에 나눠 담는지는 **상위 층의 구현**이고 이 파일은 모른다. 알게 되면 그 저장소를
 #     안 쓰는 환경에서 하네스가 없는 구조를 요구하게 된다(제0원칙 4 — 구체가 아닌 계약).
 #     어디에 어떻게 저장했는지의 검증은 그 저장소 자신의 규약이 한다.
 if knowledge_gate_active && ! hook_disabled "stop:knowledge"; then
   gate_budget "knowledge"
   {
     echo "[완료 차단] 지식 저장소 반영 미확인 — 이 턴의 결정·설계를 남기지 않고 끝낼 수 없습니다."
     echo
     echo "이 턴에서 바뀐 코드/설정:"
     sed 's/^/  - /' "$KNOWLEDGE_FLAG" 2>/dev/null
     echo
     echo "해야 할 일:"
     echo "  1. 이 머신의 지식 저장소가 **어디이고 어떤 형식인지는 사용자 층 설정**(전역"
     echo "     CLAUDE.md 등)이 답한다. 그 규약을 **전문** 읽는다 — 부분 독해 금지."
     echo "  2. 이번 턴에 결정·설계·개발작업이 있으면 그 규약대로 반영하고, 반영됐다는"
     echo "     확인 가능한 증거(커밋 해시·파일 경로 등)를 확보한다."
     echo "     판단을 만든 **근거(raw)** 도 규약이 정한 자리에 함께 남긴다 — 요약만 남기면"
     echo "     \"왜 그렇게 정했나\"가 복원 불가능해진다."
     echo "  3. 반영할 지식이 없으면(순수 버그픽스·기계적 수정) 불요 사유를 _workspace/progress.md 에 기록한다."
     echo "  4. 2 또는 3을 마친 뒤에만:  rm -f .claude/.needs-knowledge"
diff --git a/tests/retrieval-attestation.test.sh b/tests/retrieval-attestation.test.sh
index a40f266..ccb9051 100755
--- a/tests/retrieval-attestation.test.sh
+++ b/tests/retrieval-attestation.test.sh
@@ -1,217 +1,228 @@
 #!/usr/bin/env bash
-# retrieval-attestation.test.sh — Stop 훅의 **회수 표명 게이트**(stop:retrieval, ADR-0013) 회귀 방어.
+# retrieval-attestation.test.sh — Stop 훅의 **머리 표명 게이트**(stop:retrieval,
+# ADR-0013·ADR-0015) 회귀 방어.
 #
-#   "설계·계획 산출물(00_design*·01_plan*)이 저장된 턴은, 그 첫 줄이
-#    `사전 결정 회수:` 표명 형식을 지키기 전엔 끝낼 수 없다. 지키면 게이트가 스스로 풀린다."
+#   "설계·계획 산출물(00_design*·01_plan*)이 저장된 턴은, 머리 두 줄 —
+#    1줄 `사전 결정 회수:` · 2줄 `레퍼런스 조사: 조사함(<대상·출처>)|불요(<사유>)|실패(<사유>)`
+#    — 이 표명 형식을 지키기 전엔 끝낼 수 없다. 지키면 게이트가 스스로 풀린다."
 #
-# 이 게이트는 **형식만** 본다 — 진짜 읽었는지는 기계가 못 본다(ADR-0013 ④).
+# 이 게이트는 **형식만** 본다 — 진짜 읽었는지·조사했는지는 기계가 못 본다(ADR-0013 ④·ADR-0015).
 # 실패 방향이 게이트마다 다르다:
 #   위음성 — 표명 없는 산출물이 조용히 통과한다. 이 게이트가 존재하는 이유의 반대
 #   상태 오염 — 자동 해제·재평가·지문이 기존 게이트 기계(조기 종료·예산·결정 게이트)를
 #              깨는 것. 설계 검수 2라운드의 차단급 전부가 이 축이었다 — 그래서 이 파일의
 #              절반이 "다른 게이트가 멀쩡한가"를 잰다
 #
 # **판정 규칙의 사본을 두지 않는다.** 훅 자신을 돌려 차단 여부·메시지·플래그 상태로 잰다.
 # **rc 만으로 판정하지 않는다.** 회수 게이트가 통과해도 뒤의 감사 게이트가 같은 rc=2 를
 # 내므로, 어느 게이트가 말했는지는 메시지로만 갈린다. 통과 기대 케이스는 후속 게이트가
 # **실제로 말했는지**까지 요구한다 — 안 하면 훅이 앞에서 죽어도 초록이 난다.
 #
 # **공시된 측정 공백:** 3.4 의 exit 0 경로에 있는 decision_note 방출은 현행 발동 규칙
 # 아래서 도달 불가다 — decision_note 가 서려면 4종 플래그 중 하나가 서야 하는데, 그 플래그가
 # work_pending 을 참으로 유지해 exit 0 에 못 간다. 방출 코드는 발동 규칙이 바뀌는 날을 위한
 # 방어로 남겼고, 그 제거 변이는 원리적으로 초록이다(ADR-0012 의 "모르는 rc" 공백과 같은 부류).
 #
 # 왜 set -e 가 없나: 비영 rc 를 assert 하는 테스트다.
 # 셸 이식성: macOS 기본 bash 는 3.2 다. mapfile·연관배열·${var,,} 금지.
 
 set -uo pipefail
 
 TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
 REPO_ROOT="$(CDPATH='' cd -- "$TEST_DIR/.." && pwd -P)"
 HOOKS="$REPO_ROOT/template/.claude/hooks"
 
 command -v python3 >/dev/null 2>&1 || { echo "✗ python3 이 필요합니다 (payload 픽스처 의존)" >&2; exit 1; }
 for f in verify-before-stop.sh mark-needs-audit.sh _common.sh; do
   [ -f "$HOOKS/$f" ] || { echo "✗ 훅을 찾지 못했습니다: $f" >&2; exit 1; }
 done
 
 TMPROOT="$(mktemp -d)" || exit 1
 if [ -z "$TMPROOT" ] || [ ! -d "$TMPROOT" ]; then
   echo "✗ 임시 디렉토리를 만들지 못했습니다" >&2; exit 1
 fi
 TMPROOT="$(CDPATH='' cd -- "$TMPROOT" && pwd -P)"
 # chmod 000 픽스처(r13)가 있으므로 되돌린 뒤 지운다.
 trap 'chmod -R u+rwX "$TMPROOT" 2>/dev/null; rm -rf "$TMPROOT"' EXIT
 
 ran=0; pass=0; fail=0
 RC=999; ERR=''; OUT=''; DID_RUN=0
 
 # 판정 토큰 — 각 게이트 메시지의 고유 문구. 어느 게이트가 말했는지는 이걸로만 갈린다.
-TOK_RET='회수 표명이 없습니다'
-TOK_RET_FLAGFAIL='회수 표명 검사 불가'
+TOK_RET='머리 표명이 계약과 다릅니다'
+TOK_RET_FLAGFAIL='머리 표명 검사 불가'
 TOK_AUDIT='completion-auditor 미실행'
 TOK_PUSH='커밋이 원격에 없습니다'
 TOK_KNOW='지식 저장소 반영 미확인'
 TOK_DUAL='codex 듀얼 리뷰 미수행'
 TOK_DECISION='혼자 정한 것이 있는데'
 TOK_NOTE='결정 게이트 생략'
 TOK_BRICK='세션 벽돌 방지'
 
 report() {
   ran=$((ran + 1))
   if [ -z "$2" ]; then pass=$((pass + 1)); printf '  ✓ %s\n' "$1"
   else fail=$((fail + 1)); printf '  ✗ %s — %s\n' "$1" "$2"; fi
 }
 
 contains() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
 
 # --- 픽스처 --------------------------------------------------------------
 
 # new_project — 케이스마다 독립 프로젝트(mktemp — 명령 치환 카운터는 서브셸에 갇힌다).
 # 타입체크·지식게이트는 리터럴로 비운다: 이 파일이 재는 것은 회수 게이트와 그 결합뿐이고,
 # 앞 게이트가 먼저 막으면 케이스가 회수 게이트에 도달조차 못 한 채 기대값이 우연히 맞는다.
 # 지식 게이트를 켤 케이스(r23)만 인자로 켠다.
 new_project() {   # $1 = 지식게이트 값(비우면 꺼짐)
   local p
   p="$(mktemp -d "$TMPROOT/proj.XXXXXX")" || return 1
   mkdir -p "$p/.claude/hooks" "$p/.claude/harness" "$p/_workspace" || return 1
   cp "$HOOKS/_common.sh" "$HOOKS/verify-before-stop.sh" "$HOOKS/mark-needs-audit.sh" "$p/.claude/hooks/" || return 1
   printf 'HARNESS_TYPECHECK_CMD=""\nHARNESS_KNOWLEDGE_GATE="%s"\n' "${1-}" \
     > "$p/.claude/harness/harness.env" || return 1
   printf '%s\n' "$p"
 }
 
 # mk_tx <경로> <neutral|marker> — 최소 대화 기록. 결정 게이트(3.2)가 이 파일을 읽는다.
 #   neutral = 표지 어휘 없는 발화 (결정 게이트 침묵)
 #   marker  = 표지 어휘 + 서술형 (결정 게이트가 무장돼 있으면 차단)
 mk_tx() {
   local tp="$1" kind="$2"
   printf '%s\n' '{"type":"user","isSidechain":false,"message":{"role":"user","content":"작업해줘"}}' > "$tp" || return 1
   case "$kind" in
     neutral) printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"확인했습니다."}]}}' >> "$tp" ;;
     marker)  printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"이건 범위 밖이라 그대로 뒀습니다."}]}}' >> "$tp" ;;
   esac
 }
 
 # run_stop <프로젝트> <transcript경로|""> [env 인자...]
 run_stop() {
   local p="$1" tp="$2"
   shift 2
   local errf="$TMPROOT/err.$$" outf="$TMPROOT/out.$$" payf="$TMPROOT/pay.$$"
   RC=999; ERR=''; OUT=''; DID_RUN=1
   python3 -c '
 import json, sys
 d = {"stop_hook_active": False}
 if sys.argv[1]:
     d["transcript_path"] = sys.argv[1]
 with open(sys.argv[2], "w", encoding="utf-8") as fh:
     fh.write(json.dumps(d))' "$tp" "$payf"
   # cwd 를 프로젝트가 아닌 곳(TMPROOT)으로 둔다 — 상대경로 항목을 cwd 기준으로 여는
   # 구현이면 여기서 전부 "소실"이 되어 r11 이 빨개진다. 이 디렉토리 선택이 곧 픽스처다.
   ( cd "$TMPROOT" && env -u HARNESS_HOOKS -u ECC_DISABLED_HOOKS ${@+"$@"} CLAUDE_PROJECT_DIR="$p" \
       bash "$p/.claude/hooks/verify-before-stop.sh" <"$payf" >"$outf" 2>"$errf" )
   RC=$?
   rm -f "$payf"
   ERR="$(cat "$errf" 2>/dev/null)"
   OUT="$(cat "$outf" 2>/dev/null)"
   rm -f "$errf" "$outf"
 }
 
 # set_flag <프로젝트> <이름> <값...> — 플래그에 줄들을 기록한다.
 set_flag() {
   local p="$1" name="$2"; shift 2
   : > "$p/.claude/.needs-$name"
   local v
   for v in "$@"; do printf '%s\n' "$v" >> "$p/.claude/.needs-$name"; done
 }
 
-# mk_doc <경로> <첫줄|"EMPTY"> — 산출물 파일을 만든다.
+# mk_doc <경로> <첫줄|"EMPTY"> [둘째줄|"ONELINE"] — 산출물 파일을 만든다.
+#   EMPTY          : 0바이트 파일 (셋째 인자는 무시한다 — 명시 계약)
+#   둘째줄=ONELINE : 첫 줄만 있는 1줄 파일 (둘째 줄 누락 케이스용)
+#   둘째줄 생략    : GOOD_SECOND — **불량 픽스처도 둘째 줄은 정상**으로 두어 두 검사를
+#                    격리한다(첫 줄 검사를 지우는 변이가 둘째 줄 차단에 가려지면 안 된다).
+#                    격리 예외는 EMPTY(0바이트) 하나뿐이다.
 mk_doc() {
-  local f="$1" first="$2"
+  local f="$1" first="$2" second="${3-$GOOD_SECOND}"
   case "$first" in
-    EMPTY) : > "$f" ;;
-    *) printf '%s\n본문.\n' "$first" > "$f" ;;
+    EMPTY) : > "$f"; return ;;
+  esac
+  case "$second" in
+    ONELINE) printf '%s\n' "$first" > "$f" ;;
+    *) printf '%s\n%s\n본문.\n' "$first" "$second" > "$f" ;;
   esac
 }
 
 GOOD_FIRST='사전 결정 회수: docs/decisions/'
+GOOD_SECOND='레퍼런스 조사: 조사함(docs/decisions/ — 형제 게이트 선례)'
 flag_gone() { [ ! -e "$1/.claude/.needs-retrieval" ]; }
 
 # --- 케이스 --------------------------------------------------------------
 # 번호는 설계서 7절의 목록과 1:1 이다. 새 케이스는 뒤에만 붙인다.
 
 r01() { # 정상 첫 줄 → 회수 침묵 + 자동 해제 + 감사 게이트 도달.
   local name='r01 정상 첫 줄 → 통과 + 플래그 자동 해제' why=''
   local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   set_flag "$p" retrieval '_workspace/00_design.md'
   set_flag "$p" audit 'src/x.ts'
   mk_tx "$p/tx.jsonl" neutral
   run_stop "$p" "$p/tx.jsonl"
   if [ "$DID_RUN" -ne 1 ];             then why='훅 미실행'
   elif contains "$ERR" "$TOK_RET";     then why='위양성 — 회수 게이트가 막았다'
   elif [ "$RC" -ne 2 ];                then why="rc=$RC (기대 2 — 감사 게이트)"
   elif ! contains "$ERR" "$TOK_AUDIT"; then why="감사 게이트 미도달 = 아무것도 안 쟀다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   elif ! flag_gone "$p";               then why='플래그가 자동 해제되지 않았다'
   fi
   report "$name" "$why"
 }
 
 r02() { # `없음(사유)` 형식도 정상 표명이다.
   local name='r02 없음(사유) 형식 → 통과' why=''
   local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   mk_doc "$p/_workspace/00_design.md" '사전 결정 회수: 없음(진입점 미설정 — 새 프로젝트)'
   set_flag "$p" retrieval '_workspace/00_design.md'
   set_flag "$p" audit 'src/x.ts'
   mk_tx "$p/tx.jsonl" neutral
   run_stop "$p" "$p/tx.jsonl"
