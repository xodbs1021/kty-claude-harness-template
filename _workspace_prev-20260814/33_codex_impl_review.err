   337	  mk_doc "$out/_workspace/01_plan.md" '표명 없는 밖 계획이다.'
   338	  set_flag "$p" retrieval '_workspace/00_design.md' "$out/_workspace/01_plan.md"
   339	  set_flag "$p" audit 'src/x.ts'
   340	  mk_tx "$p/tx.jsonl" neutral
   341	  run_stop "$p" "$p/tx.jsonl"
