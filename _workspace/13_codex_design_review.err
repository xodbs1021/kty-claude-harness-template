    98	# project_rel <절대경로> — $proj 아래면 프로젝트 기준 상대경로를 stdout·rc=0, 아니면 rc=1.
    99	# 접두사에 **슬래시를 반드시 포함**한다. 빠뜨리면 형제 디렉토리(<proj>-backup/…)를
   100	# 프로젝트 안으로 오인한다. "$proj" 를 인용하는 것은 경로 안의 글롭 문자 때문이다.
   101	project_rel() {
   102	  case "$1" in
   103	    "$proj"/*) printf '%s\n' "${1#"$proj"/}" ;;
   104	    *) return 1 ;;
   105	  esac
   106	}
