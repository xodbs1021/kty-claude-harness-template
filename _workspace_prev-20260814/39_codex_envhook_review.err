   131	# 히어독 시작을 찾는다. 따옴표 안의 `<<` 와 주석 뒤의 `<<` 는 히어독이 아니다.
   132	# 인용 상태 OPENQ 는 **줄을 넘어 이어진다.** 셸의 인용은 개행에서 끝나지 않기 때문이다 —
   133	# 다른 키의 여러 줄 값 본문 안에 우리 키가 있으면 그건 선언이 아니다. 이걸 줄 단위로만
   134	# 보면 다른 키의 여러 줄 값 안에 있는 우리 키가 유일한 선언으로 판독돼
   135	# **게이트가 꺼진다**(실측). 그래서 이 함수는 줄마다 OPENQ 를 이어받아 갱신한다.
   136	function scan_line(s,   n, i, j, c, t, dash, q2) {
   137	  n = length(s); i = 1
   138	  while (i <= n) {
   139	    c = substr(s, i, 1)
   140	    if (OPENQ != "") { if (c == OPENQ) OPENQ = ""; i++; continue }
   141	    if (c == "\\") { i += 2; continue }                            # 백슬래시 이스케이프
   142	    if (c == "\"" || c == SQ) { OPENQ = c; i++; continue }
   143	    if (c == "#" && (i == 1 || substr(s, i - 1, 1) == " " || substr(s, i - 1, 1) == "\t")) return
   144	    if (c == "<" && substr(s, i + 1, 1) == "<") {
