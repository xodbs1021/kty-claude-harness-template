     1	#!/usr/bin/env bash
     2	# check-harness-env.test.sh — harness.env 편집 검증 훅(post:edit:harness-env, ADR-0016) 회귀 방어.
     3	#
     4	#   "harness.env 를 편집한 직후, 값을 믿을 수 없는 알려진 키가 있으면 그 자리에서
     5	#    systemMessage 로 알린다. 부재(안 쓰는 키)와 정상 판독은 침묵한다."
     6	#
     7	# 실패 방향이 둘이다:
     8	#   위음성 — 문법 실수를 침묵으로 넘긴다. 이 훅이 존재하는 이유의 반대(조용한 검사 생략)
     9	#   위양성 — 안 쓰는 키·무관 파일에 경고를 낸다. 경고가 소음이 되면 진짜 경고도 무시된다.
    10	#            판독기 rc=1/rc=3 구분(_common.sh 반환 계약)이 정확히 이 축을 지킨다
    11	#
    12	# **판정 규칙의 사본을 두지 않는다.** 훅 자신을 돌려 stdout(systemMessage)으로 잰다.
    13	# 훅은 항상 exit 0 이므로 rc 로는 아무것도 판정하지 않는다 — stdout 의 존재·내용이 전부다.
    14	# 셸 이식성: macOS 기본 bash 는 3.2 다. mapfile·연관배열·${var,,} 금지.
    15	
    16	set -uo pipefail
    17	
    18	TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    19	REPO_ROOT="$(CDPATH='' cd -- "$TEST_DIR/.." && pwd -P)"
    20	HOOKS="$REPO_ROOT/template/.claude/hooks"
    21	
    22	command -v python3 >/dev/null 2>&1 || { echo "✗ python3 이 필요합니다 (payload 픽스처 의존)" >&2; exit 1; }
    23	for f in check-harness-env.sh _common.sh; do
    24	  [ -f "$HOOKS/$f" ] || { echo "✗ 훅을 찾지 못했습니다: $f" >&2; exit 1; }
    25	done
    26	
    27	TMPROOT="$(mktemp -d)" || exit 1
    28	if [ -z "$TMPROOT" ] || [ ! -d "$TMPROOT" ]; then
    29	  echo "✗ 임시 디렉토리를 만들지 못했습니다" >&2; exit 1
    30	fi
    31	TMPROOT="$(CDPATH='' cd -- "$TMPROOT" && pwd -P)"
    32	trap 'chmod -R u+rwX "$TMPROOT" 2>/dev/null; rm -rf "$TMPROOT"' EXIT
    33	
    34	ran=0; pass=0; fail=0
    35	RC=999; OUT=''; ERR=''; DID_RUN=0
    36	
    37	TOK_WARN='harness.env 판독 경고'
    38	TOK_SKIP='조용히 생략'
    39	
    40	report() {
    41	  ran=$((ran + 1))
    42	  if [ -z "$2" ]; then pass=$((pass + 1)); printf '  ✓ %s\n' "$1"
    43	  else fail=$((fail + 1)); printf '  ✗ %s — %s\n' "$1" "$2"; fi
    44	}
    45	contains() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
    46	
    47	# new_project [env내용|__NOFILE__] — 훅·공용 모듈이 설치된 독립 프로젝트.
    48	new_project() {
    49	  local p
    50	  p="$(mktemp -d "$TMPROOT/proj.XXXXXX")" || return 1
    51	  mkdir -p "$p/.claude/hooks" "$p/.claude/harness" || return 1
    52	  cp "$HOOKS/_common.sh" "$HOOKS/check-harness-env.sh" "$p/.claude/hooks/" || return 1
    53	  case "${1-}" in
    54	    __NOFILE__) ;;
    55	    *) printf '%s' "${1-}" > "$p/.claude/harness/harness.env" || return 1 ;;
    56	  esac
    57	  printf '%s\n' "$p"
    58	}
