   273	# (3.4) **머리 표명 게이트** (ADR-0013·ADR-0015) — 설계·계획 산출물의 머리 두 줄이
   274	#      표명 형식을 지키는지 본다:
   275	#        1줄 `사전 결정 회수:` (ADR-0013 — ADR-0009 계약의 산문 승격)
   276	#        2줄 `레퍼런스 조사: 조사함(<대상·출처>)|불요(<사유>)|실패(<시도 — 사유>)`
   277	#            (ADR-0015 — "조사가 필요한 지시인가"의 판정은 기계가 못 하므로, 판정의
   278	#             **무표명 통과**를 막는다. 불요에도 사유를 강제하는 것이 핵심이다)
   279	#
   280	#      **형식만 본다.** 진짜 읽었는지·조사했는지는 기계가 못 본다(내용 검증은 검수 몫 —
   281	#      ADR-0013 ④·ADR-0015).
   282	#      **자동 해제** — 형식을 지키면 이 게이트가 스스로 플래그를 지운다. 지울 플래그를
   283	#      에이전트 손에 주지 않는 것이 이 게이트의 형태다(결정 게이트의 "실제로 물으면
   284	#      풀린다"와 같은 구조).
   285	#      **듀얼리뷰(3.5)보다 앞** — 표명 없는 산출물로 리뷰에 노력을 쓰기 전에 잡는 편이
   286	#      싸다. 정확성 문제가 아니라 비용 문제다(ADR-0012 ④와 같은 논리).
   287	if retrieval_pending; then
   288	  if [ ! -r "$RETRIEVAL_FLAG" ]; then
   289	    # 플래그는 서 있는데(-s) 읽을 수 없다 — "검사 대상 0건"으로 위장되면 조용한 통과라
   290	    # fail-closed 로 차단한다. 무엇이 대상이었는지조차 모르는 상태다.
   291	    gate_budget "retrieval:unreadable-flag"
   292	    {
   293	      echo "[완료 차단] 머리 표명 검사 불가 — 플래그 파일을 읽을 수 없습니다: $RETRIEVAL_FLAG"
   294	      echo "권한·손상을 확인한 뒤 다시 종료하세요."
   295	      emit_decision_note
   296	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
   297	    } >&2
   298	    bump_and_block
   299	  fi
   300	  # 예산 키 항목은 "경로#검사번호"다(#1 첫 줄 / #2 둘째 줄). 검사 번호까지 넣는 이유:
   301	  # 경로만 넣으면 두 줄 다 불량인 파일의 첫 줄만 고친 **진전**이 키를 못 바꿔, 4회째
   302	  # 예산 소진이 플래그 5종을 전삭제한다(설계 검수 [cx] r2). 사유 문자열은 넣지 않는다 —
   303	  # 같은 검사가 다른 사유로 바뀌는 것은 진전이 아니다.
   304	  retrieval_bad_paths=""   # 불량 항목 "경로#검사번호" (정렬 전, 줄 단위) — 예산 키용
   305	  retrieval_bad_msgs=""    # "경로 — 사유" (차단 메시지용)
   306	  # `|| [ -n "$entry" ]` 가 필수다: 마지막 줄이 개행 없이 끝나면 read 가 값을 담고도
   307	  # rc=1 을 내 본문이 안 돌고, 그 항목이 **조용히 스킵**된다 — record_flag 쓰기가
   308	  # 중단된 플래그에서 표명 없는 산출물이 통과하는 경로였다(구현 검수 [cx] HIGH).
   309	  while IFS= read -r entry || [ -n "$entry" ]; do
   310	    [ -n "$entry" ] || continue                     # 빈 줄은 기록 계약 밖 — 건너뛴다
   311	    case "$entry" in
   312	      /*) rfile="$entry" ;;
   313	      # 기록값 계약(mark-needs-audit): 프로젝트 안은 상대경로다. 훅 실행 cwd 가 아니라
   314	      # **$PROJECT_DIR 기준**으로 연다 — cwd 기준이면 다른 곳에서 실행된 턴에 전부
   315	      # "소실"로 오인돼 불량이 조용히 통과한다([cc·cx] 검수).
   316	      *)  rfile="$PROJECT_DIR/$entry" ;;
   317	    esac
   318	    # 소실은 건너뛴다. 차단하면 산출물을 아카이브한 턴이 벽돌이 된다(고칠 대상이 없다).
   319	    # 이 스킵이 삭제 우회를 연다는 것은 ADR-0013 이 공시한다 — 실존 검증은 감사자 몫.
   320	    [ -e "$rfile" ] || continue
   321	    if [ ! -r "$rfile" ]; then
   322	      retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   323	"
   324	      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일을 읽을 수 없음
   325	"
   326	      continue
   327	    fi
   328	    rline=""
   329	    rline2=""
   330	    ref_missing=0
   331	    # 머리 2줄을 한 블록 리다이렉트로 읽는다 — 파일을 두 번 열지 않는다. 중괄호 블록은
   332	    # 서브셸이 아니라 대입이 블록 밖에 남고, 리다이렉트는 블록 안에만 적용되므로 바깥
   333	    # while 의 stdin($RETRIEVAL_FLAG)과 충돌하지 않는다.
   334	    {
   335	      IFS= read -r rline || true
   336	      # 둘째 줄 "누락" 판정은 read 의 rc 를 실제로 소비해야 한다. 무개행 마지막 줄에서
   337	      # read 는 값을 담고도 rc=1 을 내므로, rc 만 보면 개행 없는 정상 표명이 누락으로
   338	      # 오판되고 값만 보면 판정이 뭉개진다. 한 줄 관용구(`read || [ -n ]`)는 단발 read
   339	      # 에서 rc 를 아무도 소비하지 않는 no-op 이다(설계 검수 [cc] r2 HIGH — while 루프
   340	      # 조건이던 원본과 자리가 다르다). 그래서 분기로 소비한다.
   341	      if IFS= read -r rline2; then
   342	        :
   343	      elif [ -n "$rline2" ]; then
   344	        :                   # 개행 없는 마지막 줄 — 값이 있으므로 누락이 아니다
   345	      else
   346	        ref_missing=1       # rc!=0 이고 값도 없다 = 둘째 줄이 없다(1줄 파일)
   347	      fi
   348	    } < "$rfile"
   349	    # ── 첫 줄: 회수 표명 (ADR-0013) ──
   350	    # 첫 줄 판정 전에 선두 BOM·후행 CR 을 걷어낸다 — harness_env_value 가 같은 부류
   351	    # (눈에 안 보이는 바이트가 판정을 뒤집는 것)에 데인 전례가 있다.
   352	    rline="${rline#$'\xEF\xBB\xBF'}"
   353	    rline="${rline%$'\r'}"
   354	    case "$rline" in
   355	      "사전 결정 회수:"*)
   356	        if [ -z "$(printf '%s' "${rline#사전 결정 회수:}" | LC_ALL=C tr -d '[:space:]')" ]; then
   357	          retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   358	"
   359	          retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 표명 접두어 뒤에 내용이 없음
   360	"
   361	        fi
   362	        ;;
   363	      "")
   364	        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   365	"
   366	        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일이 비었거나 첫 줄이 빈 줄
   367	"
   368	        ;;
   369	      *)
   370	        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   371	"
   372	        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 첫 줄이 '사전 결정 회수:' 로 시작하지 않음
   373	"
   374	        ;;
   375	    esac
   376	    # ── 둘째 줄: 레퍼런스 표명 (ADR-0015) — 닫힌 문법 ──
   377	    #   레퍼런스 조사:<SP*><변형><SP*>(<내용>)<SP*>
   378	    #   <변형> = 조사함|불요|실패 (정확 일치 — 꼬리 문자가 붙으면 불량)
   379	    #   <SP>   = ASCII 스페이스·탭 뿐 (비ASCII 공백은 SP 가 아니다)
   380	    #   <내용> = LC_ALL=C tr -d '[:space:]' 후 비어있지 않음 (내부 괄호 허용 —
   381	    #            마지막 `)` 가 닫는 괄호. 첫 `)` 로 자르면 `조사함(a(b) c)` 가 잘린다)
   382	    if [ "$ref_missing" -eq 1 ]; then
   383	      retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   384	"
   385	      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 둘째 줄 없음(레퍼런스 표명 누락)
   386	"
   387	    else
   388	      rline2="${rline2%$'\r'}"
   389	      case "$rline2" in
   390	        "레퍼런스 조사:"*)
   391	          ref_body="${rline2#레퍼런스 조사:}"
   392	          # 앞뒤 SP(스페이스·탭)만 트림한다 — 트림 후 마지막 문자가 `)` 여야 하므로
   393	          # 닫는 괄호 뒤 잡음은 아래 case 에서 불량으로 떨어진다.
   394	          while :; do
   395	            case "$ref_body" in
   396	              ' '*)  ref_body="${ref_body# }" ;;
   397	              '	'*)  ref_body="${ref_body#	}" ;;
   398	              *' ')  ref_body="${ref_body% }" ;;
   399	              *'	')  ref_body="${ref_body%	}" ;;
   400	              *) break ;;
   401	            esac
   402	          done
   403	          ref_head="${ref_body%%\(*}"
   404	          while :; do
   405	            case "$ref_head" in
   406	              *' ')  ref_head="${ref_head% }" ;;
   407	              *'	')  ref_head="${ref_head%	}" ;;
   408	              *) break ;;
   409	            esac
   410	          done
   411	          if [ "$ref_head" = "$ref_body" ]; then
   412	            # 여는 괄호가 없다 — `불요` 단독(사유 없음)·접두어만 남은 줄이 여기 온다.
   413	            retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   414	"
   415	            retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
   416	"
   417	          else
   418	            case "$ref_head" in
   419	              조사함|불요|실패)
   420	                case "$ref_body" in
   421	                  *\))
   422	                    ref_inner="${ref_body#*\(}"
   423	                    ref_inner="${ref_inner%\)}"
   424	                    # 내용 검사는 세 변형 **공통의 단일 경로**다 — 변형별로 복제하면
   425	                    # 한 변형만 검사가 빠지는 부류가 생긴다(`실패()` — 설계 검수 [cx] r2).
   426	                    if [ -z "$(printf '%s' "$ref_inner" | LC_ALL=C tr -d '[:space:]')" ]; then
   427	                      retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   428	"
   429	                      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명의 괄호 안이 비었음(불요·실패에도 사유는 필수)
   430	"
   431	                    fi
   432	                    ;;
   433	                  *)
   434	                    # 트림 후에도 `)` 로 안 끝난다 — 닫는 괄호 뒤 잡음·미닫힘.
   435	                    retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   436	"
   437	                    retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
   438	"
   439	                    ;;
   440	                esac
   441	                ;;
   442	              *)
   443	                # 변형 꼬리(`조사함부족`)·유의어(`불필요`)·비ASCII 공백이 낀 머리.
   444	                retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   445	"
   446	                retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
   447	"
   448	                ;;
   449	            esac
   450	          fi
   451	          ;;
   452	        *)
   453	          # 빈 둘째 줄(개행만)도 여기로 온다 — 접두어 사유 하나로 접는다.
   454	          retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   455	"
   456	          retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 둘째 줄이 '레퍼런스 조사:' 로 시작하지 않음
   457	"
   458	          ;;
   459	      esac
   460	    fi
   461	  done < "$RETRIEVAL_FLAG"
   462	
   463	  if [ -z "$retrieval_bad_paths" ]; then
   464	    # 전부 형식 준수(또는 소실뿐) → 자동 해제. rm 이 실패하면 플래그가 남아 다음 턴에
   465	    # 다시 검사된다 — 게이트가 죽는 방향이 아니라 남는 방향이므로 조용해도 안전하다.
   466	    rm -f "$RETRIEVAL_FLAG" 2>/dev/null
   467	    # 지문을 다시 계산한다 — 진입 시 스냅숏에는 방금 지운 "r" 비트가 남아 있어, 이 턴의
   468	    # 하위 게이트가 stale 지문으로 예산을 매기고 다음 턴에 거짓 리셋이 난다([cc] HIGH).
   469	    compute_flags_fp
   470	    if ! work_pending; then
   471	      # 이 턴의 할 일이 이것뿐이었다 — 여기서 끝내지 않으면 맨 아래 감사 게이트가
   472	      # 빈 목록으로 허위 차단한다([cc·cx] 검수). 술어는 조기 종료와 같은 것을 쓴다 —
   473	      # push 미완·다른 플래그가 남았으면 아래 게이트들로 계속 흘러간다.
   474	      rm -f "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
   475	      if [ -n "${decision_note:-}" ]; then
   476	        # 경고를 삼키지 않는 것이 결정 게이트 fail-open 의 유일한 조건이다(ADR-0012 ②).
   477	        # 성공 경로에도 적용된다 — 예산 소진 경로가 같은 방식으로 싣는다.
   478	        printf '{"systemMessage":"참고: %s — 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."}\n' "$decision_note"
   479	      fi
   480	      exit 0
   481	    fi
   482	  else
   483	    # 예산 키는 게이트 자신에게만 결합한다. 불량 목록을 공유 지문(flags_fp)에 넣으면
   484	    # 다른 게이트의 예산까지 리셋된다. 목록이 줄면(파일을 고치면) 이 게이트의 카운터만
   485	    # 리셋된다 — push 가 "몇 개 남았나"를 지문에 넣는 것과 같은 의도다.
   486	    # 파이프가 실패하거나 빈 값을 내면(제한된 PATH·I/O 오류) 예산 키가 비어 "진전이
   487	    # 리셋을 못 만드는" 상태가 된다([cx] 지적) — 외부 명령 없는 bash 치환으로 폴백한다.
   488	    # 폴백은 정렬이 없어 키 안정성이 낮지만, 같은 플래그 파일은 순서가 유지되므로 실효는 같다.
   489	    retrieval_bad_sorted="$(printf '%s' "$retrieval_bad_paths" | sort -u | tr '\n' ' ')" \
   490	      || retrieval_bad_sorted=""
   491	    [ -n "$retrieval_bad_sorted" ] || retrieval_bad_sorted="${retrieval_bad_paths//$'\n'/ }"
   492	    gate_budget "retrieval:${retrieval_bad_sorted}"
   493	    {
   494	      echo "[완료 차단] 설계·계획 산출물의 머리 표명이 계약과 다릅니다 — 회수(1줄)·레퍼런스 조사(2줄) 표명 없이 만든 산출물로는 끝낼 수 없습니다."
   495	      echo
   496	      echo "형식이 어긋난 파일:"
   497	      printf '%s' "$retrieval_bad_msgs" | sed 's/^/  - /'
   498	      echo
   499	      echo "해야 할 일:"
   500	      echo "  1. 프로필 9절의 지식 진입점을 읽고, 이번 작업과 관련된 항목만 따라가 읽는다."
   501	      echo "  2. 레퍼런스 조사가 필요한 작업이었는지 판단한다 — 필요했으면 조사하고(인접"
   502	      echo "     도메인 포함), 불요·실패라도 사유를 적는다. 조용한 스킵은 없다."
   503	      echo "  3. 산출물 **머리 3줄**을 이 형식으로 맞춘다:"
   504	      echo "     1줄: 사전 결정 회수: <읽은 경로>      또는  사전 결정 회수: 없음(<사유>)"
   505	      echo "     2줄: 레퍼런스 조사: 조사함(<대상·출처>) | 불요(<사유>) | 실패(<시도 — 사유>)"
   506	      echo "          — 이 세 단어와 반각 괄호만. 괄호 안이 비면 불량입니다."
   507	      echo "     3줄~: - 걸리는 선행 결정: <제목 — 한 줄> (없으면 \"걸리는 선행 결정 없음\")"
   508	      echo "  4. 형식을 지키면 이 게이트는 스스로 풀립니다 — 지울 플래그가 없습니다."
   509	      echo
   510	      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지·조사했는지는 검수(plan-reviewer·codex)가 봅니다."
   511	      emit_decision_note
   512	      echo
   513	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
   514	    } >&2
   515	    bump_and_block
   516	  fi
   517	fi
   518	
   519	# (3.5) 듀얼 리뷰(codex) 게이트 (2026-08-03 kty — "리뷰가 필요한 모든 단계를 codex와 같이"의 기계화).
   520	#      설계·계획 산출물이 저장되거나 코드가 바뀐 턴은 codex 독립 리뷰 없이 끝낼 수 없다.
   521	#      Claude 단독 리뷰가 놓친 CRITICAL을 codex가 잡은 실사고(2026-08-03 POK-30)의 재발 방지.
   522	if [ -s "$DUALREVIEW_FLAG" ] && ! hook_disabled "stop:dualreview"; then
   523	  gate_budget "dualreview"
   524	  {
   525	    echo "[완료 차단] codex 듀얼 리뷰 미수행 — Claude 단독 리뷰로는 끝낼 수 없습니다."
     1	#!/usr/bin/env bash
     2	# retrieval-attestation.test.sh — Stop 훅의 **머리 표명 게이트**(stop:retrieval,
     3	# ADR-0013·ADR-0015) 회귀 방어.
     4	#
     5	#   "설계·계획 산출물(00_design*·01_plan*)이 저장된 턴은, 머리 두 줄 —
     6	#    1줄 `사전 결정 회수:` · 2줄 `레퍼런스 조사: 조사함(<대상·출처>)|불요(<사유>)|실패(<사유>)`
     7	#    — 이 표명 형식을 지키기 전엔 끝낼 수 없다. 지키면 게이트가 스스로 풀린다."
     8	#
     9	# 이 게이트는 **형식만** 본다 — 진짜 읽었는지·조사했는지는 기계가 못 본다(ADR-0013 ④·ADR-0015).
    10	# 실패 방향이 게이트마다 다르다:
    11	#   위음성 — 표명 없는 산출물이 조용히 통과한다. 이 게이트가 존재하는 이유의 반대
    12	#   상태 오염 — 자동 해제·재평가·지문이 기존 게이트 기계(조기 종료·예산·결정 게이트)를
    13	#              깨는 것. 설계 검수 2라운드의 차단급 전부가 이 축이었다 — 그래서 이 파일의
    14	#              절반이 "다른 게이트가 멀쩡한가"를 잰다
    15	#
    16	# **판정 규칙의 사본을 두지 않는다.** 훅 자신을 돌려 차단 여부·메시지·플래그 상태로 잰다.
    17	# **rc 만으로 판정하지 않는다.** 회수 게이트가 통과해도 뒤의 감사 게이트가 같은 rc=2 를
    18	# 내므로, 어느 게이트가 말했는지는 메시지로만 갈린다. 통과 기대 케이스는 후속 게이트가
    19	# **실제로 말했는지**까지 요구한다 — 안 하면 훅이 앞에서 죽어도 초록이 난다.
    20	#
    21	# **공시된 측정 공백:** 3.4 의 exit 0 경로에 있는 decision_note 방출은 현행 발동 규칙
    22	# 아래서 도달 불가다 — decision_note 가 서려면 4종 플래그 중 하나가 서야 하는데, 그 플래그가
    23	# work_pending 을 참으로 유지해 exit 0 에 못 간다. 방출 코드는 발동 규칙이 바뀌는 날을 위한
    24	# 방어로 남겼고, 그 제거 변이는 원리적으로 초록이다(ADR-0012 의 "모르는 rc" 공백과 같은 부류).
    25	#
    26	# 왜 set -e 가 없나: 비영 rc 를 assert 하는 테스트다.
    27	# 셸 이식성: macOS 기본 bash 는 3.2 다. mapfile·연관배열·${var,,} 금지.
    28	
    29	set -uo pipefail
    30	
    31	TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    32	REPO_ROOT="$(CDPATH='' cd -- "$TEST_DIR/.." && pwd -P)"
    33	HOOKS="$REPO_ROOT/template/.claude/hooks"
    34	
    35	command -v python3 >/dev/null 2>&1 || { echo "✗ python3 이 필요합니다 (payload 픽스처 의존)" >&2; exit 1; }
    36	for f in verify-before-stop.sh mark-needs-audit.sh _common.sh; do
    37	  [ -f "$HOOKS/$f" ] || { echo "✗ 훅을 찾지 못했습니다: $f" >&2; exit 1; }
    38	done
    39	
    40	TMPROOT="$(mktemp -d)" || exit 1
    41	if [ -z "$TMPROOT" ] || [ ! -d "$TMPROOT" ]; then
    42	  echo "✗ 임시 디렉토리를 만들지 못했습니다" >&2; exit 1
    43	fi
    44	TMPROOT="$(CDPATH='' cd -- "$TMPROOT" && pwd -P)"
    45	# chmod 000 픽스처(r13)가 있으므로 되돌린 뒤 지운다.
    46	trap 'chmod -R u+rwX "$TMPROOT" 2>/dev/null; rm -rf "$TMPROOT"' EXIT
    47	
    48	ran=0; pass=0; fail=0
    49	RC=999; ERR=''; OUT=''; DID_RUN=0
    50	
    51	# 판정 토큰 — 각 게이트 메시지의 고유 문구. 어느 게이트가 말했는지는 이걸로만 갈린다.
    52	TOK_RET='머리 표명이 계약과 다릅니다'
    53	TOK_RET_FLAGFAIL='머리 표명 검사 불가'
    54	TOK_AUDIT='completion-auditor 미실행'
    55	TOK_PUSH='커밋이 원격에 없습니다'
    56	TOK_KNOW='지식 저장소 반영 미확인'
    57	TOK_DUAL='codex 듀얼 리뷰 미수행'
    58	TOK_DECISION='혼자 정한 것이 있는데'
    59	TOK_NOTE='결정 게이트 생략'
    60	TOK_BRICK='세션 벽돌 방지'
    61	
    62	report() {
    63	  ran=$((ran + 1))
    64	  if [ -z "$2" ]; then pass=$((pass + 1)); printf '  ✓ %s\n' "$1"
    65	  else fail=$((fail + 1)); printf '  ✗ %s — %s\n' "$1" "$2"; fi
    66	}
    67	
    68	contains() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
    69	
    70	# --- 픽스처 --------------------------------------------------------------
    71	
    72	# new_project — 케이스마다 독립 프로젝트(mktemp — 명령 치환 카운터는 서브셸에 갇힌다).
    73	# 타입체크·지식게이트는 리터럴로 비운다: 이 파일이 재는 것은 회수 게이트와 그 결합뿐이고,
    74	# 앞 게이트가 먼저 막으면 케이스가 회수 게이트에 도달조차 못 한 채 기대값이 우연히 맞는다.
    75	# 지식 게이트를 켤 케이스(r23)만 인자로 켠다.
    76	new_project() {   # $1 = 지식게이트 값(비우면 꺼짐)
    77	  local p
    78	  p="$(mktemp -d "$TMPROOT/proj.XXXXXX")" || return 1
    79	  mkdir -p "$p/.claude/hooks" "$p/.claude/harness" "$p/_workspace" || return 1
    80	  cp "$HOOKS/_common.sh" "$HOOKS/verify-before-stop.sh" "$HOOKS/mark-needs-audit.sh" "$p/.claude/hooks/" || return 1
    81	  printf 'HARNESS_TYPECHECK_CMD=""\nHARNESS_KNOWLEDGE_GATE="%s"\n' "${1-}" \
    82	    > "$p/.claude/harness/harness.env" || return 1
    83	  printf '%s\n' "$p"
    84	}
    85	
    86	# mk_tx <경로> <neutral|marker> — 최소 대화 기록. 결정 게이트(3.2)가 이 파일을 읽는다.
    87	#   neutral = 표지 어휘 없는 발화 (결정 게이트 침묵)
    88	#   marker  = 표지 어휘 + 서술형 (결정 게이트가 무장돼 있으면 차단)
    89	mk_tx() {
    90	  local tp="$1" kind="$2"
    91	  printf '%s\n' '{"type":"user","isSidechain":false,"message":{"role":"user","content":"작업해줘"}}' > "$tp" || return 1
    92	  case "$kind" in
    93	    neutral) printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"확인했습니다."}]}}' >> "$tp" ;;
    94	    marker)  printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"이건 범위 밖이라 그대로 뒀습니다."}]}}' >> "$tp" ;;
    95	  esac
    96	}
    97	
    98	# run_stop <프로젝트> <transcript경로|""> [env 인자...]
    99	run_stop() {
   100	  local p="$1" tp="$2"
   101	  shift 2
   102	  local errf="$TMPROOT/err.$$" outf="$TMPROOT/out.$$" payf="$TMPROOT/pay.$$"
   103	  RC=999; ERR=''; OUT=''; DID_RUN=1
   104	  python3 -c '
   105	import json, sys
   106	d = {"stop_hook_active": False}
   107	if sys.argv[1]:
   108	    d["transcript_path"] = sys.argv[1]
   109	with open(sys.argv[2], "w", encoding="utf-8") as fh:
   110	    fh.write(json.dumps(d))' "$tp" "$payf"
   111	  # cwd 를 프로젝트가 아닌 곳(TMPROOT)으로 둔다 — 상대경로 항목을 cwd 기준으로 여는
   112	  # 구현이면 여기서 전부 "소실"이 되어 r11 이 빨개진다. 이 디렉토리 선택이 곧 픽스처다.
   113	  ( cd "$TMPROOT" && env -u HARNESS_HOOKS -u ECC_DISABLED_HOOKS ${@+"$@"} CLAUDE_PROJECT_DIR="$p" \
   114	      bash "$p/.claude/hooks/verify-before-stop.sh" <"$payf" >"$outf" 2>"$errf" )
   115	  RC=$?
   116	  rm -f "$payf"
   117	  ERR="$(cat "$errf" 2>/dev/null)"
   118	  OUT="$(cat "$outf" 2>/dev/null)"
   119	  rm -f "$errf" "$outf"
   120	}
   121	
   122	# set_flag <프로젝트> <이름> <값...> — 플래그에 줄들을 기록한다.
   123	set_flag() {
   124	  local p="$1" name="$2"; shift 2
   125	  : > "$p/.claude/.needs-$name"
   126	  local v
   127	  for v in "$@"; do printf '%s\n' "$v" >> "$p/.claude/.needs-$name"; done
   128	}
   129	
   130	# mk_doc <경로> <첫줄|"EMPTY"> [둘째줄|"ONELINE"] — 산출물 파일을 만든다.
   131	#   EMPTY          : 0바이트 파일 (셋째 인자는 무시한다 — 명시 계약)
   132	#   둘째줄=ONELINE : 첫 줄만 있는 1줄 파일 (둘째 줄 누락 케이스용)
   133	#   둘째줄 생략    : GOOD_SECOND — **불량 픽스처도 둘째 줄은 정상**으로 두어 두 검사를
   134	#                    격리한다(첫 줄 검사를 지우는 변이가 둘째 줄 차단에 가려지면 안 된다).
   135	#                    격리 예외는 EMPTY(0바이트) 하나뿐이다.
   136	mk_doc() {
   137	  local f="$1" first="$2" second="${3-$GOOD_SECOND}"
   138	  case "$first" in
   139	    EMPTY) : > "$f"; return ;;
   140	  esac
   141	  case "$second" in
   142	    ONELINE) printf '%s\n' "$first" > "$f" ;;
   143	    *) printf '%s\n%s\n본문.\n' "$first" "$second" > "$f" ;;
   144	  esac
   145	}
   146	
   147	GOOD_FIRST='사전 결정 회수: docs/decisions/'
   148	GOOD_SECOND='레퍼런스 조사: 조사함(docs/decisions/ — 형제 게이트 선례)'
   149	flag_gone() { [ ! -e "$1/.claude/.needs-retrieval" ]; }
   150	
   151	# --- 케이스 --------------------------------------------------------------
   152	# 번호는 설계서 7절의 목록과 1:1 이다. 새 케이스는 뒤에만 붙인다.
   153	
   154	r01() { # 정상 첫 줄 → 회수 침묵 + 자동 해제 + 감사 게이트 도달.
   155	  local name='r01 정상 첫 줄 → 통과 + 플래그 자동 해제' why=''
   156	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   157	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   158	  set_flag "$p" retrieval '_workspace/00_design.md'
   159	  set_flag "$p" audit 'src/x.ts'
   160	  mk_tx "$p/tx.jsonl" neutral
   161	  run_stop "$p" "$p/tx.jsonl"
   162	  if [ "$DID_RUN" -ne 1 ];             then why='훅 미실행'
   163	  elif contains "$ERR" "$TOK_RET";     then why='위양성 — 회수 게이트가 막았다'
   164	  elif [ "$RC" -ne 2 ];                then why="rc=$RC (기대 2 — 감사 게이트)"
   165	  elif ! contains "$ERR" "$TOK_AUDIT"; then why="감사 게이트 미도달 = 아무것도 안 쟀다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   166	  elif ! flag_gone "$p";               then why='플래그가 자동 해제되지 않았다'
   167	  fi
   168	  report "$name" "$why"
   169	}
   170	
   171	r02() { # `없음(사유)` 형식도 정상 표명이다.
   172	  local name='r02 없음(사유) 형식 → 통과' why=''
   173	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   174	  mk_doc "$p/_workspace/00_design.md" '사전 결정 회수: 없음(진입점 미설정 — 새 프로젝트)'
   175	  set_flag "$p" retrieval '_workspace/00_design.md'
   176	  set_flag "$p" audit 'src/x.ts'
   177	  mk_tx "$p/tx.jsonl" neutral
   178	  run_stop "$p" "$p/tx.jsonl"
   179	  if [ "$DID_RUN" -ne 1 ];             then why='훅 미실행'
   180	  elif contains "$ERR" "$TOK_RET";     then why='위양성 — 회수 게이트가 막았다'
   181	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   182	  elif ! flag_gone "$p";               then why='플래그 미해제'
   183	  fi
   184	  report "$name" "$why"
   185	}
   186	
   187	r03() { # 표명 없음 → 차단. 첫 줄이 `사전` 으로 시작하지만 완전한 접두어는 아니다 —
   188	        # 패턴을 `사전` 따위로 느슨하게 만드는 변이가 이 행에서 빨개진다.
   189	  local name='r03 첫 줄에 표명 없음 → 차단 + 파일명' why=''
   190	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   191	  mk_doc "$p/_workspace/00_design.md" '사전 결정 회수 없이 작성했다.'
   192	  set_flag "$p" retrieval '_workspace/00_design.md'
   193	  set_flag "$p" audit 'src/x.ts'
   194	  mk_tx "$p/tx.jsonl" neutral
   195	  run_stop "$p" "$p/tx.jsonl"
   196	  if [ "$DID_RUN" -ne 1 ];                       then why='훅 미실행'
   197	  elif [ "$RC" -ne 2 ];                          then why="rc=$RC (기대 2)"
   198	  elif ! contains "$ERR" "$TOK_RET";             then why="회수 게이트가 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   199	  elif ! contains "$ERR" '_workspace/00_design.md'; then why='불량 파일명이 메시지에 없다'
   200	  elif contains "$ERR" "$TOK_AUDIT";             then why='차단인데 감사 게이트까지 흘러갔다'
   201	  elif flag_gone "$p";                           then why='불량인데 플래그가 해제됐다'
   202	  fi
   203	  report "$name" "$why"
   204	}
   205	
   206	r04() { # 빈 파일 → 차단.
   207	  local name='r04 빈 파일 → 차단' why=''
   208	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   209	  mk_doc "$p/_workspace/00_design.md" EMPTY
   210	  set_flag "$p" retrieval '_workspace/00_design.md'
   211	  set_flag "$p" audit 'src/x.ts'
   212	  mk_tx "$p/tx.jsonl" neutral
   213	  run_stop "$p" "$p/tx.jsonl"
   214	  if ! contains "$ERR" "$TOK_RET"; then why='차단하지 않았다'
   215	  elif ! contains "$ERR" '비었';   then why='사유(빈 파일)가 메시지에 없다'
   216	  fi
   217	  report "$name" "$why"
   218	}
   219	
   220	r05() { # 접두어만 있고 내용이 없다 → 차단.
   221	  local name='r05 접두어 뒤 내용 없음 → 차단' why=''
   222	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   223	  mk_doc "$p/_workspace/00_design.md" '사전 결정 회수:   '
   224	  set_flag "$p" retrieval '_workspace/00_design.md'
   225	  set_flag "$p" audit 'src/x.ts'
   226	  mk_tx "$p/tx.jsonl" neutral
   227	  run_stop "$p" "$p/tx.jsonl"
   228	  if ! contains "$ERR" "$TOK_RET";      then why='차단하지 않았다'
   229	  elif ! contains "$ERR" '내용이 없음'; then why='사유(내용 없음)가 메시지에 없다'
   230	  fi
   231	  report "$name" "$why"
   232	}
   233	
   234	r06() { # 01_plan* 도 같은 계약이다.
   235	  local name='r06 01_plan 산출물도 대상 → 차단' why=''
   236	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   237	  mk_doc "$p/_workspace/01_plan.md" '계획: 이렇게 한다.'
   238	  set_flag "$p" retrieval '_workspace/01_plan.md'
   239	  set_flag "$p" audit 'src/x.ts'
   240	  mk_tx "$p/tx.jsonl" neutral
   240	  mk_tx "$p/tx.jsonl" neutral
   241	  run_stop "$p" "$p/tx.jsonl"
   242	  if ! contains "$ERR" "$TOK_RET"; then why='차단하지 않았다'
   243	  elif ! contains "$ERR" '_workspace/01_plan.md'; then why='파일명이 없다'
   244	  fi
   245	  report "$name" "$why"
   246	}
   247	
   248	r07() { # 여러 파일 중 하나만 불량 → 차단하되 불량만 지목. 그리고 **듀얼리뷰 플래그가
   249	        # 함께 서 있어도 회수 게이트가 먼저 말한다** — 게이트를 3.5 뒤로 옮기는 변이가
   250	        # 여기서 빨개진다(순서는 계약이다 — ADR-0013 Stop 실행 순서).
   251	  local name='r07 다중 파일 부분 불량 → 불량만 지목 + 3.5 보다 앞' why=''
   252	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   253	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   254	  mk_doc "$p/_workspace/01_plan.md" '표명 없는 계획이다.'
   255	  set_flag "$p" retrieval '_workspace/00_design.md' '_workspace/01_plan.md'
   256	  set_flag "$p" dualreview '_workspace/00_design.md'
   257	  set_flag "$p" audit 'src/x.ts'
   258	  mk_tx "$p/tx.jsonl" neutral
   259	  run_stop "$p" "$p/tx.jsonl"
   260	  if ! contains "$ERR" "$TOK_RET";                    then why="회수 게이트가 먼저 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   261	  elif contains "$ERR" "$TOK_DUAL";                   then why='듀얼리뷰 게이트가 먼저/함께 말했다 (순서 위반)'
   262	  elif ! contains "$ERR" '_workspace/01_plan.md';     then why='불량 파일명이 없다'
   263	  elif contains "$ERR" "00_design.md — ";             then why='정상 파일이 불량으로 지목됐다'
   264	  fi
   265	  report "$name" "$why"
   266	}
   267	
   268	r08() { # 플래그 항목의 파일이 사라졌다 → 그 항목은 건너뛰고 해제한다(공시된 한계).
   269	        # 이 동작이 바뀌면(차단으로) 아카이브 턴이 벽돌이 된다 — 계약의 케이스화.
   270	  local name='r08 소실 항목 → 스킵 + 해제' why=''
   271	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   272	  set_flag "$p" retrieval '_workspace/00_design.md'   # 파일은 만들지 않는다
   273	  set_flag "$p" audit 'src/x.ts'
   274	  mk_tx "$p/tx.jsonl" neutral
   275	  run_stop "$p" "$p/tx.jsonl"
   276	  if contains "$ERR" "$TOK_RET";       then why='소실 항목을 차단했다'
   277	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   278	  elif ! flag_gone "$p";               then why='플래그가 해제되지 않았다 (갇힘 경로)'
   279	  fi
   280	  report "$name" "$why"
   281	}
   282	
   283	r09() { # 게이트를 끄면 검사도 갇힘도 없다 — 같은 상태에서 **다음 턴**(다른 플래그가
   284	        # 다 지워진 읽기 전용 턴)도 조기 종료로 통과해야 한다. retrieval_pending 이
   285	        # 훅 비활성을 접지 않으면 남은 플래그가 조기 종료를 막아 빈 감사 차단이 난다.
   286	  local name='r09 stop:retrieval 비활성 → 검사 생략 + 다음 턴 조기 종료' why=''
   287	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   288	  mk_doc "$p/_workspace/00_design.md" '표명 없는 설계다.'
   289	  set_flag "$p" retrieval '_workspace/00_design.md'
   290	  set_flag "$p" audit 'src/x.ts'
   291	  mk_tx "$p/tx.jsonl" neutral
   292	  run_stop "$p" "$p/tx.jsonl" ECC_DISABLED_HOOKS=stop:retrieval
   293	  if contains "$ERR" "$TOK_RET"; then why='비활성인데 회수 게이트가 말했다'
   294	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   295	  else
   296	    rm -f "$p/.claude/.needs-audit"     # 다음 턴: 감사까지 끝난 읽기 전용 턴
   297	    run_stop "$p" "$p/tx.jsonl" ECC_DISABLED_HOOKS=stop:retrieval
   298	    if [ "$RC" -ne 0 ]; then why="다음 턴 rc=$RC (기대 0 — 남은 회수 플래그가 조기 종료를 막았다): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   299	    fi
   300	  fi
   301	  report "$name" "$why"
   302	}
   303	
   304	r10() { # 발동 조건은 플래그다 — 파일만 있고 플래그가 없으면 검사하지 않는다.
   305	  local name='r10 플래그 없음 → 발동 안 함' why=''
   306	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   307	  mk_doc "$p/_workspace/00_design.md" '표명 없는 설계다.'
   308	  set_flag "$p" audit 'src/x.ts'
   309	  mk_tx "$p/tx.jsonl" neutral
   310	  run_stop "$p" "$p/tx.jsonl"
   311	  if contains "$ERR" "$TOK_RET"; then why='플래그 없이 발동했다'
   312	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   313	  fi
   314	  report "$name" "$why"
   315	}
   316	
   317	r11() { # 상대경로 항목은 $PROJECT_DIR 기준으로 열린다. run_stop 이 cwd 를 TMPROOT 로
   318	        # 두므로, cwd 기준으로 여는 구현이면 파일이 "소실"로 오인돼 이 차단이 사라진다.
   319	  local name='r11 상대경로 항목 — 다른 cwd 에서도 판정' why=''
   320	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   321	  mk_doc "$p/_workspace/00_design.md" '표명 없는 설계다.'
   322	  set_flag "$p" retrieval '_workspace/00_design.md'
   323	  set_flag "$p" audit 'src/x.ts'
   324	  mk_tx "$p/tx.jsonl" neutral
   325	  run_stop "$p" "$p/tx.jsonl"
   326	  if ! contains "$ERR" "$TOK_RET"; then why="차단하지 않았다 (상대경로가 cwd 기준으로 열렸을 가능성): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   327	  fi
   328	  report "$name" "$why"
