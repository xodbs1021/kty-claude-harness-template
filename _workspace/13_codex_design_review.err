   248	lower_abs="$(printf '%s' "$abs" | tr '[:upper:]' '[:lower:]')"
   249	# 설계·계획 산출물은 듀얼리뷰 **와 지식 게이트**를 세운다. 코드가 아니므로 타입체크·
   250	# 변경설명·감사는 과하지만, 설계가 나온 턴을 지식 저장소 반영 없이 끝내면 "왜 그렇게
   251	# 정했나"가 그 자리에서 사라진다 — 결정을 만든 근거가 정확히 이 파일들이다.
   252	case "$lower_abs" in
   253	  */_workspace/00_design*.md|*/_workspace/01_plan*.md)
