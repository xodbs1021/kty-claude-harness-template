   489	        # 모른 채 통과한다 — 형식 변화의 신호로 보고 소리를 낸다.
   490	        fail("대화 기록에 dict 가 아닌 항목이 있습니다 (형식이 바뀌었을 수 있습니다)")
   491	    if is_user_prompt(e):
