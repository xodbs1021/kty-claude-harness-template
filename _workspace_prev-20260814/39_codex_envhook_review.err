   132	    # 판독 불가 사유도 함께 싣는다. 여기서 빠뜨리면 **예산이 소진된 턴에 발생한**
   133	    # 판독 불가가 영구 소실된다 — 게이트 메시지가 이 경로로는 안 나가기 때문이다([cx] 2라운드).
   134	    printf '{"systemMessage":"[완료 게이트] 같은 지점(%s)에서 %s회 차단 후에도 진전이 없어 세션 벽돌 방지를 위해 통과시킵니다. 이 턴의 완료 주장(및 변경 설명)을 신뢰하지 마세요. 미처리 변경: %s%s"}\n' \
   135	      "$1" "$MAX_BLOCKS" "$changed" \
   136	      "${decision_note:+ / $decision_note}"
   137	    exit 0
   138	  fi
   139	}
   140	
   141	# 결정 게이트가 대화 기록을 못 읽었으면 **어느 게이트가 막든** 그 사유를 함께 낸다.
   142	# 감사 게이트에만 실으면, 앞 게이트가 먼저 막은 턴에는 안 보이고 그 플래그를 지운 다음
   143	# 턴에는 조기 종료로 **영영 사라진다**(검수 [cx] 지적). 조용히 사라지는 것이 이 게이트를
   144	# 만든 이유 그 자체라, 경고를 삼키지 않는 것이 fail-open 의 조건이다.
   145	emit_decision_note() {
   146	  [ -n "${decision_note:-}" ] || return 0
   147	  echo
   148	  echo "참고: $decision_note"
   149	  echo "      → 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."
   150	}
   151	
   152	bump_and_block() {
   153	  if ! printf '%s\n' "$((count + 1))" > "$BLOCK_COUNT" 2>/dev/null; then
   154	    # 카운터를 못 쓰면 무한루프 위험 → 표준 가드로 폴백
   155	    case "$stop_active" in
   156	      [Tt]rue) exit 0 ;;
   157	    esac
   158	  fi
   159	  exit 2
   160	}
   161	
   162	# (3) 타입체크 — 결정론적 바닥. 명령은 프로필에서 파생된 harness.env 에서 읽는다.
   163	#     HARNESS_TYPECHECK_CMD 가 비어 있으면(타입 없는 언어/미설정) 생략한다.
   164	#     이렇게 하면 이 훅이 특정 스택(pnpm/tsc)에 묶이지 않는다 — 도메인-무관 재사용.
   165	#     **이 파일을 실행하지 않는다.** source 하면 사용자 소유 셸 파일이 훅의 제어 흐름을
   166	#     가져간다 — `exit 0` 한 줄이면 이 훅이 조용히 끝나 **게이트 4종이 통째로 사라지고**
   167	#     흔적도 안 남는다. 원문 판독으로 그 부류를 없앤다(harness_env_value 주석 참조).
   168	typecheck_note=""
   169	#     rc 를 함께 받는다. "리터럴로 비웠다"(rc=0 + 빈 값 = 의도한 생략) · "부재"(rc=3 =
   170	#     키를 안 씀) · "값을 믿을 수 없다"(rc=1 = 선언 2개 이상·지원 문법 밖·읽기 실패)는
   171	#     셋 다 생략으로 가지만 사용자에게 **다른 정보**다 — 마지막 것만 고칠 수 있는 실수라
   172	#     그렇게 적어야 한다(구분의 정본은 _common.sh 반환 계약 — ADR-0016).
   173	TYPECHECK_CMD="$(harness_env_value HARNESS_TYPECHECK_CMD)"; typecheck_rc=$?
   174	
   175	if [ "$typecheck_rc" -eq 3 ]; then
   176	  typecheck_note="타입체크 생략 (HARNESS_TYPECHECK_CMD 미설정)"
   177	elif [ "$typecheck_rc" -ne 0 ]; then
   178	  typecheck_note="타입체크 생략 (harness.env 의 HARNESS_TYPECHECK_CMD 값을 믿을 수 없음 — 선언이 2개 이상이거나, 지원 문법 밖이거나, 읽기 실패입니다. 고칠 수 있는 실수입니다)"
   179	elif [ -z "$TYPECHECK_CMD" ]; then
   180	  typecheck_note="타입체크 생략 (HARNESS_TYPECHECK_CMD 가 빈 값으로 설정됨)"
   181	else
   182	  timeout_bin=""
   183	  if command -v timeout >/dev/null 2>&1; then
   184	    timeout_bin="timeout"
   185	  elif command -v gtimeout >/dev/null 2>&1; then
   186	    timeout_bin="gtimeout"
   187	  fi
   188	  # macOS 기본에는 timeout 이 없다. 그 경우 settings.json 의 "timeout": 120 이 최종 안전망.
   189	
   190	  if [ -n "$timeout_bin" ]; then
   191	    tc_out="$(cd "$PROJECT_DIR" && "$timeout_bin" 90 sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   192	  else
   193	    tc_out="$(cd "$PROJECT_DIR" && sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   194	  fi
   195	
   196	  if [ "$tc_rc" -eq 124 ] || [ "$tc_rc" -eq 137 ]; then
   197	    # 타임아웃은 "타입 오류"가 아니라 "모름". 차단하지 않고 감사자에게 넘긴다.
   198	    typecheck_note="타입체크 타임아웃 → 생략 (감사자가 재확인할 것)"
   199	  elif [ "$tc_rc" -eq 127 ]; then
   200	    # 명령/도구 없음(rc=127)은 "타입 오류"가 아니다. 오탐 차단 방지 위해 생략.
   201	    typecheck_note="타입체크 생략 (명령 실행 불가 rc=127): $TYPECHECK_CMD"
   202	  elif [ "$tc_rc" -ne 0 ]; then
   203	    gate_budget "typecheck"
   204	    {
   205	      echo "[완료 차단] 타입체크 실패 — 지금은 '완료'가 아닙니다."
   206	      echo
   207	      echo "명령: $TYPECHECK_CMD"
   208	      echo
   209	      printf '%s\n' "$tc_out" | head -n 15
   210	      echo
   211	      echo "고친 뒤 다시 종료하세요.  (차단 $((count + 1))/${MAX_BLOCKS})"
   212	      echo "탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=$HOOK_ID"
   213	    } >&2
   214	    bump_and_block
   215	  fi
   216	fi
   217	
   218	# (3.2) **결정 게이트** — "물어봤어야 할 것을 혼자 정했나".
   219	#      나머지 게이트가 전부 **산출물**을 볼 때 이것만 **에이전트 자신의 행동**을 본다.
   220	#      판정 규칙·좁히는 장치 셋·fail-open 사유는 _common.sh 의 decision_scan 주석이 정본이다.
   221	#
   222	#      **타입체크 다음, 나머지 게이트보다 앞에 둔다.** 질문의 답이 코드를 바꿀 수 있으므로, 리뷰·설명·감사에
   223	#      노력을 쓰기 전에 묻는 편이 싸다. (push 탐지와 달리 순서가 정확성을 바꾸지는 않는다 —
   224	#      대화 기록은 이미 다 쓰였고 게이트 순서가 그 내용을 바꾸지 않기 때문이다.)
   225	decision_note=""
   226	# **발동 조건은 플래그다.** 조기 종료는 push 미완만으로도 풀리므로, 그것만 보고 스캔하면
   227	# 아무것도 안 바꾼 읽기 전용 턴까지 검사하게 된다 — "플래그와 무관하게 항상"은 사용자가
   228	# 기각한 보기다. 여기서 한 번 더 물어 발동 계약을 조기 종료와 분리한다.
   229	decision_armed=0
   230	if [ -s "$AUDIT_FLAG" ] || [ -s "$EXPLAIN_FLAG" ] || [ -s "$DUALREVIEW_FLAG" ] || knowledge_gate_active; then
   231	  decision_armed=1
   232	fi
   233	if [ "$decision_armed" -eq 1 ] && ! hook_disabled "stop:decision"; then
   234	  decision_hits="$(decision_scan "$transcript_path")"; decision_rc=$?
   235	  case "$decision_rc" in
   236	    3) : ;;   # 표지 없음 · 또는 이 턴에 물었음
   237	    2)
   238	      # **이 게이트의 유일한 fail-open.** 통과시키되 사유를 게이트 메시지에 실어 보낸다.
   239	      # 대화 기록 형식은 하네스 소유가 아니라, 여기서 차단하면 그 세션 안에 고칠 방법이 없다.
   240	      decision_note="결정 게이트 생략 ($decision_hits)" ;;
   241	    0) ;;     # 아래에서 차단한다 (case 안에서 하면 들여쓰기가 깊어져 메시지가 안 읽힌다)
   242	    *)
   243	      # **모르는 rc 는 통과가 아니라 판독 불가다.** python3 부재(127)·처리 못 한 예외(1)·
   244	      # 신호 종료가 전부 여기로 온다. 이걸 통과로 읽으면 게이트가 조용히 사라진다.
   245	      decision_note="결정 게이트 생략 (스캐너가 예상 밖 상태로 끝남 rc=$decision_rc — python3 부재·예외·신호 종료일 수 있습니다)" ;;
   246	  esac
   247	  if [ "$decision_rc" -eq 0 ]; then
   248	    gate_budget "decision"
   249	    {
   250	      echo "[완료 차단] 혼자 정한 것이 있는데 이 턴에 사용자에게 한 번도 묻지 않았습니다."
   251	      echo
   252	      echo "걸린 문장:"
   253	      printf '%s\n' "$decision_hits" | sed 's/^/  - /'
   254	      echo
   255	      echo "이 게이트가 겨누는 것:"
   256	      echo "  게이트가 막을 때는 따르면서, 게이트가 없는 자리에서는 혼자 정하고 보고서에"
   257	      echo "  한 줄 적는 부류입니다. 그 '한 줄'은 도구 호출이 아니라 문장이라 승인창이"
   258	      echo "  안 뜨고, 그래서 이 저장소가 겪은 실패 대부분이 이 축에서 났습니다."
   259	      echo
   260	      echo "해야 할 일:"
   261	      echo "  1. 위 문장들이 정말 **사용자가 정할 일**이었는지 본다."
   262	      echo "     '범위 밖'·'별도로'·'그대로 뒀'는 대개 선택지를 줬어야 하는 자리입니다."
   263	      echo "  2. AskUserQuestion 으로 **실제로 묻는다.** 보고서에 적는 것은 묻는 것이 아닙니다."
   264	      echo "  3. 질문을 한 번이라도 하면 이 게이트는 풀립니다."
   265	      echo
   266	      echo "위양성이라면(그 어휘를 설명·인용한 것이지 결정이 아니라면):"
   267	      echo "  - 백틱이나 따옴표로 감싸면 스캔에서 빠집니다 — 인용은 결정이 아니니까요."
   268	      echo "  - 그래도 걸리면 사용자에게 위양성임을 알리고 지시를 받으세요."
   269	      echo
   270	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:decision"
   271	    } >&2
   272	    bump_and_block
   273	  fi
   274	fi
   275	
   276	# (3.4) **머리 표명 게이트** (ADR-0013·ADR-0015) — 설계·계획 산출물의 머리 두 줄이
   277	#      표명 형식을 지키는지 본다:
   278	#        1줄 `사전 결정 회수:` (ADR-0013 — ADR-0009 계약의 산문 승격)
   279	#        2줄 `레퍼런스 조사: 조사함(<대상·출처>)|불요(<사유>)|실패(<시도 — 사유>)`
   280	#            (ADR-0015 — "조사가 필요한 지시인가"의 판정은 기계가 못 하므로, 판정의
   281	#             **무표명 통과**를 막는다. 불요에도 사유를 강제하는 것이 핵심이다)
   282	#
   283	#      **형식만 본다.** 진짜 읽었는지·조사했는지는 기계가 못 본다(내용 검증은 검수 몫 —
   284	#      ADR-0013 ④·ADR-0015).
   285	#      **자동 해제** — 형식을 지키면 이 게이트가 스스로 플래그를 지운다. 지울 플래그를
   286	#      에이전트 손에 주지 않는 것이 이 게이트의 형태다(결정 게이트의 "실제로 물으면
   287	#      풀린다"와 같은 구조).
   288	#      **듀얼리뷰(3.5)보다 앞** — 표명 없는 산출물로 리뷰에 노력을 쓰기 전에 잡는 편이
   289	#      싸다. 정확성 문제가 아니라 비용 문제다(ADR-0012 ④와 같은 논리).
   290	if retrieval_pending; then
   291	  if [ ! -r "$RETRIEVAL_FLAG" ]; then
   292	    # 플래그는 서 있는데(-s) 읽을 수 없다 — "검사 대상 0건"으로 위장되면 조용한 통과라
   293	    # fail-closed 로 차단한다. 무엇이 대상이었는지조차 모르는 상태다.
   294	    gate_budget "retrieval:unreadable-flag"
   295	    {
   296	      echo "[완료 차단] 머리 표명 검사 불가 — 플래그 파일을 읽을 수 없습니다: $RETRIEVAL_FLAG"
   297	      echo "권한·손상을 확인한 뒤 다시 종료하세요."
   298	      emit_decision_note
   299	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
   300	    } >&2
   301	    bump_and_block
   302	  fi
   303	  # 예산 키 항목은 "경로#검사번호"다(#1 첫 줄 / #2 둘째 줄). 검사 번호까지 넣는 이유:
   304	  # 경로만 넣으면 두 줄 다 불량인 파일의 첫 줄만 고친 **진전**이 키를 못 바꿔, 4회째
   305	  # 예산 소진이 플래그 5종을 전삭제한다(설계 검수 [cx] r2). 사유 문자열은 넣지 않는다 —
   306	  # 같은 검사가 다른 사유로 바뀌는 것은 진전이 아니다.
   307	  retrieval_bad_paths=""   # 불량 항목 "경로#검사번호" (정렬 전, 줄 단위) — 예산 키용
   308	  retrieval_bad_msgs=""    # "경로 — 사유" (차단 메시지용)
   309	  # `|| [ -n "$entry" ]` 가 필수다: 마지막 줄이 개행 없이 끝나면 read 가 값을 담고도
   310	  # rc=1 을 내 본문이 안 돌고, 그 항목이 **조용히 스킵**된다 — record_flag 쓰기가
   311	  # 중단된 플래그에서 표명 없는 산출물이 통과하는 경로였다(구현 검수 [cx] HIGH).
   312	  while IFS= read -r entry || [ -n "$entry" ]; do
   313	    [ -n "$entry" ] || continue                     # 빈 줄은 기록 계약 밖 — 건너뛴다
   314	    case "$entry" in
   315	      /*) rfile="$entry" ;;
   316	      # 기록값 계약(mark-needs-audit): 프로젝트 안은 상대경로다. 훅 실행 cwd 가 아니라
   317	      # **$PROJECT_DIR 기준**으로 연다 — cwd 기준이면 다른 곳에서 실행된 턴에 전부
   318	      # "소실"로 오인돼 불량이 조용히 통과한다([cc·cx] 검수).
   319	      *)  rfile="$PROJECT_DIR/$entry" ;;
   320	    esac
   321	    # 소실은 건너뛴다. 차단하면 산출물을 아카이브한 턴이 벽돌이 된다(고칠 대상이 없다).
   322	    # 이 스킵이 삭제 우회를 연다는 것은 ADR-0013 이 공시한다 — 실존 검증은 감사자 몫.
   323	    [ -e "$rfile" ] || continue
   324	    if [ ! -r "$rfile" ]; then
   325	      retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   326	"
   327	      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일을 읽을 수 없음
   328	"
   329	      continue
   330	    fi
   331	    rline=""
   332	    rline2=""
   333	    ref_missing=0
   334	    # 머리 2줄을 한 블록 리다이렉트로 읽는다 — 파일을 두 번 열지 않는다. 중괄호 블록은
   335	    # 서브셸이 아니라 대입이 블록 밖에 남고, 리다이렉트는 블록 안에만 적용되므로 바깥
   336	    # while 의 stdin($RETRIEVAL_FLAG)과 충돌하지 않는다.
   337	    {
   338	      IFS= read -r rline || true
   339	      # 둘째 줄 "누락" 판정은 read 의 rc 를 실제로 소비해야 한다. 무개행 마지막 줄에서
   340	      # read 는 값을 담고도 rc=1 을 내므로, rc 만 보면 개행 없는 정상 표명이 누락으로
   341	      # 오판되고 값만 보면 판정이 뭉개진다. 한 줄 관용구(`read || [ -n ]`)는 단발 read
   342	      # 에서 rc 를 아무도 소비하지 않는 no-op 이다(설계 검수 [cc] r2 HIGH — while 루프
   343	      # 조건이던 원본과 자리가 다르다). 그래서 분기로 소비한다.
   344	      if IFS= read -r rline2; then
   345	        :
   346	      elif [ -n "$rline2" ]; then
   347	        :                   # 개행 없는 마지막 줄 — 값이 있으므로 누락이 아니다
   348	      else
   349	        ref_missing=1       # rc!=0 이고 값도 없다 = 둘째 줄이 없다(1줄 파일)
   350	      fi
   351	    } < "$rfile"
   352	    # ── 첫 줄: 회수 표명 (ADR-0013) ──
   353	    # 첫 줄 판정 전에 선두 BOM·후행 CR 을 걷어낸다 — harness_env_value 가 같은 부류
   354	    # (눈에 안 보이는 바이트가 판정을 뒤집는 것)에 데인 전례가 있다.
   355	    rline="${rline#$'\xEF\xBB\xBF'}"
   356	    rline="${rline%$'\r'}"
   357	    case "$rline" in
   358	      "사전 결정 회수:"*)
   359	        if [ -z "$(printf '%s' "${rline#사전 결정 회수:}" | LC_ALL=C tr -d '[:space:]')" ]; then
   360	          retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   361	"
   362	          retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 표명 접두어 뒤에 내용이 없음
   363	"
   364	        fi
   365	        ;;
   366	      "")
   367	        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   368	"
   369	        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일이 비었거나 첫 줄이 빈 줄
   370	"
   371	        ;;
   372	      *)
   373	        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   374	"
   375	        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 첫 줄이 '사전 결정 회수:' 로 시작하지 않음
   376	"
   377	        ;;
   378	    esac
   379	    # ── 둘째 줄: 레퍼런스 표명 (ADR-0015) — 닫힌 문법 ──
   380	    #   레퍼런스 조사:<SP*><변형><SP*>(<내용>)<SP*>
   381	    #   <변형> = 조사함|불요|실패 (정확 일치 — 꼬리 문자가 붙으면 불량)
   382	    #   <SP>   = ASCII 스페이스·탭 뿐 (비ASCII 공백은 SP 가 아니다)
   383	    #   <내용> = LC_ALL=C tr -d '[:space:]' 후 비어있지 않음 (내부 괄호 허용 —
   384	    #            마지막 `)` 가 닫는 괄호. 첫 `)` 로 자르면 `조사함(a(b) c)` 가 잘린다)
   385	    if [ "$ref_missing" -eq 1 ]; then
   386	      retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   387	"
   388	      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 둘째 줄 없음(레퍼런스 표명 누락)
   389	"
   390	    else
   391	      rline2="${rline2%$'\r'}"
   392	      case "$rline2" in
   393	        "레퍼런스 조사:"*)
   394	          ref_body="${rline2#레퍼런스 조사:}"
   395	          # 앞뒤 SP(스페이스·탭)만 트림한다 — 트림 후 마지막 문자가 `)` 여야 하므로
   396	          # 닫는 괄호 뒤 잡음은 아래 case 에서 불량으로 떨어진다.
   397	          while :; do
   398	            case "$ref_body" in
   399	              ' '*)  ref_body="${ref_body# }" ;;
   400	              '	'*)  ref_body="${ref_body#	}" ;;
   401	              *' ')  ref_body="${ref_body% }" ;;
   402	              *'	')  ref_body="${ref_body%	}" ;;
   403	              *) break ;;
   404	            esac
   405	          done
   406	          ref_head="${ref_body%%\(*}"
   407	          while :; do
   408	            case "$ref_head" in
   409	              *' ')  ref_head="${ref_head% }" ;;
   410	              *'	')  ref_head="${ref_head%	}" ;;
   411	              *) break ;;
   412	            esac
   413	          done
   414	          if [ "$ref_head" = "$ref_body" ]; then
   415	            # 여는 괄호가 없다 — `불요` 단독(사유 없음)·접두어만 남은 줄이 여기 온다.
   416	            retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   417	"
   418	            retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
   419	"
   420	          else
   421	            case "$ref_head" in
   422	              조사함|불요|실패)
   423	                case "$ref_body" in
   424	                  *\))
   425	                    ref_inner="${ref_body#*\(}"
   426	                    ref_inner="${ref_inner%\)}"
   427	                    # 내용 검사는 세 변형 **공통의 단일 경로**다 — 변형별로 복제하면
   428	                    # 한 변형만 검사가 빠지는 부류가 생긴다(`실패()` — 설계 검수 [cx] r2).
   429	                    if [ -z "$(printf '%s' "$ref_inner" | LC_ALL=C tr -d '[:space:]')" ]; then
   430	                      retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   431	"
   432	                      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명의 괄호 안이 비었음
   433	"
   434	                    fi
   435	                    ;;
   436	                  *)
   437	                    # 트림 후에도 `)` 로 안 끝난다 — 닫는 괄호 뒤 잡음·미닫힘.
   438	                    retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   439	"
   440	                    retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
   441	"
   442	                    ;;
   443	                esac
   444	                ;;
   445	              *)
   446	                # 변형 꼬리(`조사함부족`)·유의어(`불필요`)·비ASCII 공백이 낀 머리.
   447	                retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   448	"
   449	                retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 레퍼런스 표명이 조사함(<내용>)/불요(<사유>)/실패(<사유>) 형식이 아님
   450	"
   451	                ;;
   452	            esac
   453	          fi
   454	          ;;
   455	        *)
   456	          # 빈 둘째 줄(개행만)도 여기로 온다 — 접두어 사유 하나로 접는다.
   457	          retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
   458	"
   459	          retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 둘째 줄이 '레퍼런스 조사:' 로 시작하지 않음
   460	"
   461	          ;;
   462	      esac
   463	    fi
   464	  done < "$RETRIEVAL_FLAG"
   465	
   466	  if [ -z "$retrieval_bad_paths" ]; then
   467	    # 전부 형식 준수(또는 소실뿐) → 자동 해제. rm 이 실패하면 플래그가 남아 다음 턴에
   468	    # 다시 검사된다 — 게이트가 죽는 방향이 아니라 남는 방향이므로 조용해도 안전하다.
   469	    rm -f "$RETRIEVAL_FLAG" 2>/dev/null
   470	    # 지문을 다시 계산한다 — 진입 시 스냅숏에는 방금 지운 "r" 비트가 남아 있어, 이 턴의
   471	    # 하위 게이트가 stale 지문으로 예산을 매기고 다음 턴에 거짓 리셋이 난다([cc] HIGH).
   472	    compute_flags_fp
   473	    if ! work_pending; then
   474	      # 이 턴의 할 일이 이것뿐이었다 — 여기서 끝내지 않으면 맨 아래 감사 게이트가
   475	      # 빈 목록으로 허위 차단한다([cc·cx] 검수). 술어는 조기 종료와 같은 것을 쓴다 —
   476	      # push 미완·다른 플래그가 남았으면 아래 게이트들로 계속 흘러간다.
   477	      rm -f "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
   478	      if [ -n "${decision_note:-}" ]; then
   479	        # 경고를 삼키지 않는 것이 결정 게이트 fail-open 의 유일한 조건이다(ADR-0012 ②).
   480	        # 성공 경로에도 적용된다 — 예산 소진 경로가 같은 방식으로 싣는다.
   481	        printf '{"systemMessage":"참고: %s — 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."}\n' "$decision_note"
   482	      fi
   483	      exit 0
   484	    fi
   485	  else
   486	    # 예산 키는 게이트 자신에게만 결합한다. 불량 목록을 공유 지문(flags_fp)에 넣으면
   487	    # 다른 게이트의 예산까지 리셋된다. 목록이 줄면(파일을 고치면) 이 게이트의 카운터만
   488	    # 리셋된다 — push 가 "몇 개 남았나"를 지문에 넣는 것과 같은 의도다.
   489	    # 파이프가 실패하거나 빈 값을 내면(제한된 PATH·I/O 오류) 예산 키가 비어 "진전이
   490	    # 리셋을 못 만드는" 상태가 된다([cx] 지적) — 외부 명령 없는 bash 치환으로 폴백한다.
   491	    # 폴백은 정렬이 없어 키 안정성이 낮지만, 같은 플래그 파일은 순서가 유지되므로 실효는 같다.
   492	    retrieval_bad_sorted="$(printf '%s' "$retrieval_bad_paths" | sort -u | tr '\n' ' ')" \
   493	      || retrieval_bad_sorted=""
   494	    [ -n "$retrieval_bad_sorted" ] || retrieval_bad_sorted="${retrieval_bad_paths//$'\n'/ }"
   495	    gate_budget "retrieval:${retrieval_bad_sorted}"
   496	    {
   497	      echo "[완료 차단] 설계·계획 산출물의 머리 표명이 계약과 다릅니다 — 회수(1줄)·레퍼런스 조사(2줄) 표명 없이 만든 산출물로는 끝낼 수 없습니다."
   498	      echo
   499	      echo "형식이 어긋난 파일:"
   500	      printf '%s' "$retrieval_bad_msgs" | sed 's/^/  - /'
   501	      echo
   502	      echo "해야 할 일:"
   503	      echo "  1. 프로필 9절의 지식 진입점을 읽고, 이번 작업과 관련된 항목만 따라가 읽는다."
   504	      echo "  2. 레퍼런스 조사가 필요한 작업이었는지 판단한다 — 필요했으면 조사하고(인접"
   505	      echo "     도메인 포함), 불요·실패라도 사유를 적는다. 조용한 스킵은 없다."
   506	      echo "  3. 산출물 **머리 3줄**을 이 형식으로 맞춘다:"
   507	      echo "     1줄: 사전 결정 회수: <읽은 경로>      또는  사전 결정 회수: 없음(<사유>)"
   508	      echo "     2줄: 레퍼런스 조사: 조사함(<대상·출처>) | 불요(<사유>) | 실패(<시도 — 사유>)"
   509	      echo "          — 이 세 단어와 반각 괄호만. 괄호 안이 비면 불량입니다."
   510	      echo "     3줄~: - 걸리는 선행 결정: <제목 — 한 줄> (없으면 \"- 걸리는 선행 결정 없음\")"
   511	      echo "  4. 형식을 지키면 이 게이트는 스스로 풀립니다 — 지울 플래그가 없습니다."
   512	      echo
   513	      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지·조사했는지는 검수(plan-reviewer·codex)가 봅니다."
   514	      emit_decision_note
   515	      echo
   516	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
   517	    } >&2
   518	    bump_and_block
   519	  fi
   520	fi
   521	
   522	# (3.5) 듀얼 리뷰(codex) 게이트 (2026-08-03 kty — "리뷰가 필요한 모든 단계를 codex와 같이"의 기계화).
   523	#      설계·계획 산출물이 저장되거나 코드가 바뀐 턴은 codex 독립 리뷰 없이 끝낼 수 없다.
   524	#      Claude 단독 리뷰가 놓친 CRITICAL을 codex가 잡은 실사고(2026-08-03 POK-30)의 재발 방지.
   525	if [ -s "$DUALREVIEW_FLAG" ] && ! hook_disabled "stop:dualreview"; then
   526	  gate_budget "dualreview"
   527	  {
   528	    echo "[완료 차단] codex 듀얼 리뷰 미수행 — Claude 단독 리뷰로는 끝낼 수 없습니다."
   529	    echo
   530	    echo "이 턴의 듀얼 리뷰 대상:"
   531	    sed 's/^/  - /' "$DUALREVIEW_FLAG" 2>/dev/null
   532	    echo
   533	    echo "해야 할 일:"
   534	    echo "  1. 대상 산출물/diff를 codex로 독립 리뷰시킨다 (모델·effort는 guard-codex-invocation 규정 — 임의 하향 금지)."
   535	    echo "  2. 결과를 _workspace/ 에 *codex*.md 로 저장하고 지적을 [cc]/[cx] 태그로 통합한다."
   536	    echo "  3. 그 뒤에만:  rm -f .claude/.needs-dualreview"
   537	    echo "     codex 미설치·호출 실패면 사용자 보고에 '듀얼 리뷰 생략(codex 실패)'을 명시한 뒤에 지운다."
   538	    echo "     리뷰 없이 플래그만 지우는 것은 이 게이트의 존재 이유를 없앤다."
   539	    echo
   540	    emit_decision_note
   541	    echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:dualreview"
   542	  } >&2
   543	  bump_and_block
   544	fi
   545	
   546	# (4) change-explainer 게이트 (Phase 5) — 감사자보다 먼저 강제한다.
   547	#     코드가 바뀐 턴은 변경 설명 없이 끝낼 수 없다. change-explainer 가 실제로
   548	#     사용자용 설명을 낸 뒤에만 .needs-explain 을 지운다.
   549	#     (완료 감사와 별개로 이 게이트만 끄려면 ECC_DISABLED_HOOKS=stop:explain)
   550	if [ -s "$EXPLAIN_FLAG" ] && ! hook_disabled "stop:explain"; then
   551	  gate_budget "explain"
   552	  {
   553	    echo "[완료 차단] change-explainer 미실행 — 변경 설명 없이 끝낼 수 없습니다."
   554	    echo
   555	    echo "이 턴에서 바뀐 코드/설정:"
   556	    sed 's/^/  - /' "$EXPLAIN_FLAG" 2>/dev/null
   557	    echo
   558	    echo "해야 할 일:"
   559	    echo "  1. change-explainer 에이전트로 실제 diff 기반 사용자용 변경 설명을 낸다."
   560	    echo "  2. 설명을 낸 뒤에만:  rm -f .claude/.needs-explain"
   561	    echo "     설명 없이 플래그만 지우는 것은 이 게이트의 존재 이유를 없앤다."
   562	    echo
   563	    emit_decision_note
   564	    echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:explain"
   565	  } >&2
   566	  bump_and_block
   567	fi
   568	
   569	# (5) 지식 저장소 반영 게이트 — 감사보다 먼저 강제한다 (감사자가 반영 결과를 검증하도록).
   570	#     (2026-08-02 kty — 산문 규칙이 세션 내내 0회 이행된 실사고의 기계화)
   571	#
   572	#     **이 훅이 아는 것은 계약 하나뿐이다**: "지식 저장소가 설정돼 있으면, 결정·설계가
   573	#     나온 턴은 반영 없이 끝낼 수 없다." 저장소가 어디인지·어떤 구조인지·무엇을 어느
   574	#     파일에 나눠 담는지는 **상위 층의 구현**이고 이 파일은 모른다. 알게 되면 그 저장소를
   575	#     안 쓰는 환경에서 하네스가 없는 구조를 요구하게 된다(제0원칙 4 — 구체가 아닌 계약).
   576	#     어디에 어떻게 저장했는지의 검증은 그 저장소 자신의 규약이 한다.
   577	if knowledge_gate_active && ! hook_disabled "stop:knowledge"; then
   578	  gate_budget "knowledge"
   579	  {
   580	    echo "[완료 차단] 지식 저장소 반영 미확인 — 이 턴의 결정·설계를 남기지 않고 끝낼 수 없습니다."
   581	    echo
   582	    echo "이 턴에서 바뀐 코드/설정:"
   583	    sed 's/^/  - /' "$KNOWLEDGE_FLAG" 2>/dev/null
   584	    echo
   585	    echo "해야 할 일:"
   586	    echo "  1. 이 머신의 지식 저장소가 **어디이고 어떤 형식인지는 사용자 층 설정**(전역"
   587	    echo "     CLAUDE.md 등)이 답한다. 그 규약을 **전문** 읽는다 — 부분 독해 금지."
   588	    echo "  2. 이번 턴에 결정·설계·개발작업이 있으면 그 규약대로 반영하고, 반영됐다는"
   589	    echo "     확인 가능한 증거(커밋 해시·파일 경로 등)를 확보한다."
