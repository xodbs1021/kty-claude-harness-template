   518	            # 실측: content 가 ["문장"] 형태면 조용히 버려져 rc=3 으로 통과했다.
   519	            fail("assistant content 블록 형식이 예상과 다릅니다 (형식이 바뀌었을 수 있습니다)")
   520	        if b.get("type") == "tool_use":
   521	            if b.get("name") == "AskUserQuestion":
   522	                asked += 1
   523	        elif b.get("type") == "text":
   524	            t = b.get("text")
   525	            if not isinstance(t, str):
   526	                fail("text 블록의 text 필드가 문자열이 아닙니다 (형식이 바뀌었을 수 있습니다)")
   527	            texts.append(t)
   528	        elif b.get("type") not in KNOWN_BLOCKS:
   529	            # **블록 타입 이름이 바뀌면 발화가 조용히 사라진다.** 컨테이너만 검사하고
   530	            # 그 안의 타입을 안 보면 비대칭이다 — 형식 변경은 컨테이너보다 블록 쪽이
   531	            # 더 흔하다. 실측: {"type":"output_text","text":"…제 판단으로 정했습니다."}
   532	            # 가 rc=3(차단 불필요)으로 조용히 통과했다([cc] 2라운드).
   533	            fail("모르는 assistant 블록 타입입니다: %r (형식이 바뀌었을 수 있습니다)"
   534	                 % (b.get("type"),))
   535	
   536	if asked > 0:
   537	    raise SystemExit(3)
   538	
   539	hits, seen = [], set()
   540	for text in texts:
   541	    for line in drop_fences(text).split("\n"):
   542	        if BLOCKQUOTE.match(line):
   543	            continue
   544	        line = QUOTED.sub(" ", INLINE.sub(" ", line))
   545	        chunks = SENT.split(line)
   546	        for i in range(0, len(chunks), 2):
   547	            body = chunks[i]
   548	            whole = body + (chunks[i + 1] if i + 1 < len(chunks) else "")
   549	            # 부정이 붙으면 물음이 아니라 자백이다 — "물어보지 않고 …했습니다".
   550	            if QUESTION.search(whole) and not NEG_ASK.search(whole):
   551	                continue
   552	            core = TRAIL.sub("", LEAD.sub("", body).strip())
   553	            if not core or not MARKER.search(core) or not DECLARATIVE.search(core):
   554	                continue
   555	            if core in seen:
   556	                continue
   557	            seen.add(core)
   558	            hits.append(core if len(core) <= MAX_LEN else core[:MAX_LEN] + "…")
   559	
   560	if not hits:
   561	    raise SystemExit(3)
   562	for h in hits[:MAX_HITS]:
   563	    sys.stdout.write(h + "\n")
   564	if len(hits) > MAX_HITS:
   565	    sys.stdout.write("... 그리고 %d개 더\n" % (len(hits) - MAX_HITS))
   566	raise SystemExit(0)
   567	PY
   568	}

