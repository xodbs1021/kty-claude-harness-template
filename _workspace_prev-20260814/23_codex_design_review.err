    43	# 경로를 넣지 않는 것도 같은 이유다: 기록 실패 상황에서 사용자에게 필요한 정보는
    44	# "게이트가 안 섰다"는 사실이고, 경로를 끼우는 순간 이스케이프 기계장치가 딸려온다.
    45	MSG_WRITE_FAIL="완료 게이트 플래그를 기록하지 못했다(.claude 쓰기 실패). 게이트가 서지 않았으니 완료 판정 전에 수동으로 확인하라."
    46	MSG_NEWLINE="편집 경로에 개행이 있어 게이트 플래그를 기록하지 않았다. 줄 단위 플래그 파일이 오염되기 때문이다. 수동으로 확인하라."
    47	MSG_GIT_UNAVAILABLE="git 이 저장소 정보를 돌려주지 못해(소유권 거부·권한·손상) 하네스 정본 여부를 판정하지 못했다. 앵커 밖 파일에는 게이트가 서지 않았으니 수동으로 확인하라."
    48	
    49	# --- 계약 함수 ------------------------------------------------------------
    50	
    51	# emit_message <메시지> — {"systemMessage":"..."} 를 stdout 에 한 줄로.
    52	# JSON 을 만드는 **유일 지점**이다. 여기 말고 다른 곳에서 stdout 에 쓰면 안 된다.
    53	emit_message() {
    54	  printf '{"systemMessage":"%s"}\n' "$1"
    55	}
    56	
    57	# physical_dir <디렉토리> — 심링크·`..`·`.` 를 푼 물리 절대경로를 stdout 에.
    58	# 실패하면 **원본을 그대로 내고** rc=1. 호출자는 스킵하지 않는다 — 정규화에 실패했다고
    59	# 게이트를 지우면 조용한 위음성이 되므로, 덜 정확한 경로로라도 판정을 잇는 쪽을 택한다.
    60	#
    61	# **cd 는 반드시 -P 여야 한다** — pwd -P 만으로는 부족하다. 논리 cd(기본값)는 `심링크/..` 를
    62	# 심링크를 따라가기 **전에** 문자로 상쇄하므로 커널이 실제로 여는 곳과 다른 답을 낸다
    63	# (실측: `cd -- /var/..` → `/`, `cd -P -- /var/..` → `/private`). 그 차이만큼 프로젝트
    64	# **밖** 파일이 프로젝트 **안** 상대경로로 기록돼, 게이트는 서는데 감사자가 엉뚱한 파일을
    65	# 본다(케이스 67). 반대 방향으로는 밖 하네스 파일의 게이트가 통째로 사라진다(케이스 68).
    66	# 형제 검사기 scripts/check-rule-copies.sh 의 physical_path 와 같은 방식이다(PR #13).
    67	physical_dir() {
    68	  local out
    69	  out="$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P)"
    70	  if [ -z "$out" ]; then
    71	    printf '%s\n' "$1"
    72	    return 1
    73	  fi
    74	  printf '%s\n' "$out"
    75	}
    76	
    77	# physical_path <파일경로> — 편집 경로를 물리화한다. 실패하면 **원본 경로를 그대로 내고** rc=1.
    78	#
    79	# 마지막 성분이 **이름이면 보존**한다 — 파일 자신이 심링크여도 편집 대상의 이름으로
    80	# 기록해야 하고, 애초에 파일에는 cd 할 수 없다. 파일이 아직 없을 수도 있다(케이스 51).
    81	#
    82	# **단 `.`·`..` 는 이름이 아니라 디렉토리 이동이라 반드시 푼다.** 보존할 이름이 없으므로
    83	# 위 예외의 근거가 성립하지 않는다. 안 풀면 dirname 만 물리화된 `…/src/..` 가 그대로 나와
    84	# 프로젝트 접두사에 문자열상 걸리고, 플래그에 디렉토리 표기가 박힌다(케이스 69·70).
    85	# 형제 검사기가 PR #13 에서 같은 이름의 같은 버그를 이 방식으로 고쳤다 — 접근을 맞춘다.
    86	physical_path() {
    87	  local dir base
    88	  base="$(basename -- "$1")"
    89	  # cd 는 반드시 명령 치환 안에서 — 함수 본문에서 그냥 cd 하면 호출부의 cwd 가 바뀐다.
    90	  case "$base" in
    91	    . | ..) physical_dir "$1"; return ;;
    92	  esac
    93	  dir="$(physical_dir "$(dirname -- "$1")")" || { printf '%s\n' "$1"; return 1; }
    94	  # pwd -P 가 "/" 를 낼 때만 "//base" 가 된다 (루트 바로 아래 경로).
    95	  if [ "$dir" = '/' ]; then dir=''; fi
    96	  printf '%s/%s\n' "$dir" "$base"
    97	}
    98	
    99	# project_rel <절대경로> — $proj 아래면 프로젝트 기준 상대경로를 stdout·rc=0, 아니면 rc=1.
   100	# 접두사에 **슬래시를 반드시 포함**한다. 빠뜨리면 형제 디렉토리(<proj>-backup/…)를
   101	# 프로젝트 안으로 오인한다. "$proj" 를 인용하는 것은 경로 안의 글롭 문자 때문이다.
   102	project_rel() {
   103	  case "$1" in
   104	    "$proj"/*) printf '%s\n' "${1#"$proj"/}" ;;
   105	    *) return 1 ;;
   106	  esac
   107	}
   108	
   109	# git_toplevel <절대경로> — 그 파일이 속한 git 저장소 루트를 물리 경로로. 없으면 rc=1.
   110	# GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE 을 소거한다: 훅이 git 훅 안에서 돌면 이 변수들이
   111	# 엉뚱한 저장소를 가리켜 귀속이 통째로 바뀐다.
   112	# 경로에 /.git/ 가 있으면 그 앞을 기준으로 삼는다: git 은 .git 안에서 --show-toplevel 에
   113	# 실패하므로(실측 rc=128), 그대로 물으면 .git/hooks/* 편집이 판정 불가로 새어나간다.
   114	git_toplevel() {
   115	  local dir top
   116	  case "$1" in
   117	    */.git/*) dir="${1%%/.git/*}" ;;
   118	    */.git)   dir="${1%/.git}" ;;
   119	    *)        dir="$(dirname -- "$1")" ;;
   120	  esac
   121	  top="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
   122	         git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"
   123	  [ -n "$top" ] || return 1
   124	  physical_dir "$top"
   125	}
   126	
   127	# has_git_ancestor <절대경로> — 조상 디렉토리에 .git 이 있는가. git 을 쓰지 않는다.
   128	# git_toplevel 이 빈 값을 돌려준 이유가 "저장소가 아님"인지 "git 이 거부함"인지를 가르는
   129	# 데 쓴다. rev-parse 는 둘 다 rc=128 로 돌려주므로 stderr 내용으로 가르는 것은 취약하다.
   130	has_git_ancestor() {
   131	  local d
   132	  d="$(dirname -- "$1")"
   133	  while [ "$d" != '/' ] && [ "$d" != '.' ]; do
   134	    [ -e "$d/.git" ] && return 0
   135	    d="$(dirname -- "$d")"
   136	  done
   137	  return 1
   138	}
   139	
   140	# is_harness_canonical <저장소루트> — 하네스 정본 저장소인가.
   141	# 마커는 이 한 조건뿐이다. 조건을 더 얹으면 재배치 포크에서 위음성이 넓어지는데,
   142	# 위음성은 조용하고 오탐은 탈출구(ECC_DISABLED_HOOKS)가 있다 — 그래서 단순한 쪽을 택했다.
   143	is_harness_canonical() {
   144	  [ -d "$1/template/.claude" ]
   145	}
   146	
   147	# harness_anchor <선행 슬래시가 있는 경로> — 하네스 동작을 정의하는 자리인가.
   148	# 앵커 목록을 정의하는 **유일 지점**이다.
   149	harness_anchor() {
   150	  case "$1" in
   151	    */.claude/agents/*|*/.claude/skills/*|*/.claude/hooks/*|*/.claude/harness/*|*/.claude/settings.json)
   152	      return 0 ;;
   153	  esac
   154	  return 1
   155	}
   156	
   157	# classify <기준 상대경로> <기준 디렉토리> — gate · knowledge · skip 을 stdout 에.
   158	# 프로젝트 안(4a)과 밖-하네스정본(4b)이 **같은 규칙**을 쓰도록 공유한다.
   159	#
   160	# 순서가 계약이다:
   161	#   1) .claude/*·_workspace/* 제외가 앵커보다 **먼저**. 그래야 하네스 정본 저장소가
   162	#      자기 자신에 설치해 둔 소비 사본(.claude/hooks/*)이 빠지고 정본(template/.claude/*)만
   163	#      발화한다. 설치본은 정본을 고쳐 sync 하는 게 규약이라 제자리 편집은 일시적이다.
   164	#   2) 앵커가 *.md 제외보다 먼저. 에이전트·스킬·원칙 정의는 전부 .md 인데 일괄 제외하면
   165	#      하네스 저장소에서 가장 흔한 변경에 플래그가 하나도 안 선다.
   166	#   3) global-agents/*.md 는 **정본 스코프에서만** 예외의 예외를 연다. install/sync 가
   167	#      배포하는 전역 에이전트 정본이기 때문이며, 남의 프로젝트로 새면 오탐이 된다.
   168	classify() {
   169	  local rel="$1" base="$2" lower
   170	  case "$rel" in
   171	    _workspace/*|.claude/*) printf 'skip\n'; return 0 ;;
   172	  esac
   173	  if harness_anchor "/$rel"; then
   174	    printf 'gate\n'; return 0
   175	  fi
   176	  case "$rel" in
   177	    global-agents/*.md)
   178	      if is_harness_canonical "$base"; then printf 'gate\n'; return 0; fi ;;
   179	  esac
   180	  # 확장자 판정은 소문자화해서 본다 — README.MD 가 코드로 취급되면 안 된다.
   181	  lower="$(printf '%s' "$rel" | tr '[:upper:]' '[:lower:]')"
   182	  # 결정 문서는 문서 제외의 **예외**다. 하네스가 스스로 "결정은 여기 이 이름으로 쓴다"고
   183	  # 규정한 경로(결정 기록 절)라 **하네스가 아는 산출물**이고, 그 자리가 편집됐다는 것은
   184	  # 곧 결정이 나왔다는 뜻이다. 코드가 아니므로 게이트 4종은 과하다 — 지식 게이트만 세운다.
   185	  #
   186	  # 공시된 한계: 결정 문서를 이 경로 **밖**에 두면 게이트가 서지 않는다. 하네스가 아는
   187	  # 경로만 알 수 있기 때문이고, 프로젝트마다 다른 위치를 알아내려면 다시 상위 층 구현을
   188	  # 알아야 한다. 이 공백은 회수 정책 ADR 로 넘긴다.
   189	  case "$lower" in
   190	    docs/decisions/*.md|docs/decisions/*.markdown) printf 'knowledge\n'; return 0 ;;
   191	  esac
   192	  case "$lower" in
   193	    *.md|*.markdown) printf 'skip\n'; return 0 ;;
   194	  esac
   195	  printf 'gate\n'
   196	}
   197	
   198	# record_flag <플래그파일> <값> — 이미 있으면 그냥 두고, 없으면 한 줄 덧붙인다. 실패하면 rc=1.
   199	# grep 의 -- 는 필수다: 값이 - 로 시작하면(예: 파일명 --version) grep 이 그것을 옵션으로
   200	# 해석해 rc=0(=이미 있음)을 돌려주고, BSD grep 은 -q 아래서도 버전 문자열을 stdout 에 뱉는다.
   201	# append 를 중괄호로 감싸는 것도 필수다: 리다이렉트 **열기** 실패는 셸이 보고하는데,
   202	# printf 뒤에 붙인 2>/dev/null 은 그 시점에 아직 적용되지 않아 stderr 가 샌다(실측).
   203	record_flag() {
   204	  mkdir -p "$STATE_DIR" 2>/dev/null
   205	  if grep -qxF -- "$2" "$1" 2>/dev/null; then
   206	    return 0
   207	  fi
   208	  { printf '%s\n' "$2" >> "$1"; } 2>/dev/null || return 1
   209	  return 0
   210	}
   211	
   212	# --- 판정 -----------------------------------------------------------------
   213	
   214	payload="$(cat)"
   215	# json_get 결과를 **센티널로** 받는다. 명령 치환은 후행 개행을 전부 지우므로 그냥 받으면
   216	# 경로 끝의 개행이 아래 가드에 닿기도 전에 사라지고, 경고 없이 **다른 파일** 경로가
   217	# 기록된다("src/app.ts" + LF → "src/app.ts"). X 를 붙여 받고 도로 뗀 뒤, json_get 자신이
   218	# print() 로 붙인 개행 **하나만** 지운다 — 그러면 원본의 후행 개행이 살아남는다.
   219	raw="$(printf '%s' "$payload" | json_get tool_input.file_path; printf 'X')"
   220	raw="${raw%X}"
   221	file_path="${raw%$'\n'}"
   222	[ -z "$file_path" ] && exit 0
   223	
   224	# 개행 가드는 **정규화보다 먼저**여야 한다. 디렉토리 컴포넌트가 개행으로 끝나면
   225	# (…/sr<LF>/app.ts) physical_path 의 pwd -P 출력을 받는 명령 치환이 그 개행을 먹어
   226	# 경로가 …/sr/app.ts 로 조용히 바뀐다 — 없는 파일이 게이트에 박히고 정작 편집한
   227	# 파일은 무게이트가 된다. 플래그 파일은 줄 단위라 개행이 든 경로는 애초에 못 적는다.
   228	case "$file_path" in
   229	  *$'\n'*) emit_message "$MSG_NEWLINE"; exit 0 ;;
   230	esac
   231	
   232	# 양쪽을 물리 경로로 맞춘 뒤에 비교한다. git 은 실제 경로를 돌려주는데 편집 경로는
   233	# 심링크를 지나올 수 있고(macOS /var → /private/var), .. 로 되돌아올 수도 있다.
   234	# 정규화 없이 자르면 접두사가 안 맞아 프로젝트 안 편집이 통째로 "밖"으로 샌다.
   235	# PROJECT_DIR 은 디렉토리라 통째로 물리화한다(심링크 PROJECT_DIR — 케이스 11·12).
   236	# 편집 경로는 파일이라 마지막 성분 이름을 보존하는 physical_path 를 쓴다 — 두 계약이
   237	# 다르므로 함수도 둘이다.
   238	proj="$(physical_dir "$PROJECT_DIR")"
   239	case "$file_path" in
   240	  /*) ;;
   241	  *) file_path="$proj/$file_path" ;;
   242	esac
   243	abs="$(physical_path "$file_path")"
   244	
   245	# 설계·계획 산출물은 위치·git 여부와 무관하게 듀얼리뷰 게이트만 세운다.
   246	# **정규화 뒤**에 판정해야 한다: 상대경로 입력에는 선행 슬래시가 없어 아래 글롭에
   247	# 걸리지 않고, .. 가 섞인 경로는 기록값이 .claude/../_workspace/… 로 남는다.
   248	# 매칭만 소문자화하고 기록은 원본 대소문자로 한다.
   249	lower_abs="$(printf '%s' "$abs" | tr '[:upper:]' '[:lower:]')"
   250	# 설계·계획 산출물은 듀얼리뷰 **와 지식·회수 표명 게이트**를 세운다. 코드가 아니므로
   251	# 타입체크·변경설명·감사는 과하지만, 설계가 나온 턴을 지식 저장소 반영 없이 끝내면
   252	# "왜 그렇게 정했나"가 그 자리에서 사라진다 — 결정을 만든 근거가 정확히 이 파일들이다.
   253	# 회수 플래그(ADR-0013)는 첫 줄이 `사전 결정 회수:` 표명을 지키는지 Stop 이 검사하고
   254	# 지키면 스스로 지운다. 이름에 codex 가 든다고 빼는 식의 **이름 제외는 두지 않는다** —
   255	# 관측되지 않은 재귀를 막으려고 실재하는 위음성(codex 를 다루는 정상 설계서의 무게이트)을
   256	# 만들게 된다. 리뷰 산출물과의 재귀는 명명 계약(리뷰 산출물은 00_design·01_plan 접두어
   257	# 금지 — 오케스트레이터 스킬)이 막는다.
   258	case "$lower_abs" in
   259	  */_workspace/00_design*.md|*/_workspace/01_plan*.md)
   260	    dual_value="$(project_rel "$abs")" || dual_value="$abs"
   261	    dw=0
   262	    record_flag "$DUALREVIEW_FLAG" "$dual_value" || dw=1
   263	    record_flag "$KNOWLEDGE_FLAG"  "$dual_value" || dw=1
   264	    record_flag "$RETRIEVAL_FLAG"  "$dual_value" || dw=1
   265	    [ "$dw" -eq 1 ] && emit_message "$MSG_WRITE_FAIL"
   266	    exit 0 ;;
   267	esac
   268	
   269	if rel="$(project_rel "$abs")"; then
   270	  value="$rel"
   271	  verdict="$(classify "$rel" "$proj")"
   272	else
   273	  # 프로젝트 밖. 기록값은 절대경로다.
   274	  value="$abs"
   275	  root="$(git_toplevel "$abs")" || root=''
   276	  if [ -n "$root" ] && is_harness_canonical "$root"; then
   277	    case "$abs" in
   278	      "$root"/*) rel="${abs#"$root"/}" ;;
   279	      *) rel="$abs" ;;
   280	    esac
   281	    verdict="$(classify "$rel" "$root")"
   282	  elif harness_anchor "$abs"; then
   283	    # 앵커 판정에 git 을 요구하지 않는다 — 홈에 설치된 .claude/agents/*.md 는
   284	    # 그 디렉토리가 git 저장소가 아니어도 하네스 동작을 정의한다.
   285	    verdict='gate'
   286	  else
   287	    verdict='skip'
   288	    # git 이 빈 값을 돌려줬는데 조상에 .git 이 있으면, 저장소가 아닌 게 아니라 git 이
   289	    # 거부한 것이다(safe.directory 소유권 거부·권한·손상). 그대로 두면 정본 저장소
   290	    # 전체가 앵커 밖 파일에 대해 무게이트 + 무신호로 조용히 감시 축소된다.
   291	    # 판정은 바꾸지 않는다(추측으로 게이트를 세우면 남의 저장소를 오탐한다) — 알리기만
   292	    # 한다. physical_path 가 fail-loud 인데 여기만 fail-silent 이던 비대칭을 없앤다.
   293	    [ -z "$root" ] && has_git_ancestor "$abs" && emit_message "$MSG_GIT_UNAVAILABLE"
   294	  fi
   295	fi
   296	
   297	# 결정 문서는 지식 게이트 하나만. 코드가 아니므로 타입체크·변경설명·감사는 과하다.
   298	if [ "$verdict" = 'knowledge' ]; then
   299	  record_flag "$KNOWLEDGE_FLAG" "$value" || emit_message "$MSG_WRITE_FAIL"
   300	  exit 0
   301	fi
   302	
   303	[ "$verdict" = 'gate' ] || exit 0
   304	
   305	# 완료 게이트 4종을 동시에 세운다:
   306	#   .needs-audit      → completion-auditor 강제 (Phase 6)
   307	#   .needs-explain    → change-explainer 강제 (Phase 5)
   308	#   .needs-knowledge  → 지식 저장소 반영 또는 불요 사유 기록 강제 (2026-08-02 kty —
   309	#                       산문 규칙이 기억에만 의존해 세션 내내 0회 이행된 실사고의 재발 방지)
   310	#   .needs-dualreview → codex 듀얼 리뷰 강제 (2026-08-03 kty)
   311	# 각 게이트는 해당 작업이 실제로 끝난 뒤에만 수동으로 지워진다. Stop 훅이 넷 다 본다.
   312	#
   313	# 지식 게이트가 꺼져 있어도 여기서는 **기록한다.** 켜짐/꺼짐 판정은 harness.env 를 한 번
   314	# 더 읽는 일인데 이 훅은 편집마다 돌고 Stop 훅은 턴에 한 번 돈다 — 판정은 Stop 쪽
   315	# 한 곳(knowledge_gate_active)으로 모았다. 꺼져 있으면 이 파일은 아무 효력이 없다.
   316	write_failed=0
   317	for flag in "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG"; do
   318	  record_flag "$flag" "$value" || write_failed=1
   319	done
   320	# 넷이 다 실패해도 메시지는 한 줄만 낸다.
   321	[ "$write_failed" -eq 1 ] && emit_message "$MSG_WRITE_FAIL"
   322	exit 0

