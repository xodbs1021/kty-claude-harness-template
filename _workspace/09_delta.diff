++# run_stop <프로젝트> <transcript경로|빈문자열> [env 인자...]
++# 빈 문자열이면 payload 에서 transcript_path 키를 **아예 뺀다**(키 부재 케이스).
++run_stop() {
++  local p="$1" tp="$2"
++  shift 2
++  local errf="$TMPROOT/err.$$" outf="$TMPROOT/out.$$" payf="$TMPROOT/pay.$$"
++  RC=999; ERR=''; OUT=''; DID_RUN=1
