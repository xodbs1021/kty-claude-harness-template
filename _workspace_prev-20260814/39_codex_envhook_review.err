 p27() { pcase '히어독 <<- 는 탭 들여쓴 종결어'        0 'printf ok' 'cat <<-EOF'$'\n'"$KEY=\"evil\""$'\n\t''EOF'$'\n'"$KEY=\"printf ok\""$'\n'; }
 p28() { pcase "히어독 <<'EOF' 인용 종결어"            0 'printf ok' "cat <<'EOF'"$'\n'"$KEY=\"evil\""$'\n''EOF'$'\n'"$KEY=\"printf ok\""$'\n'; }
