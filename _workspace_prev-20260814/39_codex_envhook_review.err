     1	#!/usr/bin/env bash
     2	# check-harness-env.test.sh — harness.env 편집 검증 훅(post:edit:harness-env, ADR-0016) 회귀 방어.
     3	#
     4	#   "harness.env 를 편집한 직후, 값을 믿을 수 없는 알려진 키가 있으면 그 자리에서
     5	#    systemMessage 로 알린다. 부재(안 쓰는 키)와 정상 판독은 침묵한다."
     6	#
     7	# 실패 방향이 둘이다:
     8	#   위음성 — 문법 실수를 침묵으로 넘긴다. 이 훅이 존재하는 이유의 반대(조용한 검사 생략)
     9	#   위양성 — 안 쓰는 키·무관 파일에 경고를 낸다. 경고가 소음이 되면 진짜 경고도 무시된다.
    10	#            판독기 rc=1/rc=3 구분(_common.sh 반환 계약)이 정확히 이 축을 지킨다
    11	#
    12	# **판정 규칙의 사본을 두지 않는다.** 훅 자신을 돌려 stdout(systemMessage)으로 잰다.
    13	# 훅은 항상 exit 0 이므로 rc 로는 아무것도 판정하지 않는다 — stdout 의 존재·내용이 전부다.
    14	# 셸 이식성: macOS 기본 bash 는 3.2 다. mapfile·연관배열·${var,,} 금지.
    15	
    16	set -uo pipefail
    17	
    18	TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    19	REPO_ROOT="$(CDPATH='' cd -- "$TEST_DIR/.." && pwd -P)"
    20	HOOKS="$REPO_ROOT/template/.claude/hooks"
    21	
    22	command -v python3 >/dev/null 2>&1 || { echo "✗ python3 이 필요합니다 (payload 픽스처 의존)" >&2; exit 1; }
    23	for f in check-harness-env.sh _common.sh; do
    24	  [ -f "$HOOKS/$f" ] || { echo "✗ 훅을 찾지 못했습니다: $f" >&2; exit 1; }
    25	done
    26	
    27	TMPROOT="$(mktemp -d)" || exit 1
    28	if [ -z "$TMPROOT" ] || [ ! -d "$TMPROOT" ]; then
    29	  echo "✗ 임시 디렉토리를 만들지 못했습니다" >&2; exit 1
    30	fi
    31	TMPROOT="$(CDPATH='' cd -- "$TMPROOT" && pwd -P)"
    32	trap 'chmod -R u+rwX "$TMPROOT" 2>/dev/null; rm -rf "$TMPROOT"' EXIT
    33	
    34	ran=0; pass=0; fail=0
    35	RC=999; OUT=''; ERR=''; DID_RUN=0
    36	
    37	TOK_WARN='harness.env 판독 경고'
    38	TOK_SKIP='조용히 생략'
    39	
    40	report() {
    41	  ran=$((ran + 1))
    42	  if [ -z "$2" ]; then pass=$((pass + 1)); printf '  ✓ %s\n' "$1"
    43	  else fail=$((fail + 1)); printf '  ✗ %s — %s\n' "$1" "$2"; fi
    44	}
    45	contains() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
    46	
    47	# new_project [env내용|__NOFILE__] — 훅·공용 모듈이 설치된 독립 프로젝트.
    48	new_project() {
    49	  local p
    50	  p="$(mktemp -d "$TMPROOT/proj.XXXXXX")" || return 1
    51	  mkdir -p "$p/.claude/hooks" "$p/.claude/harness" || return 1
    52	  cp "$HOOKS/_common.sh" "$HOOKS/check-harness-env.sh" "$p/.claude/hooks/" || return 1
    53	  case "${1-}" in
    54	    __NOFILE__) ;;
    55	    *) printf '%s' "${1-}" > "$p/.claude/harness/harness.env" || return 1 ;;
    56	  esac
    57	  printf '%s\n' "$p"
    58	}
    59	
    60	# run_hook <프로젝트> <편집경로> [env 인자...] — PostToolUse payload 를 만들어 훅을 돌린다.
    61	run_hook() {
    62	  local p="$1" fp="$2"
    63	  shift 2
    64	  local outf="$TMPROOT/out.$$" errf="$TMPROOT/err.$$" payf="$TMPROOT/pay.$$"
    65	  RC=999; OUT=''; ERR=''; DID_RUN=1
    66	  python3 -c '
    67	import json, sys
    68	with open(sys.argv[2], "w", encoding="utf-8") as fh:
    69	    fh.write(json.dumps({"tool_input": {"file_path": sys.argv[1]}}))' "$fp" "$payf"
    70	  ( cd "$TMPROOT" && env -u HARNESS_HOOKS -u ECC_DISABLED_HOOKS ${@+"$@"} CLAUDE_PROJECT_DIR="$p" \
    71	      bash "$p/.claude/hooks/check-harness-env.sh" <"$payf" >"$outf" 2>"$errf" )
    72	  RC=$?
    73	  rm -f "$payf"
    74	  OUT="$(cat "$outf" 2>/dev/null)"
    75	  ERR="$(cat "$errf" 2>/dev/null)"
    76	  rm -f "$outf" "$errf"
    77	}
    78	
    79	# silent_case <이름> <env내용|__NOFILE__> [편집경로덮어씀] — 경고가 없어야 하는 케이스.
    80	# rc=0 과 stdout 공백까지 요구한다(PostToolUse 는 절대 실패하면 안 된다).
    81	silent_case() {
    82	  local name="$1" body="$2" fp="${3-}" why='' p
    83	  p="$(new_project "$body")" || { report "$name" '픽스처 실패'; return 0; }
    84	  [ -n "$fp" ] || fp="$p/.claude/harness/harness.env"
    85	  run_hook "$p" "$fp"
    86	  if [ "$DID_RUN" -ne 1 ];        then why='훅 미실행'
    87	  elif [ "$RC" -ne 0 ];           then why="rc=$RC (기대 0)"
    88	  elif [ -n "$OUT" ];             then why="위양성 — 경고가 나왔다: $(printf '%s' "$OUT" | head -c 120)"
    89	  fi
    90	  report "$name" "$why"
    91	}
    92	
    93	# warn_case <이름> <env내용> <나열되어야 할 키> <나열되면 안 되는 키|''>
    94	warn_case() {
    95	  local name="$1" body="$2" want_key="$3" forbid_key="${4-}" why='' p
    96	  p="$(new_project "$body")" || { report "$name" '픽스처 실패'; return 0; }
    97	  run_hook "$p" "$p/.claude/harness/harness.env"
    98	  if [ "$DID_RUN" -ne 1 ];              then why='훅 미실행'
    99	  elif [ "$RC" -ne 0 ];                 then why="rc=$RC (기대 0 — PostToolUse 는 실패하면 안 된다)"
   100	  elif ! contains "$OUT" "$TOK_WARN";   then why="경고가 없다: [$(printf '%s' "$OUT" | head -c 120)]"
   101	  elif ! contains "$OUT" "$TOK_SKIP";   then why='결과(검사 생략) 안내가 없다'
   102	  elif ! contains "$OUT" "$want_key";   then why="불량 키($want_key)가 나열되지 않았다"
   103	  elif [ -n "$forbid_key" ] && contains "$OUT" "$forbid_key"; then why="정상 키($forbid_key)가 불량으로 나열됐다"
   104	  fi
   105	  report "$name" "$why"
   106	}
