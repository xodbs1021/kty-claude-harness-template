   561	    elif ! contains "$ERR" '차단 2/';     then why="결정 게이트 카운터가 리셋됐다 (집합 변화가 전파됨): $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   562	    fi
   563	  fi
