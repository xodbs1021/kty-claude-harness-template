   396	p48() { pcase '다른 키의 여러 줄 값 안에 있는 키는 선언이 아니다' 3 '' \
   397	        "NOTES='example:"$'\n'"$KEY="$'\n'"end'"$'\n'; }
   398	p49() { pcase '히어독 <<\EOF (백슬래시 인용) 본문도 건너뛴다' 0 'printf ok' \
   399	        'cat <<\EOF'$'\n'"$KEY=\"evil\""$'\n''EOF'$'\n'"$KEY=\"printf ok\""$'\n'; }
   400	p50() { pcase '닫는 따옴표 뒤 공백 없는 # 는 주석이 아니다'    1 '' \
   401	        "$KEY=\"\"#on"$'\n'; }
   402	p51() { pcase '인용 없는 값이 # 로 시작하면 값 그대로다'        0 '#on' \
   403	        "$KEY=#on"$'\n'; }
   404	p52() { pcase '인용이 EOF 까지 안 닫히면 파일을 못 믿는다'      1 '' \
