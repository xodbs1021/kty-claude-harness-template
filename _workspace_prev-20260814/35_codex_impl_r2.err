     1	#!/usr/bin/env bash
     2	# mutate-retrieval-gate.sh — 머리 표명 게이트(stop:retrieval, ADR-0013 회수 1줄 +
     3	# ADR-0015 레퍼런스 조사 2줄) 방어의 **변이 측정**.
     4	#
     5	# 방어를 하나씩 지우거나 뒤집고, tests/retrieval-attestation.test.sh 가 빨개지는지 잰다.
     6	# 케이스 수·통과 수는 아무것도 증명하지 않는다 — 변이가 유일하게 믿을 만한 지표다.
     7	#
     8	# 계약 (위음성 카탈로그 23번 — 변이 하네스 자신의 거짓말 방지):
     9	#   · 대상 파일에 미커밋 변경이 있으면 **거부**한다 (복원이 작업물을 지운다)
    10	#   · 치환 앵커는 **정확히 1회** 매치해야 진행한다 — 빗나가면 빈 변이(거짓 초록)가 된다
    11	#   · 복원 직후 git hash-object ↔ rev-parse HEAD:<경로> 를 대조한다
    12	#
    13	# 공시된 측정 공백:
    14	#   · 3.4 exit 0 경로의 decision_note 방출 제거 — 현행 발동 규칙에서 도달 불가라
    15	#     **원리적으로 초록**이다 (테스트 파일 헤더 공시와 짝. ADR-0012 "모르는 rc" 공백과 같은 부류)
    16	
    17	set -uo pipefail
    18	cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
    19	
    20	VSTOP="template/.claude/hooks/verify-before-stop.sh"
    21	MARK="template/.claude/hooks/mark-needs-audit.sh"
    22	COMMON="template/.claude/hooks/_common.sh"
    23	TEST="./tests/retrieval-attestation.test.sh"
    24	
    25	for f in "$VSTOP" "$MARK" "$COMMON"; do
    26	  if ! git diff --quiet -- "$f" || ! git diff --cached --quiet -- "$f"; then
    27	    echo "✗ 대상에 미커밋 변경이 있습니다: $f — 먼저 커밋하고 재세요 (복원이 작업물을 지웁니다)" >&2
    28	    exit 1
    29	  fi
    30	done
    31	
    32	# 락 — 형제 변이 하네스(decision-gate·harness-env)와 같은 관례. 겹쳐 돌리면 주입된
    33	# 변이가 서로의 복원을 밟고, **측정 중인 트리를 배포하는 사고**(실제로 겪음)의 탐지
    34	# 근거이기도 하다 — install/sync 의 배포 가드가 이 락의 존재로 "측정 중"을 판정한다.
    35	LOCK="$(git rev-parse --git-dir)/mutate-retrieval-gate.lock"
    36	if ! mkdir "$LOCK" 2>/dev/null; then
    37	  echo "✗ 이미 다른 변이 측정이 돌고 있습니다: $LOCK" >&2
    38	  echo "  (그 프로세스가 죽었다면: rmdir '$LOCK')" >&2
    39	  exit 1
    40	fi
    41	trap 'rmdir "$LOCK" 2>/dev/null' EXIT
    42	
    43	# **기준선 확인이 먼저다.** 변이 전 테스트가 이미 빨간 상태면 모든 변이가 "적색"으로
    44	# 집계돼 하네스가 성공을 위장한다 — 적색의 원인이 방어인지 무관한 회귀인지 구별이 안 된다
    45	# (구현 검수 [cx] 지적).
    46	if ! "$TEST" >/dev/null 2>&1; then
    47	  echo "✗ 기준선 실패 — 변이 없이도 테스트가 빨갛습니다. 먼저 초록으로 만들고 재세요" >&2
    48	  exit 1
    49	fi
    50	
    51	total=0; red=0; green=0
    52	
    53	restore() {   # $1 = 파일
    54	  git restore --source=HEAD --worktree -- "$1" || { echo "✗ 복원 실패: $1" >&2; exit 1; }
    55	  local w h
    56	  w="$(git hash-object "$1")"; h="$(git rev-parse "HEAD:$1")"
    57	  [ "$w" = "$h" ] || { echo "✗ 복원 검증 실패: $1 ($w != $h)" >&2; exit 1; }
    58	}
    59	
    60	# mutate <이름> <파일> <앵커(문자열)> <대체(문자열)>
    61	# 앵커가 정확히 1회 매치하지 않으면 그 항목을 실패로 세운다(fail-closed).
    62	mutate() {
    63	  local name="$1" file="$2" anchor="$3" repl="$4" n
    64	  total=$((total + 1))
    65	  n="$(python3 - "$file" "$anchor" <<'PY'
    66	import sys
    67	src = open(sys.argv[1], encoding='utf-8').read()
    68	print(src.count(sys.argv[2]))
    69	PY
    70	)"
    71	  if [ "$n" != "1" ]; then
    72	    echo "  ✗ [$name] 앵커 매치 ${n}회 (기대 1) — 빈 변이 방지로 실패 처리" >&2
    73	    return 1
    74	  fi
    75	  python3 - "$file" "$anchor" "$repl" <<'PY'
    76	import sys
    77	p, a, r = sys.argv[1], sys.argv[2], sys.argv[3]
    78	src = open(p, encoding='utf-8').read()
    79	open(p, 'w', encoding='utf-8').write(src.replace(a, r, 1))
    80	PY
    81	  if "$TEST" >/dev/null 2>&1; then
    82	    green=$((green + 1))
    83	    echo "  🟢 [$name] 살아남음 — 이 방어를 지키는 케이스가 없다"
    84	  else
    85	    red=$((red + 1))
    86	    echo "  🔴 [$name] 적색 (방어 확인)"
    87	  fi
    88	  restore "$file"
    89	}
    90	
    91	echo "머리 표명 게이트 변이 측정"
    92	
    93	# 1. 첫 줄 검사를 느슨하게: 접두어 매치를 무엇이든 통과로
    94	mutate 'm01 첫 줄 패턴을 항상 매치로' "$VSTOP" \
    95	  '      "사전 결정 회수:"*)' \
    96	  '      *)'
    97	
    98	# 2. 자동 해제 제거
    99	mutate 'm02 자동 해제 제거' "$VSTOP" \
   100	  '    rm -f "$RETRIEVAL_FLAG" 2>/dev/null' \
   101	  '    :'
   102	
   103	# 3. 해제 후 재평가 제거 (허위 감사 차단 재현)
   104	mutate 'm03 재평가 exit 0 제거' "$VSTOP" \
   105	  '    if ! work_pending; then
   106	      # 이 턴의 할 일이 이것뿐이었다' \
   107	  '    if false; then
   108	      # 이 턴의 할 일이 이것뿐이었다'
   109	
   110	# 4. 재평가식(work_pending)에서 push 항 제거
   111	mutate 'm04 work_pending 에서 push 제거' "$VSTOP" \
   112	  '  [ -n "$push_unsent" ] && return 0' \
   113	  '  :'
   114	
   115	# 5. 패턴 접두어를 `사전` 으로 느슨화
   165	    '    :'
   166	
   167	# 15. 게이트를 듀얼리뷰(3.5) 뒤로 옮기기 — 지우는 변이가 아니라 **옮기는 변이**다.
   168	#     (지우면 "게이트 없음"을 재는 것이지 "순서가 틀림"을 재는 것이 아니다 — ADR-0012 규약)
   169	total=$((total + 1))
   170	if python3 - "$VSTOP" <<'PY'
   171	import sys
   172	p = sys.argv[1]
   173	src = open(p, encoding='utf-8').read()
   174	# 앵커 정확히 1회 계약 — mutate() 와 동일. index() 는 첫 발생만 잡아 중복 앵커에서
   175	# 엉뚱한 블록을 옮기고도 "순서 방어 확인"으로 집계될 수 있다(구현 검수 [cx] 지적).
   176	for a in ('# (3.4) **머리 표명 게이트**', '# (3.5) 듀얼 리뷰(codex) 게이트',
   177	          '# (4) change-explainer 게이트'):
   178	    if src.count(a) != 1:
   179	        raise SystemExit(1)
   180	start = src.index('# (3.4) **머리 표명 게이트**')
   181	end = src.index('# (3.5) 듀얼 리뷰(codex) 게이트')
   182	block = src[start:end]
   183	rest = src[:start] + src[end:]
   184	anchor = "# (4) change-explainer 게이트"
   185	i = rest.index(anchor)
   186	open(p, 'w', encoding='utf-8').write(rest[:i] + block + rest[i:])
   187	PY
   188	then
   189	  if "$TEST" >/dev/null 2>&1; then
   190	    green=$((green + 1)); echo "  🟢 [m15 게이트를 3.5 뒤로 이동] 살아남음"
   191	  else
   192	    red=$((red + 1)); echo "  🔴 [m15 게이트를 3.5 뒤로 이동] 적색 (순서 계약 확인)"
   193	  fi
   194	  restore "$VSTOP"
   195	else
   196	  echo "  ✗ [m15] 블록 이동 실패 — 실패 처리" >&2
   197	fi
   198	
   199	# 16. retrieval_pending 에서 hook_disabled 접기 제거 (게이트 끈 환경의 갇힘 재현)
   200	mutate 'm16 retrieval_pending 의 비활성 접기 제거' "$COMMON" \
   201	  '  ! hook_disabled "stop:retrieval"' \
   202	  '  true'
   203	
   204	# 17. 자동 해제 후 지문 재계산 제거 (stale 지문 → 하위 게이트 카운터 거짓 리셋 재현)
   205	mutate 'm17 해제 후 compute_flags_fp 재호출 제거' "$VSTOP" \
   300	# 32. 변형 뒤 공백 불허 — `조사함 (x)` 가 불량이 된다 (r43 방어)
   301	mutate 'm32 변형 뒤 공백 불허' "$VSTOP" \
   302	  '              *'"'"' '"'"')  ref_head="${ref_head% }" ;;' \
   303	  '              *'"'"' '"'"')  break ;;'
   304	
   305	# 33. SP 에서 탭 제거 — 접두어 뒤 탭이 불량이 된다 (r47 방어)
   306	mutate 'm33 SP 탭 제거' "$VSTOP" \
   307	  "              '	'*)  ref_body=\"\${ref_body#	}\" ;;" \
   308	  "              '	'*)  break ;;"
   309	
   310	# 34. 닫는 괄호 뒤 공백 불허 (r49 방어)
   311	mutate 'm34 괄호 뒤 공백 불허' "$VSTOP" \
   312	  '              *'"'"' '"'"')  ref_body="${ref_body% }" ;;' \
   313	  '              *'"'"' '"'"')  break ;;'
   314	
   315	# 36. 변형 뒤 탭 트림 제거 — `조사함<TAB>(x)` 가 불량이 된다 (r47 자리 2 방어)
   316	mutate 'm36 변형 뒤 탭 트림 제거' "$VSTOP" \
   317	  "              *'	')  ref_head=\"\${ref_head%	}\" ;;" \
   318	  "              *'	')  break ;;"
   319	
   320	# 37. 닫는 괄호 뒤 탭 트림 제거 — `조사함(x)<TAB>` 가 불량이 된다 (r47 자리 3 방어)
   321	mutate 'm37 괄호 뒤 탭 트림 제거' "$VSTOP" \
   322	  "              *'	')  ref_body=\"\${ref_body%	}\" ;;" \
   323	  "              *'	')  break ;;"
   324	
   325	# 35. 첫 줄 "빈 줄" 분기 제거 — r50(격리 픽스처)·r04(사유 단언)가 잡는다
   326	mutate 'm35 첫 줄 빈 줄 분기 제거' "$VSTOP" \
   327	  '      "")
   328	        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
   329	"
   330	        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일이 비었거나 첫 줄이 빈 줄
   331	"
   332	        ;;' \
   333	  '      "")
   334	        ;;'
   335	
   336	echo
   337	echo "총 $total 건 — 적색 $red · 초록 $green"
   338	[ "$green" -eq 0 ] && [ "$red" -eq "$total" ]
