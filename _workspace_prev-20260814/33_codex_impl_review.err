   433	r17() { # retrieval 플래그는 decision_armed 에 **들어가지 않는다** — 소실 항목만 남은
   434	        # stale 플래그 + 결정 표지 발화에서 결정 게이트가 오발동하면 3.4 의 해제 기회가
   435	        # 오지 않는다(설계 검수 [cc] r2 H). 기대: 결정 침묵 + 해제 + exit 0.
   436	  local name='r17 stale 플래그가 결정 게이트를 무장시키지 않는다' why=''
   437	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   438	  set_flag "$p" retrieval '_workspace/00_design.md'   # 파일 없음 = stale
   439	  mk_tx "$p/tx.jsonl" marker
   440	  run_stop "$p" "$p/tx.jsonl"
   440	  run_stop "$p" "$p/tx.jsonl"
   441	  if contains "$ERR" "$TOK_DECISION"; then why='결정 게이트가 오발동했다'
   442	  elif [ "$RC" -ne 0 ];               then why="rc=$RC (기대 0): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   443	  elif ! flag_gone "$p";              then why='stale 플래그가 해제되지 않았다'
   444	  fi
   445	  report "$name" "$why"
   446	}
   447	
   448	r18() { # 정상 표명 + 다른 할 일 전무 → exit 0. 재평가가 없으면 맨 아래 감사 게이트가
   449	        # 빈 목록으로 허위 차단한다(설계 검수 [cx] r2).
   450	  local name='r18 정상 + 할 일 전무 → exit 0 (허위 감사 차단 없음)' why=''
   451	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   452	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   453	  set_flag "$p" retrieval '_workspace/00_design.md'
   454	  mk_tx "$p/tx.jsonl" neutral
   455	  run_stop "$p" "$p/tx.jsonl"
   456	  if [ "$RC" -ne 0 ];       then why="rc=$RC (기대 0): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   457	  elif ! flag_gone "$p";    then why='플래그 미해제'
   458	  elif contains "$ERR" '완료 차단'; then why='어떤 게이트가 차단했다'
   459	  fi
   460	  report "$name" "$why"
   461	}
   462	
   463	r19() { # arming 은 수기 플래그가 아니라 **mark-needs-audit 실제 실행**으로도 잰다 —
   464	        # 기록 제거 변이가 수기 픽스처에 가려지지 않게. Stop 까지 이어 돌려 차단 확인.
   465	  local name='r19 mark-needs-audit 실행 → 회수 플래그 → 차단' why=''
   466	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   467	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   468	  printf '{"tool_input":{"file_path":"%s"}}' "$p/_workspace/00_design.md" | \
   469	    CLAUDE_PROJECT_DIR="$p" bash "$p/.claude/hooks/mark-needs-audit.sh" >/dev/null 2>&1
   470	  if [ ! -s "$p/.claude/.needs-retrieval" ]; then
   471	    why='mark-needs-audit 가 회수 플래그를 기록하지 않았다'
   472	  else
   473	    set_flag "$p" audit 'src/x.ts'   # 감사 도달 확인용
   474	    mk_tx "$p/tx.jsonl" neutral
   475	    run_stop "$p" "$p/tx.jsonl"
   476	    contains "$ERR" "$TOK_RET" || why='기록된 플래그로 차단되지 않았다'
   477	  fi
   478	  report "$name" "$why"
   479	}
   480	
   481	r20() { # 이름·경로에 codex 가 들어도 산출물이면 검사 대상이다 — mark-needs-audit 쪽
   482	        # 계약(케이스 74·75)의 Stop 쪽 절반: 그 플래그로 실제 차단까지 간다.
   483	  local name='r20 codex 이름 산출물도 검사된다' why=''
   484	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   485	  mk_doc "$p/_workspace/00_design-codex-gate.md" '표명 없음.'
   486	  set_flag "$p" retrieval '_workspace/00_design-codex-gate.md'
   487	  set_flag "$p" audit 'src/x.ts'
   488	  mk_tx "$p/tx.jsonl" neutral
   489	  run_stop "$p" "$p/tx.jsonl"
   490	  contains "$ERR" "$TOK_RET" || why='codex 이름이라는 이유로 검사에서 빠졌다'
   491	  report "$name" "$why"
   492	}
   493	
   494	r21() { # 표명 리터럴 드리프트 — 같은 문자열이 세 정본 자리에 있어야 한다.
   495	        # 대상 목록은 상수다(파생하면 파일이 빠져도 초록이 된다).
   496	  local name='r21 표명 문자열이 훅·스킬·프로필에서 동일' why=''
   497	  local lit='사전 결정 회수:' f
   498	  for f in \
   499	    "$HOOKS/verify-before-stop.sh" \
   500	    "$REPO_ROOT/template/.claude/skills/harness-orchestrator/SKILL.md" \
   501	    "$REPO_ROOT/template/.claude/harness/project-profile.template.md"; do
   502	    grep -qF "$lit" "$f" || { why="리터럴이 없다: $f"; break; }
   503	  done
   504	  report "$name" "$why"
   505	}
   506	
   507	r22() { # 정상 해제 + push 미완 → push 게이트가 막는다. 재평가식이 플래그만 세면
   508	        # 자동 해제가 push 를 삼킨다(설계 검수 [cc·cx] r2 B — 커밋 29개를 잃은 상태의 재개방).
   509	  local name='r22 정상 해제 + push 미완 → push 차단' why=''
   510	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   511	  ( cd "$p" && git init -q . && git checkout -q -b main 2>/dev/null; \
   512	    git -C "$p" config user.email t@t && git -C "$p" config user.name t \
   513	    && git -C "$p" add -A >/dev/null 2>&1 && git -C "$p" commit -qm base \
   514	    && git -C "$p" remote add origin "$p" \
   515	    && git -C "$p" update-ref refs/remotes/origin/main HEAD \
   516	    && printf 'x\n' > "$p/x.txt" && git -C "$p" add x.txt && git -C "$p" commit -qm ahead ) >/dev/null 2>&1 \
   517	    || { report "$name" '픽스처 실패: git'; return 0; }
   518	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   519	  set_flag "$p" retrieval '_workspace/00_design.md'
   520	  mk_tx "$p/tx.jsonl" neutral
   521	  run_stop "$p" "$p/tx.jsonl"
   522	  if ! contains "$ERR" "$TOK_PUSH"; then why="push 게이트 미도달 (rc=$RC): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   523	  elif ! flag_gone "$p";            then why='회수 플래그는 해제됐어야 한다'
   524	  fi
   525	  report "$name" "$why"
   526	}
   527	
   528	r23() { # 정상 해제 + 지식 게이트 켜짐 → 지식 게이트로 계속 흘러간다 (재평가가 과하게
   529	        # exit 0 하지 않는다). 켜진 지식 게이트가 work_pending 을 참으로 유지한다.
   530	  local name='r23 정상 해제 + 지식 플래그 → 지식 게이트 도달' why=''
   531	  local p; p="$(new_project on)" || { report "$name" '픽스처 실패'; return 0; }
   532	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   533	  set_flag "$p" retrieval '_workspace/00_design.md'
   534	  set_flag "$p" knowledge '_workspace/00_design.md'
   535	  mk_tx "$p/tx.jsonl" neutral
   536	  run_stop "$p" "$p/tx.jsonl"
   537	  if contains "$ERR" "$TOK_RET";      then why='위양성 — 회수 게이트가 막았다'
   538	  elif ! contains "$ERR" "$TOK_KNOW"; then why="지식 게이트 미도달 (rc=$RC): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   539	  elif ! flag_gone "$p";              then why='회수 플래그 미해제'
   540	  fi
   541	  report "$name" "$why"
   542	}
   543	
   544	r24() { # 회수 불량 목록은 **다른 게이트의 예산을 건드리지 않는다.** 결정 게이트에 갇힌 채
   545	        # 불량 집합만 바뀌어도 결정 게이트의 카운터는 이어져야 한다(공유 지문 불변식 —
   546	        # 목록을 flags_fp 로 전파하는 변이가 여기서 빨개진다).
   547	  local name='r24 불량 집합 변화가 결정 게이트 예산을 리셋하지 않는다' why=''
   548	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   549	  mk_doc "$p/_workspace/00_design.md" '표명 없음 A.'
   550	  set_flag "$p" retrieval '_workspace/00_design.md'
   551	  set_flag "$p" audit 'src/x.ts'
   552	  mk_tx "$p/tx.jsonl" marker      # 결정 게이트(3.2)가 3.4 보다 먼저 막는다
   553	  run_stop "$p" "$p/tx.jsonl"
   554	  if ! contains "$ERR" "$TOK_DECISION"; then why="결정 게이트가 먼저 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   555	  elif ! contains "$ERR" '차단 1/';     then why='1회차가 1/N 이 아니다'
   556	  else
   557	    mk_doc "$p/_workspace/01_plan.md" '표명 없음 B.'   # 불량 집합만 바꾼다
   558	    printf '_workspace/01_plan.md\n' >> "$p/.claude/.needs-retrieval"
   559	    run_stop "$p" "$p/tx.jsonl"
   560	    if ! contains "$ERR" "$TOK_DECISION"; then why='2회차에 결정 게이트가 안 막았다'
   561	    elif ! contains "$ERR" '차단 2/';     then why="결정 게이트 카운터가 리셋됐다 (집합 변화가 전파됨): $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   562	    fi
   563	  fi
   564	  report "$name" "$why"
   565	}
   566	
   567	r25() { # 첫 줄의 BOM·CR 은 걷어낸 뒤 판정한다 — 눈에 안 보이는 바이트가 정상 표명을
   568	        # 불량으로 뒤집으면 안 된다(harness_env_value 가 데인 같은 부류).
   569	  local name='r25 BOM·CRLF 첫 줄 → 정상 판정' why=''
   570	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   571	  printf '\357\273\277사전 결정 회수: docs/decisions/\r\n%s\n본문.\n' "$GOOD_SECOND" > "$p/_workspace/00_design.md"
   572	  set_flag "$p" retrieval '_workspace/00_design.md'
   573	  set_flag "$p" audit 'src/x.ts'
   574	  mk_tx "$p/tx.jsonl" neutral
   575	  run_stop "$p" "$p/tx.jsonl"
   576	  if contains "$ERR" "$TOK_RET";       then why='BOM/CR 때문에 정상 표명이 차단됐다'
   577	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   578	  elif ! flag_gone "$p";               then why='플래그 미해제'
   579	  fi
   580	  report "$name" "$why"
   581	}
   582	
   583	r26() { # 플래그 마지막 줄이 **개행 없이** 끝나도 그 항목은 검사된다. read 는 마지막
   584	        # 불완전 줄에서 값을 담고도 rc=1 을 내 `|| [ -n "$entry" ]` 가 없으면 본문이
   585	        # 안 돌고 — 표명 없는 산출물이 조용히 통과한다(구현 검수 [cx] HIGH).
   586	  local name='r26 개행 없는 마지막 플래그 줄도 검사된다' why=''
   587	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   588	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   589	  printf '_workspace/00_design.md' > "$p/.claude/.needs-retrieval"   # 개행 없음
   590	  set_flag "$p" audit 'src/x.ts'
   591	  mk_tx "$p/tx.jsonl" neutral
   592	  run_stop "$p" "$p/tx.jsonl"
   593	  if ! contains "$ERR" "$TOK_RET"; then why="차단하지 않았다 (마지막 줄이 스킵됨): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   594	  fi
   595	  report "$name" "$why"
   596	}
   597	
   598	r27() { # 자동 해제 뒤 공유 지문을 **다시 계산**한다. 진입 시 스냅숏을 그대로 쓰면 이
   599	        # 턴의 하위 게이트(예: 듀얼리뷰)가 이미 지워진 "r" 비트가 든 지문으로 예산을
   600	        # 매기고, 다음 턴 지문과 달라져 진전이 아닌데 카운터가 리셋된다 — 벽돌 방지가
   601	        # 한 사이클 헛돈다(구현 검수 [cc] HIGH, 1/3→1/3→2/3→3/3 실측 재현).
   602	  local name='r27 자동 해제 후 지문 재계산 (하위 게이트 카운터 연속)' why=''
   603	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   604	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   605	  set_flag "$p" retrieval '_workspace/00_design.md'
   606	  set_flag "$p" dualreview '_workspace/00_design.md'
   607	  mk_tx "$p/tx.jsonl" neutral
   608	  run_stop "$p" "$p/tx.jsonl"     # 1회차: 해제 + 듀얼리뷰 차단 (지문은 해제 후 상태여야 한다)
   609	  if ! contains "$ERR" "$TOK_DUAL"; then why="듀얼리뷰 게이트 미도달: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   610	  elif ! contains "$ERR" '차단 1/';  then why='1회차가 1/N 이 아니다'
   611	  else
   612	    run_stop "$p" "$p/tx.jsonl"   # 2회차: 같은 상태 — 카운터가 이어져야 한다
   613	    if ! contains "$ERR" "$TOK_DUAL"; then why='2회차에 듀얼리뷰 게이트 미도달'
   614	    elif ! contains "$ERR" '차단 2/';  then why="stale 지문으로 카운터가 리셋됐다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   615	    fi
   616	  fi
   617	  report "$name" "$why"
   618	}
   619	
   620	# --- 케이스 (r28~ — 둘째 줄 레퍼런스 표명, ADR-0015) ----------------------
     1	#!/usr/bin/env bash
     2	# mutate-retrieval-gate.sh — 머리 표명 게이트(stop:retrieval, ADR-0013 회수 1줄 +
     3	# ADR-0015 레퍼런스 조사 2줄) 방어의 **변이 측정**.
     4	#
     5	# 방어를 하나씩 지우거나 뒤집고, tests/retrieval-attestation.test.sh 가 빨개지는지 잰다.
     6	# 케이스 수·통과 수는 아무것도 증명하지 않는다 — 변이가 유일하게 믿을 만한 지표다.
     7	#
     8	# 계약 (위음성 카탈로그 23번 — 변이 하네스 자신의 거짓말 방지):
     9	#   · 대상 파일에 미커밋 변경이 있으면 **거부**한다 (복원이 작업물을 지운다)
    10	#   · 치환 앵커는 **정확히 1회** 매치해야 진행한다 — 빗나가면 빈 변이(거짓 초록)가 된다
    11	#   · 복원 직후 git hash-object ↔ rev-parse HEAD:<경로> 를 대조한다
    12	#
    13	# 공시된 측정 공백:
    14	#   · 3.4 exit 0 경로의 decision_note 방출 제거 — 현행 발동 규칙에서 도달 불가라
    15	#     **원리적으로 초록**이다 (테스트 파일 헤더 공시와 짝. ADR-0012 "모르는 rc" 공백과 같은 부류)
    16	
    17	set -uo pipefail
    18	cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
    19	
    20	VSTOP="template/.claude/hooks/verify-before-stop.sh"
    21	MARK="template/.claude/hooks/mark-needs-audit.sh"
    22	COMMON="template/.claude/hooks/_common.sh"
    23	TEST="./tests/retrieval-attestation.test.sh"
    24	
    25	for f in "$VSTOP" "$MARK" "$COMMON"; do
    26	  if ! git diff --quiet -- "$f" || ! git diff --cached --quiet -- "$f"; then
    27	    echo "✗ 대상에 미커밋 변경이 있습니다: $f — 먼저 커밋하고 재세요 (복원이 작업물을 지웁니다)" >&2
    28	    exit 1
    29	  fi
    30	done
    31	
    32	# 락 — 형제 변이 하네스(decision-gate·harness-env)와 같은 관례. 겹쳐 돌리면 주입된
    33	# 변이가 서로의 복원을 밟고, **측정 중인 트리를 배포하는 사고**(실제로 겪음)의 탐지
    34	# 근거이기도 하다 — install/sync 의 배포 가드가 이 락의 존재로 "측정 중"을 판정한다.
    35	LOCK="$(git rev-parse --git-dir)/mutate-retrieval-gate.lock"
    36	if ! mkdir "$LOCK" 2>/dev/null; then
    37	  echo "✗ 이미 다른 변이 측정이 돌고 있습니다: $LOCK" >&2
    38	  echo "  (그 프로세스가 죽었다면: rmdir '$LOCK')" >&2
    39	  exit 1
    40	fi
    41	trap 'rmdir "$LOCK" 2>/dev/null' EXIT
    42	
    43	# **기준선 확인이 먼저다.** 변이 전 테스트가 이미 빨간 상태면 모든 변이가 "적색"으로
    44	# 집계돼 하네스가 성공을 위장한다 — 적색의 원인이 방어인지 무관한 회귀인지 구별이 안 된다
    45	# (구현 검수 [cx] 지적).
    46	if ! "$TEST" >/dev/null 2>&1; then
    47	  echo "✗ 기준선 실패 — 변이 없이도 테스트가 빨갛습니다. 먼저 초록으로 만들고 재세요" >&2
    48	  exit 1
    49	fi
    50	
    51	total=0; red=0; green=0
    52	
    53	restore() {   # $1 = 파일
    54	  git restore --source=HEAD --worktree -- "$1" || { echo "✗ 복원 실패: $1" >&2; exit 1; }
    55	  local w h
    56	  w="$(git hash-object "$1")"; h="$(git rev-parse "HEAD:$1")"
    57	  [ "$w" = "$h" ] || { echo "✗ 복원 검증 실패: $1 ($w != $h)" >&2; exit 1; }
    58	}
    59	
    60	# mutate <이름> <파일> <앵커(문자열)> <대체(문자열)>
    61	# 앵커가 정확히 1회 매치하지 않으면 그 항목을 실패로 세운다(fail-closed).
    62	mutate() {
    63	  local name="$1" file="$2" anchor="$3" repl="$4" n
    64	  total=$((total + 1))
    65	  n="$(python3 - "$file" "$anchor" <<'PY'
    66	import sys
    67	src = open(sys.argv[1], encoding='utf-8').read()
    68	print(src.count(sys.argv[2]))
    69	PY
    70	)"
    71	  if [ "$n" != "1" ]; then
    72	    echo "  ✗ [$name] 앵커 매치 ${n}회 (기대 1) — 빈 변이 방지로 실패 처리" >&2
    73	    return 1
    74	  fi
    75	  python3 - "$file" "$anchor" "$repl" <<'PY'
    76	import sys
    77	p, a, r = sys.argv[1], sys.argv[2], sys.argv[3]
    78	src = open(p, encoding='utf-8').read()
    79	open(p, 'w', encoding='utf-8').write(src.replace(a, r, 1))
    80	PY
    81	  if "$TEST" >/dev/null 2>&1; then
    82	    green=$((green + 1))
    83	    echo "  🟢 [$name] 살아남음 — 이 방어를 지키는 케이스가 없다"
    84	  else
    85	    red=$((red + 1))
    86	    echo "  🔴 [$name] 적색 (방어 확인)"
    87	  fi
    88	  restore "$file"
    89	}
    90	
    91	echo "머리 표명 게이트 변이 측정"
    92	
    93	# 1. 첫 줄 검사를 느슨하게: 접두어 매치를 무엇이든 통과로
    94	mutate 'm01 첫 줄 패턴을 항상 매치로' "$VSTOP" \
    95	  '      "사전 결정 회수:"*)' \
    96	  '      *)'
    97	
    98	# 2. 자동 해제 제거
    99	mutate 'm02 자동 해제 제거' "$VSTOP" \
   100	  '    rm -f "$RETRIEVAL_FLAG" 2>/dev/null' \
   101	  '    :'
   102	
   103	# 3. 해제 후 재평가 제거 (허위 감사 차단 재현)
   104	mutate 'm03 재평가 exit 0 제거' "$VSTOP" \
   105	  '    if ! work_pending; then
   106	      # 이 턴의 할 일이 이것뿐이었다' \
   107	  '    if false; then
   108	      # 이 턴의 할 일이 이것뿐이었다'
   109	
   110	# 4. 재평가식(work_pending)에서 push 항 제거
   111	mutate 'm04 work_pending 에서 push 제거' "$VSTOP" \
   112	  '  [ -n "$push_unsent" ] && return 0' \
   113	  '  :'
   114	
   115	# 5. 패턴 접두어를 `사전` 으로 느슨화
   116	mutate 'm05 패턴을 사전 만으로 느슨화' "$VSTOP" \
   117	  '      "사전 결정 회수:"*)' \
   118	  '      "사전"*)'
   119	
   120	# 6. mark-needs-audit 의 회수 기록 제거
   121	mutate 'm06 회수 플래그 기록 제거' "$MARK" \
   122	  '    record_flag "$RETRIEVAL_FLAG"  "$dual_value" || dw=1' \
   123	  '    :'
   124	
   125	# 7. 조기 종료·재평가 술어에서 retrieval 제거
   126	mutate 'm07 work_pending 에서 retrieval 제거' "$VSTOP" \
   127	  '  retrieval_pending && return 0' \
   128	  '  :'
   129	
