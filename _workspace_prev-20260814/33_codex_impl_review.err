   598	r27() { # 자동 해제 뒤 공유 지문을 **다시 계산**한다. 진입 시 스냅숏을 그대로 쓰면 이
   599	        # 턴의 하위 게이트(예: 듀얼리뷰)가 이미 지워진 "r" 비트가 든 지문으로 예산을
   600	        # 매기고, 다음 턴 지문과 달라져 진전이 아닌데 카운터가 리셋된다 — 벽돌 방지가
   601	        # 한 사이클 헛돈다(구현 검수 [cc] HIGH, 1/3→1/3→2/3→3/3 실측 재현).
   602	  local name='r27 자동 해제 후 지문 재계산 (하위 게이트 카운터 연속)' why=''
   603	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   604	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
