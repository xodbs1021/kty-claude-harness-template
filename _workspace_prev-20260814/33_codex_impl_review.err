    64	# 커밋 29개를 잃은 그 상태가 새 게이트로 다시 열리는 경로였다.
    65	# 지식·회수 플래그는 **게이트가 살아 있을 때만** 할 일로 센다 — 껐는데 예전에 남은
    66	# 플래그 파일이 읽기 전용 턴의 조기 종료를 막으면 안 된다.
    67	work_pending() {
    68	  [ -n "$push_unsent" ] && return 0
    69	  [ -s "$AUDIT_FLAG" ] && return 0
    70	  [ -s "$EXPLAIN_FLAG" ] && return 0
    71	  knowledge_gate_active && return 0
    72	  [ -s "$DUALREVIEW_FLAG" ] && return 0
    73	  retrieval_pending && return 0
    74	  return 1
    75	}
    76	
    77	# (1) 코드 변경이 없는 턴 → 검사 전부 생략. 읽기 전용 질문에 타입체크를 돌리지 않는다.
    78	if ! work_pending; then
    79	  rm -f "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
    80	  exit 0
    81	fi
    82	
    83	# (2) 카운터 확인 — 벽돌 방지, 진전 인지 리셋 (2026-08-03 [cx] 지적 반영)
    84	# 카운터의 목적은 "갇힘 감지"이지 노력 예산이 아니다. 게이트가 4종으로 늘며 공유 카운터
    85	# 3회로는 게이트를 순서대로 성실히 처리해도 마지막 감사 게이트 전에 소진되는 역설이 있었다.
    86	# → 차단 지문(어느 게이트에서, 어떤 플래그 상태로 막혔나)이 지난 차단과 다르면 = 진전이면
    87	#   카운터를 리셋한다. 같은 지문으로 MAX_BLOCKS회 = 진짜 갇힘일 때만 경고와 통과.
    88	count=0
    89	if [ -f "$BLOCK_COUNT" ]; then
    90	  count="$(tr -dc '0-9' < "$BLOCK_COUNT" 2>/dev/null)"
    91	fi
    92	[ -z "$count" ] && count=0
    93	prev_fp="$(cat "$BLOCK_FP" 2>/dev/null)"
    94	# 지문 = 서 있는 플래그의 집합(내용 아님). 내용을 넣으면 갇힌 채 새 파일만 편집해도
    95	# 리셋되고(무한 차단), cksum 충돌로 실제 진전이 리셋 안 될 수도 있다([cx] 지적).
    96	#
    97	# **함수인 이유:** 3.4 게이트가 실행 도중 자기 플래그를 지운다(자동 해제). 진입 시 1회
    98	# 스냅숏만 쓰면 그 턴의 하위 게이트(3.5~6)가 이미 지워진 "r" 비트가 든 stale 지문으로
    99	# 예산을 매기고, 다음 턴의 지문과 달라져 **진전이 아닌데 카운터가 리셋**된다 — 벽돌
   100	# 방지가 한 사이클 헛돈다(구현 검수 [cc]가 4회 연속 실행으로 재현: 1/3→1/3→2/3→3/3).
   101	compute_flags_fp() {
   102	  flags_fp=""
   103	  [ -s "$AUDIT_FLAG" ]      && flags_fp="${flags_fp}a"
   104	  [ -s "$EXPLAIN_FLAG" ]    && flags_fp="${flags_fp}e"
   105	  knowledge_gate_active     && flags_fp="${flags_fp}k"
   106	  [ -s "$DUALREVIEW_FLAG" ] && flags_fp="${flags_fp}d"
   107	  # 회수 플래그도 **존재 비트만** 넣는다. 불량 파일 목록은 retrieval 게이트 자신의 예산
   108	  # 키에만 결합한다(아래 3.4) — 여기(공유 지문)에 넣으면 결정 게이트에 갇힌 채 불량 집합만
   109	  # 바뀌어도 그쪽 예산이 리셋돼, 위 "내용을 넣으면"의 경고 그대로가 된다([cc·cx] 검수).
   110	  retrieval_pending         && flags_fp="${flags_fp}r"
   111	  # push 는 "몇 개 남았나"가 곧 진전이다. 지문에 안 넣으면 한 커밋씩 올리는 실제 진전이
   112	  # 같은 지문으로 세어져 예산이 소진되고, 그때 감사 플래그까지 함께 지워진다([cx] 지적).
   113	  [ -n "$push_unsent" ] && flags_fp="${flags_fp}p:${push_branch}:${push_unsent}"
   114	}
   115	flags_fp=""
   116	compute_flags_fp
   117	new_fp=""
   118	
   119	gate_budget() {  # $1 = 게이트 식별자. 각 차단 지점이 메시지 출력 전에 호출한다.
   120	  new_fp="$1|$flags_fp"
   121	  # 지문을 기록할 수 있을 때만 리셋한다 — 지문 파일을 못 쓰는 환경에서 리셋하면
   122	  # prev_fp가 영원히 비어 매번 1/3로 무한 차단된다([cx] 지적). 그 경우 리셋 없는
   123	  # 구식 누적으로 동작해 3회 후 통과가 보장된다.
   124	  if printf '%s\n' "$new_fp" > "$BLOCK_FP" 2>/dev/null; then
   125	    if [ "$new_fp" != "$prev_fp" ]; then
   126	      count=0   # 지난 차단과 다른 게이트/플래그 집합 = 진전 — 예산 리셋
   127	    fi
   128	  fi
   129	  if [ "$count" -ge "$MAX_BLOCKS" ]; then
   130	    changed="$(cat "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" 2>/dev/null | tr -d '"\\' | sort -u | tr '\n' ' ')"
   131	    rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
   132	    # 판독 불가 사유도 함께 싣는다. 여기서 빠뜨리면 **예산이 소진된 턴에 발생한**
   133	    # 판독 불가가 영구 소실된다 — 게이트 메시지가 이 경로로는 안 나가기 때문이다([cx] 2라운드).
   134	    printf '{"systemMessage":"[완료 게이트] 같은 지점(%s)에서 %s회 차단 후에도 진전이 없어 세션 벽돌 방지를 위해 통과시킵니다. 이 턴의 완료 주장(및 변경 설명)을 신뢰하지 마세요. 미처리 변경: %s%s"}\n' \
   135	      "$1" "$MAX_BLOCKS" "$changed" \
   136	      "${decision_note:+ / $decision_note}"
   137	    exit 0
   138	  fi
   139	}
   140	
   141	# 결정 게이트가 대화 기록을 못 읽었으면 **어느 게이트가 막든** 그 사유를 함께 낸다.
   142	# 감사 게이트에만 실으면, 앞 게이트가 먼저 막은 턴에는 안 보이고 그 플래그를 지운 다음
   143	# 턴에는 조기 종료로 **영영 사라진다**(검수 [cx] 지적). 조용히 사라지는 것이 이 게이트를
   144	# 만든 이유 그 자체라, 경고를 삼키지 않는 것이 fail-open 의 조건이다.
   145	emit_decision_note() {
   146	  [ -n "${decision_note:-}" ] || return 0
   147	  echo
   148	  echo "참고: $decision_note"
   149	  echo "      → 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."
   150	}
   151	
   152	bump_and_block() {
   153	  if ! printf '%s\n' "$((count + 1))" > "$BLOCK_COUNT" 2>/dev/null; then
   154	    # 카운터를 못 쓰면 무한루프 위험 → 표준 가드로 폴백
   155	    case "$stop_active" in
   156	      [Tt]rue) exit 0 ;;
   157	    esac
   158	  fi
   159	  exit 2
   160	}
   161	
   162	# (3) 타입체크 — 결정론적 바닥. 명령은 프로필에서 파생된 harness.env 에서 읽는다.
   163	#     HARNESS_TYPECHECK_CMD 가 비어 있으면(타입 없는 언어/미설정) 생략한다.
   164	#     이렇게 하면 이 훅이 특정 스택(pnpm/tsc)에 묶이지 않는다 — 도메인-무관 재사용.
   165	#     **이 파일을 실행하지 않는다.** source 하면 사용자 소유 셸 파일이 훅의 제어 흐름을
   166	#     가져간다 — `exit 0` 한 줄이면 이 훅이 조용히 끝나 **게이트 4종이 통째로 사라지고**
   167	#     흔적도 안 남는다. 원문 판독으로 그 부류를 없앤다(harness_env_value 주석 참조).
   168	typecheck_note=""
   169	#     rc 를 함께 받는다. "리터럴로 비웠다"(rc=0 + 빈 값 = 의도한 생략)와 "값을 믿을 수
   170	#     없다"(rc=1 = 미설정·선언 2개 이상·지원 문법 밖·읽기 실패)는 둘 다 생략으로 가지만
   171	#     사용자에게 **다른 정보**다. 후자는 고칠 수 있는 실수라 그렇게 적어야 한다.
   172	TYPECHECK_CMD="$(harness_env_value HARNESS_TYPECHECK_CMD)"; typecheck_rc=$?
   173	
   174	if [ "$typecheck_rc" -ne 0 ]; then
   175	  typecheck_note="타입체크 생략 (harness.env 의 HARNESS_TYPECHECK_CMD 를 읽지 못함 — 미설정이거나, 선언이 2개 이상이거나, 지원 문법 밖입니다)"
   176	elif [ -z "$TYPECHECK_CMD" ]; then
   177	  typecheck_note="타입체크 생략 (HARNESS_TYPECHECK_CMD 가 빈 값으로 설정됨)"
   178	else
   179	  timeout_bin=""
   180	  if command -v timeout >/dev/null 2>&1; then
   181	    timeout_bin="timeout"
   182	  elif command -v gtimeout >/dev/null 2>&1; then
   183	    timeout_bin="gtimeout"
   184	  fi
   185	  # macOS 기본에는 timeout 이 없다. 그 경우 settings.json 의 "timeout": 120 이 최종 안전망.
   186	
   187	  if [ -n "$timeout_bin" ]; then
   188	    tc_out="$(cd "$PROJECT_DIR" && "$timeout_bin" 90 sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   189	  else
   190	    tc_out="$(cd "$PROJECT_DIR" && sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   191	  fi
   192	
   193	  if [ "$tc_rc" -eq 124 ] || [ "$tc_rc" -eq 137 ]; then
   194	    # 타임아웃은 "타입 오류"가 아니라 "모름". 차단하지 않고 감사자에게 넘긴다.
   195	    typecheck_note="타입체크 타임아웃 → 생략 (감사자가 재확인할 것)"
   196	  elif [ "$tc_rc" -eq 127 ]; then
   197	    # 명령/도구 없음(rc=127)은 "타입 오류"가 아니다. 오탐 차단 방지 위해 생략.
   198	    typecheck_note="타입체크 생략 (명령 실행 불가 rc=127): $TYPECHECK_CMD"
   199	  elif [ "$tc_rc" -ne 0 ]; then
   200	    gate_budget "typecheck"
   201	    {
   202	      echo "[완료 차단] 타입체크 실패 — 지금은 '완료'가 아닙니다."
   203	      echo
   204	      echo "명령: $TYPECHECK_CMD"
   205	      echo
   206	      printf '%s\n' "$tc_out" | head -n 15
   207	      echo
   208	      echo "고친 뒤 다시 종료하세요.  (차단 $((count + 1))/${MAX_BLOCKS})"
   209	      echo "탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=$HOOK_ID"
   210	    } >&2
   211	    bump_and_block
   212	  fi
   213	fi
   214	
   215	# (3.2) **결정 게이트** — "물어봤어야 할 것을 혼자 정했나".
   216	#      나머지 게이트가 전부 **산출물**을 볼 때 이것만 **에이전트 자신의 행동**을 본다.
   217	#      판정 규칙·좁히는 장치 셋·fail-open 사유는 _common.sh 의 decision_scan 주석이 정본이다.
   218	#
   219	#      **타입체크 다음, 나머지 게이트보다 앞에 둔다.** 질문의 답이 코드를 바꿀 수 있으므로, 리뷰·설명·감사에
   220	#      노력을 쓰기 전에 묻는 편이 싸다. (push 탐지와 달리 순서가 정확성을 바꾸지는 않는다 —
   221	#      대화 기록은 이미 다 쓰였고 게이트 순서가 그 내용을 바꾸지 않기 때문이다.)
   222	decision_note=""
   223	# **발동 조건은 플래그다.** 조기 종료는 push 미완만으로도 풀리므로, 그것만 보고 스캔하면
   224	# 아무것도 안 바꾼 읽기 전용 턴까지 검사하게 된다 — "플래그와 무관하게 항상"은 사용자가
   225	# 기각한 보기다. 여기서 한 번 더 물어 발동 계약을 조기 종료와 분리한다.
   226	decision_armed=0
   227	if [ -s "$AUDIT_FLAG" ] || [ -s "$EXPLAIN_FLAG" ] || [ -s "$DUALREVIEW_FLAG" ] || knowledge_gate_active; then
   228	  decision_armed=1
   229	fi
   230	if [ "$decision_armed" -eq 1 ] && ! hook_disabled "stop:decision"; then
   231	  decision_hits="$(decision_scan "$transcript_path")"; decision_rc=$?
   232	  case "$decision_rc" in
   233	    3) : ;;   # 표지 없음 · 또는 이 턴에 물었음
   234	    2)
   235	      # **이 게이트의 유일한 fail-open.** 통과시키되 사유를 게이트 메시지에 실어 보낸다.
   236	      # 대화 기록 형식은 하네스 소유가 아니라, 여기서 차단하면 그 세션 안에 고칠 방법이 없다.
   237	      decision_note="결정 게이트 생략 ($decision_hits)" ;;
   238	    0) ;;     # 아래에서 차단한다 (case 안에서 하면 들여쓰기가 깊어져 메시지가 안 읽힌다)
   239	    *)
   240	      # **모르는 rc 는 통과가 아니라 판독 불가다.** python3 부재(127)·처리 못 한 예외(1)·
   241	      # 신호 종료가 전부 여기로 온다. 이걸 통과로 읽으면 게이트가 조용히 사라진다.
   242	      decision_note="결정 게이트 생략 (스캐너가 예상 밖 상태로 끝남 rc=$decision_rc — python3 부재·예외·신호 종료일 수 있습니다)" ;;
   243	  esac
   244	  if [ "$decision_rc" -eq 0 ]; then
   245	    gate_budget "decision"
   246	    {
   247	      echo "[완료 차단] 혼자 정한 것이 있는데 이 턴에 사용자에게 한 번도 묻지 않았습니다."
   248	      echo
   249	      echo "걸린 문장:"
   250	      printf '%s\n' "$decision_hits" | sed 's/^/  - /'
diff --git a/_workspace/mutate-retrieval-gate.sh b/_workspace/mutate-retrieval-gate.sh
index 0906587..16f20a0 100755
--- a/_workspace/mutate-retrieval-gate.sh
+++ b/_workspace/mutate-retrieval-gate.sh
@@ -1,211 +1,322 @@
 #!/usr/bin/env bash
-# mutate-retrieval-gate.sh — 회수 표명 게이트(stop:retrieval) 방어의 **변이 측정**.
+# mutate-retrieval-gate.sh — 머리 표명 게이트(stop:retrieval, ADR-0013 회수 1줄 +
+# ADR-0015 레퍼런스 조사 2줄) 방어의 **변이 측정**.
 #
 # 방어를 하나씩 지우거나 뒤집고, tests/retrieval-attestation.test.sh 가 빨개지는지 잰다.
 # 케이스 수·통과 수는 아무것도 증명하지 않는다 — 변이가 유일하게 믿을 만한 지표다.
 #
 # 계약 (위음성 카탈로그 23번 — 변이 하네스 자신의 거짓말 방지):
 #   · 대상 파일에 미커밋 변경이 있으면 **거부**한다 (복원이 작업물을 지운다)
 #   · 치환 앵커는 **정확히 1회** 매치해야 진행한다 — 빗나가면 빈 변이(거짓 초록)가 된다
 #   · 복원 직후 git hash-object ↔ rev-parse HEAD:<경로> 를 대조한다
 #
 # 공시된 측정 공백:
 #   · 3.4 exit 0 경로의 decision_note 방출 제거 — 현행 발동 규칙에서 도달 불가라
 #     **원리적으로 초록**이다 (테스트 파일 헤더 공시와 짝. ADR-0012 "모르는 rc" 공백과 같은 부류)
 
 set -uo pipefail
 cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
 
 VSTOP="template/.claude/hooks/verify-before-stop.sh"
 MARK="template/.claude/hooks/mark-needs-audit.sh"
 COMMON="template/.claude/hooks/_common.sh"
 TEST="./tests/retrieval-attestation.test.sh"
 
 for f in "$VSTOP" "$MARK" "$COMMON"; do
   if ! git diff --quiet -- "$f" || ! git diff --cached --quiet -- "$f"; then
     echo "✗ 대상에 미커밋 변경이 있습니다: $f — 먼저 커밋하고 재세요 (복원이 작업물을 지웁니다)" >&2
     exit 1
   fi
 done
 
 # 락 — 형제 변이 하네스(decision-gate·harness-env)와 같은 관례. 겹쳐 돌리면 주입된
 # 변이가 서로의 복원을 밟고, **측정 중인 트리를 배포하는 사고**(실제로 겪음)의 탐지
 # 근거이기도 하다 — install/sync 의 배포 가드가 이 락의 존재로 "측정 중"을 판정한다.
 LOCK="$(git rev-parse --git-dir)/mutate-retrieval-gate.lock"
 if ! mkdir "$LOCK" 2>/dev/null; then
   echo "✗ 이미 다른 변이 측정이 돌고 있습니다: $LOCK" >&2
   echo "  (그 프로세스가 죽었다면: rmdir '$LOCK')" >&2
   exit 1
 fi
 trap 'rmdir "$LOCK" 2>/dev/null' EXIT
 
 # **기준선 확인이 먼저다.** 변이 전 테스트가 이미 빨간 상태면 모든 변이가 "적색"으로
 # 집계돼 하네스가 성공을 위장한다 — 적색의 원인이 방어인지 무관한 회귀인지 구별이 안 된다
 # (구현 검수 [cx] 지적).
 if ! "$TEST" >/dev/null 2>&1; then
   echo "✗ 기준선 실패 — 변이 없이도 테스트가 빨갛습니다. 먼저 초록으로 만들고 재세요" >&2
   exit 1
 fi
 
 total=0; red=0; green=0
 
 restore() {   # $1 = 파일
   git restore --source=HEAD --worktree -- "$1" || { echo "✗ 복원 실패: $1" >&2; exit 1; }
   local w h
   w="$(git hash-object "$1")"; h="$(git rev-parse "HEAD:$1")"
   [ "$w" = "$h" ] || { echo "✗ 복원 검증 실패: $1 ($w != $h)" >&2; exit 1; }
 }
 
 # mutate <이름> <파일> <앵커(문자열)> <대체(문자열)>
 # 앵커가 정확히 1회 매치하지 않으면 그 항목을 실패로 세운다(fail-closed).
 mutate() {
   local name="$1" file="$2" anchor="$3" repl="$4" n
   total=$((total + 1))
   n="$(python3 - "$file" "$anchor" <<'PY'
 import sys
 src = open(sys.argv[1], encoding='utf-8').read()
 print(src.count(sys.argv[2]))
 PY
 )"
   if [ "$n" != "1" ]; then
     echo "  ✗ [$name] 앵커 매치 ${n}회 (기대 1) — 빈 변이 방지로 실패 처리" >&2
     return 1
   fi
   python3 - "$file" "$anchor" "$repl" <<'PY'
 import sys
 p, a, r = sys.argv[1], sys.argv[2], sys.argv[3]
 src = open(p, encoding='utf-8').read()
 open(p, 'w', encoding='utf-8').write(src.replace(a, r, 1))
 PY
   if "$TEST" >/dev/null 2>&1; then
     green=$((green + 1))
     echo "  🟢 [$name] 살아남음 — 이 방어를 지키는 케이스가 없다"
   else
     red=$((red + 1))
     echo "  🔴 [$name] 적색 (방어 확인)"
   fi
   restore "$file"
 }
 
-echo "회수 표명 게이트 변이 측정"
+echo "머리 표명 게이트 변이 측정"
 
 # 1. 첫 줄 검사를 느슨하게: 접두어 매치를 무엇이든 통과로
 mutate 'm01 첫 줄 패턴을 항상 매치로' "$VSTOP" \
   '      "사전 결정 회수:"*)' \
   '      *)'
 
 # 2. 자동 해제 제거
 mutate 'm02 자동 해제 제거' "$VSTOP" \
   '    rm -f "$RETRIEVAL_FLAG" 2>/dev/null' \
   '    :'
 
 # 3. 해제 후 재평가 제거 (허위 감사 차단 재현)
 mutate 'm03 재평가 exit 0 제거' "$VSTOP" \
   '    if ! work_pending; then
       # 이 턴의 할 일이 이것뿐이었다' \
   '    if false; then
       # 이 턴의 할 일이 이것뿐이었다'
 
 # 4. 재평가식(work_pending)에서 push 항 제거
 mutate 'm04 work_pending 에서 push 제거' "$VSTOP" \
   '  [ -n "$push_unsent" ] && return 0' \
   '  :'
 
 # 5. 패턴 접두어를 `사전` 으로 느슨화
 mutate 'm05 패턴을 사전 만으로 느슨화' "$VSTOP" \
   '      "사전 결정 회수:"*)' \
   '      "사전"*)'
 
 # 6. mark-needs-audit 의 회수 기록 제거
 mutate 'm06 회수 플래그 기록 제거' "$MARK" \
   '    record_flag "$RETRIEVAL_FLAG"  "$dual_value" || dw=1' \
   '    :'
 
 # 7. 조기 종료·재평가 술어에서 retrieval 제거
 mutate 'm07 work_pending 에서 retrieval 제거' "$VSTOP" \
   '  retrieval_pending && return 0' \
   '  :'
 
 # 8. 예산 키에서 불량 목록 제거 (진전이 리셋을 못 만든다)
 mutate 'm08 예산 키의 불량 목록 제거' "$VSTOP" \
   '    gate_budget "retrieval:${retrieval_bad_sorted}"' \
   '    gate_budget "retrieval"'
 
 # 9. 불량 목록을 공유 지문으로 전파 (다른 게이트 예산 오염)
 mutate 'm09 불량 목록을 flags_fp 로 전파' "$VSTOP" \
   'retrieval_pending         && flags_fp="${flags_fp}r"' \
   'retrieval_pending         && flags_fp="${flags_fp}r$(sort -u "$RETRIEVAL_FLAG" 2>/dev/null | tr "\n" " ")"'
 
 # 10. 회수 차단 메시지에서 emit_decision_note 제거
 mutate 'm10 회수 차단의 decision_note 제거' "$VSTOP" \
-  '      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지는 검수(plan-reviewer·codex)가 봅니다."
+  '      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지·조사했는지는 검수(plan-reviewer·codex)가 봅니다."
       emit_decision_note' \
-  '      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지는 검수(plan-reviewer·codex)가 봅니다."'
+  '      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지·조사했는지는 검수(plan-reviewer·codex)가 봅니다."'
 
 # 11. 경로 해석을 cwd 기준으로 되돌림
 mutate 'm11 상대경로를 cwd 기준으로' "$VSTOP" \
   '      *)  rfile="$PROJECT_DIR/$entry" ;;' \
   '      *)  rfile="$entry" ;;'
 
 # 12. 예산 소진 정리 rm 목록에서 회수 플래그 제거
 mutate 'm12 소진 정리 rm 에서 회수 제거' "$VSTOP" \
   '    rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null' \
   '    rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null'
 
 # 13. 소진 정리 changed 나열에서 회수 플래그 제거
 mutate 'm13 소진 changed 에서 회수 제거' "$VSTOP" \
   '"$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" 2>/dev/null | tr -d' \
   '"$DUALREVIEW_FLAG" 2>/dev/null | tr -d'
 
 # 14. BOM·CR 스트립 제거
 mutate 'm14 BOM·CR 스트립 제거' "$VSTOP" \
     "    rline=\"\${rline#\$'\\xEF\\xBB\\xBF'}\"
     rline=\"\${rline%\$'\\r'}\"" \
     '    :'
 
 # 15. 게이트를 듀얼리뷰(3.5) 뒤로 옮기기 — 지우는 변이가 아니라 **옮기는 변이**다.
 #     (지우면 "게이트 없음"을 재는 것이지 "순서가 틀림"을 재는 것이 아니다 — ADR-0012 규약)
 total=$((total + 1))
 if python3 - "$VSTOP" <<'PY'
 import sys
 p = sys.argv[1]
 src = open(p, encoding='utf-8').read()
-start = src.index('# (3.4) **회수 표명 게이트**')
+start = src.index('# (3.4) **머리 표명 게이트**')
 end = src.index('# (3.5) 듀얼 리뷰(codex) 게이트')
 block = src[start:end]
 rest = src[:start] + src[end:]
 anchor = "# (4) change-explainer 게이트"
 i = rest.index(anchor)
 open(p, 'w', encoding='utf-8').write(rest[:i] + block + rest[i:])
 PY
 then
   if "$TEST" >/dev/null 2>&1; then
     green=$((green + 1)); echo "  🟢 [m15 게이트를 3.5 뒤로 이동] 살아남음"
   else
     red=$((red + 1)); echo "  🔴 [m15 게이트를 3.5 뒤로 이동] 적색 (순서 계약 확인)"
   fi
   restore "$VSTOP"
 else
   echo "  ✗ [m15] 블록 이동 실패 — 실패 처리" >&2
 fi
 
 # 16. retrieval_pending 에서 hook_disabled 접기 제거 (게이트 끈 환경의 갇힘 재현)
 mutate 'm16 retrieval_pending 의 비활성 접기 제거' "$COMMON" \
   '  ! hook_disabled "stop:retrieval"' \
   '  true'
 
 # 17. 자동 해제 후 지문 재계산 제거 (stale 지문 → 하위 게이트 카운터 거짓 리셋 재현)
 mutate 'm17 해제 후 compute_flags_fp 재호출 제거' "$VSTOP" \
   '    # 지문을 다시 계산한다 — 진입 시 스냅숏에는 방금 지운 "r" 비트가 남아 있어, 이 턴의
     # 하위 게이트가 stale 지문으로 예산을 매기고 다음 턴에 거짓 리셋이 난다([cc] HIGH).
     compute_flags_fp' \
   '    :'
 
 # 18. read 관용구 되돌림 (개행 없는 마지막 줄이 조용히 스킵되는 결함 재현)
 mutate 'm18 read 의 || [ -n ] 제거' "$VSTOP" \
   '  while IFS= read -r entry || [ -n "$entry" ]; do' \
   '  while IFS= read -r entry; do'
 
+# --- ADR-0015: 둘째 줄(레퍼런스 표명) 방어 (m19~m35) -----------------------
+
+# 19. 둘째 줄 검사 통째 무력화 — if 체인 머리에 항상 참인 no-op 가지를 끼운다
+mutate 'm19 둘째 줄 검사 통째 제거' "$VSTOP" \
+  '    if [ "$ref_missing" -eq 1 ]; then' \
+  '    if : ; then :
+    elif [ "$ref_missing" -eq 1 ]; then'
+
+# 20. 접두어만 검사로 느슨화 — 접두어 매치 즉시 통과 (사유 강제가 산문으로 밀린다)
+mutate 'm20 접두어만 검사로 느슨화' "$VSTOP" \
+  '        "레퍼런스 조사:"*)
+          ref_body="${rline2#레퍼런스 조사:}"' \
+  '        "레퍼런스 조사:"*)
+          :
+          ;;
+        "__never__")
+          ref_body="${rline2#레퍼런스 조사:}"'
+
+# 21. 괄호 내용 검사 제거 (빈 괄호 허용 — 불요/실패 사유 강제 소멸)
+mutate 'm21 괄호 내용 검사 제거' "$VSTOP" \
+  "                    if [ -z \"\$(printf '%s' \"\$ref_inner\" | LC_ALL=C tr -d '[:space:]')\" ]; then" \
+  '                    if false; then'
+
+# 22. 둘째 줄 CR 스트립 제거
+mutate 'm22 둘째 줄 CR 스트립 제거' "$VSTOP" \
+  "      rline2=\"\${rline2%\$'\\r'}\"" \
+  '      :'
+
+# 23. `불요` 변형 제거
+mutate 'm23 불요 변형 제거' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              조사함|실패)'
+
+# 24. 닫는 괄호 뒤 잡음 허용 (accept 팔을 전부 매치로 — 아래 bad 팔이 죽는다)
+mutate 'm24 꼬리 잡음 허용' "$VSTOP" \
+  '                  *\))' \
+  '                  *)'
+
+# 25. 둘째 줄 불량(접두어 사유)을 목록에 추가하지 않음 — 판정만 하고 버림
+mutate 'm25 둘째 줄 불량 목록 누락' "$VSTOP" \
+  "          retrieval_bad_paths=\"\${retrieval_bad_paths}\${entry}#2
+\"
+          retrieval_bad_msgs=\"\${retrieval_bad_msgs}\${entry} — 둘째 줄이 '레퍼런스 조사:' 로 시작하지 않음
+\"" \
+  '          :'
+
+# 26. 무개행 마지막 줄 보정 가지 제거 — 개행 없는 정상 둘째 줄이 누락으로 오판된다
+mutate 'm26 무개행 보정 elif 가지 제거' "$VSTOP" \
+  '      elif [ -n "$rline2" ]; then
+        :                   # 개행 없는 마지막 줄 — 값이 있으므로 누락이 아니다
+      else' \
+  '      else'
+
+# 27. 변형 정확 일치를 접두 일치로 — `조사함부족(x)` 이 통과한다
+mutate 'm27 변형 꼬리 허용' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              조사함*|불요*|실패*)'
+
+# 28. 예산 키의 검사 종류 태그 제거 — 파일 내 부분 진전이 리셋을 못 만든다
+mutate 'm28 예산 키 검사 태그 제거' "$VSTOP" \
+  "    retrieval_bad_sorted=\"\$(printf '%s' \"\$retrieval_bad_paths\" | sort -u | tr '\\n' ' ')\" \\" \
+  "    retrieval_bad_sorted=\"\$(printf '%s' \"\$retrieval_bad_paths\" | sed 's/#[12]\$//' | sort -u | tr '\\n' ' ')\" \\"
+
+# 29. `실패` 변형 제거 (제3 변형)
+mutate 'm29 실패 변형 제거' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              조사함|불요)'
+
+# 30. `조사함` 변형 제거 (변형 3종 제거 변이의 대칭 완성)
+mutate 'm30 조사함 변형 제거' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              불요|실패)'
+
+# 31. 내부 괄호 거부 — 내용 안 `)` 를 잡음으로 오인하는 구현 재현 (r40 방어)
+mutate 'm31 내부 괄호 거부' "$VSTOP" \
+  '                case "$ref_body" in
+                  *\))' \
+  '                case "$ref_body" in
+                  *\)*\))
+                    retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+                    ;;
+                  *\))'
+
+# 32. 변형 뒤 공백 불허 — `조사함 (x)` 가 불량이 된다 (r43 방어)
+mutate 'm32 변형 뒤 공백 불허' "$VSTOP" \
+  '              *'"'"' '"'"')  ref_head="${ref_head% }" ;;' \
+  '              *'"'"' '"'"')  break ;;'
+
+# 33. SP 에서 탭 제거 — 접두어 뒤 탭이 불량이 된다 (r47 방어)
+mutate 'm33 SP 탭 제거' "$VSTOP" \
+  "              '	'*)  ref_body=\"\${ref_body#	}\" ;;" \
+  "              '	'*)  break ;;"
+
+# 34. 닫는 괄호 뒤 공백 불허 (r49 방어)
+mutate 'm34 괄호 뒤 공백 불허' "$VSTOP" \
+  '              *'"'"' '"'"')  ref_body="${ref_body% }" ;;' \
+  '              *'"'"' '"'"')  break ;;'
+
+# 35. 첫 줄 "빈 줄" 분기 제거 — r50(격리 픽스처)·r04(사유 단언)가 잡는다
+mutate 'm35 첫 줄 빈 줄 분기 제거' "$VSTOP" \
+  '      "")
+        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
+"
+        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일이 비었거나 첫 줄이 빈 줄
+"
+        ;;' \
+  '      "")
+        ;;'
+
 echo
 echo "총 $total 건 — 적색 $red · 초록 $green"
 [ "$green" -eq 0 ] && [ "$red" -eq "$total" ]
diff --git a/template/.claude/hooks/verify-before-stop.sh b/template/.claude/hooks/verify-before-stop.sh
index 30b6e4f..6391f58 100644
--- a/template/.claude/hooks/verify-before-stop.sh
+++ b/template/.claude/hooks/verify-before-stop.sh
@@ -193,281 +193,398 @@ else
   if [ "$tc_rc" -eq 124 ] || [ "$tc_rc" -eq 137 ]; then
     # 타임아웃은 "타입 오류"가 아니라 "모름". 차단하지 않고 감사자에게 넘긴다.
     typecheck_note="타입체크 타임아웃 → 생략 (감사자가 재확인할 것)"
   elif [ "$tc_rc" -eq 127 ]; then
     # 명령/도구 없음(rc=127)은 "타입 오류"가 아니다. 오탐 차단 방지 위해 생략.
     typecheck_note="타입체크 생략 (명령 실행 불가 rc=127): $TYPECHECK_CMD"
   elif [ "$tc_rc" -ne 0 ]; then
     gate_budget "typecheck"
     {
       echo "[완료 차단] 타입체크 실패 — 지금은 '완료'가 아닙니다."
       echo
       echo "명령: $TYPECHECK_CMD"
       echo
       printf '%s\n' "$tc_out" | head -n 15
       echo
       echo "고친 뒤 다시 종료하세요.  (차단 $((count + 1))/${MAX_BLOCKS})"
       echo "탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=$HOOK_ID"
     } >&2
     bump_and_block
   fi
 fi
 
 # (3.2) **결정 게이트** — "물어봤어야 할 것을 혼자 정했나".
 #      나머지 게이트가 전부 **산출물**을 볼 때 이것만 **에이전트 자신의 행동**을 본다.
 #      판정 규칙·좁히는 장치 셋·fail-open 사유는 _common.sh 의 decision_scan 주석이 정본이다.
 #
 #      **타입체크 다음, 나머지 게이트보다 앞에 둔다.** 질문의 답이 코드를 바꿀 수 있으므로, 리뷰·설명·감사에
 #      노력을 쓰기 전에 묻는 편이 싸다. (push 탐지와 달리 순서가 정확성을 바꾸지는 않는다 —
 #      대화 기록은 이미 다 쓰였고 게이트 순서가 그 내용을 바꾸지 않기 때문이다.)
 decision_note=""
 # **발동 조건은 플래그다.** 조기 종료는 push 미완만으로도 풀리므로, 그것만 보고 스캔하면
 # 아무것도 안 바꾼 읽기 전용 턴까지 검사하게 된다 — "플래그와 무관하게 항상"은 사용자가
 # 기각한 보기다. 여기서 한 번 더 물어 발동 계약을 조기 종료와 분리한다.
 decision_armed=0
 if [ -s "$AUDIT_FLAG" ] || [ -s "$EXPLAIN_FLAG" ] || [ -s "$DUALREVIEW_FLAG" ] || knowledge_gate_active; then
   decision_armed=1
 fi
 if [ "$decision_armed" -eq 1 ] && ! hook_disabled "stop:decision"; then
   decision_hits="$(decision_scan "$transcript_path")"; decision_rc=$?
   case "$decision_rc" in
     3) : ;;   # 표지 없음 · 또는 이 턴에 물었음
     2)
       # **이 게이트의 유일한 fail-open.** 통과시키되 사유를 게이트 메시지에 실어 보낸다.
       # 대화 기록 형식은 하네스 소유가 아니라, 여기서 차단하면 그 세션 안에 고칠 방법이 없다.
       decision_note="결정 게이트 생략 ($decision_hits)" ;;
     0) ;;     # 아래에서 차단한다 (case 안에서 하면 들여쓰기가 깊어져 메시지가 안 읽힌다)
     *)
       # **모르는 rc 는 통과가 아니라 판독 불가다.** python3 부재(127)·처리 못 한 예외(1)·
       # 신호 종료가 전부 여기로 온다. 이걸 통과로 읽으면 게이트가 조용히 사라진다.
       decision_note="결정 게이트 생략 (스캐너가 예상 밖 상태로 끝남 rc=$decision_rc — python3 부재·예외·신호 종료일 수 있습니다)" ;;
   esac
   if [ "$decision_rc" -eq 0 ]; then
     gate_budget "decision"
     {
       echo "[완료 차단] 혼자 정한 것이 있는데 이 턴에 사용자에게 한 번도 묻지 않았습니다."
       echo
       echo "걸린 문장:"
       printf '%s\n' "$decision_hits" | sed 's/^/  - /'
       echo
       echo "이 게이트가 겨누는 것:"
       echo "  게이트가 막을 때는 따르면서, 게이트가 없는 자리에서는 혼자 정하고 보고서에"
       echo "  한 줄 적는 부류입니다. 그 '한 줄'은 도구 호출이 아니라 문장이라 승인창이"
       echo "  안 뜨고, 그래서 이 저장소가 겪은 실패 대부분이 이 축에서 났습니다."
       echo
       echo "해야 할 일:"
       echo "  1. 위 문장들이 정말 **사용자가 정할 일**이었는지 본다."
       echo "     '범위 밖'·'별도로'·'그대로 뒀'는 대개 선택지를 줬어야 하는 자리입니다."
       echo "  2. AskUserQuestion 으로 **실제로 묻는다.** 보고서에 적는 것은 묻는 것이 아닙니다."
       echo "  3. 질문을 한 번이라도 하면 이 게이트는 풀립니다."
       echo
       echo "위양성이라면(그 어휘를 설명·인용한 것이지 결정이 아니라면):"
       echo "  - 백틱이나 따옴표로 감싸면 스캔에서 빠집니다 — 인용은 결정이 아니니까요."
       echo "  - 그래도 걸리면 사용자에게 위양성임을 알리고 지시를 받으세요."
       echo
       echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:decision"
     } >&2
     bump_and_block
   fi
 fi
 
-# (3.4) **회수 표명 게이트** (ADR-0013) — 설계·계획 산출물의 첫 줄이 `사전 결정 회수:`
-#      표명 형식을 지키는지 본다. 표명 첫 줄은 ADR-0009 가 만든 계약인데 그 검증이
-#      산문("확인한다 — 없으면 되돌린다")으로만 있었다 — 산문 승격 부류다.
+# (3.4) **머리 표명 게이트** (ADR-0013·ADR-0015) — 설계·계획 산출물의 머리 두 줄이
+#      표명 형식을 지키는지 본다:
+#        1줄 `사전 결정 회수:` (ADR-0013 — ADR-0009 계약의 산문 승격)
+#        2줄 `레퍼런스 조사: 조사함(<대상·출처>)|불요(<사유>)|실패(<시도 — 사유>)`
+#            (ADR-0015 — "조사가 필요한 지시인가"의 판정은 기계가 못 하므로, 판정의
+#             **무표명 통과**를 막는다. 불요에도 사유를 강제하는 것이 핵심이다)
 #
-#      **형식만 본다.** 진짜 읽었는지는 기계가 못 본다(내용 검증은 층 위반 — ADR-0013 ④).
+#      **형식만 본다.** 진짜 읽었는지·조사했는지는 기계가 못 본다(내용 검증은 검수 몫 —
+#      ADR-0013 ④·ADR-0015).
 #      **자동 해제** — 형식을 지키면 이 게이트가 스스로 플래그를 지운다. 지울 플래그를
 #      에이전트 손에 주지 않는 것이 이 게이트의 형태다(결정 게이트의 "실제로 물으면
 #      풀린다"와 같은 구조).
 #      **듀얼리뷰(3.5)보다 앞** — 표명 없는 산출물로 리뷰에 노력을 쓰기 전에 잡는 편이
 #      싸다. 정확성 문제가 아니라 비용 문제다(ADR-0012 ④와 같은 논리).
 if retrieval_pending; then
   if [ ! -r "$RETRIEVAL_FLAG" ]; then
     # 플래그는 서 있는데(-s) 읽을 수 없다 — "검사 대상 0건"으로 위장되면 조용한 통과라
     # fail-closed 로 차단한다. 무엇이 대상이었는지조차 모르는 상태다.
     gate_budget "retrieval:unreadable-flag"
     {
-      echo "[완료 차단] 회수 표명 검사 불가 — 플래그 파일을 읽을 수 없습니다: $RETRIEVAL_FLAG"
+      echo "[완료 차단] 머리 표명 검사 불가 — 플래그 파일을 읽을 수 없습니다: $RETRIEVAL_FLAG"
       echo "권한·손상을 확인한 뒤 다시 종료하세요."
       emit_decision_note
       echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
     } >&2
     bump_and_block
   fi
-  retrieval_bad_paths=""   # 불량 항목의 경로(정렬 전, 줄 단위) — 예산 키용
+  # 예산 키 항목은 "경로#검사번호"다(#1 첫 줄 / #2 둘째 줄). 검사 번호까지 넣는 이유:
+  # 경로만 넣으면 두 줄 다 불량인 파일의 첫 줄만 고친 **진전**이 키를 못 바꿔, 4회째
+  # 예산 소진이 플래그 5종을 전삭제한다(설계 검수 [cx] r2). 사유 문자열은 넣지 않는다 —
+  # 같은 검사가 다른 사유로 바뀌는 것은 진전이 아니다.
+  retrieval_bad_paths=""   # 불량 항목 "경로#검사번호" (정렬 전, 줄 단위) — 예산 키용
   retrieval_bad_msgs=""    # "경로 — 사유" (차단 메시지용)
   # `|| [ -n "$entry" ]` 가 필수다: 마지막 줄이 개행 없이 끝나면 read 가 값을 담고도
   # rc=1 을 내 본문이 안 돌고, 그 항목이 **조용히 스킵**된다 — record_flag 쓰기가
   # 중단된 플래그에서 표명 없는 산출물이 통과하는 경로였다(구현 검수 [cx] HIGH).
   while IFS= read -r entry || [ -n "$entry" ]; do
     [ -n "$entry" ] || continue                     # 빈 줄은 기록 계약 밖 — 건너뛴다
     case "$entry" in
       /*) rfile="$entry" ;;
       # 기록값 계약(mark-needs-audit): 프로젝트 안은 상대경로다. 훅 실행 cwd 가 아니라
       # **$PROJECT_DIR 기준**으로 연다 — cwd 기준이면 다른 곳에서 실행된 턴에 전부
       # "소실"로 오인돼 불량이 조용히 통과한다([cc·cx] 검수).
       *)  rfile="$PROJECT_DIR/$entry" ;;
     esac
     # 소실은 건너뛴다. 차단하면 산출물을 아카이브한 턴이 벽돌이 된다(고칠 대상이 없다).
     # 이 스킵이 삭제 우회를 연다는 것은 ADR-0013 이 공시한다 — 실존 검증은 감사자 몫.
     [ -e "$rfile" ] || continue
     if [ ! -r "$rfile" ]; then
-      retrieval_bad_paths="${retrieval_bad_paths}${entry}
+      retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
 "
       retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일을 읽을 수 없음
 "
       continue
     fi
     rline=""
-    IFS= read -r rline < "$rfile" || true
+    rline2=""
+    ref_missing=0
+    # 머리 2줄을 한 블록 리다이렉트로 읽는다 — 파일을 두 번 열지 않는다. 중괄호 블록은
+    # 서브셸이 아니라 대입이 블록 밖에 남고, 리다이렉트는 블록 안에만 적용되므로 바깥
+    # while 의 stdin($RETRIEVAL_FLAG)과 충돌하지 않는다.
+    {
+      IFS= read -r rline || true
+      # 둘째 줄 "누락" 판정은 read 의 rc 를 실제로 소비해야 한다. 무개행 마지막 줄에서
+      # read 는 값을 담고도 rc=1 을 내므로, rc 만 보면 개행 없는 정상 표명이 누락으로
+      # 오판되고 값만 보면 판정이 뭉개진다. 한 줄 관용구(`read || [ -n ]`)는 단발 read
+      # 에서 rc 를 아무도 소비하지 않는 no-op 이다(설계 검수 [cc] r2 HIGH — while 루프
+      # 조건이던 원본과 자리가 다르다). 그래서 분기로 소비한다.
+      if IFS= read -r rline2; then
+        :
+      elif [ -n "$rline2" ]; then
+        :                   # 개행 없는 마지막 줄 — 값이 있으므로 누락이 아니다
+      else
+        ref_missing=1       # rc!=0 이고 값도 없다 = 둘째 줄이 없다(1줄 파일)
+      fi
+    } < "$rfile"
+    # ── 첫 줄: 회수 표명 (ADR-0013) ──
     # 첫 줄 판정 전에 선두 BOM·후행 CR 을 걷어낸다 — harness_env_value 가 같은 부류
     # (눈에 안 보이는 바이트가 판정을 뒤집는 것)에 데인 전례가 있다.
     rline="${rline#$'\xEF\xBB\xBF'}"
     rline="${rline%$'\r'}"
     case "$rline" in
       "사전 결정 회수:"*)
-        if [ -z "$(printf '%s' "${rline#사전 결정 회수:}" | tr -d '[:space:]')" ]; then
