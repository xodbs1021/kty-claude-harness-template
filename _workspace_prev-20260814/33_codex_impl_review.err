   187	r03() { # 표명 없음 → 차단. 첫 줄이 `사전` 으로 시작하지만 완전한 접두어는 아니다 —
   188	        # 패턴을 `사전` 따위로 느슨하게 만드는 변이가 이 행에서 빨개진다.
   189	  local name='r03 첫 줄에 표명 없음 → 차단 + 파일명' why=''
   190	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
