   778	  elif ! contains "$ERR" '괄호 안이 비었음'; then why='사유(빈 괄호)가 없다'
   779	  else
   780	    p2="$(new_project)" || { report "$name" '픽스처 실패(2)'; return 0; }
   781	    mk_doc "$p2/_workspace/00_design.md" "$GOOD_FIRST" '레퍼런스 조사: 실패(   )'
   782	    set_flag "$p2" retrieval '_workspace/00_design.md'
   783	    set_flag "$p2" audit 'src/x.ts'
   784	    mk_tx "$p2/tx.jsonl" neutral
   785	    run_stop "$p2" "$p2/tx.jsonl"
   786	    contains "$ERR" '괄호 안이 비었음' || why='실패(공백만) 를 차단하지 않았다'
   787	  fi
   788	  report "$name" "$why"
   789	}
   790	
   791	r47() { # SP 에는 탭도 든다 — 접두어·변형 사이 탭 (r43 의 짝, 허용 쪽 경계).
   792	  ref_pass 'r47 접두어 뒤 탭 → 정상' PRINTF_RAW \
   793	    "$GOOD_FIRST"$'\n''레퍼런스 조사:'$'\t''조사함(x)'$'\n''본문.'$'\n'
   794	}
   795	
   796	r48() { # 비ASCII 공백은 SP 가 아니다 — 전각 공백이 변형과 괄호 사이에 끼면 불량.
   797	  ref_block 'r48 변형·괄호 사이 전각 공백 → 차단' '레퍼런스 조사: 조사함　(x)' '형식이 아님'
   798	}
   799	
   800	r49() { ref_pass 'r49 닫는 괄호 뒤 공백만 → 정상' '레퍼런스 조사: 불요(x)  '; }
   801	
   802	r50() { # 첫 줄 "빈 줄" 분기의 격리 픽스처 — 0바이트 파일 없이도 그 분기를 잰다.
   803	        # (r04 는 두 검사 동시 불량이라 격리 예외 — 이 케이스가 그 예외를 좁힌다.)
   804	  local name='r50 첫 줄 빈 줄·둘째 줄 정상 → 첫 줄 사유로만 차단' why='' p
   805	  p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   806	  printf '\n%s\n본문.\n' "$GOOD_SECOND" > "$p/_workspace/00_design.md"
   807	  set_flag "$p" retrieval '_workspace/00_design.md'
   808	  set_flag "$p" audit 'src/x.ts'
   809	  mk_tx "$p/tx.jsonl" neutral
   810	  run_stop "$p" "$p/tx.jsonl"
   811	  if ! contains "$ERR" "$TOK_RET"; then why='차단하지 않았다'
   812	  elif ! contains "$ERR" '비었';   then why='사유(빈 줄)가 없다'
   813	  elif contains "$ERR" '둘째 줄';  then why='둘째 줄 사유가 끼었다 — 격리 실패'
   814	  fi
   815	  report "$name" "$why"
   816	}
   817	
   818	# --- 실행 -----------------------------------------------------------------
   819	# EXPECTED_CASES 는 상수다. 파생값이면 케이스를 지워도 초록이다.
   820	EXPECTED_CASES=50
   821	CASES='r01 r02 r03 r04 r05 r06 r07 r08 r09 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47 r48 r49 r50'
   822	
   823	echo "retrieval-attestation.test.sh — 머리 표명 게이트(stop:retrieval) 회귀"
   824	case_total="$(printf '%s\n' $CASES | wc -l | tr -d ' ')"
   825	case_uniq="$(printf '%s\n' $CASES | sort | uniq | wc -l | tr -d ' ')"
   826	if [ "$case_total" -ne "$EXPECTED_CASES" ] || [ "$case_uniq" -ne "$EXPECTED_CASES" ]; then
   827	  echo "✗ 케이스 목록이 계약과 다릅니다: 총 $case_total / 고유 $case_uniq / 기대 $EXPECTED_CASES" >&2
   828	  exit 1
   829	fi
   830	for c in $CASES; do "$c"; done
   831	if [ "$ran" -ne "$EXPECTED_CASES" ]; then
   832	  echo "✗ 실행 수($ran)가 기대($EXPECTED_CASES)와 다릅니다 — 케이스가 조용히 빠졌습니다" >&2
   833	  exit 1
   834	fi
   835	echo "— $pass/$ran 통과"
   836	[ "$fail" -eq 0 ]

exec
/bin/zsh -lc "nl -ba tests/retrieval-attestation.test.sh | sed -n '20,220p'; nl -ba tests/retrieval-attestation.test.sh | sed -n '220,440p'; nl -ba tests/retrieval-attestation.test.sh | sed -n '440,620p'; nl -ba _workspace/mutate-retrieval-gate.sh | sed -n '1,180p'; nl -ba _workspace/mutate-retrieval-gate.sh | sed -n '180,360p'" in /Users/kty/Downloads/kty-claude-harness-template
 succeeded in 0ms:
    20	#
