   796	r47() { # SP 에는 탭도 든다 — 트림 자리 셋(접두어 뒤·변형 뒤·닫는 괄호 뒤) 전부 잰다.
   797	        # 한 자리만 재면 나머지 트림 한 줄이 빠진 구현이 정상 입력을 차단해도 안 보인다
   798	        # (구현 검수 [cx] 지적 — [cc] 가 수동 재현으로 확인한 경계의 단언화).
   799	  local name='r47 탭 SP — 접두어·변형·괄호 뒤 전부 정상' why='' p s i
   800	  for i in 1 2 3; do
   801	    case "$i" in
   802	      1) s='레퍼런스 조사:'$'\t''조사함(x)' ;;
   803	      2) s='레퍼런스 조사: 조사함'$'\t''(x)' ;;
   804	      3) s='레퍼런스 조사: 조사함(x)'$'\t' ;;
   805	    esac
   806	    p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   807	    printf '%s\n%s\n본문.\n' "$GOOD_FIRST" "$s" > "$p/_workspace/00_design.md"
   808	    set_flag "$p" retrieval '_workspace/00_design.md'
   809	    set_flag "$p" audit 'src/x.ts'
   810	    mk_tx "$p/tx.jsonl" neutral
   811	    run_stop "$p" "$p/tx.jsonl"
   812	    if contains "$ERR" "$TOK_RET";       then why="자리 $i 의 탭이 차단됐다"; break
   813	    elif ! contains "$ERR" "$TOK_AUDIT"; then why="자리 $i 감사 게이트 미도달"; break
   814	    fi
   815	  done
   816	  report "$name" "$why"
   817	}
