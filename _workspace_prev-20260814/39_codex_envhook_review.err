     9	# CI 에 넣지 않는다. 검수·감사 때 손으로 돌리는 계측 도구다.
    10	# 사용법: ./_workspace/mutate-harness-env.sh
    11	
    12	set -uo pipefail
    13	cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
    14	
    15	COMMON='template/.claude/hooks/_common.sh'
    16	STOP='template/.claude/hooks/verify-before-stop.sh'
    17	TESTS='./tests/harness-env-read.test.sh'
    18	
    19	# 이 하네스는 HEAD 를 정본으로 삼아 restore 한다. 그래서 **대상 파일에 미커밋 변경이
    20	# 있으면 그것을 지워버린다** — 실제로 한 번 당했다(측정하려다 방금 쓴 수정을 날렸다).
