    96	  if [ "$dir" = '/' ]; then dir=''; fi
    97	  printf '%s/%s\n' "$dir" "$base"
    98	}
    99	
   100	# project_rel <절대경로> — $proj 아래면 프로젝트 기준 상대경로를 stdout·rc=0, 아니면 rc=1.
   101	# 접두사에 **슬래시를 반드시 포함**한다. 빠뜨리면 형제 디렉토리(<proj>-backup/…)를
   102	# 프로젝트 안으로 오인한다. "$proj" 를 인용하는 것은 경로 안의 글롭 문자 때문이다.
   103	project_rel() {
   104	  case "$1" in
   105	    "$proj"/*) printf '%s\n' "${1#"$proj"/}" ;;
   106	    *) return 1 ;;
   107	  esac
   108	}
   109	
   110	# git_toplevel <절대경로> — 그 파일이 속한 git 저장소 루트를 물리 경로로. 없으면 rc=1.
   111	# GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE 을 소거한다: 훅이 git 훅 안에서 돌면 이 변수들이
   112	# 엉뚱한 저장소를 가리켜 귀속이 통째로 바뀐다.
   113	# 경로에 /.git/ 가 있으면 그 앞을 기준으로 삼는다: git 은 .git 안에서 --show-toplevel 에
   114	# 실패하므로(실측 rc=128), 그대로 물으면 .git/hooks/* 편집이 판정 불가로 새어나간다.
   115	git_toplevel() {
   116	  local dir top
   117	  case "$1" in
   118	    */.git/*) dir="${1%%/.git/*}" ;;
   119	    */.git)   dir="${1%/.git}" ;;
