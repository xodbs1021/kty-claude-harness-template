   303	json_get() {
   304	  python3 -c '
   305	import json, sys
   306	try:
   307	    data = json.load(sys.stdin)
   308	except Exception:
   309	    sys.exit(0)
   310	for key in sys.argv[1].split("."):
   311	    if not isinstance(data, dict):
   312	        sys.exit(0)
   313	    data = data.get(key)
   314	    if data is None:
   315	        sys.exit(0)
