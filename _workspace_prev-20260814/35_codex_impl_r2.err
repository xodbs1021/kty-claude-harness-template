   762	  elif ! contains "$ERR" '둘째 줄이'; then why='1회차에 둘째 줄 사유가 없다 (첫 줄 불량이 둘째 줄 검사를 건너뛰게 함 — 구현 검수 [cx] 지적의 단언화)'
   763	  else
   764	    mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST" '무관한 둘째 줄'   # 첫 줄만 고침 = 진전
   765	    run_stop "$p" "$p/tx.jsonl"
   766	    if ! contains "$ERR" "$TOK_RET";  then why='2회차에 차단하지 않았다'
   767	    elif ! contains "$ERR" '둘째 줄이'; then why='2회차 사유가 둘째 줄이 아니다'
   768	    elif ! contains "$ERR" '차단 1/'; then why="부분 진전인데 카운터가 리셋되지 않았다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   769	    fi
   770	  fi
   771	  report "$name" "$why"
   772	}
