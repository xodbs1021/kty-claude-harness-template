   432	
   433	r17() { # retrieval 플래그는 decision_armed 에 **들어가지 않는다** — 소실 항목만 남은
   434	        # stale 플래그 + 결정 표지 발화에서 결정 게이트가 오발동하면 3.4 의 해제 기회가
   435	        # 오지 않는다(설계 검수 [cc] r2 H). 기대: 결정 침묵 + 해제 + exit 0.
   436	  local name='r17 stale 플래그가 결정 게이트를 무장시키지 않는다' why=''
   437	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   438	  set_flag "$p" retrieval '_workspace/00_design.md'   # 파일 없음 = stale
   439	  mk_tx "$p/tx.jsonl" marker
   440	  run_stop "$p" "$p/tx.jsonl"
   441	  if contains "$ERR" "$TOK_DECISION"; then why='결정 게이트가 오발동했다'
   442	  elif [ "$RC" -ne 0 ];               then why="rc=$RC (기대 0): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   443	  elif ! flag_gone "$p";              then why='stale 플래그가 해제되지 않았다'
   444	  fi
   445	  report "$name" "$why"
   446	}
   447	
   448	r18() { # 정상 표명 + 다른 할 일 전무 → exit 0. 재평가가 없으면 맨 아래 감사 게이트가
   449	        # 빈 목록으로 허위 차단한다(설계 검수 [cx] r2).
   450	  local name='r18 정상 + 할 일 전무 → exit 0 (허위 감사 차단 없음)' why=''
   451	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   452	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   453	  set_flag "$p" retrieval '_workspace/00_design.md'
   454	  mk_tx "$p/tx.jsonl" neutral
   455	  run_stop "$p" "$p/tx.jsonl"
   456	  if [ "$RC" -ne 0 ];       then why="rc=$RC (기대 0): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   457	  elif ! flag_gone "$p";    then why='플래그 미해제'
   458	  elif contains "$ERR" '완료 차단'; then why='어떤 게이트가 차단했다'
   459	  fi
   460	  report "$name" "$why"
   461	}
   462	
   463	r19() { # arming 은 수기 플래그가 아니라 **mark-needs-audit 실제 실행**으로도 잰다 —
   464	        # 기록 제거 변이가 수기 픽스처에 가려지지 않게. Stop 까지 이어 돌려 차단 확인.
   465	  local name='r19 mark-needs-audit 실행 → 회수 플래그 → 차단' why=''
   466	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   467	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   468	  printf '{"tool_input":{"file_path":"%s"}}' "$p/_workspace/00_design.md" | \
   469	    CLAUDE_PROJECT_DIR="$p" bash "$p/.claude/hooks/mark-needs-audit.sh" >/dev/null 2>&1
   470	  if [ ! -s "$p/.claude/.needs-retrieval" ]; then
   471	    why='mark-needs-audit 가 회수 플래그를 기록하지 않았다'
   472	  else
   473	    set_flag "$p" audit 'src/x.ts'   # 감사 도달 확인용
   474	    mk_tx "$p/tx.jsonl" neutral
   475	    run_stop "$p" "$p/tx.jsonl"
   476	    contains "$ERR" "$TOK_RET" || why='기록된 플래그로 차단되지 않았다'
   477	  fi
   478	  report "$name" "$why"
   479	}
   480	
   481	r20() { # 이름·경로에 codex 가 들어도 산출물이면 검사 대상이다 — mark-needs-audit 쪽
   482	        # 계약(케이스 74·75)의 Stop 쪽 절반: 그 플래그로 실제 차단까지 간다.
   483	  local name='r20 codex 이름 산출물도 검사된다' why=''
   484	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   485	  mk_doc "$p/_workspace/00_design-codex-gate.md" '표명 없음.'
   486	  set_flag "$p" retrieval '_workspace/00_design-codex-gate.md'
   487	  set_flag "$p" audit 'src/x.ts'
   488	  mk_tx "$p/tx.jsonl" neutral
   489	  run_stop "$p" "$p/tx.jsonl"
   490	  contains "$ERR" "$TOK_RET" || why='codex 이름이라는 이유로 검사에서 빠졌다'
   491	  report "$name" "$why"
   492	}
   493	
   494	r21() { # 표명 리터럴 드리프트 — 같은 문자열이 세 정본 자리에 있어야 한다.
   495	        # 대상 목록은 상수다(파생하면 파일이 빠져도 초록이 된다).
   496	  local name='r21 표명 문자열이 훅·스킬·프로필에서 동일' why=''
   497	  local lit='사전 결정 회수:' f
   498	  for f in \
   499	    "$HOOKS/verify-before-stop.sh" \
   500	    "$REPO_ROOT/template/.claude/skills/harness-orchestrator/SKILL.md" \
   501	    "$REPO_ROOT/template/.claude/harness/project-profile.template.md"; do
   502	    grep -qF "$lit" "$f" || { why="리터럴이 없다: $f"; break; }
   503	  done
   504	  report "$name" "$why"
   505	}
   506	
   507	r22() { # 정상 해제 + push 미완 → push 게이트가 막는다. 재평가식이 플래그만 세면
   508	        # 자동 해제가 push 를 삼킨다(설계 검수 [cc·cx] r2 B — 커밋 29개를 잃은 상태의 재개방).
   509	  local name='r22 정상 해제 + push 미완 → push 차단' why=''
   510	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   511	  ( cd "$p" && git init -q . && git checkout -q -b main 2>/dev/null; \
   512	    git -C "$p" config user.email t@t && git -C "$p" config user.name t \
   513	    && git -C "$p" add -A >/dev/null 2>&1 && git -C "$p" commit -qm base \
   514	    && git -C "$p" remote add origin "$p" \
   515	    && git -C "$p" update-ref refs/remotes/origin/main HEAD \
   516	    && printf 'x\n' > "$p/x.txt" && git -C "$p" add x.txt && git -C "$p" commit -qm ahead ) >/dev/null 2>&1 \
   517	    || { report "$name" '픽스처 실패: git'; return 0; }
   518	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   519	  set_flag "$p" retrieval '_workspace/00_design.md'
   520	  mk_tx "$p/tx.jsonl" neutral
   520	  mk_tx "$p/tx.jsonl" neutral
   521	  run_stop "$p" "$p/tx.jsonl"
   522	  if ! contains "$ERR" "$TOK_PUSH"; then why="push 게이트 미도달 (rc=$RC): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   523	  elif ! flag_gone "$p";            then why='회수 플래그는 해제됐어야 한다'
   524	  fi
   525	  report "$name" "$why"
   526	}
   527	
   528	r23() { # 정상 해제 + 지식 게이트 켜짐 → 지식 게이트로 계속 흘러간다 (재평가가 과하게
   529	        # exit 0 하지 않는다). 켜진 지식 게이트가 work_pending 을 참으로 유지한다.
   530	  local name='r23 정상 해제 + 지식 플래그 → 지식 게이트 도달' why=''
   531	  local p; p="$(new_project on)" || { report "$name" '픽스처 실패'; return 0; }
   532	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   533	  set_flag "$p" retrieval '_workspace/00_design.md'
   534	  set_flag "$p" knowledge '_workspace/00_design.md'
   535	  mk_tx "$p/tx.jsonl" neutral
   536	  run_stop "$p" "$p/tx.jsonl"
   537	  if contains "$ERR" "$TOK_RET";      then why='위양성 — 회수 게이트가 막았다'
