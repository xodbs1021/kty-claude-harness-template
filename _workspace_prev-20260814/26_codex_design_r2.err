   610	# EXPECTED_CASES 는 상수다. 파생값이면 케이스를 지워도 초록이다.
   611	EXPECTED_CASES=27
   612	CASES='r01 r02 r03 r04 r05 r06 r07 r08 r09 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27'
