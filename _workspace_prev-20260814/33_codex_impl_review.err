   331	r12() { # 절대경로 항목(프로젝트 밖) + 상대·절대 혼재. 밖 파일이 불량이면 차단.
   332	  local name='r12 절대경로·혼재 항목 판정' why=''
   333	  local p out; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   334	  out="$(mktemp -d "$TMPROOT/outside.XXXXXX")" || { report "$name" '픽스처 실패'; return 0; }
   335	  mkdir -p "$out/_workspace"
