   108	# git_toplevel <절대경로> — 그 파일이 속한 git 저장소 루트를 물리 경로로. 없으면 rc=1.
   109	# GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE 을 소거한다: 훅이 git 훅 안에서 돌면 이 변수들이
   110	# 엉뚱한 저장소를 가리켜 귀속이 통째로 바뀐다.
   111	# 경로에 /.git/ 가 있으면 그 앞을 기준으로 삼는다: git 은 .git 안에서 --show-toplevel 에
   112	# 실패하므로(실측 rc=128), 그대로 물으면 .git/hooks/* 편집이 판정 불가로 새어나간다.
   113	git_toplevel() {
   114	  local dir top
   115	  case "$1" in
   116	    */.git/*) dir="${1%%/.git/*}" ;;
   117	    */.git)   dir="${1%/.git}" ;;
   118	    *)        dir="$(dirname -- "$1")" ;;
   119	  esac
   120	  top="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
   121	         git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"
   122	  [ -n "$top" ] || return 1
   123	  physical_dir "$top"
   124	}
   125	
   126	# has_git_ancestor <절대경로> — 조상 디렉토리에 .git 이 있는가. git 을 쓰지 않는다.
   127	# git_toplevel 이 빈 값을 돌려준 이유가 "저장소가 아님"인지 "git 이 거부함"인지를 가르는
   128	# 데 쓴다. rev-parse 는 둘 다 rc=128 로 돌려주므로 stderr 내용으로 가르는 것은 취약하다.
   129	has_git_ancestor() {
   130	  local d
   131	  d="$(dirname -- "$1")"
