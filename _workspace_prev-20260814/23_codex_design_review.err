    70	# new_project — 케이스마다 독립 프로젝트(mktemp — 명령 치환 카운터는 서브셸에 갇힌다).
    71	# 타입체크·지식게이트는 리터럴로 비운다: 이 파일이 재는 것은 회수 게이트와 그 결합뿐이고,
    72	# 앞 게이트가 먼저 막으면 케이스가 회수 게이트에 도달조차 못 한 채 기대값이 우연히 맞는다.
    73	# 지식 게이트를 켤 케이스(r23)만 인자로 켠다.
    74	new_project() {   # $1 = 지식게이트 값(비우면 꺼짐)
    75	  local p
    76	  p="$(mktemp -d "$TMPROOT/proj.XXXXXX")" || return 1
    77	  mkdir -p "$p/.claude/hooks" "$p/.claude/harness" "$p/_workspace" || return 1
    78	  cp "$HOOKS/_common.sh" "$HOOKS/verify-before-stop.sh" "$HOOKS/mark-needs-audit.sh" "$p/.claude/hooks/" || return 1
    79	  printf 'HARNESS_TYPECHECK_CMD=""\nHARNESS_KNOWLEDGE_GATE="%s"\n' "${1-}" \
    80	    > "$p/.claude/harness/harness.env" || return 1
    81	  printf '%s\n' "$p"
    82	}
    83	
    84	# mk_tx <경로> <neutral|marker> — 최소 대화 기록. 결정 게이트(3.2)가 이 파일을 읽는다.
    85	#   neutral = 표지 어휘 없는 발화 (결정 게이트 침묵)
    86	#   marker  = 표지 어휘 + 서술형 (결정 게이트가 무장돼 있으면 차단)
    87	mk_tx() {
    88	  local tp="$1" kind="$2"
    89	  printf '%s\n' '{"type":"user","isSidechain":false,"message":{"role":"user","content":"작업해줘"}}' > "$tp" || return 1
    90	  case "$kind" in
    91	    neutral) printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"확인했습니다."}]}}' >> "$tp" ;;
    92	    marker)  printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"이건 범위 밖이라 그대로 뒀습니다."}]}}' >> "$tp" ;;
    93	  esac
    94	}
    95	
    96	# run_stop <프로젝트> <transcript경로|""> [env 인자...]
    97	run_stop() {
    98	  local p="$1" tp="$2"
    99	  shift 2
   100	  local errf="$TMPROOT/err.$$" outf="$TMPROOT/out.$$" payf="$TMPROOT/pay.$$"
   101	  RC=999; ERR=''; OUT=''; DID_RUN=1
   102	  python3 -c '
   103	import json, sys
   104	d = {"stop_hook_active": False}
   105	if sys.argv[1]:
   106	    d["transcript_path"] = sys.argv[1]
   107	with open(sys.argv[2], "w", encoding="utf-8") as fh:
   108	    fh.write(json.dumps(d))' "$tp" "$payf"
   109	  # cwd 를 프로젝트가 아닌 곳(TMPROOT)으로 둔다 — 상대경로 항목을 cwd 기준으로 여는
   110	  # 구현이면 여기서 전부 "소실"이 되어 r11 이 빨개진다. 이 디렉토리 선택이 곧 픽스처다.
   111	  ( cd "$TMPROOT" && env -u HARNESS_HOOKS -u ECC_DISABLED_HOOKS ${@+"$@"} CLAUDE_PROJECT_DIR="$p" \
   112	      bash "$p/.claude/hooks/verify-before-stop.sh" <"$payf" >"$outf" 2>"$errf" )
   113	  RC=$?
   114	  rm -f "$payf"
   115	  ERR="$(cat "$errf" 2>/dev/null)"
   116	  OUT="$(cat "$outf" 2>/dev/null)"
   117	  rm -f "$errf" "$outf"
   118	}
   119	
   120	# set_flag <프로젝트> <이름> <값...> — 플래그에 줄들을 기록한다.
   121	set_flag() {
   122	  local p="$1" name="$2"; shift 2
   123	  : > "$p/.claude/.needs-$name"
   124	  local v
   125	  for v in "$@"; do printf '%s\n' "$v" >> "$p/.claude/.needs-$name"; done
   126	}
   127	
   128	# mk_doc <경로> <첫줄|"EMPTY"> — 산출물 파일을 만든다.
   129	mk_doc() {
   130	  local f="$1" first="$2"
   131	  case "$first" in
   132	    EMPTY) : > "$f" ;;
   133	    *) printf '%s\n본문.\n' "$first" > "$f" ;;
   134	  esac
   135	}
   136	
   137	GOOD_FIRST='사전 결정 회수: docs/decisions/'
   138	flag_gone() { [ ! -e "$1/.claude/.needs-retrieval" ]; }
   139	
   140	# --- 케이스 --------------------------------------------------------------
   141	# 번호는 설계서 7절의 목록과 1:1 이다. 새 케이스는 뒤에만 붙인다.
   142	
   143	r01() { # 정상 첫 줄 → 회수 침묵 + 자동 해제 + 감사 게이트 도달.
   144	  local name='r01 정상 첫 줄 → 통과 + 플래그 자동 해제' why=''
   145	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   146	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   147	  set_flag "$p" retrieval '_workspace/00_design.md'
   148	  set_flag "$p" audit 'src/x.ts'
   149	  mk_tx "$p/tx.jsonl" neutral
   150	  run_stop "$p" "$p/tx.jsonl"
   151	  if [ "$DID_RUN" -ne 1 ];             then why='훅 미실행'
   152	  elif contains "$ERR" "$TOK_RET";     then why='위양성 — 회수 게이트가 막았다'
   153	  elif [ "$RC" -ne 2 ];                then why="rc=$RC (기대 2 — 감사 게이트)"
   154	  elif ! contains "$ERR" "$TOK_AUDIT"; then why="감사 게이트 미도달 = 아무것도 안 쟀다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   155	  elif ! flag_gone "$p";               then why='플래그가 자동 해제되지 않았다'
   156	  fi
   157	  report "$name" "$why"
   158	}
   159	
   160	r02() { # `없음(사유)` 형식도 정상 표명이다.
   161	  local name='r02 없음(사유) 형식 → 통과' why=''
   162	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   163	  mk_doc "$p/_workspace/00_design.md" '사전 결정 회수: 없음(진입점 미설정 — 새 프로젝트)'
   164	  set_flag "$p" retrieval '_workspace/00_design.md'
   165	  set_flag "$p" audit 'src/x.ts'
   166	  mk_tx "$p/tx.jsonl" neutral
   167	  run_stop "$p" "$p/tx.jsonl"
   168	  if [ "$DID_RUN" -ne 1 ];             then why='훅 미실행'
   169	  elif contains "$ERR" "$TOK_RET";     then why='위양성 — 회수 게이트가 막았다'
   170	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   171	  elif ! flag_gone "$p";               then why='플래그 미해제'
   172	  fi
   173	  report "$name" "$why"
   174	}
   175	
   176	r03() { # 표명 없음 → 차단. 첫 줄이 `사전` 으로 시작하지만 완전한 접두어는 아니다 —
   177	        # 패턴을 `사전` 따위로 느슨하게 만드는 변이가 이 행에서 빨개진다.
   178	  local name='r03 첫 줄에 표명 없음 → 차단 + 파일명' why=''
   179	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   180	  mk_doc "$p/_workspace/00_design.md" '사전 결정 회수 없이 작성했다.'
   181	  set_flag "$p" retrieval '_workspace/00_design.md'
   182	  set_flag "$p" audit 'src/x.ts'
   183	  mk_tx "$p/tx.jsonl" neutral
   184	  run_stop "$p" "$p/tx.jsonl"
   185	  if [ "$DID_RUN" -ne 1 ];                       then why='훅 미실행'
   186	  elif [ "$RC" -ne 2 ];                          then why="rc=$RC (기대 2)"
   187	  elif ! contains "$ERR" "$TOK_RET";             then why="회수 게이트가 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   188	  elif ! contains "$ERR" '_workspace/00_design.md'; then why='불량 파일명이 메시지에 없다'
   189	  elif contains "$ERR" "$TOK_AUDIT";             then why='차단인데 감사 게이트까지 흘러갔다'
   190	  elif flag_gone "$p";                           then why='불량인데 플래그가 해제됐다'
   191	  fi
   192	  report "$name" "$why"
   193	}
   194	
   195	r04() { # 빈 파일 → 차단.
   196	  local name='r04 빈 파일 → 차단' why=''
   197	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   198	  mk_doc "$p/_workspace/00_design.md" EMPTY
   199	  set_flag "$p" retrieval '_workspace/00_design.md'
   200	  set_flag "$p" audit 'src/x.ts'
   201	  mk_tx "$p/tx.jsonl" neutral
   202	  run_stop "$p" "$p/tx.jsonl"
   203	  if ! contains "$ERR" "$TOK_RET"; then why='차단하지 않았다'
   204	  elif ! contains "$ERR" '비었';   then why='사유(빈 파일)가 메시지에 없다'
   205	  fi
   206	  report "$name" "$why"
   207	}
   208	
   209	r05() { # 접두어만 있고 내용이 없다 → 차단.
   210	  local name='r05 접두어 뒤 내용 없음 → 차단' why=''
   211	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   212	  mk_doc "$p/_workspace/00_design.md" '사전 결정 회수:   '
   213	  set_flag "$p" retrieval '_workspace/00_design.md'
   214	  set_flag "$p" audit 'src/x.ts'
   215	  mk_tx "$p/tx.jsonl" neutral
   216	  run_stop "$p" "$p/tx.jsonl"
   217	  if ! contains "$ERR" "$TOK_RET";      then why='차단하지 않았다'
   218	  elif ! contains "$ERR" '내용이 없음'; then why='사유(내용 없음)가 메시지에 없다'
   219	  fi
   220	  report "$name" "$why"
   221	}
   222	
   223	r06() { # 01_plan* 도 같은 계약이다.
   224	  local name='r06 01_plan 산출물도 대상 → 차단' why=''
   225	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   226	  mk_doc "$p/_workspace/01_plan.md" '계획: 이렇게 한다.'
   227	  set_flag "$p" retrieval '_workspace/01_plan.md'
   228	  set_flag "$p" audit 'src/x.ts'
   229	  mk_tx "$p/tx.jsonl" neutral
   230	  run_stop "$p" "$p/tx.jsonl"
   231	  if ! contains "$ERR" "$TOK_RET"; then why='차단하지 않았다'
   232	  elif ! contains "$ERR" '_workspace/01_plan.md'; then why='파일명이 없다'
   233	  fi
   234	  report "$name" "$why"
   235	}
   236	
   237	r07() { # 여러 파일 중 하나만 불량 → 차단하되 불량만 지목. 그리고 **듀얼리뷰 플래그가
   238	        # 함께 서 있어도 회수 게이트가 먼저 말한다** — 게이트를 3.5 뒤로 옮기는 변이가
   239	        # 여기서 빨개진다(순서는 계약이다 — ADR-0013 Stop 실행 순서).
   240	  local name='r07 다중 파일 부분 불량 → 불량만 지목 + 3.5 보다 앞' why=''
   241	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   242	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   243	  mk_doc "$p/_workspace/01_plan.md" '표명 없는 계획이다.'
   244	  set_flag "$p" retrieval '_workspace/00_design.md' '_workspace/01_plan.md'
   245	  set_flag "$p" dualreview '_workspace/00_design.md'
   246	  set_flag "$p" audit 'src/x.ts'
   247	  mk_tx "$p/tx.jsonl" neutral
   248	  run_stop "$p" "$p/tx.jsonl"
   249	  if ! contains "$ERR" "$TOK_RET";                    then why="회수 게이트가 먼저 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   250	  elif contains "$ERR" "$TOK_DUAL";                   then why='듀얼리뷰 게이트가 먼저/함께 말했다 (순서 위반)'
   251	  elif ! contains "$ERR" '_workspace/01_plan.md';     then why='불량 파일명이 없다'
   252	  elif contains "$ERR" "00_design.md — ";             then why='정상 파일이 불량으로 지목됐다'
   253	  fi
   254	  report "$name" "$why"
   255	}
   256	
   257	r08() { # 플래그 항목의 파일이 사라졌다 → 그 항목은 건너뛰고 해제한다(공시된 한계).
   258	        # 이 동작이 바뀌면(차단으로) 아카이브 턴이 벽돌이 된다 — 계약의 케이스화.
   259	  local name='r08 소실 항목 → 스킵 + 해제' why=''
   260	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   261	  set_flag "$p" retrieval '_workspace/00_design.md'   # 파일은 만들지 않는다
   262	  set_flag "$p" audit 'src/x.ts'
   263	  mk_tx "$p/tx.jsonl" neutral
   264	  run_stop "$p" "$p/tx.jsonl"
   265	  if contains "$ERR" "$TOK_RET";       then why='소실 항목을 차단했다'
   266	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   267	  elif ! flag_gone "$p";               then why='플래그가 해제되지 않았다 (갇힘 경로)'
   268	  fi
   269	  report "$name" "$why"
   270	}
   271	
   272	r09() { # 게이트를 끄면 검사도 갇힘도 없다 — 같은 상태에서 **다음 턴**(다른 플래그가
   273	        # 다 지워진 읽기 전용 턴)도 조기 종료로 통과해야 한다. retrieval_pending 이
   274	        # 훅 비활성을 접지 않으면 남은 플래그가 조기 종료를 막아 빈 감사 차단이 난다.
   275	  local name='r09 stop:retrieval 비활성 → 검사 생략 + 다음 턴 조기 종료' why=''
   276	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   277	  mk_doc "$p/_workspace/00_design.md" '표명 없는 설계다.'
   278	  set_flag "$p" retrieval '_workspace/00_design.md'
   279	  set_flag "$p" audit 'src/x.ts'
   280	  mk_tx "$p/tx.jsonl" neutral
   281	  run_stop "$p" "$p/tx.jsonl" ECC_DISABLED_HOOKS=stop:retrieval
   282	  if contains "$ERR" "$TOK_RET"; then why='비활성인데 회수 게이트가 말했다'
   283	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   284	  else
   285	    rm -f "$p/.claude/.needs-audit"     # 다음 턴: 감사까지 끝난 읽기 전용 턴
   286	    run_stop "$p" "$p/tx.jsonl" ECC_DISABLED_HOOKS=stop:retrieval
   287	    if [ "$RC" -ne 0 ]; then why="다음 턴 rc=$RC (기대 0 — 남은 회수 플래그가 조기 종료를 막았다): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   288	    fi
   289	  fi
   290	  report "$name" "$why"
   291	}
   292	
   293	r10() { # 발동 조건은 플래그다 — 파일만 있고 플래그가 없으면 검사하지 않는다.
   294	  local name='r10 플래그 없음 → 발동 안 함' why=''
   295	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   296	  mk_doc "$p/_workspace/00_design.md" '표명 없는 설계다.'
   297	  set_flag "$p" audit 'src/x.ts'
   298	  mk_tx "$p/tx.jsonl" neutral
   299	  run_stop "$p" "$p/tx.jsonl"
   300	  if contains "$ERR" "$TOK_RET"; then why='플래그 없이 발동했다'
   301	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   302	  fi
   303	  report "$name" "$why"
   304	}
   305	
   306	r11() { # 상대경로 항목은 $PROJECT_DIR 기준으로 열린다. run_stop 이 cwd 를 TMPROOT 로
   307	        # 두므로, cwd 기준으로 여는 구현이면 파일이 "소실"로 오인돼 이 차단이 사라진다.
   308	  local name='r11 상대경로 항목 — 다른 cwd 에서도 판정' why=''
   309	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   310	  mk_doc "$p/_workspace/00_design.md" '표명 없는 설계다.'
   311	  set_flag "$p" retrieval '_workspace/00_design.md'
   312	  set_flag "$p" audit 'src/x.ts'
   313	  mk_tx "$p/tx.jsonl" neutral
   314	  run_stop "$p" "$p/tx.jsonl"
   315	  if ! contains "$ERR" "$TOK_RET"; then why="차단하지 않았다 (상대경로가 cwd 기준으로 열렸을 가능성): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   316	  fi
   317	  report "$name" "$why"
   318	}
   319	
   320	r12() { # 절대경로 항목(프로젝트 밖) + 상대·절대 혼재. 밖 파일이 불량이면 차단.
   321	  local name='r12 절대경로·혼재 항목 판정' why=''
   322	  local p out; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   323	  out="$(mktemp -d "$TMPROOT/outside.XXXXXX")" || { report "$name" '픽스처 실패'; return 0; }
   324	  mkdir -p "$out/_workspace"
   325	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   326	  mk_doc "$out/_workspace/01_plan.md" '표명 없는 밖 계획이다.'
   327	  set_flag "$p" retrieval '_workspace/00_design.md' "$out/_workspace/01_plan.md"
   328	  set_flag "$p" audit 'src/x.ts'
   329	  mk_tx "$p/tx.jsonl" neutral
   330	  run_stop "$p" "$p/tx.jsonl"
   331	  if ! contains "$ERR" "$TOK_RET";              then why='차단하지 않았다'
   332	  elif ! contains "$ERR" "$out/_workspace/01_plan.md"; then why='밖 불량 파일명이 없다'
   333	  fi
   334	  report "$name" "$why"
   335	}
   336	
   337	r13() { # fail-closed 두 축: ① 플래그 파일 자체를 읽을 수 없다 → 차단(사유 포함)
   338	        #                   ② 대상 파일이 있는데 읽을 수 없다 → 불량으로 차단
   339	  local name='r13 읽기 실패는 통과가 아니다 (플래그·대상)' why=''
