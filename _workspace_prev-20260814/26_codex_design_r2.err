   125	    if [ "$new_fp" != "$prev_fp" ]; then
   126	      count=0   # 지난 차단과 다른 게이트/플래그 집합 = 진전 — 예산 리셋
   127	    fi
   128	  fi
   129	  if [ "$count" -ge "$MAX_BLOCKS" ]; then
   130	    changed="$(cat "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" 2>/dev/null | tr -d '"\\' | sort -u | tr '\n' ' ')"
   131	    rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
   132	    # 판독 불가 사유도 함께 싣는다. 여기서 빠뜨리면 **예산이 소진된 턴에 발생한**
   133	    # 판독 불가가 영구 소실된다 — 게이트 메시지가 이 경로로는 안 나가기 때문이다([cx] 2라운드).
   134	    printf '{"systemMessage":"[완료 게이트] 같은 지점(%s)에서 %s회 차단 후에도 진전이 없어 세션 벽돌 방지를 위해 통과시킵니다. 이 턴의 완료 주장(및 변경 설명)을 신뢰하지 마세요. 미처리 변경: %s%s"}\n' \
   135	      "$1" "$MAX_BLOCKS" "$changed" \
   136	      "${decision_note:+ / $decision_note}"
   137	    exit 0
   138	  fi
   139	}
   140	
   141	# 결정 게이트가 대화 기록을 못 읽었으면 **어느 게이트가 막든** 그 사유를 함께 낸다.
   142	# 감사 게이트에만 실으면, 앞 게이트가 먼저 막은 턴에는 안 보이고 그 플래그를 지운 다음
   143	# 턴에는 조기 종료로 **영영 사라진다**(검수 [cx] 지적). 조용히 사라지는 것이 이 게이트를
   144	# 만든 이유 그 자체라, 경고를 삼키지 않는 것이 fail-open 의 조건이다.
   145	emit_decision_note() {
   265	      echo "  - 그래도 걸리면 사용자에게 위양성임을 알리고 지시를 받으세요."
   266	      echo
   267	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:decision"
   268	    } >&2
   269	    bump_and_block
   270	  fi
   271	fi
   272	
   273	# (3.4) **회수 표명 게이트** (ADR-0013) — 설계·계획 산출물의 첫 줄이 `사전 결정 회수:`
   274	#      표명 형식을 지키는지 본다. 표명 첫 줄은 ADR-0009 가 만든 계약인데 그 검증이
   275	#      산문("확인한다 — 없으면 되돌린다")으로만 있었다 — 산문 승격 부류다.
   276	#
   277	#      **형식만 본다.** 진짜 읽었는지는 기계가 못 본다(내용 검증은 층 위반 — ADR-0013 ④).
   278	#      **자동 해제** — 형식을 지키면 이 게이트가 스스로 플래그를 지운다. 지울 플래그를
   279	#      에이전트 손에 주지 않는 것이 이 게이트의 형태다(결정 게이트의 "실제로 물으면
   280	#      풀린다"와 같은 구조).
   281	#      **듀얼리뷰(3.5)보다 앞** — 표명 없는 산출물로 리뷰에 노력을 쓰기 전에 잡는 편이
   282	#      싸다. 정확성 문제가 아니라 비용 문제다(ADR-0012 ④와 같은 논리).
   283	if retrieval_pending; then
   284	  if [ ! -r "$RETRIEVAL_FLAG" ]; then
   285	    # 플래그는 서 있는데(-s) 읽을 수 없다 — "검사 대상 0건"으로 위장되면 조용한 통과라
   286	    # fail-closed 로 차단한다. 무엇이 대상이었는지조차 모르는 상태다.
   287	    gate_budget "retrieval:unreadable-flag"
   288	    {
   289	      echo "[완료 차단] 회수 표명 검사 불가 — 플래그 파일을 읽을 수 없습니다: $RETRIEVAL_FLAG"
   290	      echo "권한·손상을 확인한 뒤 다시 종료하세요."
   291	      emit_decision_note
   292	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
   293	    } >&2
   294	    bump_and_block
   295	  fi
   296	  retrieval_bad_paths=""   # 불량 항목의 경로(정렬 전, 줄 단위) — 예산 키용
   297	  retrieval_bad_msgs=""    # "경로 — 사유" (차단 메시지용)
   298	  # `|| [ -n "$entry" ]` 가 필수다: 마지막 줄이 개행 없이 끝나면 read 가 값을 담고도
   299	  # rc=1 을 내 본문이 안 돌고, 그 항목이 **조용히 스킵**된다 — record_flag 쓰기가
   300	  # 중단된 플래그에서 표명 없는 산출물이 통과하는 경로였다(구현 검수 [cx] HIGH).
   301	  while IFS= read -r entry || [ -n "$entry" ]; do
   302	    [ -n "$entry" ] || continue                     # 빈 줄은 기록 계약 밖 — 건너뛴다
   303	    case "$entry" in
   304	      /*) rfile="$entry" ;;
   305	      # 기록값 계약(mark-needs-audit): 프로젝트 안은 상대경로다. 훅 실행 cwd 가 아니라
   306	      # **$PROJECT_DIR 기준**으로 연다 — cwd 기준이면 다른 곳에서 실행된 턴에 전부
   307	      # "소실"로 오인돼 불량이 조용히 통과한다([cc·cx] 검수).
   308	      *)  rfile="$PROJECT_DIR/$entry" ;;
   309	    esac
   310	    # 소실은 건너뛴다. 차단하면 산출물을 아카이브한 턴이 벽돌이 된다(고칠 대상이 없다).
   311	    # 이 스킵이 삭제 우회를 연다는 것은 ADR-0013 이 공시한다 — 실존 검증은 감사자 몫.
   312	    [ -e "$rfile" ] || continue
   313	    if [ ! -r "$rfile" ]; then
   314	      retrieval_bad_paths="${retrieval_bad_paths}${entry}
   315	"
   316	      retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일을 읽을 수 없음
   317	"
   318	      continue
   319	    fi
   320	    rline=""
   321	    IFS= read -r rline < "$rfile" || true
   322	    # 첫 줄 판정 전에 선두 BOM·후행 CR 을 걷어낸다 — harness_env_value 가 같은 부류
   323	    # (눈에 안 보이는 바이트가 판정을 뒤집는 것)에 데인 전례가 있다.
   324	    rline="${rline#$'\xEF\xBB\xBF'}"
   325	    rline="${rline%$'\r'}"
   326	    case "$rline" in
   327	      "사전 결정 회수:"*)
   328	        if [ -z "$(printf '%s' "${rline#사전 결정 회수:}" | tr -d '[:space:]')" ]; then
   329	          retrieval_bad_paths="${retrieval_bad_paths}${entry}
   330	"
   331	          retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 표명 접두어 뒤에 내용이 없음
   332	"
   333	        fi
   334	        ;;
   335	      "")
   336	        retrieval_bad_paths="${retrieval_bad_paths}${entry}
   337	"
   338	        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일이 비었거나 첫 줄이 빈 줄
   339	"
   340	        ;;
   341	      *)
   342	        retrieval_bad_paths="${retrieval_bad_paths}${entry}
   343	"
   344	        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 첫 줄이 '사전 결정 회수:' 로 시작하지 않음
   345	"
   346	        ;;
   347	    esac
   348	  done < "$RETRIEVAL_FLAG"
   349	
   350	  if [ -z "$retrieval_bad_paths" ]; then
   351	    # 전부 형식 준수(또는 소실뿐) → 자동 해제. rm 이 실패하면 플래그가 남아 다음 턴에
   352	    # 다시 검사된다 — 게이트가 죽는 방향이 아니라 남는 방향이므로 조용해도 안전하다.
   353	    rm -f "$RETRIEVAL_FLAG" 2>/dev/null
   354	    # 지문을 다시 계산한다 — 진입 시 스냅숏에는 방금 지운 "r" 비트가 남아 있어, 이 턴의
   355	    # 하위 게이트가 stale 지문으로 예산을 매기고 다음 턴에 거짓 리셋이 난다([cc] HIGH).
   356	    compute_flags_fp
   357	    if ! work_pending; then
   358	      # 이 턴의 할 일이 이것뿐이었다 — 여기서 끝내지 않으면 맨 아래 감사 게이트가
   359	      # 빈 목록으로 허위 차단한다([cc·cx] 검수). 술어는 조기 종료와 같은 것을 쓴다 —
   360	      # push 미완·다른 플래그가 남았으면 아래 게이트들로 계속 흘러간다.
   361	      rm -f "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
   362	      if [ -n "${decision_note:-}" ]; then
   363	        # 경고를 삼키지 않는 것이 결정 게이트 fail-open 의 유일한 조건이다(ADR-0012 ②).
   364	        # 성공 경로에도 적용된다 — 예산 소진 경로가 같은 방식으로 싣는다.
   365	        printf '{"systemMessage":"참고: %s — 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."}\n' "$decision_note"
   366	      fi
   367	      exit 0
   368	    fi
   369	  else
   370	    # 예산 키는 게이트 자신에게만 결합한다. 불량 목록을 공유 지문(flags_fp)에 넣으면
   371	    # 다른 게이트의 예산까지 리셋된다. 목록이 줄면(파일을 고치면) 이 게이트의 카운터만
   372	    # 리셋된다 — push 가 "몇 개 남았나"를 지문에 넣는 것과 같은 의도다.
   373	    # 파이프가 실패하거나 빈 값을 내면(제한된 PATH·I/O 오류) 예산 키가 비어 "진전이
   374	    # 리셋을 못 만드는" 상태가 된다([cx] 지적) — 외부 명령 없는 bash 치환으로 폴백한다.
   375	    # 폴백은 정렬이 없어 키 안정성이 낮지만, 같은 플래그 파일은 순서가 유지되므로 실효는 같다.
   376	    retrieval_bad_sorted="$(printf '%s' "$retrieval_bad_paths" | sort -u | tr '\n' ' ')" \
   377	      || retrieval_bad_sorted=""
   378	    [ -n "$retrieval_bad_sorted" ] || retrieval_bad_sorted="${retrieval_bad_paths//$'\n'/ }"
   379	    gate_budget "retrieval:${retrieval_bad_sorted}"
   380	    {
   381	      echo "[완료 차단] 설계·계획 산출물에 회수 표명이 없습니다 — 선행 결정을 회수하지 않고 만든 산출물로는 끝낼 수 없습니다."
   382	      echo
   383	      echo "형식이 어긋난 파일:"
   384	      printf '%s' "$retrieval_bad_msgs" | sed 's/^/  - /'
   385	      echo
   386	      echo "해야 할 일:"
   387	      echo "  1. 프로필 9절의 지식 진입점을 읽고, 이번 작업과 관련된 항목만 따라가 읽는다."
   388	      echo "  2. 산출물 **첫 줄**에 표명을 적는다:"
   389	      echo "     사전 결정 회수: <읽은 경로>     또는     사전 결정 회수: 없음(<사유>)"
   390	      echo "     이어서 회수 블록: - 걸리는 선행 결정: <제목 — 한 줄> (없으면 \"걸리는 선행 결정 없음\")"
   391	      echo "  3. 형식을 지키면 이 게이트는 스스로 풀립니다 — 지울 플래그가 없습니다."
   392	      echo
   393	      echo "이 게이트는 형식만 봅니다. 진짜 읽었는지는 검수(plan-reviewer·codex)가 봅니다."
   394	      emit_decision_note
   395	      echo
   396	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:retrieval"
   397	    } >&2
   398	    bump_and_block
   399	  fi
   400	fi
   401	
   402	# (3.5) 듀얼 리뷰(codex) 게이트 (2026-08-03 kty — "리뷰가 필요한 모든 단계를 codex와 같이"의 기계화).
   403	#      설계·계획 산출물이 저장되거나 코드가 바뀐 턴은 codex 독립 리뷰 없이 끝낼 수 없다.
   404	#      Claude 단독 리뷰가 놓친 CRITICAL을 codex가 잡은 실사고(2026-08-03 POK-30)의 재발 방지.
   405	if [ -s "$DUALREVIEW_FLAG" ] && ! hook_disabled "stop:dualreview"; then
    35	  [ -f "$HOOKS/$f" ] || { echo "✗ 훅을 찾지 못했습니다: $f" >&2; exit 1; }
    36	done
    37	
    38	TMPROOT="$(mktemp -d)" || exit 1
    39	if [ -z "$TMPROOT" ] || [ ! -d "$TMPROOT" ]; then
    40	  echo "✗ 임시 디렉토리를 만들지 못했습니다" >&2; exit 1
    41	fi
    42	TMPROOT="$(CDPATH='' cd -- "$TMPROOT" && pwd -P)"
    43	# chmod 000 픽스처(r13)가 있으므로 되돌린 뒤 지운다.
    44	trap 'chmod -R u+rwX "$TMPROOT" 2>/dev/null; rm -rf "$TMPROOT"' EXIT
    45	
    46	ran=0; pass=0; fail=0
    47	RC=999; ERR=''; OUT=''; DID_RUN=0
    48	
    49	# 판정 토큰 — 각 게이트 메시지의 고유 문구. 어느 게이트가 말했는지는 이걸로만 갈린다.
    50	TOK_RET='회수 표명이 없습니다'
    51	TOK_RET_FLAGFAIL='회수 표명 검사 불가'
    52	TOK_AUDIT='completion-auditor 미실행'
    53	TOK_PUSH='커밋이 원격에 없습니다'
    54	TOK_KNOW='지식 저장소 반영 미확인'
    55	TOK_DUAL='codex 듀얼 리뷰 미수행'
    56	TOK_DECISION='혼자 정한 것이 있는데'
    57	TOK_NOTE='결정 게이트 생략'
    58	TOK_BRICK='세션 벽돌 방지'
    59	
    60	report() {
    61	  ran=$((ran + 1))
    62	  if [ -z "$2" ]; then pass=$((pass + 1)); printf '  ✓ %s\n' "$1"
    63	  else fail=$((fail + 1)); printf '  ✗ %s — %s\n' "$1" "$2"; fi
    64	}
    65	
    66	contains() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
    67	
    68	# --- 픽스처 --------------------------------------------------------------
    69	
    70	# new_project — 케이스마다 독립 프로젝트(mktemp — 명령 치환 카운터는 서브셸에 갇힌다).
    71	# 타입체크·지식게이트는 리터럴로 비운다: 이 파일이 재는 것은 회수 게이트와 그 결합뿐이고,
    72	# 앞 게이트가 먼저 막으면 케이스가 회수 게이트에 도달조차 못 한 채 기대값이 우연히 맞는다.
    73	# 지식 게이트를 켤 케이스(r23)만 인자로 켠다.
    74	new_project() {   # $1 = 지식게이트 값(비우면 꺼짐)
    75	  local p
    76	  p="$(mktemp -d "$TMPROOT/proj.XXXXXX")" || return 1
    77	  mkdir -p "$p/.claude/hooks" "$p/.claude/harness" "$p/_workspace" || return 1
    78	  cp "$HOOKS/_common.sh" "$HOOKS/verify-before-stop.sh" "$HOOKS/mark-needs-audit.sh" "$p/.claude/hooks/" || return 1
    79	  printf 'HARNESS_TYPECHECK_CMD=""\nHARNESS_KNOWLEDGE_GATE="%s"\n' "${1-}" \
    80	    > "$p/.claude/harness/harness.env" || return 1
    81	  printf '%s\n' "$p"
    82	}
    83	
    84	# mk_tx <경로> <neutral|marker> — 최소 대화 기록. 결정 게이트(3.2)가 이 파일을 읽는다.
    85	#   neutral = 표지 어휘 없는 발화 (결정 게이트 침묵)
    86	#   marker  = 표지 어휘 + 서술형 (결정 게이트가 무장돼 있으면 차단)
    87	mk_tx() {
    88	  local tp="$1" kind="$2"
    89	  printf '%s\n' '{"type":"user","isSidechain":false,"message":{"role":"user","content":"작업해줘"}}' > "$tp" || return 1
    90	  case "$kind" in
    91	    neutral) printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"확인했습니다."}]}}' >> "$tp" ;;
    92	    marker)  printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"이건 범위 밖이라 그대로 뒀습니다."}]}}' >> "$tp" ;;
    93	  esac
    94	}
    95	
    96	# run_stop <프로젝트> <transcript경로|""> [env 인자...]
    97	run_stop() {
    98	  local p="$1" tp="$2"
    99	  shift 2
   100	  local errf="$TMPROOT/err.$$" outf="$TMPROOT/out.$$" payf="$TMPROOT/pay.$$"
   101	  RC=999; ERR=''; OUT=''; DID_RUN=1
   102	  python3 -c '
   103	import json, sys
   104	d = {"stop_hook_active": False}
   105	if sys.argv[1]:
   106	    d["transcript_path"] = sys.argv[1]
   107	with open(sys.argv[2], "w", encoding="utf-8") as fh:
   108	    fh.write(json.dumps(d))' "$tp" "$payf"
   109	  # cwd 를 프로젝트가 아닌 곳(TMPROOT)으로 둔다 — 상대경로 항목을 cwd 기준으로 여는
   110	  # 구현이면 여기서 전부 "소실"이 되어 r11 이 빨개진다. 이 디렉토리 선택이 곧 픽스처다.
   111	  ( cd "$TMPROOT" && env -u HARNESS_HOOKS -u ECC_DISABLED_HOOKS ${@+"$@"} CLAUDE_PROJECT_DIR="$p" \
   112	      bash "$p/.claude/hooks/verify-before-stop.sh" <"$payf" >"$outf" 2>"$errf" )
   113	  RC=$?
   114	  rm -f "$payf"
   115	  ERR="$(cat "$errf" 2>/dev/null)"
   116	  OUT="$(cat "$outf" 2>/dev/null)"
   117	  rm -f "$errf" "$outf"
   118	}
   119	
   120	# set_flag <프로젝트> <이름> <값...> — 플래그에 줄들을 기록한다.
   121	set_flag() {
   122	  local p="$1" name="$2"; shift 2
   123	  : > "$p/.claude/.needs-$name"
   124	  local v
   125	  for v in "$@"; do printf '%s\n' "$v" >> "$p/.claude/.needs-$name"; done
   126	}
   127	
   128	# mk_doc <경로> <첫줄|"EMPTY"> — 산출물 파일을 만든다.
   129	mk_doc() {
   130	  local f="$1" first="$2"
   131	  case "$first" in
   132	    EMPTY) : > "$f" ;;
   133	    *) printf '%s\n본문.\n' "$first" > "$f" ;;
   134	  esac
   135	}
   136	
   137	GOOD_FIRST='사전 결정 회수: docs/decisions/'
   138	flag_gone() { [ ! -e "$1/.claude/.needs-retrieval" ]; }
