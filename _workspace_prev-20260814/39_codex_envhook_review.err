+# 보존)이 **반대 방향**이다(rc=0 빈 값 vs rc=3). 그리고 부재(rc=3)와 문법 밖(rc=1)을
+# 하나로 뭉치면, 편집 검증 훅(check-harness-env)이 안 쓰는 키의 정상 설정에도 경고를
+# 내게 된다 — 경고가 소음이 되면 진짜 경고도 무시된다(ADR-0016). 3 을 쓰는 이유는
+# decision_scan 과 같다: awk 자체의 비정상 종료(rc=2 등)가 정상 부재로 위장되지 않게
+# 정상 경로에 흔한 코드를 주지 않는다. **기존 호출부는 전부 "rc!=0 = 못 믿음/부재"로
+# 처리하므로 1↔3 구분 추가는 동작을 바꾸지 않는다** — 구분을 소비하는 곳만 갈라 읽는다.
 #
 # ── 지원 문법 (좁게 고정했다. 이 밖은 전부 rc=1) ───────────────────────
 #   KEY=값  ·  export KEY=값   (export 뒤는 공백 또는 탭)
 #   값: "겹따옴표"  ·  '홑따옴표'  ·  인용 없는 평문
 #   닫는 따옴표 뒤에는 **공백**과 `# 주석` 만 올 수 있다 (`""#on` 은 문법 밖 — 셸에서
 #     그 값은 `#on` 이라 비어 있지 않은데, 주석으로 읽으면 게이트가 꺼지는 방향이다)
 #   인용 없는 값은 **공백에 이어지는 `#`** 부터가 주석이다 (`a#b`·`#on` 은 값 그대로)
 # ── 지원하지 않는 것 (조용히 절반만 읽지 않고 rc=1 로 떨어진다) ────────
 #   등호 바로 뒤의 공백(`KEY= x`) · 백슬래시 이스케이프 · 한 줄에 인용 조각 여러 개 ·
 #   여러 줄 값 · 닫히지 않은 따옴표
 #
 # 판독 모델: **선행 공백이 없는 최상위 대입만** 선언으로 센다. 조건문·함수 본문 안의
 # 대입은 실행되지 않을 수도 있어 원문만으로는 발효 여부를 알 수 없다.
 # 선언이 2개 이상이면 어느 것이 이기는지 원문으로 알 수 없으므로 rc=1 이다.
 #
 # **인용 상태는 줄을 넘어 이어진다.** 셸의 인용은 개행에서 끝나지 않으므로, 다른 키의
 # 여러 줄 값 본문 안에 이 키가 나타나도 그건 선언이 아니다. 이걸 줄 단위로만 보면
 # `NOTES='...(개행)KEY=(개행)...'` 이 유일한 선언으로 판독돼 게이트가 꺼진다(실측).
 #
 # 히어독: `<<WORD`·`<<-WORD`·`<<'WORD'`·`<<"WORD"`·`<<\WORD` 를 인용 상태를 보며 찾아
 # 본문을 건너뛴다(`"a << b"` 는 히어독이 아니다). 탐지가 어느 쪽으로 틀려도 결과는 rc=1 로
 # 수렴한다 — 히어독을 놓치면 선언이 2개가 되고, 없는 히어독을 만들면 0개가 된다.
 # EOF 까지 히어독이나 인용이 안 닫히면 파일을 못 믿는 것이므로 역시 rc=1.
 # 한 줄에 히어독이 둘이면 첫 개만 본다.
 #
 # 알려진 한계: 값 안의 `$VAR`·`$(...)` 는 **판독 시점에 확장되지 않는다** — 원문 그대로
 # 값이 된다. 다만 그 값은 결국 `sh -c` 로 넘어가므로 **실행 시점에는 확장된다**
 # (실측: `HARNESS_TYPECHECK_CMD='printf $HOME'` → 실행하면 홈 경로가 찍힌다).
 # 즉 "확장되지 않는다"가 아니라 "**나중에** 확장된다"이다. 확장이 곤란한 자리라면
 # 그 자리에 최종 문자열을 적어야 한다.
+# 둘째 인자(선택)로 판독할 파일을 지정할 수 있다 — 편집 검증 훅이 "방금 편집된 그 파일"을
+# 읽어야 하기 때문이다(다른 프로젝트의 harness.env 편집도 그 파일 기준으로 판정).
+# 생략하면 이 프로젝트의 정본 경로다.
 harness_env_value() {
-  local file="$STATE_DIR/harness/harness.env" key="$1" val rc
-  [ -f "$file" ] || { printf '%s' ''; return 1; }
+  local file="${2:-$STATE_DIR/harness/harness.env}" key="$1" val rc
+  [ -f "$file" ] || { printf '%s' ''; return 3; }
   if [ ! -r "$file" ]; then
     # "미설정"과 "읽기 실패"는 다르다. 판정은 같게(rc=1) 가되 실패는 소리를 낸다.
     printf '[하네스] harness.env 를 읽지 못했습니다 — 미설정으로 봅니다: %s\n' "$file" >&2
     printf '%s' ''
     return 1
   fi
   # LC_ALL=C 여야 substr 이 바이트 단위로 동작해 BOM 3바이트를 정확히 떼어낸다.
   val="$(LC_ALL=C awk -v key="$key" -v bom="$(printf '\357\273\277')" '
 function ltrim(s) { sub(/^[ \t]+/, "", s); return s }
 function rtrim(s) { sub(/[ \t]+$/, "", s); return s }
 
 # 히어독 시작을 찾는다. 따옴표 안의 `<<` 와 주석 뒤의 `<<` 는 히어독이 아니다.
 # 인용 상태 OPENQ 는 **줄을 넘어 이어진다.** 셸의 인용은 개행에서 끝나지 않기 때문이다 —
 # 다른 키의 여러 줄 값 본문 안에 우리 키가 있으면 그건 선언이 아니다. 이걸 줄 단위로만
 # 보면 다른 키의 여러 줄 값 안에 있는 우리 키가 유일한 선언으로 판독돼
 # **게이트가 꺼진다**(실측). 그래서 이 함수는 줄마다 OPENQ 를 이어받아 갱신한다.
 function scan_line(s,   n, i, j, c, t, dash, q2) {
   n = length(s); i = 1
   while (i <= n) {
     c = substr(s, i, 1)
     if (OPENQ != "") { if (c == OPENQ) OPENQ = ""; i++; continue }
     if (c == "\\") { i += 2; continue }                            # 백슬래시 이스케이프
     if (c == "\"" || c == SQ) { OPENQ = c; i++; continue }
     if (c == "#" && (i == 1 || substr(s, i - 1, 1) == " " || substr(s, i - 1, 1) == "\t")) return
     if (c == "<" && substr(s, i + 1, 1) == "<") {
       if (substr(s, i + 2, 1) == "<") { i += 3; continue }         # <<< 는 히어스트링
       j = i + 2; dash = 0
       if (substr(s, j, 1) == "-") { dash = 1; j++ }
       while (substr(s, j, 1) == " " || substr(s, j, 1) == "\t") j++
       t = ""
       # 종결어는 인용을 **섞을 수 있다**: EOF · "EOF" · EO"F" · \\EOF · E\\OF 가 전부
       # 같은 종결어 EOF 다. 한 형태만 읽으면 나머지에서 본문을 안 건너뛰고, 그 안의 빈
       # 게이트 선언이 진짜 선언으로 판독돼 **게이트가 꺼진다**. 그래서 조각을 이어 붙인다.
       while (j <= n) {
         c = substr(s, j, 1)
         if (c == " " || c == "\t" || c == ";" || c == "&" || c == "|" || c == ">" || c == "<") break
         if (c == "\\") { j++; if (j <= n) { t = t substr(s, j, 1); j++ } ; continue }
         if (c == "\"" || c == SQ) {
           q2 = c; j++
           while (j <= n && substr(s, j, 1) != q2) { t = t substr(s, j, 1); j++ }
           j++
           continue
         }
         t = t c; j++
       }
       if (t != "") { INHD = 1; HTERM = t; HDASH = dash; return }
       i = j
       continue
     }
     i++
   }
 }
 
 # 지원 문법대로 값을 판독한다. 문법 밖이면 BAD 를 세운다(빈 값으로 위장하지 않는다).
 function parse_value(v,   q, rest, e, out, tail, i, c, p) {
   if (v == "") return ""
   # **등호 바로 뒤의 공백은 지원하지 않는다(rc=1).** 셸은 `KEY= x` 를 "빈 값 대입 + 명령 x"
   # 로 읽는데, 관대하게 값으로 삼으면 셸과 반대 방향으로 갈리고, 빈 값으로 삼으면
   # `KEY=  "on"` 이 조용히 게이트를 끈다. 어느 쪽도 안전하지 않아 문법 밖으로 돌린다.
   if (substr(v, 1, 1) == " " || substr(v, 1, 1) == "\t") { BAD = 1; return "" }
   q = substr(v, 1, 1)
   if (q == "\"" || q == SQ) {
     rest = substr(v, 2)
     e = index(rest, q)
     if (e == 0) { BAD = 1; return "" }                             # 닫히지 않은 따옴표
     out = substr(rest, 1, e - 1)
     tail = substr(rest, e + 1)
     if (tail != "") {
       # 닫는 따옴표 **바로 뒤**에는 공백이 와야 한다. `KEY=""#on` 은 셸에서 값이 `#on`
       # (비어 있지 않다)인데, 여기서 `#` 을 주석으로 받으면 빈 값이 되어 **게이트가 꺼진다.**
       if (substr(tail, 1, 1) != " " && substr(tail, 1, 1) != "\t") { BAD = 1; return "" }
       tail = ltrim(tail)
       if (tail != "" && substr(tail, 1, 1) != "#") { BAD = 1; return "" }   # 따옴표 뒤 잡음
     }
     return out
   }
   # 인용 없는 값에서 `#` 은 **공백 뒤에서만** 주석을 연다. `KEY=#on` 의 값은 셸에서
   # `#on` 이다 — 여기서 빈 값으로 읽으면 그 역시 게이트를 끄는 방향이다.
   out = ""
   for (i = 1; i <= length(v); i++) {
     c = substr(v, i, 1)
     if (c == "#" && i > 1) {
       p = substr(v, i - 1, 1)
       if (p == " " || p == "\t") break
     }
     out = out c
   }
   return rtrim(out)
 }
 
 BEGIN {
   SQ = sprintf("%c", 39)
   N = 0; FOUND = ""; INHD = 0; HTERM = ""; HDASH = 0; BAD = 0; OPENQ = ""
   RX = "^(export[ \t]+)?" key "="
 }
 {
   line = $0
   sub(/\r$/, "", line)
   if (NR == 1 && substr(line, 1, 3) == bom) line = substr(line, 4)
 
   if (INHD) {
     t = line
     if (HDASH) sub(/^\t+/, "", t)
     if (t == HTERM) { INHD = 0; HTERM = "" }
     next
   }
 
   # **인용이 이전 줄에서 열린 채면 이 줄은 값의 본문이지 선언이 아니다.**
   # 이 검사가 없으면 다른 키의 여러 줄 값 안에 있는 우리 키가 유일한 선언으로 판독돼
   # 게이트가 꺼진다(실측). 판정 전에 물어야 한다.
   if (OPENQ == "") {
     # 선언 판정이 히어독 시작 판정보다 **먼저**다: `KEY=v <<EOF` 의 대입은 실제로 발효한다.
     if (line ~ RX) {
       N++
       if (N == 1) FOUND = substr(line, index(line, "=") + 1)
     }
   }
   scan_line(line)
 }
 END {
   if (INHD) exit 1          # 히어독이 EOF 까지 안 닫혔다 = 탐지가 빗나갔다
   if (OPENQ != "") exit 1   # 인용이 EOF 까지 안 닫혔다 = 파일을 못 믿는다
-  if (N != 1) exit 1
+  if (N == 0) exit 3        # 부재 — 안 쓰는 키의 정상 상태 (반환 계약 rc=3)
+  if (N > 1) exit 1
   v = parse_value(FOUND)
   if (BAD) exit 1
   printf "%s", v
   exit 0
 }
 ' "$file" 2>/dev/null)"
   rc=$?
-  [ "$rc" -eq 0 ] || { printf '%s' ''; return 1; }
-  printf '%s' "$val"
-  return 0
+  case "$rc" in
+    0) printf '%s' "$val"; return 0 ;;
+    3) printf '%s' ''; return 3 ;;
+    # 그 밖(1 = 못 믿음, awk 비정상 종료 2·126·127 포함)은 전부 "못 믿음"으로 접는다 —
+    # fail-closed. 부재로 위장되면 편집 검증 훅이 진짜 실수를 침묵으로 놓친다.
+    *) printf '%s' ''; return 1 ;;
+  esac
 }
 
 # 지식 반영 게이트가 켜져 있는가 (rc=0 켜짐 / rc=1 꺼짐).
 #
 # 하네스가 소유하는 것은 **계약 하나**뿐이다 — "지식 저장소가 설정돼 있으면, 결정·설계가
 # 나온 턴은 반영 없이 끝낼 수 없다." 어디에 어떤 구조로 반영하는지는 이 층이 모른다.
 # 그래서 필요한 것도 1비트뿐이고, 그 1비트를 얻으려고 파일을 실행하지 않는다.
 #
 # **기본이 켜짐인 것이 이 함수의 핵심이다.** 기존 설치본에는 이 키가 아예 없는데,
 # 없을 때 "꺼짐"으로 읽으면 하네스를 갱신하는 순간 게이트가 **조용히 꺼진다** — 사용자는
 # 지식이 쌓인다고 믿는데 그 턴부터 아무것도 안 남는다. 표명이 없으면 이전 동작을 보존한다.
 # 선언이 2개 이상이거나 문법 밖일 때도 같은 이유로 켠다(rc=1 → 켜짐).
 #
 # 끄는 방법은 **값을 리터럴로 비우는 것 하나뿐**이다: HARNESS_KNOWLEDGE_GATE=""
 # `="off"` 는 켜진 것으로 읽힌다 — 비어 있지 않기 때문이다. harness.env 주석에 명시돼 있다.
 harness_knowledge_gate_on() {
   local v
   v="$(harness_env_value HARNESS_KNOWLEDGE_GATE)" || return 0   # 값을 못 믿으면 켠다
   [ -n "$v" ]                                                   # 리터럴로 비었을 때만 꺼짐
 }
 
 # 지식 게이트가 이번 턴에 **발효 중인가** — 플래그가 섰고 게이트도 켜져 있는가.
 # 판정을 이 한 곳에 모은다. 두 군데서 따로 물으면 "게이트를 껐는데 남아 있던 플래그가
 # 읽기 전용 턴의 조기 종료를 막는" 종류의 어긋남이 생긴다.
 knowledge_gate_active() {
   [ -s "$KNOWLEDGE_FLAG" ] || return 1
   harness_knowledge_gate_on
 }
 
 # 회수 표명 게이트에 **할 일이 남았는가** — 플래그가 섰고 훅도 살아 있는가.
 #
 # 이름을 *_gate_active 로 짓지 않았다. knowledge_gate_active 는 "플래그 + harness.env
 # 스위치"이고 개별 훅 비활성(stop:knowledge)은 호출부가 따로 보는데, retrieval 은 env
 # 스위치가 없어 끄는 방법이 ECC_DISABLED_HOOKS=stop:retrieval **하나뿐**이다. 그래서
 # 비활성이 곧 "할 일 없음"이고 이 함수 하나에 접는다 — 안 접으면 게이트를 끈 환경에서
 # 남은 플래그가 영영 안 지워진 채 읽기 전용 턴의 조기 종료를 막고, 그 소음이 예산을
 # 소진시켜 다른 게이트 플래그까지 지워버린다(설계 검수 [cc] r2 H5 시나리오).
 # 플래그 5종 중 이것만 이런 의미라는 사실은 docs/usage.md 에 공시돼 있다.
 retrieval_pending() {
   [ -s "$RETRIEVAL_FLAG" ] || return 1
   ! hook_disabled "stop:retrieval"
 }
 
 # stdin 의 JSON 에서 점 경로로 값 하나를 뽑는다. 없거나 파싱 실패면 빈 문자열.
 # 훅 입력이 깨져도 절대 죽지 않는다 — 죽으면 오탐 차단이 된다.
 json_get() {
   python3 -c '
 import json, sys
 try:
     data = json.load(sys.stdin)
 except Exception:
     sys.exit(0)
 for key in sys.argv[1].split("."):
     if not isinstance(data, dict):
         sys.exit(0)
     data = data.get(key)
     if data is None:
         sys.exit(0)
 print(data)
 ' "$1" 2>/dev/null
 }
 
 # 이 턴의 대화 기록을 읽어 **"물어봤어야 할 것을 혼자 정했다"는 자백**을 찾는다.
 #
 # 왜 이런 게이트가 필요한가: 완료 게이트 넷(타입체크·듀얼리뷰·변경설명·지식반영)은 전부
 # **산출물**을 본다. 에이전트 자신의 행동을 겨눈 것은 없었고, 그 비대칭이 실물로 드러났다 —
 # 게이트가 막을 때는 세 번 다 따랐는데, 게이트가 없는 축에서는 전부 혼자 정하고 보고서에
 # 한 줄 적었다. 그 "한 줄"은 **도구 호출이 아니라 문장**이라 어떤 PreToolUse 훅도 볼 수 없고
 # 승인창도 안 뜬다(승인창은 *한 일*에만 뜬다). 그래서 Stop 이 대화 기록을 직접 읽는다.
 #
 # ── 판정 ─────────────────────────────────────────────────────────────
 #   결정 표지 어휘를 담은 **서술형** 문장이 있는데  AND  이 턴에 AskUserQuestion 이 0회
 #   → 차단. 질문을 한 번 하면 풀리므로 세션이 벽돌이 되지 않는다.
 #
 # 표지 어휘를 이렇게 고른 이유: 저 말들은 "물어봤어야 할 것을 혼자 정했다"를 **자백**할
 # 때만 나온다. 자백은 있는데 질문이 0회면 그 자체가 위반이다.
 #
 # ── 좁히는 장치 셋 (위양성 억제) ─────────────────────────────────────
 # 어휘만 보면 이 게이트를 **유지보수하는 작업 자체가 매번 걸린다** — 훅·테스트·결정 문서가
 # 그 어휘를 데이터로 품기 때문이다. 그러면 사람이 게이트를 끄게 되고 그게 최악이다.
diff --git a/template/.claude/hooks/check-harness-env.sh b/template/.claude/hooks/check-harness-env.sh
new file mode 100755
index 0000000..edd49cb
--- /dev/null
+++ b/template/.claude/hooks/check-harness-env.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# PostToolUse(Edit|Write|MultiEdit): harness.env 편집 직후, 알려진 키를 **실제 판독기로**
+# 읽어 "문법 밖이라 미설정으로 취급될" 키를 그 자리에서 알린다 (ADR-0016).
+#
+# 왜 필요한가: harness.env 는 실행되지 않고 좁은 문법으로 판독된다(_common.sh 주석).
+# 그 대가로 문법을 조금만 틀리면 값이 **조용히 미설정 취급**되고 해당 검사가 생략된다 —
+# 원인(편집 실수)과 발각(턴 종료 게이트 메시지) 사이가 멀수록 비싼, 조용한 실패 부류다.
+# 이 훅이 그 거리를 0 으로 줄인다.
+#
+# 판정은 harness_env_value 하나뿐이다 — **규칙의 사본을 만들지 않는다.** 훅이 문법을
+# 다시 해석하는 순간 두 규칙이 어긋나는 날이 온다. 그래서 판독기의 반환 계약(rc=1
+# 못 믿음 / rc=3 부재)을 소비만 한다: 부재는 안 쓰는 키의 정상 상태라 침묵하고,
+# "못 믿음"만 경고한다. 이 구분이 없으면 키를 안 쓰는 프로젝트의 모든 편집에 경고가
+# 떠서 경고가 소음이 된다.
+#
+# 알려진 키 목록은 여기가 유일 지점이다. 목록에 없는 키(오타 HARNESS_TYPECHEK_CMD 등)는
+# **못 잡는다** — 잡으려면 파일의 선언을 직접 파싱해야 하는데 그게 규칙의 사본이다(공시).
+#
+# PostToolUse 는 절대 차단하지 않는다(도구는 이미 실행됨). 항상 exit 0.
+# 셸 이식성: macOS 기본 bash 는 3.2 다. ${var,,}·mapfile·연관배열 금지.
+
+set -uo pipefail
+# shellcheck source=_common.sh
+. "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
+
+HOOK_ID="post:edit:harness-env"
+hook_disabled "$HOOK_ID" && exit 0
+
+KNOWN_KEYS="HARNESS_TYPECHECK_CMD HARNESS_KNOWLEDGE_GATE"
+
+payload="$(cat)"
+# 명령 치환의 후행 개행 흡수를 센티널로 막는다 — mark-needs-audit 와 같은 관용구.
+raw="$(printf '%s' "$payload" | json_get tool_input.file_path; printf 'X')"
+raw="${raw%X}"
+file_path="${raw%$'\n'}"
+[ -z "$file_path" ] && exit 0
+
+# 개행이 든 경로는 판정하지 않는다 — mark-needs-audit 가 이미 systemMessage 로 알린다.
+case "$file_path" in
+  *$'\n'*) exit 0 ;;
+esac
+
+# 이 훅의 대상은 하네스가 규정한 자리의 harness.env 뿐이다. 다른 이름·다른 자리는
+# 하네스 설정이 아니다(동명 파일 오탐 방지 — .claude/harness/ 앵커까지 요구).
+case "$file_path" in
+  */.claude/harness/harness.env|.claude/harness/harness.env) ;;
+  *) exit 0 ;;
+esac
+
+case "$file_path" in
+  /*) envfile="$file_path" ;;
+  *)  envfile="$PROJECT_DIR/$file_path" ;;
+esac
+
+bad_keys=""
+for key in $KNOWN_KEYS; do
+  # 판독기의 stderr(읽기 실패 경고)는 버린다 — 이 훅이 자기 메시지로 대신 알린다.
+  harness_env_value "$key" "$envfile" >/dev/null 2>&1
+  case "$?" in
+    0|3) ;;                              # 판독됨 / 부재(안 쓰는 키) — 정상, 침묵
+    *)   bad_keys="${bad_keys}${key} " ;;  # 못 믿음 — 경고 대상
+  esac
+done
+[ -z "$bad_keys" ] && exit 0
+
+# 키 이름은 [A-Z_] 뿐이라 JSON 이스케이프가 필요 없다. 경로는 넣지 않는다 —
+# 넣는 순간 이스케이프 기계장치가 딸려온다(mark-needs-audit 의 메시지 계약과 동일).
+printf '{"systemMessage":"harness.env 판독 경고: %s— 이 키는 값을 믿을 수 없어 미설정으로 취급되고, 해당 검사가 조용히 생략됩니다. 원인은 중복 선언·지원 문법 밖·닫히지 않은 따옴표·읽기 실패 중 하나입니다. 파일 첫머리의 문법 규칙을 확인하세요."}\n' "$bad_keys"
+exit 0
diff --git a/template/.claude/hooks/verify-before-stop.sh b/template/.claude/hooks/verify-before-stop.sh
index e5d6e03..bb83991 100644
--- a/template/.claude/hooks/verify-before-stop.sh
+++ b/template/.claude/hooks/verify-before-stop.sh
@@ -89,167 +89,170 @@ count=0
 if [ -f "$BLOCK_COUNT" ]; then
   count="$(tr -dc '0-9' < "$BLOCK_COUNT" 2>/dev/null)"
 fi
 [ -z "$count" ] && count=0
 prev_fp="$(cat "$BLOCK_FP" 2>/dev/null)"
 # 지문 = 서 있는 플래그의 집합(내용 아님). 내용을 넣으면 갇힌 채 새 파일만 편집해도
 # 리셋되고(무한 차단), cksum 충돌로 실제 진전이 리셋 안 될 수도 있다([cx] 지적).
 #
 # **함수인 이유:** 3.4 게이트가 실행 도중 자기 플래그를 지운다(자동 해제). 진입 시 1회
 # 스냅숏만 쓰면 그 턴의 하위 게이트(3.5~6)가 이미 지워진 "r" 비트가 든 stale 지문으로
 # 예산을 매기고, 다음 턴의 지문과 달라져 **진전이 아닌데 카운터가 리셋**된다 — 벽돌
 # 방지가 한 사이클 헛돈다(구현 검수 [cc]가 4회 연속 실행으로 재현: 1/3→1/3→2/3→3/3).
 compute_flags_fp() {
   flags_fp=""
   [ -s "$AUDIT_FLAG" ]      && flags_fp="${flags_fp}a"
   [ -s "$EXPLAIN_FLAG" ]    && flags_fp="${flags_fp}e"
   knowledge_gate_active     && flags_fp="${flags_fp}k"
   [ -s "$DUALREVIEW_FLAG" ] && flags_fp="${flags_fp}d"
   # 회수 플래그도 **존재 비트만** 넣는다. 불량 파일 목록은 retrieval 게이트 자신의 예산
   # 키에만 결합한다(아래 3.4) — 여기(공유 지문)에 넣으면 결정 게이트에 갇힌 채 불량 집합만
   # 바뀌어도 그쪽 예산이 리셋돼, 위 "내용을 넣으면"의 경고 그대로가 된다([cc·cx] 검수).
   retrieval_pending         && flags_fp="${flags_fp}r"
   # push 는 "몇 개 남았나"가 곧 진전이다. 지문에 안 넣으면 한 커밋씩 올리는 실제 진전이
   # 같은 지문으로 세어져 예산이 소진되고, 그때 감사 플래그까지 함께 지워진다([cx] 지적).
   [ -n "$push_unsent" ] && flags_fp="${flags_fp}p:${push_branch}:${push_unsent}"
 }
 flags_fp=""
 compute_flags_fp
 new_fp=""
 
 gate_budget() {  # $1 = 게이트 식별자. 각 차단 지점이 메시지 출력 전에 호출한다.
   new_fp="$1|$flags_fp"
   # 지문을 기록할 수 있을 때만 리셋한다 — 지문 파일을 못 쓰는 환경에서 리셋하면
   # prev_fp가 영원히 비어 매번 1/3로 무한 차단된다([cx] 지적). 그 경우 리셋 없는
   # 구식 누적으로 동작해 3회 후 통과가 보장된다.
   if printf '%s\n' "$new_fp" > "$BLOCK_FP" 2>/dev/null; then
     if [ "$new_fp" != "$prev_fp" ]; then
       count=0   # 지난 차단과 다른 게이트/플래그 집합 = 진전 — 예산 리셋
     fi
   fi
   if [ "$count" -ge "$MAX_BLOCKS" ]; then
     changed="$(cat "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" 2>/dev/null | tr -d '"\\' | sort -u | tr '\n' ' ')"
     rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
     # 판독 불가 사유도 함께 싣는다. 여기서 빠뜨리면 **예산이 소진된 턴에 발생한**
     # 판독 불가가 영구 소실된다 — 게이트 메시지가 이 경로로는 안 나가기 때문이다([cx] 2라운드).
     printf '{"systemMessage":"[완료 게이트] 같은 지점(%s)에서 %s회 차단 후에도 진전이 없어 세션 벽돌 방지를 위해 통과시킵니다. 이 턴의 완료 주장(및 변경 설명)을 신뢰하지 마세요. 미처리 변경: %s%s"}\n' \
       "$1" "$MAX_BLOCKS" "$changed" \
       "${decision_note:+ / $decision_note}"
     exit 0
   fi
 }
 
 # 결정 게이트가 대화 기록을 못 읽었으면 **어느 게이트가 막든** 그 사유를 함께 낸다.
 # 감사 게이트에만 실으면, 앞 게이트가 먼저 막은 턴에는 안 보이고 그 플래그를 지운 다음
 # 턴에는 조기 종료로 **영영 사라진다**(검수 [cx] 지적). 조용히 사라지는 것이 이 게이트를
 # 만든 이유 그 자체라, 경고를 삼키지 않는 것이 fail-open 의 조건이다.
 emit_decision_note() {
   [ -n "${decision_note:-}" ] || return 0
   echo
   echo "참고: $decision_note"
   echo "      → 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."
 }
 
 bump_and_block() {
   if ! printf '%s\n' "$((count + 1))" > "$BLOCK_COUNT" 2>/dev/null; then
     # 카운터를 못 쓰면 무한루프 위험 → 표준 가드로 폴백
     case "$stop_active" in
       [Tt]rue) exit 0 ;;
     esac
   fi
   exit 2
 }
 
 # (3) 타입체크 — 결정론적 바닥. 명령은 프로필에서 파생된 harness.env 에서 읽는다.
 #     HARNESS_TYPECHECK_CMD 가 비어 있으면(타입 없는 언어/미설정) 생략한다.
 #     이렇게 하면 이 훅이 특정 스택(pnpm/tsc)에 묶이지 않는다 — 도메인-무관 재사용.
 #     **이 파일을 실행하지 않는다.** source 하면 사용자 소유 셸 파일이 훅의 제어 흐름을
 #     가져간다 — `exit 0` 한 줄이면 이 훅이 조용히 끝나 **게이트 4종이 통째로 사라지고**
 #     흔적도 안 남는다. 원문 판독으로 그 부류를 없앤다(harness_env_value 주석 참조).
 typecheck_note=""
-#     rc 를 함께 받는다. "리터럴로 비웠다"(rc=0 + 빈 값 = 의도한 생략)와 "값을 믿을 수
-#     없다"(rc=1 = 미설정·선언 2개 이상·지원 문법 밖·읽기 실패)는 둘 다 생략으로 가지만
-#     사용자에게 **다른 정보**다. 후자는 고칠 수 있는 실수라 그렇게 적어야 한다.
+#     rc 를 함께 받는다. "리터럴로 비웠다"(rc=0 + 빈 값 = 의도한 생략) · "부재"(rc=3 =
+#     키를 안 씀) · "값을 믿을 수 없다"(rc=1 = 선언 2개 이상·지원 문법 밖·읽기 실패)는
+#     셋 다 생략으로 가지만 사용자에게 **다른 정보**다 — 마지막 것만 고칠 수 있는 실수라
+#     그렇게 적어야 한다(구분의 정본은 _common.sh 반환 계약 — ADR-0016).
 TYPECHECK_CMD="$(harness_env_value HARNESS_TYPECHECK_CMD)"; typecheck_rc=$?
 
-if [ "$typecheck_rc" -ne 0 ]; then
-  typecheck_note="타입체크 생략 (harness.env 의 HARNESS_TYPECHECK_CMD 를 읽지 못함 — 미설정이거나, 선언이 2개 이상이거나, 지원 문법 밖입니다)"
+if [ "$typecheck_rc" -eq 3 ]; then
+  typecheck_note="타입체크 생략 (HARNESS_TYPECHECK_CMD 미설정)"
+elif [ "$typecheck_rc" -ne 0 ]; then
+  typecheck_note="타입체크 생략 (harness.env 의 HARNESS_TYPECHECK_CMD 값을 믿을 수 없음 — 선언이 2개 이상이거나, 지원 문법 밖이거나, 읽기 실패입니다. 고칠 수 있는 실수입니다)"
 elif [ -z "$TYPECHECK_CMD" ]; then
   typecheck_note="타입체크 생략 (HARNESS_TYPECHECK_CMD 가 빈 값으로 설정됨)"
 else
   timeout_bin=""
   if command -v timeout >/dev/null 2>&1; then
     timeout_bin="timeout"
   elif command -v gtimeout >/dev/null 2>&1; then
     timeout_bin="gtimeout"
   fi
   # macOS 기본에는 timeout 이 없다. 그 경우 settings.json 의 "timeout": 120 이 최종 안전망.
 
   if [ -n "$timeout_bin" ]; then
     tc_out="$(cd "$PROJECT_DIR" && "$timeout_bin" 90 sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   else
     tc_out="$(cd "$PROJECT_DIR" && sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   fi
 
   if [ "$tc_rc" -eq 124 ] || [ "$tc_rc" -eq 137 ]; then
     # 타임아웃은 "타입 오류"가 아니라 "모름". 차단하지 않고 감사자에게 넘긴다.
     typecheck_note="타입체크 타임아웃 → 생략 (감사자가 재확인할 것)"
   elif [ "$tc_rc" -eq 127 ]; then
     # 명령/도구 없음(rc=127)은 "타입 오류"가 아니다. 오탐 차단 방지 위해 생략.
     typecheck_note="타입체크 생략 (명령 실행 불가 rc=127): $TYPECHECK_CMD"
   elif [ "$tc_rc" -ne 0 ]; then
     gate_budget "typecheck"
     {
       echo "[완료 차단] 타입체크 실패 — 지금은 '완료'가 아닙니다."
       echo
       echo "명령: $TYPECHECK_CMD"
       echo
       printf '%s\n' "$tc_out" | head -n 15
       echo
       echo "고친 뒤 다시 종료하세요.  (차단 $((count + 1))/${MAX_BLOCKS})"
       echo "탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=$HOOK_ID"
     } >&2
     bump_and_block
   fi
 fi
 
 # (3.2) **결정 게이트** — "물어봤어야 할 것을 혼자 정했나".
 #      나머지 게이트가 전부 **산출물**을 볼 때 이것만 **에이전트 자신의 행동**을 본다.
 #      판정 규칙·좁히는 장치 셋·fail-open 사유는 _common.sh 의 decision_scan 주석이 정본이다.
 #
 #      **타입체크 다음, 나머지 게이트보다 앞에 둔다.** 질문의 답이 코드를 바꿀 수 있으므로, 리뷰·설명·감사에
 #      노력을 쓰기 전에 묻는 편이 싸다. (push 탐지와 달리 순서가 정확성을 바꾸지는 않는다 —
 #      대화 기록은 이미 다 쓰였고 게이트 순서가 그 내용을 바꾸지 않기 때문이다.)
 decision_note=""
 # **발동 조건은 플래그다.** 조기 종료는 push 미완만으로도 풀리므로, 그것만 보고 스캔하면
 # 아무것도 안 바꾼 읽기 전용 턴까지 검사하게 된다 — "플래그와 무관하게 항상"은 사용자가
 # 기각한 보기다. 여기서 한 번 더 물어 발동 계약을 조기 종료와 분리한다.
 decision_armed=0
 if [ -s "$AUDIT_FLAG" ] || [ -s "$EXPLAIN_FLAG" ] || [ -s "$DUALREVIEW_FLAG" ] || knowledge_gate_active; then
   decision_armed=1
 fi
 if [ "$decision_armed" -eq 1 ] && ! hook_disabled "stop:decision"; then
   decision_hits="$(decision_scan "$transcript_path")"; decision_rc=$?
   case "$decision_rc" in
     3) : ;;   # 표지 없음 · 또는 이 턴에 물었음
     2)
       # **이 게이트의 유일한 fail-open.** 통과시키되 사유를 게이트 메시지에 실어 보낸다.
       # 대화 기록 형식은 하네스 소유가 아니라, 여기서 차단하면 그 세션 안에 고칠 방법이 없다.
       decision_note="결정 게이트 생략 ($decision_hits)" ;;
     0) ;;     # 아래에서 차단한다 (case 안에서 하면 들여쓰기가 깊어져 메시지가 안 읽힌다)
     *)
       # **모르는 rc 는 통과가 아니라 판독 불가다.** python3 부재(127)·처리 못 한 예외(1)·
       # 신호 종료가 전부 여기로 온다. 이걸 통과로 읽으면 게이트가 조용히 사라진다.
       decision_note="결정 게이트 생략 (스캐너가 예상 밖 상태로 끝남 rc=$decision_rc — python3 부재·예외·신호 종료일 수 있습니다)" ;;
   esac
   if [ "$decision_rc" -eq 0 ]; then
     gate_budget "decision"
     {
       echo "[완료 차단] 혼자 정한 것이 있는데 이 턴에 사용자에게 한 번도 묻지 않았습니다."
       echo
       echo "걸린 문장:"
       printf '%s\n' "$decision_hits" | sed 's/^/  - /'
       echo
       echo "이 게이트가 겨누는 것:"
       echo "  게이트가 막을 때는 따르면서, 게이트가 없는 자리에서는 혼자 정하고 보고서에"
       echo "  한 줄 적는 부류입니다. 그 '한 줄'은 도구 호출이 아니라 문장이라 승인창이"
       echo "  안 뜨고, 그래서 이 저장소가 겪은 실패 대부분이 이 축에서 났습니다."
