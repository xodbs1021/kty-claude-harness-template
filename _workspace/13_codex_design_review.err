   659	          'text:사용자 의견을 확인도 하지 않고 가정하여 구현했습니다.'; }
   660	# [cx] 예산이 소진된 턴에 새로 판독 불가가 나면 사유가 **영구 소실**된다 —
   661	# 게이트 메시지가 그 경로로는 안 나가기 때문이다. 벽돌 방지 알림에 함께 실어야 한다.
   662	d58() {
   663	  local name='예산 소진 턴에도 판독 불가 사유가 남는다' why=''
   664	  local p; p="$(new_project '')" || { report "$name" '픽스처 실패'; return 0; }
   665	  local tp="$p/transcript.jsonl"
   666	  # **표지 없는 기록으로 예산을 소진시켜야 한다.** 결정 게이트로 소진시키면 4번째 턴에
   667	  # 게이트가 바뀌면서 차단 지문도 바뀌어 예산이 리셋된다 — 그러면 벽돌 경로에 닿지 않는다.
   668	  # 감사 게이트에서 같은 지문으로 3회 막은 뒤, 그 턴에 기록이 사라지는 것이 재현 경로다.
   669	  mk_transcript "$tp" 'text:구현을 마쳤고 테스트가 전부 통과했습니다.'
   670	  setup_flags "$p" audit
   671	  local i
   672	  for i in 1 2 3; do run_stop "$p" "$tp"; done      # 감사 게이트에서 같은 지문 3회
   673	  run_stop "$p" "$p/does-not-exist.jsonl"            # 4번째 턴에 기록이 사라진다
   674	  if   [ "$RC" -ne 0 ];                then why="rc=$RC (기대 0 — 소진 후 통과)"
   675	  elif ! contains "$OUT" "$TOK_BRICK"; then why='벽돌 방지 알림이 없다'
   676	  elif ! contains "$OUT" "$TOK_NOTE";  then why='판독 불가 사유가 영구 소실됐다'
   677	  fi
   678	  report "$name" "$why"
   679	}
   680	
   681	# ── 10. [cc] CRITICAL — 게이트가 한 번 막고 스스로 물러나던 결함 ─────
   682	# 훅이 낸 차단 메시지가 대화 기록에 type:"user"(isMeta) 로 되돌아 들어와 **새 턴 경계**가
   683	# 됐다. 그래서 방금 막은 자백이 다음 턴의 창 밖으로 밀려나 rc=3 으로 통과했다 —
   684	# 질문을 한 번도 안 했는데, 경고조차 없이. 겨누던 부류에 게이트 자신이 걸린 것이다.
   685	d60() { blocked_case '훅 피드백은 턴 경계가 아니다 (막은 뒤에도 계속 막는다)' '범위 밖' \
   686	          'text:이건 범위 밖이라 그대로 뒀습니다.' 'hookfb:혼자 정한 것이 있는데' \
   687	          'text:알겠습니다, 계속하겠습니다.'; }
   688	d61() { blocked_case '자동 이어하기도 턴 경계가 아니다' '제 판단으로' \
   689	          'text:제 판단으로 그렇게 진행했습니다.' 'metacont:' 'text:이어서 작업합니다.'; }
   690	# **진짜 사용자 발화는 여전히 경계다.** isMeta 를 뺀 것이 경계 판정 자체를 망가뜨리면
   245	  raw="$(cat "$STATE/$1" 2>/dev/null; printf 'X')"
   246	  FLAG_BYTES="${raw%X}"
   247	}
   248	
   249	# verdict_mismatch <gate|dual|none> <값> — 어긋난 사유를 내고, 맞으면 아무것도 안 낸다.
   250	# <값>은 **줄 목록**이다 — 여러 줄이면 줄 수와 기록 **순서**까지 계약이 된다(케이스 58).
   251	# 기대 바이트열은 각 줄 뒤에 개행 하나씩: record_flag 가 printf '%s\n' 로 덧붙이므로.
   252	# gate      = 4종 전부가 그 바이트열
   253	# designdoc = .needs-dualreview + .needs-knowledge (설계·계획 산출물)
   254	# knowledge = .needs-knowledge 만 (결정 문서 — 코드가 아니라 게이트 4종은 과하다)
   255	# none      = 4종 전부 부재·공백
   256	verdict_mismatch() {
   257	  local kind="$1" value="$2" f want
   258	  for f in $FLAG_NAMES; do
   259	    want=''
   260	    case "$kind" in
   261	      gate) want="$value"$'\n' ;;
   262	      designdoc)
   263	        case "$f" in
   264	          .needs-dualreview|.needs-knowledge) want="$value"$'\n' ;;
   265	        esac ;;
   266	      knowledge) [ "$f" = '.needs-knowledge' ] && want="$value"$'\n' ;;
   267	      none) want='' ;;
   268	      *)    printf '알 수 없는 기대 판정: %s' "$kind"; return 0 ;;
   269	    esac
   270	    flag_bytes "$f"
   271	    if [ "$FLAG_BYTES" != "$want" ]; then
   272	      printf '%s 내용 [%s] (기대 [%s])' "$f" "$FLAG_BYTES" "$want"
   273	      return 0
   274	    fi
   275	  done

