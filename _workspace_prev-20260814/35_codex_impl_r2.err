   146	# 11. 경로 해석을 cwd 기준으로 되돌림
   147	mutate 'm11 상대경로를 cwd 기준으로' "$VSTOP" \
   148	  '      *)  rfile="$PROJECT_DIR/$entry" ;;' \
   149	  '      *)  rfile="$entry" ;;'
   150	
   151	# 12. 예산 소진 정리 rm 목록에서 회수 플래그 제거
   152	mutate 'm12 소진 정리 rm 에서 회수 제거' "$VSTOP" \
   153	  '    rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null' \
   154	  '    rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null'
   155	
   156	# 13. 소진 정리 changed 나열에서 회수 플래그 제거
   157	mutate 'm13 소진 changed 에서 회수 제거' "$VSTOP" \
   158	  '"$DUALREVIEW_FLAG" "$RETRIEVAL_FLAG" 2>/dev/null | tr -d' \
   159	  '"$DUALREVIEW_FLAG" 2>/dev/null | tr -d'
   160	
   161	# 14. BOM·CR 스트립 제거
   162	mutate 'm14 BOM·CR 스트립 제거' "$VSTOP" \
   163	    "    rline=\"\${rline#\$'\\xEF\\xBB\\xBF'}\"
   164	    rline=\"\${rline%\$'\\r'}\"" \
   165	    '    :'
