   427	  if ! contains "$ERR" "$TOK_RET";  then why='회수 게이트가 막지 않았다'
   428	  elif ! contains "$ERR" "$TOK_NOTE"; then why='판독 불가 사유가 안 실렸다'
   429	  fi
   430	  report "$name" "$why"
