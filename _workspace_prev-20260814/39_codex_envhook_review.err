   158	# classify <기준 상대경로> <기준 디렉토리> — gate · knowledge · skip 을 stdout 에.
   159	# 프로젝트 안(4a)과 밖-하네스정본(4b)이 **같은 규칙**을 쓰도록 공유한다.
   160	#
   161	# 순서가 계약이다:
   162	#   1) .claude/*·_workspace/* 제외가 앵커보다 **먼저**. 그래야 하네스 정본 저장소가
   163	#      자기 자신에 설치해 둔 소비 사본(.claude/hooks/*)이 빠지고 정본(template/.claude/*)만
   164	#      발화한다. 설치본은 정본을 고쳐 sync 하는 게 규약이라 제자리 편집은 일시적이다.
   165	#   2) 앵커가 *.md 제외보다 먼저. 에이전트·스킬·원칙 정의는 전부 .md 인데 일괄 제외하면
   166	#      하네스 저장소에서 가장 흔한 변경에 플래그가 하나도 안 선다.
   167	#   3) global-agents/*.md 는 **정본 스코프에서만** 예외의 예외를 연다. install/sync 가
   168	#      배포하는 전역 에이전트 정본이기 때문이며, 남의 프로젝트로 새면 오탐이 된다.
   169	classify() {
   170	  local rel="$1" base="$2" lower
   171	  case "$rel" in
   172	    _workspace/*|.claude/*) printf 'skip\n'; return 0 ;;
   173	  esac
   174	  if harness_anchor "/$rel"; then
   175	    printf 'gate\n'; return 0
   176	  fi
   177	  case "$rel" in
   178	    global-agents/*.md)
   179	      if is_harness_canonical "$base"; then printf 'gate\n'; return 0; fi ;;
   180	  esac

