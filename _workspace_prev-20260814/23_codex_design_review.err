   404	MAX_HITS, MAX_LEN = 8, 140
   405	# 아는 블록 타입. 이 밖이 나오면 그 발화를 볼 수 없다는 뜻이라 판독 불가로 떨어뜨린다.
   406	KNOWN_BLOCKS = ("text", "thinking", "redacted_thinking", "tool_use", "tool_result", "image")
   407	
   408	
   409	def fail(reason):
   410	    sys.stdout.write(reason + "\n")
   411	    raise SystemExit(2)
   412	
   413	
   414	def drop_fences(s):
   415	    # 짝수 조각만 코드 **밖**이다. 펜스가 안 닫혔으면 마지막 조각은 코드 안으로 친다 —
   416	    # 스트리밍 중 잘린 기록에서 코드가 산문으로 새는 것을 막는다.
