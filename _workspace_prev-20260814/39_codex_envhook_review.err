   421	CASES='
   422	p01 p02 p03 p04 p05 p06 p07 p08 p09 p10
   423	p11 p12 p13 p14 p15 p16 p17 p18 p19 p20
   424	p21 p22 p23 p24 p25 p26 p27 p28 p29 p30
   425	p31 p32 p33 p34 p35 p36 p37 p38 p39 p40
   426	p41 p42 p43 p44 p45 p46 p47 p48 p49 p50 p51 p52 p53
   427	i01 i02 i03 i04 i05 i06 i07 i08 i09 i10
   428	i11 i12 i13 i14
   429	g01 g02 g03 g04 g05 g06 g07 g08 g09 g10
   430	g11 g12 g13 g14
   431	'
   432	EXPECTED_CASES=81
   433	
   434	# 목록 자체의 중복·누락을 먼저 본다. 실행 수만 세면 "하나 중복 + 하나 누락"이 상쇄돼
   435	# 그대로 초록이 된다 — 목록을 직접 봐야 그 조합이 잡힌다.
   436	case_total="$(printf '%s\n' $CASES | wc -l | tr -d ' ')"
   437	case_uniq="$(printf '%s\n' $CASES | sort | uniq | wc -l | tr -d ' ')"
   438	if [ "$case_total" -ne "$EXPECTED_CASES" ] || [ "$case_uniq" -ne "$EXPECTED_CASES" ]; then
   439	  echo "✗ CASES 목록 ${case_total}건(유일 ${case_uniq}건) ≠ 기대 ${EXPECTED_CASES}건 — 케이스가 중복됐거나 빠졌습니다" >&2
   440	  exit 1

