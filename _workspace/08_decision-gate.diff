+    if "toolUseResult" in e:            # 도구 결과는 사용자 발화가 아니다
+        return False
+    msg = e.get("message")
+    if not isinstance(msg, dict):
+        return False
+    content = msg.get("content")
+    if isinstance(content, list):
+        for b in content:
+            if isinstance(b, dict) and b.get("type") == "tool_result":
