    22	# 아래서 도달 불가다 — decision_note 가 서려면 4종 플래그 중 하나가 서야 하는데, 그 플래그가
    23	# work_pending 을 참으로 유지해 exit 0 에 못 간다. 방출 코드는 발동 규칙이 바뀌는 날을 위한
    24	# 방어로 남겼고, 그 제거 변이는 원리적으로 초록이다(ADR-0012 의 "모르는 rc" 공백과 같은 부류).
    25	#
    26	# 왜 set -e 가 없나: 비영 rc 를 assert 하는 테스트다.
    27	# 셸 이식성: macOS 기본 bash 는 3.2 다. mapfile·연관배열·${var,,} 금지.
    28	
    29	set -uo pipefail
    30	
    31	TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    32	REPO_ROOT="$(CDPATH='' cd -- "$TEST_DIR/.." && pwd -P)"
    33	HOOKS="$REPO_ROOT/template/.claude/hooks"
