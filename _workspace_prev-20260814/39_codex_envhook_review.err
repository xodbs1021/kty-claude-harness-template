   410	g14() { gcase '종결어 인용이 섞인 히어독 본문으로는 못 끈다' on \
   411	        'cat <<EO"F"'$'\n'"$GKEY=\"\""$'\n''EOF'$'\n'; }
   412	
   413	g11() { gcase '여러 줄 값 안의 키로는 못 끈다'  on \
   414	        "NOTES='example:"$'\n'"$GKEY="$'\n'"end'"$'\n'; }
   415	g12() { gcase '히어독 <<\EOF 본문으로는 못 끈다' on \
   416	        'cat <<\EOF'$'\n'"$GKEY=\"\""$'\n''EOF'$'\n'; }
   417	g13() { gcase '""#on 으로는 못 끈다'            on  "$GKEY=\"\"#on"$'\n'; }
