+import json, re, sys
+
+# 결정 표지. 굴절 변형만 최소로 넓혔고 그 이상 넓히지 않는다 — 넓히면 위양성이 늘고,
+# 위양성이 늘면 질문이 소음이 되고, 소음이 되면 진짜 질문도 무시된다.
+MARKER = re.compile(
+    "공시하|공시했|공시함"
+    "|범위 ?밖"
+    "|별도로"
+    "|그대로 (?:뒀|두었|남겼|남겨)"
+    "|(?:제|내) 판단으로"
+    "|가정하(?:고|여|였|겠)|가정했"
+    "|수용(?:된|한) 한계"
+    "|트레이드오프"
+    "|안 했(?:습니다|다|음)"
