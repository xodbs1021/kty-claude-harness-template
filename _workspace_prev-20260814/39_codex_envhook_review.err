    89	#     그 값은 `#on` 이라 비어 있지 않은데, 주석으로 읽으면 게이트가 꺼지는 방향이다)
    90	#   인용 없는 값은 **공백에 이어지는 `#`** 부터가 주석이다 (`a#b`·`#on` 은 값 그대로)
    91	# ── 지원하지 않는 것 (조용히 절반만 읽지 않고 rc=1 로 떨어진다) ────────
    92	#   등호 바로 뒤의 공백(`KEY= x`) · 백슬래시 이스케이프 · 한 줄에 인용 조각 여러 개 ·
    93	#   여러 줄 값 · 닫히지 않은 따옴표
    94	#
    95	# 판독 모델: **선행 공백이 없는 최상위 대입만** 선언으로 센다. 조건문·함수 본문 안의
    96	# 대입은 실행되지 않을 수도 있어 원문만으로는 발효 여부를 알 수 없다.
    97	# 선언이 2개 이상이면 어느 것이 이기는지 원문으로 알 수 없으므로 rc=1 이다.
    98	#
    99	# **인용 상태는 줄을 넘어 이어진다.** 셸의 인용은 개행에서 끝나지 않으므로, 다른 키의
   100	# 여러 줄 값 본문 안에 이 키가 나타나도 그건 선언이 아니다. 이걸 줄 단위로만 보면
   101	# `NOTES='...(개행)KEY=(개행)...'` 이 유일한 선언으로 판독돼 게이트가 꺼진다(실측).
   102	#
   103	# 히어독: `<<WORD`·`<<-WORD`·`<<'WORD'`·`<<"WORD"`·`<<\WORD` 를 인용 상태를 보며 찾아
   104	# 본문을 건너뛴다(`"a << b"` 는 히어독이 아니다). 탐지가 어느 쪽으로 틀려도 결과는 rc=1 로
   105	# 수렴한다 — 히어독을 놓치면 선언이 2개가 되고, 없는 히어독을 만들면 0개가 된다.
   106	# EOF 까지 히어독이나 인용이 안 닫히면 파일을 못 믿는 것이므로 역시 rc=1.
   107	# 한 줄에 히어독이 둘이면 첫 개만 본다.
   108	#
   109	# 알려진 한계: 값 안의 `$VAR`·`$(...)` 는 **판독 시점에 확장되지 않는다** — 원문 그대로
   110	# 값이 된다. 다만 그 값은 결국 `sh -c` 로 넘어가므로 **실행 시점에는 확장된다**
   111	# (실측: `HARNESS_TYPECHECK_CMD='printf $HOME'` → 실행하면 홈 경로가 찍힌다).
   112	# 즉 "확장되지 않는다"가 아니라 "**나중에** 확장된다"이다. 확장이 곤란한 자리라면
   113	# 그 자리에 최종 문자열을 적어야 한다.
   114	# 둘째 인자(선택)로 판독할 파일을 지정할 수 있다 — 편집 검증 훅이 "방금 편집된 그 파일"을
   115	# 읽어야 하기 때문이다(다른 프로젝트의 harness.env 편집도 그 파일 기준으로 판정).
   116	# 생략하면 이 프로젝트의 정본 경로다.
   117	harness_env_value() {
   118	  local file="${2:-$STATE_DIR/harness/harness.env}" key="$1" val rc
   119	  [ -f "$file" ] || { printf '%s' ''; return 3; }
   120	  if [ ! -r "$file" ]; then
   121	    # "미설정"과 "읽기 실패"는 다르다. 판정은 같게(rc=1) 가되 실패는 소리를 낸다.
   122	    printf '[하네스] harness.env 를 읽지 못했습니다 — 미설정으로 봅니다: %s\n' "$file" >&2
   123	    printf '%s' ''
   124	    return 1
   125	  fi
   126	  # LC_ALL=C 여야 substr 이 바이트 단위로 동작해 BOM 3바이트를 정확히 떼어낸다.
   127	  val="$(LC_ALL=C awk -v key="$key" -v bom="$(printf '\357\273\277')" '
   128	function ltrim(s) { sub(/^[ \t]+/, "", s); return s }
   129	function rtrim(s) { sub(/[ \t]+$/, "", s); return s }
   130	
   131	# 히어독 시작을 찾는다. 따옴표 안의 `<<` 와 주석 뒤의 `<<` 는 히어독이 아니다.
   132	# 인용 상태 OPENQ 는 **줄을 넘어 이어진다.** 셸의 인용은 개행에서 끝나지 않기 때문이다 —
   133	# 다른 키의 여러 줄 값 본문 안에 우리 키가 있으면 그건 선언이 아니다. 이걸 줄 단위로만
   134	# 보면 다른 키의 여러 줄 값 안에 있는 우리 키가 유일한 선언으로 판독돼
   135	# **게이트가 꺼진다**(실측). 그래서 이 함수는 줄마다 OPENQ 를 이어받아 갱신한다.
   136	function scan_line(s,   n, i, j, c, t, dash, q2) {
   137	  n = length(s); i = 1
   138	  while (i <= n) {
   139	    c = substr(s, i, 1)
   140	    if (OPENQ != "") { if (c == OPENQ) OPENQ = ""; i++; continue }
   141	    if (c == "\\") { i += 2; continue }                            # 백슬래시 이스케이프
   142	    if (c == "\"" || c == SQ) { OPENQ = c; i++; continue }
   143	    if (c == "#" && (i == 1 || substr(s, i - 1, 1) == " " || substr(s, i - 1, 1) == "\t")) return
   144	    if (c == "<" && substr(s, i + 1, 1) == "<") {
   145	      if (substr(s, i + 2, 1) == "<") { i += 3; continue }         # <<< 는 히어스트링
   146	      j = i + 2; dash = 0
   147	      if (substr(s, j, 1) == "-") { dash = 1; j++ }
   148	      while (substr(s, j, 1) == " " || substr(s, j, 1) == "\t") j++
   149	      t = ""
   150	      # 종결어는 인용을 **섞을 수 있다**: EOF · "EOF" · EO"F" · \\EOF · E\\OF 가 전부
   151	      # 같은 종결어 EOF 다. 한 형태만 읽으면 나머지에서 본문을 안 건너뛰고, 그 안의 빈
   152	      # 게이트 선언이 진짜 선언으로 판독돼 **게이트가 꺼진다**. 그래서 조각을 이어 붙인다.
   153	      while (j <= n) {
   154	        c = substr(s, j, 1)
   155	        if (c == " " || c == "\t" || c == ";" || c == "&" || c == "|" || c == ">" || c == "<") break
   156	        if (c == "\\") { j++; if (j <= n) { t = t substr(s, j, 1); j++ } ; continue }
   157	        if (c == "\"" || c == SQ) {
   158	          q2 = c; j++
   159	          while (j <= n && substr(s, j, 1) != q2) { t = t substr(s, j, 1); j++ }
   160	          j++
   161	          continue
   162	        }
   163	        t = t c; j++
   164	      }
   165	      if (t != "") { INHD = 1; HTERM = t; HDASH = dash; return }
   166	      i = j
   167	      continue
   168	    }
   169	    i++
   170	  }
   171	}
   172	
   173	# 지원 문법대로 값을 판독한다. 문법 밖이면 BAD 를 세운다(빈 값으로 위장하지 않는다).
   174	function parse_value(v,   q, rest, e, out, tail, i, c, p) {
   175	  if (v == "") return ""
   176	  # **등호 바로 뒤의 공백은 지원하지 않는다(rc=1).** 셸은 `KEY= x` 를 "빈 값 대입 + 명령 x"
   177	  # 로 읽는데, 관대하게 값으로 삼으면 셸과 반대 방향으로 갈리고, 빈 값으로 삼으면
   178	  # `KEY=  "on"` 이 조용히 게이트를 끈다. 어느 쪽도 안전하지 않아 문법 밖으로 돌린다.
   179	  if (substr(v, 1, 1) == " " || substr(v, 1, 1) == "\t") { BAD = 1; return "" }
   180	  q = substr(v, 1, 1)
   181	  if (q == "\"" || q == SQ) {
   182	    rest = substr(v, 2)
   183	    e = index(rest, q)
   184	    if (e == 0) { BAD = 1; return "" }                             # 닫히지 않은 따옴표
   185	    out = substr(rest, 1, e - 1)
   186	    tail = substr(rest, e + 1)
   187	    if (tail != "") {
   188	      # 닫는 따옴표 **바로 뒤**에는 공백이 와야 한다. `KEY=""#on` 은 셸에서 값이 `#on`
   189	      # (비어 있지 않다)인데, 여기서 `#` 을 주석으로 받으면 빈 값이 되어 **게이트가 꺼진다.**
   190	      if (substr(tail, 1, 1) != " " && substr(tail, 1, 1) != "\t") { BAD = 1; return "" }
   191	      tail = ltrim(tail)
   192	      if (tail != "" && substr(tail, 1, 1) != "#") { BAD = 1; return "" }   # 따옴표 뒤 잡음
   193	    }
   194	    return out
   195	  }
   196	  # 인용 없는 값에서 `#` 은 **공백 뒤에서만** 주석을 연다. `KEY=#on` 의 값은 셸에서
   197	  # `#on` 이다 — 여기서 빈 값으로 읽으면 그 역시 게이트를 끄는 방향이다.
   198	  out = ""
   199	  for (i = 1; i <= length(v); i++) {
   200	    c = substr(v, i, 1)
   201	    if (c == "#" && i > 1) {
   202	      p = substr(v, i - 1, 1)
   203	      if (p == " " || p == "\t") break
   204	    }
   205	    out = out c
   206	  }
   207	  return rtrim(out)
   208	}
   209	
   210	BEGIN {
   211	  SQ = sprintf("%c", 39)
   212	  N = 0; FOUND = ""; INHD = 0; HTERM = ""; HDASH = 0; BAD = 0; OPENQ = ""
   213	  RX = "^(export[ \t]+)?" key "="
   214	}
   215	{
   216	  line = $0
   217	  sub(/\r$/, "", line)
   218	  if (NR == 1 && substr(line, 1, 3) == bom) line = substr(line, 4)
   219	
   220	  if (INHD) {
   221	    t = line
   222	    if (HDASH) sub(/^\t+/, "", t)
   223	    if (t == HTERM) { INHD = 0; HTERM = "" }
   224	    next
   225	  }
   226	
   227	  # **인용이 이전 줄에서 열린 채면 이 줄은 값의 본문이지 선언이 아니다.**
   228	  # 이 검사가 없으면 다른 키의 여러 줄 값 안에 있는 우리 키가 유일한 선언으로 판독돼
   229	  # 게이트가 꺼진다(실측). 판정 전에 물어야 한다.
   230	  if (OPENQ == "") {
   231	    # 선언 판정이 히어독 시작 판정보다 **먼저**다: `KEY=v <<EOF` 의 대입은 실제로 발효한다.
   232	    if (line ~ RX) {
   233	      N++
   234	      if (N == 1) FOUND = substr(line, index(line, "=") + 1)
   235	    }
   236	  }
   237	  scan_line(line)
   238	}
   239	END {
   240	  if (INHD) exit 1          # 히어독이 EOF 까지 안 닫혔다 = 탐지가 빗나갔다
   241	  if (OPENQ != "") exit 1   # 인용이 EOF 까지 안 닫혔다 = 파일을 못 믿는다
   242	  if (N == 0) exit 3        # 부재 — 안 쓰는 키의 정상 상태 (반환 계약 rc=3)
   243	  if (N > 1) exit 1
   244	  v = parse_value(FOUND)
   245	  if (BAD) exit 1
   246	  printf "%s", v
   247	  exit 0
   248	}
   249	' "$file" 2>/dev/null)"
   250	  rc=$?
   251	  case "$rc" in
   252	    0) printf '%s' "$val"; return 0 ;;
   253	    3) printf '%s' ''; return 3 ;;
   254	    # 그 밖(1 = 못 믿음, awk 비정상 종료 2·126·127 포함)은 전부 "못 믿음"으로 접는다 —
   255	    # fail-closed. 부재로 위장되면 편집 검증 훅이 진짜 실수를 침묵으로 놓친다.
   256	    *) printf '%s' ''; return 1 ;;
   257	  esac
   258	}
   259	
   260	# 지식 반영 게이트가 켜져 있는가 (rc=0 켜짐 / rc=1 꺼짐).
   261	#
   262	# 하네스가 소유하는 것은 **계약 하나**뿐이다 — "지식 저장소가 설정돼 있으면, 결정·설계가
   263	# 나온 턴은 반영 없이 끝낼 수 없다." 어디에 어떤 구조로 반영하는지는 이 층이 모른다.
   264	# 그래서 필요한 것도 1비트뿐이고, 그 1비트를 얻으려고 파일을 실행하지 않는다.
   265	#
   266	# **기본이 켜짐인 것이 이 함수의 핵심이다.** 기존 설치본에는 이 키가 아예 없는데,
   267	# 없을 때 "꺼짐"으로 읽으면 하네스를 갱신하는 순간 게이트가 **조용히 꺼진다** — 사용자는
   268	# 지식이 쌓인다고 믿는데 그 턴부터 아무것도 안 남는다. 표명이 없으면 이전 동작을 보존한다.
   269	# 선언이 2개 이상이거나 문법 밖일 때도 같은 이유로 켠다(rc=1 → 켜짐).
   270	#
   271	# 끄는 방법은 **값을 리터럴로 비우는 것 하나뿐**이다: HARNESS_KNOWLEDGE_GATE=""
   272	# `="off"` 는 켜진 것으로 읽힌다 — 비어 있지 않기 때문이다. harness.env 주석에 명시돼 있다.
   273	harness_knowledge_gate_on() {
   274	  local v
   275	  v="$(harness_env_value HARNESS_KNOWLEDGE_GATE)" || return 0   # 값을 못 믿으면 켠다
   276	  [ -n "$v" ]                                                   # 리터럴로 비었을 때만 꺼짐
   277	}
   278	
   279	# 지식 게이트가 이번 턴에 **발효 중인가** — 플래그가 섰고 게이트도 켜져 있는가.
   280	# 판정을 이 한 곳에 모은다. 두 군데서 따로 물으면 "게이트를 껐는데 남아 있던 플래그가
   281	# 읽기 전용 턴의 조기 종료를 막는" 종류의 어긋남이 생긴다.
   282	knowledge_gate_active() {
   283	  [ -s "$KNOWLEDGE_FLAG" ] || return 1
   284	  harness_knowledge_gate_on
   285	}
   286	
   287	# 회수 표명 게이트에 **할 일이 남았는가** — 플래그가 섰고 훅도 살아 있는가.
   288	#
   289	# 이름을 *_gate_active 로 짓지 않았다. knowledge_gate_active 는 "플래그 + harness.env
   290	# 스위치"이고 개별 훅 비활성(stop:knowledge)은 호출부가 따로 보는데, retrieval 은 env
   291	# 스위치가 없어 끄는 방법이 ECC_DISABLED_HOOKS=stop:retrieval **하나뿐**이다. 그래서
   292	# 비활성이 곧 "할 일 없음"이고 이 함수 하나에 접는다 — 안 접으면 게이트를 끈 환경에서
   293	# 남은 플래그가 영영 안 지워진 채 읽기 전용 턴의 조기 종료를 막고, 그 소음이 예산을
   294	# 소진시켜 다른 게이트 플래그까지 지워버린다(설계 검수 [cc] r2 H5 시나리오).
   295	# 플래그 5종 중 이것만 이런 의미라는 사실은 docs/usage.md 에 공시돼 있다.
   296	retrieval_pending() {
   297	  [ -s "$RETRIEVAL_FLAG" ] || return 1
   298	  ! hook_disabled "stop:retrieval"
   299	}
   300	
   301	# stdin 의 JSON 에서 점 경로로 값 하나를 뽑는다. 없거나 파싱 실패면 빈 문자열.
   302	# 훅 입력이 깨져도 절대 죽지 않는다 — 죽으면 오탐 차단이 된다.
   303	json_get() {
   304	  python3 -c '
   305	import json, sys
   306	try:
   307	    data = json.load(sys.stdin)
   308	except Exception:
   309	    sys.exit(0)
   310	for key in sys.argv[1].split("."):
   311	    if not isinstance(data, dict):
   312	        sys.exit(0)
   313	    data = data.get(key)
   314	    if data is None:
   315	        sys.exit(0)
   316	print(data)
   317	' "$1" 2>/dev/null
   318	}
   319	
   320	# 이 턴의 대화 기록을 읽어 **"물어봤어야 할 것을 혼자 정했다"는 자백**을 찾는다.
   321	#
   322	# 왜 이런 게이트가 필요한가: 완료 게이트 넷(타입체크·듀얼리뷰·변경설명·지식반영)은 전부
   323	# **산출물**을 본다. 에이전트 자신의 행동을 겨눈 것은 없었고, 그 비대칭이 실물로 드러났다 —
   324	# 게이트가 막을 때는 세 번 다 따랐는데, 게이트가 없는 축에서는 전부 혼자 정하고 보고서에
   325	# 한 줄 적었다. 그 "한 줄"은 **도구 호출이 아니라 문장**이라 어떤 PreToolUse 훅도 볼 수 없고
   326	# 승인창도 안 뜬다(승인창은 *한 일*에만 뜬다). 그래서 Stop 이 대화 기록을 직접 읽는다.
   327	#
   328	# ── 판정 ─────────────────────────────────────────────────────────────
   329	#   결정 표지 어휘를 담은 **서술형** 문장이 있는데  AND  이 턴에 AskUserQuestion 이 0회
   330	#   → 차단. 질문을 한 번 하면 풀리므로 세션이 벽돌이 되지 않는다.
   331	#
   332	# 표지 어휘를 이렇게 고른 이유: 저 말들은 "물어봤어야 할 것을 혼자 정했다"를 **자백**할
   333	# 때만 나온다. 자백은 있는데 질문이 0회면 그 자체가 위반이다.
   334	#
   335	# ── 좁히는 장치 셋 (위양성 억제) ─────────────────────────────────────
   336	# 어휘만 보면 이 게이트를 **유지보수하는 작업 자체가 매번 걸린다** — 훅·테스트·결정 문서가
   337	# 그 어휘를 데이터로 품기 때문이다. 그러면 사람이 게이트를 끄게 되고 그게 최악이다.
   338	#   1) 구조적 제외 — 코드펜스 · 인라인 코드 · 인용줄(>) · 따옴표로 감싼 부분은 안 본다.
   339	#      그래서 어휘를 **인용부호로 감싸 언급하는 것**은 안 걸린다(문서·설명의 정상 형태다).
   340	#   2) 질문 신호 제외 — 같은 문장에 물음이 있으면 자백이 아니라 묻는 중이다.
   341	#   3) 서술형 종결 요구 — "…했다/…습니다" 같은 단정으로 끝나야 "내가 그렇게 했다"이다.
   342	# 대가는 위음성 증가다. 표현을 바꾸면 빠져나간다 — 겨누는 것이 적대적 회피가 아니라
   343	# **무의식적 습관**이라 그래도 실효가 남는다. guard-hook-disable 과 같은 판단 구조다.
   344	#
   345	# **도구 입력은 보지 않는다(text 블록만 본다).** 그래서 이 패턴이 적힌 파일을 Write/Edit
   346	# 로 쓰는 것은 안 걸린다 — 자기참조 폭발을 원천에서 없애는 장치다.
   347	# thinking 블록도 안 본다: 거기서 선택지를 저울질하는 것은 결정 통보가 아니다.
   348	# 서브에이전트 발화(isSidechain)도 뺀다: 서브에이전트는 사용자에게 물을 수 없다.
   349	#
   350	# ── 반환 계약 ─────────────────────────────────────────────────────────
   351	#   rc=0 : 차단해야 한다. stdout = 걸린 문장들(줄당 하나)
   352	#   rc=2 : **판독 불가.** stdout = 사유 한 줄
   353	#   rc=3 : 차단 불필요 (표지 없음 · 또는 이 턴에 질문을 했음)
   354	#   그 밖 : **예상 밖.** python3 부재(127) · 처리 못 한 예외(1) · 신호 종료 등
   355	#
   356	# "차단 불필요"에 1 이 아니라 **3** 을 쓰는 이유: python 이 처리 못 한 예외로 죽으면
   357	# 그것도 1 이라, 1 을 정상 통과로 쓰면 **크래시가 조용한 통과로 위장된다.** 정상 경로에
   358	# 흔한 코드를 주지 않으면 호출부가 "모르는 rc = 무언가 잘못됐다"로 갈라낼 수 있다.
   359	# 호출부는 0·2·3 만 알고 나머지는 전부 판독 불가로 취급해야 한다.
   360	#
   361	# ── rc=2 가 이 게이트의 유일한 fail-open 지점이다 ────────────────────
   362	# 대화 기록의 형식은 하네스가 소유하지 않는다 — 도구 제공자가 정하고 예고 없이 바뀐다.
   363	# 형식이 바뀌었다고 차단하면 **세션이 통째로 벽돌이 되는데 그 세션 안에 고칠 방법이 없다**
   364	# (기록을 고칠 수는 없으므로 어떤 행동으로도 게이트가 안 풀린다). 그래서 여기서만 통과로
   365	# 간다. 나머지 판정은 전부 fail-closed 다.
   366	# **조건은 경고를 삼키지 않는 것이다** — 호출부가 이 사유를 마지막 게이트 메시지에 싣는다.
   367	# 조용히 통과하면 게이트가 죽은 것을 아무도 모르고, 그것이 이 저장소가 부르는 조용한 실패다.
   368	decision_scan() {   # $1 = 대화 기록(JSONL) 경로
   369	  local path="$1"
   370	  [ -n "$path" ] || { printf '%s\n' '대화 기록 경로가 훅 입력에 없습니다'; return 2; }
   371	  [ -r "$path" ] || { printf '%s\n' "대화 기록을 읽을 수 없습니다: $path"; return 2; }
   372	  python3 - "$path" <<'PY'
   373	import json, re, sys
   374	
   375	# 결정 표지. 굴절 변형만 최소로 넓혔고 그 이상 넓히지 않는다 — 넓히면 위양성이 늘고,
   376	# 위양성이 늘면 질문이 소음이 되고, 소음이 되면 진짜 질문도 무시된다.
   377	MARKER = re.compile(
   378	    "공시하|공시했|공시함"
   379	    "|범위 ?밖"
   380	    "|별도로"
   381	    "|그대로 (?:뒀|두었|남겼|남겨)"
   382	    "|(?:제|내) 판단으로"
   383	    "|가정하(?:고|여|였|겠)|가정했"
   384	    "|수용(?:된|한) 한계"
   385	    "|트레이드오프"
   386	    "|안 했(?:습니다|다|음)"
   387	)
   388	# 같은 문장에 물음이 있으면 자백이 아니라 묻는 중이다.
   389	QUESTION = re.compile(
   390	    "\\?|까요|나요|ㄹ까|을까|할까|여쭤|여쭈|여쭙|물어|어떠신|어느 쪽"
   391	    "|골라|선택해|정해 ?주|알려 ?주|괜찮으신|의견"
   392	)
   393	# **"묻지 않았다"는 물음이 아니라 자백이다.** 이게 없으면 겨누는 문장 자체가 빠져나간다 —
   394	# "사용자에게 물어보지 않고 제 판단으로 진행했습니다" 는 `물어` 때문에 질문으로 오인된다.
   395	# 부정이 붙으면 위 QUESTION 제외를 적용하지 않는다.
   396	NEG_ASK = re.compile(
   397	    "물어 ?보지 ?않|물어 ?보지도|묻지 ?않|묻지도|여쭙지 ?않|여쭈지 ?않|여쭤 ?보지 ?않"
   398	    "|확인(?:도)? ?하지 ?않|확인 ?없이|의견을 받지 ?않|물어 ?보는 대신|묻는 대신|묻지 못"
   399	)
   400	# 서술형 종결. "내가 그렇게 했다"는 단정만 잡는다.
   401	DECLARATIVE = re.compile("(?:다|음|함|됨|임|옴)$")
   402	
   403	# 이중 백틱 코드 span 이 먼저다 — 단일 규칙만 두면 ``a`b`` 의 안쪽이 산문으로 샌다.
   404	INLINE     = re.compile("``[^`\n]*``|`[^`\n]*`")
   405	QUOTED     = re.compile("\"[^\"\n]*\"|'[^'\n]*'|“[^”\n]*”"
   406	                        "|‘[^’\n]*’|「[^」\n]*」"
   407	                        "|『[^』\n]*』")
   408	BLOCKQUOTE = re.compile("^\\s{0,3}>")
   409	# **공시된 한계:** 약어(`e.g.` 등)는 뒤에 공백이 오므로 여전히 문장을 자른다. 그 조각에
   410	# 표지와 서술형 종결이 갈리면 놓친다. 약어 목록을 들고 다니는 것은 또 하나의 추측이라
   411	# 하지 않는다 — 좁은 창으로 공시한다.
   412	# 마침표는 **뒤에 공백이나 줄끝이 올 때만** 문장 종결이다. 무조건 종결로 보면
   413	# `README.md`·`_common.sh`·버전 번호가 한 문장을 쪼개, 표지와 서술형 종결이 서로 다른
   414	# 조각으로 갈라져 **둘 다 만족하는 조각이 없어진다**(위음성).
   415	SENT       = re.compile("([\n!?…。！？]+|\\.(?=\\s)|\\.$)")
   416	LEAD       = re.compile("^[\\s*_>#\\-–—•·]+")
   417	TRAIL      = re.compile("[\\s*_`~\\[\\](){}<>:;,·…\\-—–]+$")
   418	
   419	MAX_HITS, MAX_LEN = 8, 140
   420	# 아는 블록 타입. 이 밖이 나오면 그 발화를 볼 수 없다는 뜻이라 판독 불가로 떨어뜨린다.
   421	KNOWN_BLOCKS = ("text", "thinking", "redacted_thinking", "tool_use", "tool_result", "image")
   422	
   423	
   424	def fail(reason):
   425	    sys.stdout.write(reason + "\n")
   426	    raise SystemExit(2)
   427	
   428	
   429	def drop_fences(s):
   430	    # 짝수 조각만 코드 **밖**이다. 펜스가 안 닫혔으면 마지막 조각은 코드 안으로 친다 —
   431	    # 스트리밍 중 잘린 기록에서 코드가 산문으로 새는 것을 막는다.
   432	    # 백틱만 보면 `~~~` 펜스의 예문이 산문으로 검사된다(문서가 약속한 범위보다 좁다).
   433	    for fence in ("```", "~~~"):
   434	        s = "\n".join(p for i, p in enumerate(s.split(fence)) if i % 2 == 0)
   435	    return s
   436	
   437	
   438	def is_user_prompt(e):
   439	    if e.get("type") != "user" or e.get("isSidechain"):
   440	        return False
   441	    if e.get("isMeta"):
   442	        # **사람이 하지 않은 발화다.** 훅 피드백·자동 이어하기가 여기 온다.
   443	        # 경계로 세면 이 훅이 낸 차단 메시지가 스스로 새 턴을 열어, 방금 막은 자백이
   444	        # 다음 턴의 창 **밖**으로 밀려난다 — 게이트가 한 번 막고 스스로 물러난다.
   445	        # 질문을 한 번도 안 했는데 rc=3(차단 불필요)으로 통과하고 경고조차 안 남는다.
   446	        # 검수 CRITICAL 로 적발됐고 실기록에서 재현했다([cc] 2라운드).
   447	        #
   448	        # **구조 표시로 판정한다.** 메시지 문구("Stop hook feedback:")로 거르면 문구가
   449	        # 바뀌는 날 아무도 모르게 이 결함으로 되돌아간다 — 이 저장소가 반복해서 데인 부류다.
   450	        return False
   451	    if "toolUseResult" in e:            # 도구 결과는 사용자 발화가 아니다
   452	        return False
   453	    msg = e.get("message")
   454	    if not isinstance(msg, dict):
   455	        return False
   456	    content = msg.get("content")
   457	    if isinstance(content, list):
   458	        for b in content:
   459	            if isinstance(b, dict) and b.get("type") == "tool_result":
   460	                return False
   461	    return True
   462	
   463	
   464	try:
   465	    with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as fh:
   466	        raw = fh.read()
   467	except Exception as exc:
   468	    fail("대화 기록을 열지 못했습니다: %s" % exc.__class__.__name__)
   469	
   470	lines = [ln for ln in raw.splitlines() if ln.strip()]
   471	entries, broken = [], 0
   472	for ln in lines:
   473	    try:
   474	        entries.append(json.loads(ln))
   475	    except Exception:
   476	        broken += 1
   477	# **한 줄이라도 못 읽으면 판독 불가다.** 건너뛰면 그 줄이 하필 자백이 담긴 발화이거나
   478	# 이 턴의 사용자 프롬프트일 때 조용히 새고, 후자는 경계가 **지난 턴으로 밀려** 위양성까지
   479	# 낳는다. "전멸일 때만 실패"로 두면 부분 손상이라는 가장 흔한 경우를 정확히 놓친다.
   480	if broken:
   481	    fail("대화 기록 %d줄을 파싱하지 못했습니다 (형식이 바뀌었을 수 있습니다)" % broken)
   482	if not entries:
   483	    fail("대화 기록이 비어 있습니다")
   484	
   485	start = -1
   486	for i, e in enumerate(entries):
   487	    if not isinstance(e, dict):
