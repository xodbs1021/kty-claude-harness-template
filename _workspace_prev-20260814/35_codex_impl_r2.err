   199	# 16. retrieval_pending 에서 hook_disabled 접기 제거 (게이트 끈 환경의 갇힘 재현)
   200	mutate 'm16 retrieval_pending 의 비활성 접기 제거' "$COMMON" \
   201	  '  ! hook_disabled "stop:retrieval"' \
   202	  '  true'
   203	
   204	# 17. 자동 해제 후 지문 재계산 제거 (stale 지문 → 하위 게이트 카운터 거짓 리셋 재현)
   205	mutate 'm17 해제 후 compute_flags_fp 재호출 제거' "$VSTOP" \
   206	  '    # 지문을 다시 계산한다 — 진입 시 스냅숏에는 방금 지운 "r" 비트가 남아 있어, 이 턴의
   207	    # 하위 게이트가 stale 지문으로 예산을 매기고 다음 턴에 거짓 리셋이 난다([cc] HIGH).
   208	    compute_flags_fp' \
   209	  '    :'
