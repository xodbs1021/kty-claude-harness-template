    70	# --- 픽스처 --------------------------------------------------------------
    71	
    72	# new_project — 케이스마다 독립 프로젝트(mktemp — 명령 치환 카운터는 서브셸에 갇힌다).
    73	# 타입체크·지식게이트는 리터럴로 비운다: 이 파일이 재는 것은 회수 게이트와 그 결합뿐이고,
    74	# 앞 게이트가 먼저 막으면 케이스가 회수 게이트에 도달조차 못 한 채 기대값이 우연히 맞는다.
    75	# 지식 게이트를 켤 케이스(r23)만 인자로 켠다.
    76	new_project() {   # $1 = 지식게이트 값(비우면 꺼짐)
    77	  local p
    78	  p="$(mktemp -d "$TMPROOT/proj.XXXXXX")" || return 1
    79	  mkdir -p "$p/.claude/hooks" "$p/.claude/harness" "$p/_workspace" || return 1
    80	  cp "$HOOKS/_common.sh" "$HOOKS/verify-before-stop.sh" "$HOOKS/mark-needs-audit.sh" "$p/.claude/hooks/" || return 1
    81	  printf 'HARNESS_TYPECHECK_CMD=""\nHARNESS_KNOWLEDGE_GATE="%s"\n' "${1-}" \
    82	    > "$p/.claude/harness/harness.env" || return 1
    83	  printf '%s\n' "$p"
    84	}
    85	
    86	# mk_tx <경로> <neutral|marker> — 최소 대화 기록. 결정 게이트(3.2)가 이 파일을 읽는다.
    87	#   neutral = 표지 어휘 없는 발화 (결정 게이트 침묵)
    88	#   marker  = 표지 어휘 + 서술형 (결정 게이트가 무장돼 있으면 차단)
    89	mk_tx() {
    90	  local tp="$1" kind="$2"
    91	  printf '%s\n' '{"type":"user","isSidechain":false,"message":{"role":"user","content":"작업해줘"}}' > "$tp" || return 1
    92	  case "$kind" in
    93	    neutral) printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"확인했습니다."}]}}' >> "$tp" ;;
    94	    marker)  printf '%s\n' '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"이건 범위 밖이라 그대로 뒀습니다."}]}}' >> "$tp" ;;
    95	  esac
    96	}
    97	
    98	# run_stop <프로젝트> <transcript경로|""> [env 인자...]
    99	run_stop() {
   100	  local p="$1" tp="$2"
   101	  shift 2
   102	  local errf="$TMPROOT/err.$$" outf="$TMPROOT/out.$$" payf="$TMPROOT/pay.$$"
   103	  RC=999; ERR=''; OUT=''; DID_RUN=1
   104	  python3 -c '
   105	import json, sys
   106	d = {"stop_hook_active": False}
   107	if sys.argv[1]:
   108	    d["transcript_path"] = sys.argv[1]
   109	with open(sys.argv[2], "w", encoding="utf-8") as fh:
   110	    fh.write(json.dumps(d))' "$tp" "$payf"
   111	  # cwd 를 프로젝트가 아닌 곳(TMPROOT)으로 둔다 — 상대경로 항목을 cwd 기준으로 여는
   112	  # 구현이면 여기서 전부 "소실"이 되어 r11 이 빨개진다. 이 디렉토리 선택이 곧 픽스처다.
   113	  ( cd "$TMPROOT" && env -u HARNESS_HOOKS -u ECC_DISABLED_HOOKS ${@+"$@"} CLAUDE_PROJECT_DIR="$p" \
   114	      bash "$p/.claude/hooks/verify-before-stop.sh" <"$payf" >"$outf" 2>"$errf" )
   115	  RC=$?
   116	  rm -f "$payf"
   117	  ERR="$(cat "$errf" 2>/dev/null)"
   118	  OUT="$(cat "$outf" 2>/dev/null)"
   119	  rm -f "$errf" "$outf"
   120	}
   121	
   122	# set_flag <프로젝트> <이름> <값...> — 플래그에 줄들을 기록한다.
   123	set_flag() {
   124	  local p="$1" name="$2"; shift 2
   125	  : > "$p/.claude/.needs-$name"
   126	  local v
   127	  for v in "$@"; do printf '%s\n' "$v" >> "$p/.claude/.needs-$name"; done
   128	}
   129	
   130	# mk_doc <경로> <첫줄|"EMPTY"> [둘째줄|"ONELINE"] — 산출물 파일을 만든다.
   131	#   EMPTY          : 0바이트 파일 (셋째 인자는 무시한다 — 명시 계약)
   132	#   둘째줄=ONELINE : 첫 줄만 있는 1줄 파일 (둘째 줄 누락 케이스용)
   133	#   둘째줄 생략    : GOOD_SECOND — **불량 픽스처도 둘째 줄은 정상**으로 두어 두 검사를
   134	#                    격리한다(첫 줄 검사를 지우는 변이가 둘째 줄 차단에 가려지면 안 된다).
   135	#                    격리 예외는 EMPTY(0바이트) 하나뿐이다.
   136	mk_doc() {
   137	  local f="$1" first="$2" second="${3-$GOOD_SECOND}"
   138	  case "$first" in
   139	    EMPTY) : > "$f"; return ;;
   140	  esac
   141	  case "$second" in
   142	    ONELINE) printf '%s\n' "$first" > "$f" ;;
   143	    *) printf '%s\n%s\n본문.\n' "$first" "$second" > "$f" ;;
   144	  esac
   145	}
   146	
   147	GOOD_FIRST='사전 결정 회수: docs/decisions/'
   148	GOOD_SECOND='레퍼런스 조사: 조사함(docs/decisions/ — 형제 게이트 선례)'
   149	flag_gone() { [ ! -e "$1/.claude/.needs-retrieval" ]; }
