+start = src.index('# (3.4) **머리 표명 게이트**')
 end = src.index('# (3.5) 듀얼 리뷰(codex) 게이트')
 block = src[start:end]
 rest = src[:start] + src[end:]
@@ -206,6 +213,126 @@ mutate 'm18 read 의 || [ -n ] 제거' "$VSTOP" \
   '  while IFS= read -r entry || [ -n "$entry" ]; do' \
   '  while IFS= read -r entry; do'
 
+# --- ADR-0015: 둘째 줄(레퍼런스 표명) 방어 (m19~m35) -----------------------
+
+# 19. 둘째 줄 검사 통째 무력화 — if 체인 머리에 항상 참인 no-op 가지를 끼운다
+mutate 'm19 둘째 줄 검사 통째 제거' "$VSTOP" \
+  '    if [ "$ref_missing" -eq 1 ]; then' \
+  '    if : ; then :
+    elif [ "$ref_missing" -eq 1 ]; then'
+
+# 20. 접두어만 검사로 느슨화 — 접두어 매치 즉시 통과 (사유 강제가 산문으로 밀린다)
+mutate 'm20 접두어만 검사로 느슨화' "$VSTOP" \
+  '        "레퍼런스 조사:"*)
+          ref_body="${rline2#레퍼런스 조사:}"' \
+  '        "레퍼런스 조사:"*)
+          :
+          ;;
+        "__never__")
+          ref_body="${rline2#레퍼런스 조사:}"'
+
+# 21. 괄호 내용 검사 제거 (빈 괄호 허용 — 불요/실패 사유 강제 소멸)
+mutate 'm21 괄호 내용 검사 제거' "$VSTOP" \
+  "                    if [ -z \"\$(printf '%s' \"\$ref_inner\" | LC_ALL=C tr -d '[:space:]')\" ]; then" \
+  '                    if false; then'
+
+# 22. 둘째 줄 CR 스트립 제거
+mutate 'm22 둘째 줄 CR 스트립 제거' "$VSTOP" \
+  "      rline2=\"\${rline2%\$'\\r'}\"" \
+  '      :'
+
+# 23. `불요` 변형 제거
+mutate 'm23 불요 변형 제거' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              조사함|실패)'
+
+# 24. 닫는 괄호 뒤 잡음 허용 (accept 팔을 전부 매치로 — 아래 bad 팔이 죽는다)
+mutate 'm24 꼬리 잡음 허용' "$VSTOP" \
+  '                  *\))' \
+  '                  *)'
+
+# 25. 둘째 줄 불량(접두어 사유)을 목록에 추가하지 않음 — 판정만 하고 버림
+mutate 'm25 둘째 줄 불량 목록 누락' "$VSTOP" \
+  "          retrieval_bad_paths=\"\${retrieval_bad_paths}\${entry}#2
+\"
+          retrieval_bad_msgs=\"\${retrieval_bad_msgs}\${entry} — 둘째 줄이 '레퍼런스 조사:' 로 시작하지 않음
+\"" \
+  '          :'
+
+# 26. 무개행 마지막 줄 보정 가지 제거 — 개행 없는 정상 둘째 줄이 누락으로 오판된다
+mutate 'm26 무개행 보정 elif 가지 제거' "$VSTOP" \
+  '      elif [ -n "$rline2" ]; then
+        :                   # 개행 없는 마지막 줄 — 값이 있으므로 누락이 아니다
+      else' \
+  '      else'
+
+# 27. 변형 정확 일치를 접두 일치로 — `조사함부족(x)` 이 통과한다
+mutate 'm27 변형 꼬리 허용' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              조사함*|불요*|실패*)'
+
+# 28. 예산 키의 검사 종류 태그 제거 — 파일 내 부분 진전이 리셋을 못 만든다
+mutate 'm28 예산 키 검사 태그 제거' "$VSTOP" \
+  "    retrieval_bad_sorted=\"\$(printf '%s' \"\$retrieval_bad_paths\" | sort -u | tr '\\n' ' ')\" \\" \
+  "    retrieval_bad_sorted=\"\$(printf '%s' \"\$retrieval_bad_paths\" | sed 's/#[12]\$//' | sort -u | tr '\\n' ' ')\" \\"
+
+# 29. `실패` 변형 제거 (제3 변형)
+mutate 'm29 실패 변형 제거' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              조사함|불요)'
+
+# 30. `조사함` 변형 제거 (변형 3종 제거 변이의 대칭 완성)
+mutate 'm30 조사함 변형 제거' "$VSTOP" \
+  '              조사함|불요|실패)' \
+  '              불요|실패)'
+
+# 31. 내부 괄호 거부 — 내용 안 `)` 를 잡음으로 오인하는 구현 재현 (r40 방어)
+mutate 'm31 내부 괄호 거부' "$VSTOP" \
+  '                case "$ref_body" in
+                  *\))' \
+  '                case "$ref_body" in
+                  *\)*\))
+                    retrieval_bad_paths="${retrieval_bad_paths}${entry}#2
+"
+                    ;;
+                  *\))'
+
+# 32. 변형 뒤 공백 불허 — `조사함 (x)` 가 불량이 된다 (r43 방어)
+mutate 'm32 변형 뒤 공백 불허' "$VSTOP" \
+  '              *'"'"' '"'"')  ref_head="${ref_head% }" ;;' \
+  '              *'"'"' '"'"')  break ;;'
+
+# 33. SP 에서 탭 제거 — 접두어 뒤 탭이 불량이 된다 (r47 방어)
+mutate 'm33 SP 탭 제거' "$VSTOP" \
+  "              '	'*)  ref_body=\"\${ref_body#	}\" ;;" \
+  "              '	'*)  break ;;"
+
+# 34. 닫는 괄호 뒤 공백 불허 (r49 방어)
+mutate 'm34 괄호 뒤 공백 불허' "$VSTOP" \
+  '              *'"'"' '"'"')  ref_body="${ref_body% }" ;;' \
+  '              *'"'"' '"'"')  break ;;'
+
+# 36. 변형 뒤 탭 트림 제거 — `조사함<TAB>(x)` 가 불량이 된다 (r47 자리 2 방어)
+mutate 'm36 변형 뒤 탭 트림 제거' "$VSTOP" \
+  "              *'	')  ref_head=\"\${ref_head%	}\" ;;" \
+  "              *'	')  break ;;"
+
+# 37. 닫는 괄호 뒤 탭 트림 제거 — `조사함(x)<TAB>` 가 불량이 된다 (r47 자리 3 방어)
+mutate 'm37 괄호 뒤 탭 트림 제거' "$VSTOP" \
+  "              *'	')  ref_body=\"\${ref_body%	}\" ;;" \
+  "              *'	')  break ;;"
+
+# 35. 첫 줄 "빈 줄" 분기 제거 — r50(격리 픽스처)·r04(사유 단언)가 잡는다
+mutate 'm35 첫 줄 빈 줄 분기 제거' "$VSTOP" \
+  '      "")
+        retrieval_bad_paths="${retrieval_bad_paths}${entry}#1
+"
+        retrieval_bad_msgs="${retrieval_bad_msgs}${entry} — 파일이 비었거나 첫 줄이 빈 줄
+"
+        ;;' \
+  '      "")
+        ;;'
+
 echo
 echo "총 $total 건 — 적색 $red · 초록 $green"
 [ "$green" -eq 0 ] && [ "$red" -eq "$total" ]
diff --git a/docs/decisions/2026-08-10-knowledge-retrieval-policy-decided.md b/docs/decisions/2026-08-10-knowledge-retrieval-policy-decided.md
index ee81c50..11512d8 100644
--- a/docs/decisions/2026-08-10-knowledge-retrieval-policy-decided.md
+++ b/docs/decisions/2026-08-10-knowledge-retrieval-policy-decided.md
@@ -54,12 +54,15 @@
 
 **내용의 기계 검증은 층 위반 없이는 불가능하다** — "읽었는가"를 기계가 확인하려면 하네스가 그 경로의 내용 구조를 알아야 한다(ADR-0009 Alt D 사유 유지). 못 푸는 것은 못 푼다고 적고, 세 단계로 올린다:
 
-**⑴ 표명을 두껍게.** 산출물 첫 줄(`사전 결정 회수: <경로>` 또는 `없음(<사유>)`) 직후에 회수 블록: `- 걸리는 선행 결정: <제목 — 이번 작업에 어떻게 걸리는지 한 줄>` (0건이면 `걸리는 선행 결정 없음`). 지어낸 회수는 경로 한 줄보다 목록이 더 큰 거짓말이 되고, 검증 대상이 생긴다.
+**⑴ 표명을 두껍게.** 산출물 첫 줄(`사전 결정 회수: <경로>` 또는 `없음(<사유>)`) 직후에 회수 블록: `- 걸리는 선행 결정: <제목 — 이번 작업에 어떻게 걸리는지 한 줄>` (0건이면 `걸리는 선행 결정 없음`). 지어낸 회수는 경로 한 줄보다 목록이 더 큰 거짓말이 되고, 검증 대상이 생긴다. *(갱신 — ADR-0015: 둘째 줄을 레퍼런스 조사 표명이 차지하면서 회수 블록의 위치는 "첫 줄 직후"에서 **셋째 줄부터**로 바뀌었다. 블록의 형식·의미는 불변.)*
 
 **⑵ 내용 검증은 검수 층으로 — 전부 산문 계약이다.** 검사 3항목(회수 블록 형식 / 산출물이 걸리는 선행 결정과 모순되는가 / 걸린다는 결정이 실제로 반영됐는가)을 plan-reviewer 점검 항목과 설계·계획 pass 의 codex 리뷰 프롬프트 계약에 얹는다. **기계 보장이 아니다** — `stop:dualreview` 게이트는 플래그만 보고, codex 산출물 실존도 plan-reviewer 실행도 기계가 확인하지 않는다. 기계가 보장하는 것은 "듀얼 리뷰를 마쳤다고 에이전트가 표명(플래그 삭제)했다"까지다. (설계 v2 가 "기계에 연결된 검증 축이 생긴다"고 적었다가 검수가 거짓 공시로 반증했다 — 그 철회를 여기 기록한다.)
 
 **⑶ 형식 검증은 Stop 게이트로 — 신설 `stop:retrieval`.** 표명 첫 줄은 ADR-0009 가 만든 **이미 있는 계약**이고 그 검증이 산문("첫 줄을 확인한다 — 없으면 되돌린다")으로만 있었다 — 산문 승격 부류다. `_workspace/00_design*.md`·`01_plan*.md` 는 하네스 소유 산출물이라 층 위반이 없다.
 
+*(갱신 — ADR-0015: 아래 기계 계약 중 "첫 줄" 검사는 **머리 두 줄** 검사로, 예산 키의
+불량 목록 항목은 `<경로>#검사번호` 로 확장됐다. 이 블록은 당시 결정의 기록으로 보존한다.)*
+
 ```
 mark-needs-audit: 설계·계획 산출물 저장 시 .needs-retrieval 에 경로 기록 (안=상대, 밖=절대)
 stop 게이트 3.4: 각 경로의 첫 줄이 표명 형식인가 (BOM·CR 스트립 후 판정.
@@ -138,6 +141,7 @@ stop 게이트 3.4: 각 경로의 첫 줄이 표명 형식인가 (BOM·CR 스트
 **공시된 측정 공백:** 3.4 의 자동 해제 후 exit 0 경로에 있는 `decision_note` 방출은 현행 발동 규칙에서 **도달 불가**다 — decision_note 가 서려면 결정 게이트를 무장시키는 플래그가 서야 하는데, 그 플래그가 `work_pending` 을 참으로 유지해 exit 0 에 못 간다. 방출 코드는 발동 규칙이 바뀌는 날을 위한 방어로 남겼고, **그 제거 변이는 원리적으로 초록이다**(ADR-0012 의 "모르는 rc" 공백과 같은 부류 — 두 공시가 짝이고 하나만 보면 오판한다).
 
 ## 관련
+- ADR-0015 (2026-08-11-reference-research-gate.md) — ④-⑴의 회수 블록 위치("첫 줄 직후")와 ④-⑶의 기계 계약(첫 줄 검사·예산 키)을 갱신했다: 둘째 줄에 레퍼런스 조사 표명이 추가되고 3.4 는 머리 표명 게이트로 일반화됐다
 - [ADR-0010](2026-08-06-knowledge-retrieval-policy.md) — superseded. 공백 4개의 선언이 이 ADR 의 입력이었다
 - [ADR-0009](2026-08-06-profile-canon-upstream.md) — 이 정책이 얹힌 배관
 - [ADR-0006](2026-08-05-knowledge-store-layer-boundary.md) — 지키는 층 계약
diff --git a/docs/decisions/2026-08-11-reference-research-gate.md b/docs/decisions/2026-08-11-reference-research-gate.md
new file mode 100644
index 0000000..404f720
--- /dev/null
+++ b/docs/decisions/2026-08-11-reference-research-gate.md
@@ -0,0 +1,184 @@
판정: 보류

- HIGH — 실물 훅에 변이 m03이 잔류해 자동 해제 후 재평가가 죽어 있다. [verify-before-stop.sh:470](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:470)의 `if false`는 [mutate-retrieval-gate.sh:103](/Users/kty/Downloads/kty-claude-harness-template/_workspace/mutate-retrieval-gate.sh:103)의 m03 대체문과 정확히 같다. 또한 변이 하네스는 EXIT 시 락만 제거하고([mutate-retrieval-gate.sh:41](/Users/kty/Downloads/kty-claude-harness-template/_workspace/mutate-retrieval-gate.sh:41)), 변이 후 정상 경로에서만 복원한다([mutate-retrieval-gate.sh:75](/Users/kty/Downloads/kty-claude-harness-template/_workspace/mutate-retrieval-gate.sh:75), [mutate-retrieval-gate.sh:88](/Users/kty/Downloads/kty-claude-harness-template/_workspace/mutate-retrieval-gate.sh:88)). 실물 해시는 HEAD 및 `_workspace/31_impl.diff` 대상과 다르다. 정상 머리 표명 + retrieval 플래그만 있는 입력 → 플래그를 자동 삭제한 뒤 종료하지 않고 무조건 감사 게이트([verify-before-stop.sh:627](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:627))까지 진행 → 빈 감사 대상으로 rc=2 허위 차단. r18이 겨누는 바로 그 회귀다([retrieval-attestation.test.sh:448](/Users/kty/Downloads/kty-claude-harness-template/tests/retrieval-attestation.test.sh:448)).

- MEDIUM — 7종 사유 상수 중 빈 괄호 사유가 확정 문자열과 다르며 테스트가 이를 숨긴다. 설계 상수는 `레퍼런스 표명의 괄호 안이 비었음`이다([00_design-reference-gate.md:229](/Users/kty/Downloads/kty-claude-harness-template/_workspace/00_design-reference-gate.md:229)). 구현은 뒤에 `(불요·실패에도 사유는 필수)`를 붙인다([verify-before-stop.sh:429](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:429)). 공통 단언은 부분문자열만 찾는다([retrieval-attestation.test.sh:644](/Users/kty/Downloads/kty-claude-harness-template/tests/retrieval-attestation.test.sh:644)). `레퍼런스 조사: 실패()` 입력 → 차단 자체는 맞지만 계약된 상수와 다른 진단 → 정확 문자열 소비자는 실패하는데 r33·r34·r46은 모두 통과.

- MEDIUM — “한 파일의 두 줄이 모두 불량이면 두 항목·두 메시지”라는 결합 계약을 직접 단언하지 않는다. r37은 두 상태를 별도 파일에서만 검사하고([retrieval-attestation.test.sh:695](/Users/kty/Downloads/kty-claude-harness-template/tests/retrieval-attestation.test.sh:695)), r45 첫 실행은 두 사유나 두 키의 존재를 확인하지 않는다([retrieval-attestation.test.sh:748](/Users/kty/Downloads/kty-claude-harness-template/tests/retrieval-attestation.test.sh:748)). 첫 줄이 불량일 때 둘째 줄 검사를 건너뛰는 구현 → 첫 실행은 `path#1`, 첫 줄 수정 뒤 `path#2`로 키가 바뀌어 r45의 1/3 리셋 단언까지 통과 → 설계가 요구한 동시 `#1/#2` 및 두 진단은 유실.

- MEDIUM — `sort` 실패 폴백은 구현되어 있으나 테스트와 변이가 실제로 물지 않는다. 폴백은 [verify-before-stop.sh:489](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:489)에 있지만 모든 예산 테스트는 정상 PATH의 `sort` 경로만 사용하고, m28도 주 파이프만 바꾼다([mutate-retrieval-gate.sh:268](/Users/kty/Downloads/kty-claude-harness-template/_workspace/mutate-retrieval-gate.sh:268)). 제한된 PATH에서 `sort` 실패 + 두 줄 모두 불량 → 폴백이 태그 하나를 잃거나 빈 키를 내는 회귀가 생겨도 50케이스·35변이는 초록일 수 있다.

- MEDIUM — `<SP*>`의 탭 허용을 세 위치 모두 방어하지 않는다. 구현은 접두어 뒤, 닫는 괄호 뒤, 변형 뒤 탭을 각각 처리한다([verify-before-stop.sh:397](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:397), [verify-before-stop.sh:399](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:399), [verify-before-stop.sh:407](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:407)). 그러나 r47은 접두어 뒤 탭만 검사하고([retrieval-attestation.test.sh:791](/Users/kty/Downloads/kty-claude-harness-template/tests/retrieval-attestation.test.sh:791)), m33도 그 한 처리만 제거한다([mutate-retrieval-gate.sh:299](/Users/kty/Downloads/kty-claude-harness-template/_workspace/mutate-retrieval-gate.sh:299)). `조사함<TAB>(x)` 또는 `불요(x)<TAB>` → 해당 트림 한 줄이 빠진 구현은 정상 입력을 차단하지만 현재 방어망은 통과.

- LOW — 차단 안내의 “선행 결정 없음” 형식에서 필수 `- `가 빠졌다. 구현 안내는 `걸리는 선행 결정 없음`이라고 적지만([verify-before-stop.sh:507](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/hooks/verify-before-stop.sh:507)), 정본은 `- 걸리는 선행 결정 없음`이다([project-profile.template.md:145](/Users/kty/Downloads/kty-claude-harness-template/template/.claude/harness/project-profile.template.md:145)). 사용자가 차단 메시지를 그대로 따라 결정 없음 줄을 작성 → 기계 게이트는 셋째 줄을 검사하지 않아 통과하지만 산문 계약 위반 산출물이 남는다.

- LOW — m15만 “앵커 정확히 1회” 계약을 적용하지 않는다. 일반 변이는 횟수를 센 반면, m15는 Python `str.index`로 첫 발생만 선택한다([mutate-retrieval-gate.sh:169](/Users/kty/Downloads/kty-claude-harness-template/_workspace/mutate-retrieval-gate.sh:169)). 헤더나 삽입 앵커가 중복된 입력 → 잘못된 블록을 이동해 테스트가 적색이 되어도 “순서 방어 확인”으로 집계될 수 있다.

정적 확인상 금지된 Bash 4 기능(`mapfile`·연관배열·`${var,,}`)은 없었다. 블록 리다이렉트의 대입은 부모 셸에 남고, 중첩 `case`도 Bash 3.2 문법에 맞는다. 트림 루프는 매 매치마다 ASCII 공백 또는 탭 한 글자를 제거하므로 무한루프 경로가 없다. 한글 변형은 정확 일치하며, 내부 괄호와 마지막 `)` 처리도 확정 문법과 일치한다.

미확인 — 요청의 “정적 독해만” 조건에 따라 50케이스 및 35변이를 실행하지 않았다. 다만 현재 실물의 `if false` 때문에 r18은 정적으로 실패가 확정되며, 변이 하네스 자체는 대상 파일의 dirty 상태 검사에서 실행을 거부한다.

