   141	# 위음성은 조용하고 오탐은 탈출구(ECC_DISABLED_HOOKS)가 있다 — 그래서 단순한 쪽을 택했다.
   142	is_harness_canonical() {
   143	  [ -d "$1/template/.claude" ]
   144	}
   145	
   146	# harness_anchor <선행 슬래시가 있는 경로> — 하네스 동작을 정의하는 자리인가.
   147	# 앵커 목록을 정의하는 **유일 지점**이다.
   148	harness_anchor() {
   149	  case "$1" in
   150	    */.claude/agents/*|*/.claude/skills/*|*/.claude/hooks/*|*/.claude/harness/*|*/.claude/settings.json)
   151	      return 0 ;;
