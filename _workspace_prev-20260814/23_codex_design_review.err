   434	    echo
   435	    echo "이 턴에서 바뀐 코드/설정:"
   436	    sed 's/^/  - /' "$EXPLAIN_FLAG" 2>/dev/null
   437	    echo
   438	    echo "해야 할 일:"
   439	    echo "  1. change-explainer 에이전트로 실제 diff 기반 사용자용 변경 설명을 낸다."
   440	    echo "  2. 설명을 낸 뒤에만:  rm -f .claude/.needs-explain"
