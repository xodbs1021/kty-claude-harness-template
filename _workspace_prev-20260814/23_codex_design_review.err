   426	# (4) change-explainer 게이트 (Phase 5) — 감사자보다 먼저 강제한다.
   427	#     코드가 바뀐 턴은 변경 설명 없이 끝낼 수 없다. change-explainer 가 실제로
   428	#     사용자용 설명을 낸 뒤에만 .needs-explain 을 지운다.
   429	#     (완료 감사와 별개로 이 게이트만 끄려면 ECC_DISABLED_HOOKS=stop:explain)
   430	if [ -s "$EXPLAIN_FLAG" ] && ! hook_disabled "stop:explain"; then
   431	  gate_budget "explain"
   432	  {
