   306	r11() { # 상대경로 항목은 $PROJECT_DIR 기준으로 열린다. run_stop 이 cwd 를 TMPROOT 로
   307	        # 두므로, cwd 기준으로 여는 구현이면 파일이 "소실"로 오인돼 이 차단이 사라진다.
   308	  local name='r11 상대경로 항목 — 다른 cwd 에서도 판정' why=''
   309	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   310	  mk_doc "$p/_workspace/00_design.md" '표명 없는 설계다.'
   311	  set_flag "$p" retrieval '_workspace/00_design.md'
   312	  set_flag "$p" audit 'src/x.ts'
   313	  mk_tx "$p/tx.jsonl" neutral
   314	  run_stop "$p" "$p/tx.jsonl"
   315	  if ! contains "$ERR" "$TOK_RET"; then why="차단하지 않았다 (상대경로가 cwd 기준으로 열렸을 가능성): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   316	  fi
   317	  report "$name" "$why"
   318	}
   319	
   320	r12() { # 절대경로 항목(프로젝트 밖) + 상대·절대 혼재. 밖 파일이 불량이면 차단.
   321	  local name='r12 절대경로·혼재 항목 판정' why=''
   322	  local p out; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   323	  out="$(mktemp -d "$TMPROOT/outside.XXXXXX")" || { report "$name" '픽스처 실패'; return 0; }
   324	  mkdir -p "$out/_workspace"
   325	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   326	  mk_doc "$out/_workspace/01_plan.md" '표명 없는 밖 계획이다.'
   327	  set_flag "$p" retrieval '_workspace/00_design.md' "$out/_workspace/01_plan.md"
   328	  set_flag "$p" audit 'src/x.ts'
   329	  mk_tx "$p/tx.jsonl" neutral
   330	  run_stop "$p" "$p/tx.jsonl"
   331	  if ! contains "$ERR" "$TOK_RET";              then why='차단하지 않았다'
   332	  elif ! contains "$ERR" "$out/_workspace/01_plan.md"; then why='밖 불량 파일명이 없다'
   333	  fi
   334	  report "$name" "$why"
   335	}
   336	
   337	r13() { # fail-closed 두 축: ① 플래그 파일 자체를 읽을 수 없다 → 차단(사유 포함)
   338	        #                   ② 대상 파일이 있는데 읽을 수 없다 → 불량으로 차단
   339	  local name='r13 읽기 실패는 통과가 아니다 (플래그·대상)' why=''
   340	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   341	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   342	  set_flag "$p" retrieval '_workspace/00_design.md'
   343	  set_flag "$p" audit 'src/x.ts'
   344	  mk_tx "$p/tx.jsonl" neutral
   345	  chmod 000 "$p/.claude/.needs-retrieval"
   346	  run_stop "$p" "$p/tx.jsonl"
   347	  chmod 644 "$p/.claude/.needs-retrieval" 2>/dev/null
   348	  if ! contains "$ERR" "$TOK_RET_FLAGFAIL"; then
   349	    why="플래그 읽기 실패를 차단하지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   350	  else
   351	    local p2; p2="$(new_project)" || { report "$name" '픽스처 실패(2)'; return 0; }
   352	    mk_doc "$p2/_workspace/00_design.md" "$GOOD_FIRST"
   353	    chmod 000 "$p2/_workspace/00_design.md"
   354	    set_flag "$p2" retrieval '_workspace/00_design.md'
   355	    set_flag "$p2" audit 'src/x.ts'
   356	    mk_tx "$p2/tx.jsonl" neutral
   357	    run_stop "$p2" "$p2/tx.jsonl"
   358	    chmod 644 "$p2/_workspace/00_design.md" 2>/dev/null
   359	    if ! contains "$ERR" "$TOK_RET"; then why='대상 읽기 실패를 차단하지 않았다'
   360	    elif ! contains "$ERR" '읽을 수 없음'; then why='사유(읽기 실패)가 없다'
   361	    fi
   362	  fi
   363	  report "$name" "$why"
   364	}
   365	
   366	r14() { # 불량 집합이 줄어드는 실제 진전은 이 게이트의 예산 카운터를 리셋한다.
   367	        # 예산 키에서 목록을 빼는 변이가 여기서 빨개진다(2회째가 2/3 로 나온다).
   368	  local name='r14 불량을 하나 고치면 카운터 리셋 (1/3 유지)' why=''
   369	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   370	  mk_doc "$p/_workspace/00_design.md" '표명 없음 A.'
   371	  mk_doc "$p/_workspace/01_plan.md" '표명 없음 B.'
   372	  set_flag "$p" retrieval '_workspace/00_design.md' '_workspace/01_plan.md'
   373	  set_flag "$p" audit 'src/x.ts'
   374	  mk_tx "$p/tx.jsonl" neutral
   375	  run_stop "$p" "$p/tx.jsonl"
   376	  if ! contains "$ERR" '차단 1/'; then why="1회차가 1/N 이 아니다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   377	  else
   378	    mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"    # A 를 고쳤다 = 진전
   379	    run_stop "$p" "$p/tx.jsonl"
   380	    if ! contains "$ERR" "$TOK_RET";    then why='2회차에 차단하지 않았다'
   381	    elif ! contains "$ERR" '차단 1/';   then why="진전인데 카운터가 리셋되지 않았다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   382	    fi
   383	  fi
   384	  report "$name" "$why"
   385	}
   386	
   387	r15() { # 예산 소진 시 회수 플래그도 정리 목록에 있다 — rm 과 changed 나열 양쪽.
   388	        # changed 단언은 **불량 집합에 없는 소실 항목**으로 잰다: 불량 경로는 예산 소진
   389	        # 메시지의 게이트 식별자("같은 지점(retrieval:...)")에도 실려서, changed 나열에서
   390	        # 회수 플래그를 빼도 같은 파일명이 다른 경로로 출력돼 변이가 가려진다(실측 —
   391	        # "데이터 중복이 방어를 가린다" 부류. m13 이 이 단언으로만 빨개진다).
   392	  local name='r15 예산 소진 정리에 회수 플래그 포함' why=''
   393	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   394	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   395	  set_flag "$p" retrieval '_workspace/00_design.md' '_workspace/01_plan_gone.md'
   396	  set_flag "$p" audit 'src/x.ts'
   397	  mk_tx "$p/tx.jsonl" neutral
   398	  run_stop "$p" "$p/tx.jsonl"; run_stop "$p" "$p/tx.jsonl"; run_stop "$p" "$p/tx.jsonl"
   399	  run_stop "$p" "$p/tx.jsonl"   # 4회째 — 같은 상태이므로 예산 소진
   400	  if [ "$RC" -ne 0 ];                        then why="소진 턴 rc=$RC (기대 0)"
   401	  elif ! contains "$OUT" "$TOK_BRICK";       then why='벽돌 방지 메시지가 없다'
   402	  elif ! contains "$OUT" '01_plan_gone.md';  then why='changed 나열에 회수 플래그 항목이 없다 (소실 항목은 게이트 식별자에 없다)'
   403	  elif ! flag_gone "$p";                     then why='소진 정리에서 회수 플래그가 안 지워졌다'
   404	  fi
   405	  report "$name" "$why"
   406	}
   407	
   408	r16() { # 결정 게이트 판독 불가 사유는 회수 차단 메시지에도 실린다 (ADR-0012 ②).
   409	        # transcript 를 아예 주지 않아 판독 불가를 만든다. 발동 조건은 audit 플래그.
   410	  local name='r16 판독 불가 사유가 회수 차단에 실린다' why=''
   411	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   412	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   413	  set_flag "$p" retrieval '_workspace/00_design.md'
   414	  set_flag "$p" audit 'src/x.ts'
   415	  run_stop "$p" ""
   416	  if ! contains "$ERR" "$TOK_RET";  then why='회수 게이트가 막지 않았다'
   417	  elif ! contains "$ERR" "$TOK_NOTE"; then why='판독 불가 사유가 안 실렸다'
   418	  fi
   419	  report "$name" "$why"
   420	}
   421	
   422	r17() { # retrieval 플래그는 decision_armed 에 **들어가지 않는다** — 소실 항목만 남은
   423	        # stale 플래그 + 결정 표지 발화에서 결정 게이트가 오발동하면 3.4 의 해제 기회가
   424	        # 오지 않는다(설계 검수 [cc] r2 H). 기대: 결정 침묵 + 해제 + exit 0.
   425	  local name='r17 stale 플래그가 결정 게이트를 무장시키지 않는다' why=''
   426	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   427	  set_flag "$p" retrieval '_workspace/00_design.md'   # 파일 없음 = stale
   428	  mk_tx "$p/tx.jsonl" marker
   429	  run_stop "$p" "$p/tx.jsonl"
   430	  if contains "$ERR" "$TOK_DECISION"; then why='결정 게이트가 오발동했다'
   431	  elif [ "$RC" -ne 0 ];               then why="rc=$RC (기대 0): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   432	  elif ! flag_gone "$p";              then why='stale 플래그가 해제되지 않았다'
   433	  fi
   434	  report "$name" "$why"
   435	}
   436	
   437	r18() { # 정상 표명 + 다른 할 일 전무 → exit 0. 재평가가 없으면 맨 아래 감사 게이트가
   438	        # 빈 목록으로 허위 차단한다(설계 검수 [cx] r2).
   439	  local name='r18 정상 + 할 일 전무 → exit 0 (허위 감사 차단 없음)' why=''
   440	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   441	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   442	  set_flag "$p" retrieval '_workspace/00_design.md'
   443	  mk_tx "$p/tx.jsonl" neutral
   444	  run_stop "$p" "$p/tx.jsonl"
   445	  if [ "$RC" -ne 0 ];       then why="rc=$RC (기대 0): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   446	  elif ! flag_gone "$p";    then why='플래그 미해제'
   447	  elif contains "$ERR" '완료 차단'; then why='어떤 게이트가 차단했다'
   448	  fi
   449	  report "$name" "$why"
   450	}
   451	
   452	r19() { # arming 은 수기 플래그가 아니라 **mark-needs-audit 실제 실행**으로도 잰다 —
   453	        # 기록 제거 변이가 수기 픽스처에 가려지지 않게. Stop 까지 이어 돌려 차단 확인.
   454	  local name='r19 mark-needs-audit 실행 → 회수 플래그 → 차단' why=''
   455	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   456	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   457	  printf '{"tool_input":{"file_path":"%s"}}' "$p/_workspace/00_design.md" | \
   458	    CLAUDE_PROJECT_DIR="$p" bash "$p/.claude/hooks/mark-needs-audit.sh" >/dev/null 2>&1
   459	  if [ ! -s "$p/.claude/.needs-retrieval" ]; then
   460	    why='mark-needs-audit 가 회수 플래그를 기록하지 않았다'
   461	  else
   462	    set_flag "$p" audit 'src/x.ts'   # 감사 도달 확인용
   463	    mk_tx "$p/tx.jsonl" neutral
   464	    run_stop "$p" "$p/tx.jsonl"
   465	    contains "$ERR" "$TOK_RET" || why='기록된 플래그로 차단되지 않았다'
   466	  fi
   467	  report "$name" "$why"
   468	}
   469	
   470	r20() { # 이름·경로에 codex 가 들어도 산출물이면 검사 대상이다 — mark-needs-audit 쪽
   471	        # 계약(케이스 74·75)의 Stop 쪽 절반: 그 플래그로 실제 차단까지 간다.
   472	  local name='r20 codex 이름 산출물도 검사된다' why=''
   473	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   474	  mk_doc "$p/_workspace/00_design-codex-gate.md" '표명 없음.'
   475	  set_flag "$p" retrieval '_workspace/00_design-codex-gate.md'
   476	  set_flag "$p" audit 'src/x.ts'
   477	  mk_tx "$p/tx.jsonl" neutral
   478	  run_stop "$p" "$p/tx.jsonl"
   479	  contains "$ERR" "$TOK_RET" || why='codex 이름이라는 이유로 검사에서 빠졌다'
   480	  report "$name" "$why"
   481	}
   482	
   483	r21() { # 표명 리터럴 드리프트 — 같은 문자열이 세 정본 자리에 있어야 한다.
   484	        # 대상 목록은 상수다(파생하면 파일이 빠져도 초록이 된다).
   485	  local name='r21 표명 문자열이 훅·스킬·프로필에서 동일' why=''
   486	  local lit='사전 결정 회수:' f
   487	  for f in \
   488	    "$HOOKS/verify-before-stop.sh" \
   489	    "$REPO_ROOT/template/.claude/skills/harness-orchestrator/SKILL.md" \
   490	    "$REPO_ROOT/template/.claude/harness/project-profile.template.md"; do
   491	    grep -qF "$lit" "$f" || { why="리터럴이 없다: $f"; break; }
   492	  done
   493	  report "$name" "$why"
   494	}
   495	
   496	r22() { # 정상 해제 + push 미완 → push 게이트가 막는다. 재평가식이 플래그만 세면
   497	        # 자동 해제가 push 를 삼킨다(설계 검수 [cc·cx] r2 B — 커밋 29개를 잃은 상태의 재개방).
   498	  local name='r22 정상 해제 + push 미완 → push 차단' why=''
   499	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   500	  ( cd "$p" && git init -q . && git checkout -q -b main 2>/dev/null; \
   501	    git -C "$p" config user.email t@t && git -C "$p" config user.name t \
   502	    && git -C "$p" add -A >/dev/null 2>&1 && git -C "$p" commit -qm base \
   503	    && git -C "$p" remote add origin "$p" \
   504	    && git -C "$p" update-ref refs/remotes/origin/main HEAD \
   505	    && printf 'x\n' > "$p/x.txt" && git -C "$p" add x.txt && git -C "$p" commit -qm ahead ) >/dev/null 2>&1 \
   506	    || { report "$name" '픽스처 실패: git'; return 0; }
   507	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   508	  set_flag "$p" retrieval '_workspace/00_design.md'
   509	  mk_tx "$p/tx.jsonl" neutral
   510	  run_stop "$p" "$p/tx.jsonl"
   511	  if ! contains "$ERR" "$TOK_PUSH"; then why="push 게이트 미도달 (rc=$RC): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   512	  elif ! flag_gone "$p";            then why='회수 플래그는 해제됐어야 한다'
   513	  fi
   514	  report "$name" "$why"
   515	}
   516	
   517	r23() { # 정상 해제 + 지식 게이트 켜짐 → 지식 게이트로 계속 흘러간다 (재평가가 과하게
   518	        # exit 0 하지 않는다). 켜진 지식 게이트가 work_pending 을 참으로 유지한다.
   519	  local name='r23 정상 해제 + 지식 플래그 → 지식 게이트 도달' why=''
   520	  local p; p="$(new_project on)" || { report "$name" '픽스처 실패'; return 0; }
   521	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   522	  set_flag "$p" retrieval '_workspace/00_design.md'
   523	  set_flag "$p" knowledge '_workspace/00_design.md'
   524	  mk_tx "$p/tx.jsonl" neutral
   525	  run_stop "$p" "$p/tx.jsonl"
   526	  if contains "$ERR" "$TOK_RET";      then why='위양성 — 회수 게이트가 막았다'
   527	  elif ! contains "$ERR" "$TOK_KNOW"; then why="지식 게이트 미도달 (rc=$RC): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   528	  elif ! flag_gone "$p";              then why='회수 플래그 미해제'
   529	  fi
   530	  report "$name" "$why"
   531	}
   532	
   533	r24() { # 회수 불량 목록은 **다른 게이트의 예산을 건드리지 않는다.** 결정 게이트에 갇힌 채
   534	        # 불량 집합만 바뀌어도 결정 게이트의 카운터는 이어져야 한다(공유 지문 불변식 —
   535	        # 목록을 flags_fp 로 전파하는 변이가 여기서 빨개진다).
   536	  local name='r24 불량 집합 변화가 결정 게이트 예산을 리셋하지 않는다' why=''
   537	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   538	  mk_doc "$p/_workspace/00_design.md" '표명 없음 A.'
   539	  set_flag "$p" retrieval '_workspace/00_design.md'
   540	  set_flag "$p" audit 'src/x.ts'
   541	  mk_tx "$p/tx.jsonl" marker      # 결정 게이트(3.2)가 3.4 보다 먼저 막는다
   542	  run_stop "$p" "$p/tx.jsonl"
   543	  if ! contains "$ERR" "$TOK_DECISION"; then why="결정 게이트가 먼저 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   544	  elif ! contains "$ERR" '차단 1/';     then why='1회차가 1/N 이 아니다'
   545	  else
   546	    mk_doc "$p/_workspace/01_plan.md" '표명 없음 B.'   # 불량 집합만 바꾼다
   547	    printf '_workspace/01_plan.md\n' >> "$p/.claude/.needs-retrieval"
   548	    run_stop "$p" "$p/tx.jsonl"
   549	    if ! contains "$ERR" "$TOK_DECISION"; then why='2회차에 결정 게이트가 안 막았다'
   550	    elif ! contains "$ERR" '차단 2/';     then why="결정 게이트 카운터가 리셋됐다 (집합 변화가 전파됨): $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   551	    fi
   552	  fi
   553	  report "$name" "$why"
   554	}
   555	
   556	r25() { # 첫 줄의 BOM·CR 은 걷어낸 뒤 판정한다 — 눈에 안 보이는 바이트가 정상 표명을
   557	        # 불량으로 뒤집으면 안 된다(harness_env_value 가 데인 같은 부류).
   558	  local name='r25 BOM·CRLF 첫 줄 → 정상 판정' why=''
   559	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   560	  printf '\357\273\277사전 결정 회수: docs/decisions/\r\n본문.\n' > "$p/_workspace/00_design.md"
   561	  set_flag "$p" retrieval '_workspace/00_design.md'
   562	  set_flag "$p" audit 'src/x.ts'
   563	  mk_tx "$p/tx.jsonl" neutral
   564	  run_stop "$p" "$p/tx.jsonl"
   565	  if contains "$ERR" "$TOK_RET";       then why='BOM/CR 때문에 정상 표명이 차단됐다'
   566	  elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   567	  elif ! flag_gone "$p";               then why='플래그 미해제'
   568	  fi
   569	  report "$name" "$why"
   570	}
   571	
   572	r26() { # 플래그 마지막 줄이 **개행 없이** 끝나도 그 항목은 검사된다. read 는 마지막
   573	        # 불완전 줄에서 값을 담고도 rc=1 을 내 `|| [ -n "$entry" ]` 가 없으면 본문이
   574	        # 안 돌고 — 표명 없는 산출물이 조용히 통과한다(구현 검수 [cx] HIGH).
   575	  local name='r26 개행 없는 마지막 플래그 줄도 검사된다' why=''
   576	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   577	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   578	  printf '_workspace/00_design.md' > "$p/.claude/.needs-retrieval"   # 개행 없음
   579	  set_flag "$p" audit 'src/x.ts'
   580	  mk_tx "$p/tx.jsonl" neutral
   581	  run_stop "$p" "$p/tx.jsonl"
   582	  if ! contains "$ERR" "$TOK_RET"; then why="차단하지 않았다 (마지막 줄이 스킵됨): $(printf '%s' "$ERR" | head -1 | head -c 90)"
   583	  fi
   584	  report "$name" "$why"
   585	}
   586	
   587	r27() { # 자동 해제 뒤 공유 지문을 **다시 계산**한다. 진입 시 스냅숏을 그대로 쓰면 이
   588	        # 턴의 하위 게이트(예: 듀얼리뷰)가 이미 지워진 "r" 비트가 든 지문으로 예산을
   589	        # 매기고, 다음 턴 지문과 달라져 진전이 아닌데 카운터가 리셋된다 — 벽돌 방지가
   590	        # 한 사이클 헛돈다(구현 검수 [cc] HIGH, 1/3→1/3→2/3→3/3 실측 재현).
   591	  local name='r27 자동 해제 후 지문 재계산 (하위 게이트 카운터 연속)' why=''
   592	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   593	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   594	  set_flag "$p" retrieval '_workspace/00_design.md'
   595	  set_flag "$p" dualreview '_workspace/00_design.md'
   596	  mk_tx "$p/tx.jsonl" neutral
   597	  run_stop "$p" "$p/tx.jsonl"     # 1회차: 해제 + 듀얼리뷰 차단 (지문은 해제 후 상태여야 한다)
   598	  if ! contains "$ERR" "$TOK_DUAL"; then why="듀얼리뷰 게이트 미도달: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   599	  elif ! contains "$ERR" '차단 1/';  then why='1회차가 1/N 이 아니다'
   600	  else
   601	    run_stop "$p" "$p/tx.jsonl"   # 2회차: 같은 상태 — 카운터가 이어져야 한다
   602	    if ! contains "$ERR" "$TOK_DUAL"; then why='2회차에 듀얼리뷰 게이트 미도달'
   603	    elif ! contains "$ERR" '차단 2/';  then why="stale 지문으로 카운터가 리셋됐다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   604	    fi
   605	  fi
   606	  report "$name" "$why"
   607	}
