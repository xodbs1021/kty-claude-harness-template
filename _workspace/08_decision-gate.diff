+# 같은 문장에 물음이 있으면 자백이 아니라 묻는 중이다.
+QUESTION = re.compile(
+    "\\?|까요|나요|ㄹ까|을까|할까|여쭤|여쭈|여쭙|물어|어떠신|어느 쪽"
+    "|골라|선택해|정해 ?주|알려 ?주|괜찮으신|의견"
+)
+# 서술형 종결. "내가 그렇게 했다"는 단정만 잡는다.
+DECLARATIVE = re.compile("(?:다|음|함|됨|임|옴)$")
+
+INLINE     = re.compile("`[^`\n]*`")
+QUOTED     = re.compile("\"[^\"\n]*\"|'[^'\n]*'|“[^”\n]*”"
+                        "|‘[^’\n]*’|「[^」\n]*」"
+                        "|『[^』\n]*』")
