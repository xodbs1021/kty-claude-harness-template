   141	# is_harness_canonical <저장소루트> — 하네스 정본 저장소인가.
   142	# 마커는 이 한 조건뿐이다. 조건을 더 얹으면 재배치 포크에서 위음성이 넓어지는데,
   143	# 위음성은 조용하고 오탐은 탈출구(ECC_DISABLED_HOOKS)가 있다 — 그래서 단순한 쪽을 택했다.
   144	is_harness_canonical() {
   145	  [ -d "$1/template/.claude" ]
   146	}
