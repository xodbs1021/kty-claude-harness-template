   387	g07() { gcase '들여쓴 위장으로는 못 끈다'          on  "  $GKEY=\"\""$'\n'; }
   388	g08() { gcase '주석 처리된 선언으로는 못 끈다'      on  "# $GKEY=\"\""$'\n'; }
   389	g09() { gcase 'harness.env 가 없으면 켜짐'         on  '__NOFILE__'; }
   390	g10() { gcase 'CRLF 로 비워도 꺼진다'              off "$GKEY=\"\""$'\r\n'; }
   391	
   392	
   393	# --- 듀얼 검수(2026-08-10)가 찾은 경로 ---------------------------------
   394	# 넷 다 **게이트를 끄는 방향**으로 틀리던 자리다. 이 방향의 오류가 이 설계에서 가장 나쁘다.
