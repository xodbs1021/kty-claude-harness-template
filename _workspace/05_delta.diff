+  chmod +x "$hooks_stage/"*.sh
+
+  on_swap_signal() {   # $1=신호 이름  $2=종료 코드
+    set +e             # 보고는 최선 노력, **종료 코드가 계약**이다
+    # 플래그가 아니라 **파일시스템 실제 상태**로 판정한다. 첫 mv 가 끝났는데 플래그를
