   614	    elif ! contains "$ERR" '차단 2/';  then why="stale 지문으로 카운터가 리셋됐다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   615	    fi
   616	  fi
   617	  report "$name" "$why"
