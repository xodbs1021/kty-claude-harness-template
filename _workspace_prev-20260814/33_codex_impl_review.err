   elif contains "$ERR" "$TOK_RET";     then why='위양성 — 회수 게이트가 막았다'
   elif ! contains "$ERR" "$TOK_AUDIT"; then why='감사 게이트 미도달'
   elif ! flag_gone "$p";               then why='플래그 미해제'
   fi
   report "$name" "$why"
 }
 
 r03() { # 표명 없음 → 차단. 첫 줄이 `사전` 으로 시작하지만 완전한 접두어는 아니다 —
