+SENT       = re.compile("([\n.!?…。！？]+)")
+LEAD       = re.compile("^[\\s*_>#\\-–—•·]+")
+TRAIL      = re.compile("[\\s*_`~\\[\\](){}<>:;,·…\\-—–]+$")
+
+MAX_HITS, MAX_LEN = 8, 140
+
+
+def fail(reason):
+    sys.stdout.write(reason + "\n")
+    raise SystemExit(2)
+
+
+def drop_fences(s):
