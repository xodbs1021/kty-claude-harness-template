   290	# 결정 문서는 지식 게이트 하나만. 코드가 아니므로 타입체크·변경설명·감사는 과하다.
   291	if [ "$verdict" = 'knowledge' ]; then
   292	  record_flag "$KNOWLEDGE_FLAG" "$value" || emit_message "$MSG_WRITE_FAIL"
   293	  exit 0
   294	fi
   295	
   296	[ "$verdict" = 'gate' ] || exit 0
   297	
   298	# 완료 게이트 4종을 동시에 세운다:
   299	#   .needs-audit      → completion-auditor 강제 (Phase 6)
   300	#   .needs-explain    → change-explainer 강제 (Phase 5)
   301	#   .needs-knowledge  → 지식 저장소 반영 또는 불요 사유 기록 강제 (2026-08-02 kty —
   302	#                       산문 규칙이 기억에만 의존해 세션 내내 0회 이행된 실사고의 재발 방지)
   303	#   .needs-dualreview → codex 듀얼 리뷰 강제 (2026-08-03 kty)
   304	# 각 게이트는 해당 작업이 실제로 끝난 뒤에만 수동으로 지워진다. Stop 훅이 넷 다 본다.
   305	#
   306	# 지식 게이트가 꺼져 있어도 여기서는 **기록한다.** 켜짐/꺼짐 판정은 harness.env 를 한 번
   307	# 더 읽는 일인데 이 훅은 편집마다 돌고 Stop 훅은 턴에 한 번 돈다 — 판정은 Stop 쪽
   308	# 한 곳(knowledge_gate_active)으로 모았다. 꺼져 있으면 이 파일은 아무 효력이 없다.
   309	write_failed=0
   310	for flag in "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG"; do
   311	  record_flag "$flag" "$value" || write_failed=1
   312	done
   313	# 넷이 다 실패해도 메시지는 한 줄만 낸다.
   314	[ "$write_failed" -eq 1 ] && emit_message "$MSG_WRITE_FAIL"
   315	exit 0

