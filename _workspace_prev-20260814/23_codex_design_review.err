   387	
   388	# 이중 백틱 코드 span 이 먼저다 — 단일 규칙만 두면 ``a`b`` 의 안쪽이 산문으로 샌다.
   389	INLINE     = re.compile("``[^`\n]*``|`[^`\n]*`")
   390	QUOTED     = re.compile("\"[^\"\n]*\"|'[^'\n]*'|“[^”\n]*”"
   391	                        "|‘[^’\n]*’|「[^」\n]*」"
