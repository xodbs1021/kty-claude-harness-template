   117	
   118	# run_stop_hook <proj> [env 인자...] — 감사 플래그 **하나만** 세우고 Stop 훅을 돌린다.
   119	# 하나만 세우는 것이 계약이다: 넷 다 세우면 앞선 게이트(듀얼리뷰·설명)가 먼저 막아
   120	# 타입체크 축이 문구로도 안 보인다.
   121	run_stop_hook() {
   122	  local proj="$1" errf="$TMPROOT/herr.$$"
