    90	new_fp=""
    91	
    92	gate_budget() {  # $1 = 게이트 식별자. 각 차단 지점이 메시지 출력 전에 호출한다.
    93	  new_fp="$1|$flags_fp"
    94	  # 지문을 기록할 수 있을 때만 리셋한다 — 지문 파일을 못 쓰는 환경에서 리셋하면
    95	  # prev_fp가 영원히 비어 매번 1/3로 무한 차단된다([cx] 지적). 그 경우 리셋 없는
    96	  # 구식 누적으로 동작해 3회 후 통과가 보장된다.
    97	  if printf '%s\n' "$new_fp" > "$BLOCK_FP" 2>/dev/null; then
    98	    if [ "$new_fp" != "$prev_fp" ]; then
    99	      count=0   # 지난 차단과 다른 게이트/플래그 집합 = 진전 — 예산 리셋
   100	    fi
   101	  fi
   102	  if [ "$count" -ge "$MAX_BLOCKS" ]; then
   103	    changed="$(cat "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" 2>/dev/null | tr -d '"\\' | sort -u | tr '\n' ' ')"
   104	    rm -f "$AUDIT_FLAG" "$EXPLAIN_FLAG" "$KNOWLEDGE_FLAG" "$DUALREVIEW_FLAG" "$BLOCK_COUNT" "$BLOCK_FP" 2>/dev/null
   105	    # 판독 불가 사유도 함께 싣는다. 여기서 빠뜨리면 **예산이 소진된 턴에 발생한**
   106	    # 판독 불가가 영구 소실된다 — 게이트 메시지가 이 경로로는 안 나가기 때문이다([cx] 2라운드).
   107	    printf '{"systemMessage":"[완료 게이트] 같은 지점(%s)에서 %s회 차단 후에도 진전이 없어 세션 벽돌 방지를 위해 통과시킵니다. 이 턴의 완료 주장(및 변경 설명)을 신뢰하지 마세요. 미처리 변경: %s%s"}\n' \
   108	      "$1" "$MAX_BLOCKS" "$changed" \
   109	      "${decision_note:+ / $decision_note}"
   110	    exit 0
   111	  fi
   112	}
   113	
   114	# 결정 게이트가 대화 기록을 못 읽었으면 **어느 게이트가 막든** 그 사유를 함께 낸다.
   115	# 감사 게이트에만 실으면, 앞 게이트가 먼저 막은 턴에는 안 보이고 그 플래그를 지운 다음
   116	# 턴에는 조기 종료로 **영영 사라진다**(검수 [cx] 지적). 조용히 사라지는 것이 이 게이트를
   117	# 만든 이유 그 자체라, 경고를 삼키지 않는 것이 fail-open 의 조건이다.
   118	emit_decision_note() {
   119	  [ -n "${decision_note:-}" ] || return 0
   120	  echo
   121	  echo "참고: $decision_note"
   122	  echo "      → 이 턴에 사용자에게 물었어야 할 결정이 없었는지 스스로 확인하세요."
   123	}
   124	
   125	bump_and_block() {
   126	  if ! printf '%s\n' "$((count + 1))" > "$BLOCK_COUNT" 2>/dev/null; then
   127	    # 카운터를 못 쓰면 무한루프 위험 → 표준 가드로 폴백
   128	    case "$stop_active" in
   129	      [Tt]rue) exit 0 ;;
   130	    esac
   131	  fi
   132	  exit 2
   133	}
   134	
   135	# (3) 타입체크 — 결정론적 바닥. 명령은 프로필에서 파생된 harness.env 에서 읽는다.
   136	#     HARNESS_TYPECHECK_CMD 가 비어 있으면(타입 없는 언어/미설정) 생략한다.
   137	#     이렇게 하면 이 훅이 특정 스택(pnpm/tsc)에 묶이지 않는다 — 도메인-무관 재사용.
   138	#     **이 파일을 실행하지 않는다.** source 하면 사용자 소유 셸 파일이 훅의 제어 흐름을
   139	#     가져간다 — `exit 0` 한 줄이면 이 훅이 조용히 끝나 **게이트 4종이 통째로 사라지고**
   140	#     흔적도 안 남는다. 원문 판독으로 그 부류를 없앤다(harness_env_value 주석 참조).
   141	typecheck_note=""
   142	#     rc 를 함께 받는다. "리터럴로 비웠다"(rc=0 + 빈 값 = 의도한 생략)와 "값을 믿을 수
   143	#     없다"(rc=1 = 미설정·선언 2개 이상·지원 문법 밖·읽기 실패)는 둘 다 생략으로 가지만
   144	#     사용자에게 **다른 정보**다. 후자는 고칠 수 있는 실수라 그렇게 적어야 한다.
   145	TYPECHECK_CMD="$(harness_env_value HARNESS_TYPECHECK_CMD)"; typecheck_rc=$?
   146	
   147	if [ "$typecheck_rc" -ne 0 ]; then
   148	  typecheck_note="타입체크 생략 (harness.env 의 HARNESS_TYPECHECK_CMD 를 읽지 못함 — 미설정이거나, 선언이 2개 이상이거나, 지원 문법 밖입니다)"
   149	elif [ -z "$TYPECHECK_CMD" ]; then
   150	  typecheck_note="타입체크 생략 (HARNESS_TYPECHECK_CMD 가 빈 값으로 설정됨)"
   151	else
   152	  timeout_bin=""
   153	  if command -v timeout >/dev/null 2>&1; then
   154	    timeout_bin="timeout"
   155	  elif command -v gtimeout >/dev/null 2>&1; then
   156	    timeout_bin="gtimeout"
   157	  fi
   158	  # macOS 기본에는 timeout 이 없다. 그 경우 settings.json 의 "timeout": 120 이 최종 안전망.
   159	
   160	  if [ -n "$timeout_bin" ]; then
   161	    tc_out="$(cd "$PROJECT_DIR" && "$timeout_bin" 90 sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   162	  else
   163	    tc_out="$(cd "$PROJECT_DIR" && sh -c "$TYPECHECK_CMD" 2>&1)"; tc_rc=$?
   164	  fi
   165	
   166	  if [ "$tc_rc" -eq 124 ] || [ "$tc_rc" -eq 137 ]; then
   167	    # 타임아웃은 "타입 오류"가 아니라 "모름". 차단하지 않고 감사자에게 넘긴다.
   168	    typecheck_note="타입체크 타임아웃 → 생략 (감사자가 재확인할 것)"
   169	  elif [ "$tc_rc" -eq 127 ]; then
   170	    # 명령/도구 없음(rc=127)은 "타입 오류"가 아니다. 오탐 차단 방지 위해 생략.
   171	    typecheck_note="타입체크 생략 (명령 실행 불가 rc=127): $TYPECHECK_CMD"
   172	  elif [ "$tc_rc" -ne 0 ]; then
   173	    gate_budget "typecheck"
   174	    {
   175	      echo "[완료 차단] 타입체크 실패 — 지금은 '완료'가 아닙니다."
   176	      echo
   177	      echo "명령: $TYPECHECK_CMD"
   178	      echo
   179	      printf '%s\n' "$tc_out" | head -n 15
   180	      echo
   181	      echo "고친 뒤 다시 종료하세요.  (차단 $((count + 1))/${MAX_BLOCKS})"
   182	      echo "탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=$HOOK_ID"
   183	    } >&2
   184	    bump_and_block
   185	  fi
   186	fi
   187	
   188	# (3.2) **결정 게이트** — "물어봤어야 할 것을 혼자 정했나".
   189	#      나머지 게이트가 전부 **산출물**을 볼 때 이것만 **에이전트 자신의 행동**을 본다.
   190	#      판정 규칙·좁히는 장치 셋·fail-open 사유는 _common.sh 의 decision_scan 주석이 정본이다.
   191	#
   192	#      **타입체크 다음, 나머지 게이트보다 앞에 둔다.** 질문의 답이 코드를 바꿀 수 있으므로, 리뷰·설명·감사에
   193	#      노력을 쓰기 전에 묻는 편이 싸다. (push 탐지와 달리 순서가 정확성을 바꾸지는 않는다 —
   194	#      대화 기록은 이미 다 쓰였고 게이트 순서가 그 내용을 바꾸지 않기 때문이다.)
   195	decision_note=""
   196	# **발동 조건은 플래그다.** 조기 종료는 push 미완만으로도 풀리므로, 그것만 보고 스캔하면
   197	# 아무것도 안 바꾼 읽기 전용 턴까지 검사하게 된다 — "플래그와 무관하게 항상"은 사용자가
   198	# 기각한 보기다. 여기서 한 번 더 물어 발동 계약을 조기 종료와 분리한다.
   199	decision_armed=0
   200	if [ -s "$AUDIT_FLAG" ] || [ -s "$EXPLAIN_FLAG" ] || [ -s "$DUALREVIEW_FLAG" ] || knowledge_gate_active; then
   201	  decision_armed=1
   202	fi
   203	if [ "$decision_armed" -eq 1 ] && ! hook_disabled "stop:decision"; then
   204	  decision_hits="$(decision_scan "$transcript_path")"; decision_rc=$?
   205	  case "$decision_rc" in
   206	    3) : ;;   # 표지 없음 · 또는 이 턴에 물었음
   207	    2)
   208	      # **이 게이트의 유일한 fail-open.** 통과시키되 사유를 게이트 메시지에 실어 보낸다.
   209	      # 대화 기록 형식은 하네스 소유가 아니라, 여기서 차단하면 그 세션 안에 고칠 방법이 없다.
   210	      decision_note="결정 게이트 생략 ($decision_hits)" ;;
   211	    0) ;;     # 아래에서 차단한다 (case 안에서 하면 들여쓰기가 깊어져 메시지가 안 읽힌다)
   212	    *)
   213	      # **모르는 rc 는 통과가 아니라 판독 불가다.** python3 부재(127)·처리 못 한 예외(1)·
   214	      # 신호 종료가 전부 여기로 온다. 이걸 통과로 읽으면 게이트가 조용히 사라진다.
   215	      decision_note="결정 게이트 생략 (스캐너가 예상 밖 상태로 끝남 rc=$decision_rc — python3 부재·예외·신호 종료일 수 있습니다)" ;;
   216	  esac
   217	  if [ "$decision_rc" -eq 0 ]; then
   218	    gate_budget "decision"
   219	    {
   220	      echo "[완료 차단] 혼자 정한 것이 있는데 이 턴에 사용자에게 한 번도 묻지 않았습니다."
   221	      echo
   222	      echo "걸린 문장:"
   223	      printf '%s\n' "$decision_hits" | sed 's/^/  - /'
   224	      echo
   225	      echo "이 게이트가 겨누는 것:"
   226	      echo "  게이트가 막을 때는 따르면서, 게이트가 없는 자리에서는 혼자 정하고 보고서에"
   227	      echo "  한 줄 적는 부류입니다. 그 '한 줄'은 도구 호출이 아니라 문장이라 승인창이"
   228	      echo "  안 뜨고, 그래서 이 저장소가 겪은 실패 대부분이 이 축에서 났습니다."
   229	      echo
   230	      echo "해야 할 일:"
   231	      echo "  1. 위 문장들이 정말 **사용자가 정할 일**이었는지 본다."
   232	      echo "     '범위 밖'·'별도로'·'그대로 뒀'는 대개 선택지를 줬어야 하는 자리입니다."
   233	      echo "  2. AskUserQuestion 으로 **실제로 묻는다.** 보고서에 적는 것은 묻는 것이 아닙니다."
   234	      echo "  3. 질문을 한 번이라도 하면 이 게이트는 풀립니다."
   235	      echo
   236	      echo "위양성이라면(그 어휘를 설명·인용한 것이지 결정이 아니라면):"
   237	      echo "  - 백틱이나 따옴표로 감싸면 스캔에서 빠집니다 — 인용은 결정이 아니니까요."
   238	      echo "  - 그래도 걸리면 사용자에게 위양성임을 알리고 지시를 받으세요."
   239	      echo
   240	      echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:decision"
   241	    } >&2
   242	    bump_and_block
   243	  fi
   244	fi
   245	
   246	# (3.5) 듀얼 리뷰(codex) 게이트 (2026-08-03 kty — "리뷰가 필요한 모든 단계를 codex와 같이"의 기계화).
   247	#      설계·계획 산출물이 저장되거나 코드가 바뀐 턴은 codex 독립 리뷰 없이 끝낼 수 없다.
   248	#      Claude 단독 리뷰가 놓친 CRITICAL을 codex가 잡은 실사고(2026-08-03 POK-30)의 재발 방지.
   249	if [ -s "$DUALREVIEW_FLAG" ] && ! hook_disabled "stop:dualreview"; then
   250	  gate_budget "dualreview"
   251	  {
   252	    echo "[완료 차단] codex 듀얼 리뷰 미수행 — Claude 단독 리뷰로는 끝낼 수 없습니다."
   253	    echo
   254	    echo "이 턴의 듀얼 리뷰 대상:"
   255	    sed 's/^/  - /' "$DUALREVIEW_FLAG" 2>/dev/null
   256	    echo
   257	    echo "해야 할 일:"
   258	    echo "  1. 대상 산출물/diff를 codex로 독립 리뷰시킨다 (모델·effort는 guard-codex-invocation 규정 — 임의 하향 금지)."
   259	    echo "  2. 결과를 _workspace/ 에 *codex*.md 로 저장하고 지적을 [cc]/[cx] 태그로 통합한다."
   260	    echo "  3. 그 뒤에만:  rm -f .claude/.needs-dualreview"
   261	    echo "     codex 미설치·호출 실패면 사용자 보고에 '듀얼 리뷰 생략(codex 실패)'을 명시한 뒤에 지운다."
   262	    echo "     리뷰 없이 플래그만 지우는 것은 이 게이트의 존재 이유를 없앤다."
   263	    echo
   264	    emit_decision_note
   265	    echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:dualreview"
   266	  } >&2
   267	  bump_and_block
   268	fi
   269	
   270	# (4) change-explainer 게이트 (Phase 5) — 감사자보다 먼저 강제한다.
   271	#     코드가 바뀐 턴은 변경 설명 없이 끝낼 수 없다. change-explainer 가 실제로
   272	#     사용자용 설명을 낸 뒤에만 .needs-explain 을 지운다.
   273	#     (완료 감사와 별개로 이 게이트만 끄려면 ECC_DISABLED_HOOKS=stop:explain)
   274	if [ -s "$EXPLAIN_FLAG" ] && ! hook_disabled "stop:explain"; then
   275	  gate_budget "explain"
   276	  {
   277	    echo "[완료 차단] change-explainer 미실행 — 변경 설명 없이 끝낼 수 없습니다."
   278	    echo
   279	    echo "이 턴에서 바뀐 코드/설정:"
   280	    sed 's/^/  - /' "$EXPLAIN_FLAG" 2>/dev/null
   281	    echo
   282	    echo "해야 할 일:"
   283	    echo "  1. change-explainer 에이전트로 실제 diff 기반 사용자용 변경 설명을 낸다."
   284	    echo "  2. 설명을 낸 뒤에만:  rm -f .claude/.needs-explain"
   285	    echo "     설명 없이 플래그만 지우는 것은 이 게이트의 존재 이유를 없앤다."
   286	    echo
   287	    emit_decision_note
   288	    echo "차단 $((count + 1))/${MAX_BLOCKS}.  탈출구: HARNESS_HOOKS=off  또는  ECC_DISABLED_HOOKS=stop:explain"
   289	  } >&2
   290	  bump_and_block
   291	fi
   292	
   293	# (5) 지식 저장소 반영 게이트 — 감사보다 먼저 강제한다 (감사자가 반영 결과를 검증하도록).
   294	#     (2026-08-02 kty — 산문 규칙이 세션 내내 0회 이행된 실사고의 기계화)
   295	#
   296	#     **이 훅이 아는 것은 계약 하나뿐이다**: "지식 저장소가 설정돼 있으면, 결정·설계가
   297	#     나온 턴은 반영 없이 끝낼 수 없다." 저장소가 어디인지·어떤 구조인지·무엇을 어느
   298	#     파일에 나눠 담는지는 **상위 층의 구현**이고 이 파일은 모른다. 알게 되면 그 저장소를
   299	#     안 쓰는 환경에서 하네스가 없는 구조를 요구하게 된다(제0원칙 4 — 구체가 아닌 계약).
   300	#     어디에 어떻게 저장했는지의 검증은 그 저장소 자신의 규약이 한다.
   301	if knowledge_gate_active && ! hook_disabled "stop:knowledge"; then
   302	  gate_budget "knowledge"
   303	  {
   304	    echo "[완료 차단] 지식 저장소 반영 미확인 — 이 턴의 결정·설계를 남기지 않고 끝낼 수 없습니다."
   305	    echo
   306	    echo "이 턴에서 바뀐 코드/설정:"
   307	    sed 's/^/  - /' "$KNOWLEDGE_FLAG" 2>/dev/null
   308	    echo
   309	    echo "해야 할 일:"
   310	    echo "  1. 이 머신의 지식 저장소가 **어디이고 어떤 형식인지는 사용자 층 설정**(전역"
   311	    echo "     CLAUDE.md 등)이 답한다. 그 규약을 **전문** 읽는다 — 부분 독해 금지."
   312	    echo "  2. 이번 턴에 결정·설계·개발작업이 있으면 그 규약대로 반영하고, 반영됐다는"
