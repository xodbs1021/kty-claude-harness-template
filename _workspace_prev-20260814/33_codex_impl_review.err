   197	  elif [ "$RC" -ne 2 ];                          then why="rc=$RC (기대 2)"
   198	  elif ! contains "$ERR" "$TOK_RET";             then why="회수 게이트가 막지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   199	  elif ! contains "$ERR" '_workspace/00_design.md'; then why='불량 파일명이 메시지에 없다'
   200	  elif contains "$ERR" "$TOK_AUDIT";             then why='차단인데 감사 게이트까지 흘러갔다'
   201	  elif flag_gone "$p";                           then why='불량인데 플래그가 해제됐다'
   202	  fi
   203	  report "$name" "$why"
   204	}
   205	
   206	r04() { # 빈 파일 → 차단.
   207	  local name='r04 빈 파일 → 차단' why=''
   208	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
