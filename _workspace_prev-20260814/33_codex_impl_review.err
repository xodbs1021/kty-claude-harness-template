   343	  elif ! contains "$ERR" "$out/_workspace/01_plan.md"; then why='밖 불량 파일명이 없다'
   344	  fi
   345	  report "$name" "$why"
   346	}
   347	
   348	r13() { # fail-closed 두 축: ① 플래그 파일 자체를 읽을 수 없다 → 차단(사유 포함)
   349	        #                   ② 대상 파일이 있는데 읽을 수 없다 → 불량으로 차단
   350	  local name='r13 읽기 실패는 통과가 아니다 (플래그·대상)' why=''
   351	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   352	  mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"
   353	  set_flag "$p" retrieval '_workspace/00_design.md'
   354	  set_flag "$p" audit 'src/x.ts'
   355	  mk_tx "$p/tx.jsonl" neutral
   356	  chmod 000 "$p/.claude/.needs-retrieval"
   357	  run_stop "$p" "$p/tx.jsonl"
   358	  chmod 644 "$p/.claude/.needs-retrieval" 2>/dev/null
   359	  if ! contains "$ERR" "$TOK_RET_FLAGFAIL"; then
   360	    why="플래그 읽기 실패를 차단하지 않았다: $(printf '%s' "$ERR" | head -1 | head -c 90)"
   361	  else
   362	    local p2; p2="$(new_project)" || { report "$name" '픽스처 실패(2)'; return 0; }
   363	    mk_doc "$p2/_workspace/00_design.md" "$GOOD_FIRST"
   364	    chmod 000 "$p2/_workspace/00_design.md"
   365	    set_flag "$p2" retrieval '_workspace/00_design.md'
   366	    set_flag "$p2" audit 'src/x.ts'
   367	    mk_tx "$p2/tx.jsonl" neutral
   368	    run_stop "$p2" "$p2/tx.jsonl"
   369	    chmod 644 "$p2/_workspace/00_design.md" 2>/dev/null
   370	    if ! contains "$ERR" "$TOK_RET"; then why='대상 읽기 실패를 차단하지 않았다'
   371	    elif ! contains "$ERR" '읽을 수 없음'; then why='사유(읽기 실패)가 없다'
   372	    fi
   373	  fi
   374	  report "$name" "$why"
   375	}
   376	
   377	r14() { # 불량 집합이 줄어드는 실제 진전은 이 게이트의 예산 카운터를 리셋한다.
   378	        # 예산 키에서 목록을 빼는 변이가 여기서 빨개진다(2회째가 2/3 로 나온다).
   379	  local name='r14 불량을 하나 고치면 카운터 리셋 (1/3 유지)' why=''
   380	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   381	  mk_doc "$p/_workspace/00_design.md" '표명 없음 A.'
   382	  mk_doc "$p/_workspace/01_plan.md" '표명 없음 B.'
   383	  set_flag "$p" retrieval '_workspace/00_design.md' '_workspace/01_plan.md'
   384	  set_flag "$p" audit 'src/x.ts'
   385	  mk_tx "$p/tx.jsonl" neutral
   386	  run_stop "$p" "$p/tx.jsonl"
   387	  if ! contains "$ERR" '차단 1/'; then why="1회차가 1/N 이 아니다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   388	  else
   389	    mk_doc "$p/_workspace/00_design.md" "$GOOD_FIRST"    # A 를 고쳤다 = 진전
   390	    run_stop "$p" "$p/tx.jsonl"
   391	    if ! contains "$ERR" "$TOK_RET";    then why='2회차에 차단하지 않았다'
   392	    elif ! contains "$ERR" '차단 1/';   then why="진전인데 카운터가 리셋되지 않았다: $(printf '%s' "$ERR" | tail -1 | head -c 60)"
   393	    fi
   394	  fi
   395	  report "$name" "$why"
   396	}
   397	
   398	r15() { # 예산 소진 시 회수 플래그도 정리 목록에 있다 — rm 과 changed 나열 양쪽.
   399	        # changed 단언은 **불량 집합에 없는 소실 항목**으로 잰다: 불량 경로는 예산 소진
   400	        # 메시지의 게이트 식별자("같은 지점(retrieval:...)")에도 실려서, changed 나열에서
   401	        # 회수 플래그를 빼도 같은 파일명이 다른 경로로 출력돼 변이가 가려진다(실측 —
   402	        # "데이터 중복이 방어를 가린다" 부류. m13 이 이 단언으로만 빨개진다).
   403	  local name='r15 예산 소진 정리에 회수 플래그 포함' why=''
   404	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   405	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   406	  set_flag "$p" retrieval '_workspace/00_design.md' '_workspace/01_plan_gone.md'
   407	  set_flag "$p" audit 'src/x.ts'
   408	  mk_tx "$p/tx.jsonl" neutral
   409	  run_stop "$p" "$p/tx.jsonl"; run_stop "$p" "$p/tx.jsonl"; run_stop "$p" "$p/tx.jsonl"
   410	  run_stop "$p" "$p/tx.jsonl"   # 4회째 — 같은 상태이므로 예산 소진
   411	  if [ "$RC" -ne 0 ];                        then why="소진 턴 rc=$RC (기대 0)"
   412	  elif ! contains "$OUT" "$TOK_BRICK";       then why='벽돌 방지 메시지가 없다'
   413	  elif ! contains "$OUT" '01_plan_gone.md';  then why='changed 나열에 회수 플래그 항목이 없다 (소실 항목은 게이트 식별자에 없다)'
   414	  elif ! flag_gone "$p";                     then why='소진 정리에서 회수 플래그가 안 지워졌다'
   415	  fi
   416	  report "$name" "$why"
   417	}
   418	
   419	r16() { # 결정 게이트 판독 불가 사유는 회수 차단 메시지에도 실린다 (ADR-0012 ②).
   420	        # transcript 를 아예 주지 않아 판독 불가를 만든다. 발동 조건은 audit 플래그.
   421	  local name='r16 판독 불가 사유가 회수 차단에 실린다' why=''
   422	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
   423	  mk_doc "$p/_workspace/00_design.md" '표명 없음.'
   424	  set_flag "$p" retrieval '_workspace/00_design.md'
   425	  set_flag "$p" audit 'src/x.ts'
   426	  run_stop "$p" ""
   427	  if ! contains "$ERR" "$TOK_RET";  then why='회수 게이트가 막지 않았다'
   428	  elif ! contains "$ERR" "$TOK_NOTE"; then why='판독 불가 사유가 안 실렸다'
   429	  fi
