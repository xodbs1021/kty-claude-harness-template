+    fail("대화 기록을 열지 못했습니다: %s" % exc.__class__.__name__)
+
+lines = [ln for ln in raw.splitlines() if ln.strip()]
+entries = []
+for ln in lines:
+    try:
+        entries.append(json.loads(ln))
+    except Exception:
+        pass                # 개별 줄 손상은 건너뛴다. 전멸이면 바로 아래에서 걸린다
