   152	# 번호는 설계서 7절의 목록과 1:1 이다. 새 케이스는 뒤에만 붙인다.
   153	
   154	r01() { # 정상 첫 줄 → 회수 침묵 + 자동 해제 + 감사 게이트 도달.
   155	  local name='r01 정상 첫 줄 → 통과 + 플래그 자동 해제' why=''
   156	  local p; p="$(new_project)" || { report "$name" '픽스처 실패'; return 0; }
